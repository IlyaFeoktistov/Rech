// Тест "структура" - в отличие от "сущность" (по умолчанию ссылочная, шаг
// 12, см. examples/тесты/сущность_тест.rech), структура передаётся по
// значению: присваивание копирует объект целиком, мутация через одно имя
// не видна через другое. Получатель метода ("этот") - указатель в обоих
// случаях, мутация внутри метода видна вызывающему коду сразу после
// возврата - это не меняется структурой (docs/SPEC.md, раздел 6).

структура Счётчик
{
    имеет:
        значение: Целое

    увеличить()
    {
        этот.значение = этот.значение + 1
    }
}

функция главная
{
    переменная счётчик = новый Счётчик(0)
    утверждать счётчик.значение == 0

    счётчик.увеличить()
    счётчик.увеличить()
    счётчик.увеличить()
    утверждать счётчик.значение == 3

    переменная копия = счётчик
    счётчик.увеличить()
    утверждать счётчик.значение == 4
    утверждать копия.значение == 3
}
