// Регрессионный тест для Дробное/Символ/Байт и явных кастов "(Тип)
// значение" - проверяет одинаковый результат на обоих backend'ах
// (rech test - через internal/interp, rech run - через сгенерированный C).
//
// Проверить: rech test examples/тесты/типы_и_касты_тест.rech

/** Проверяет смешанную арифметику и явные касты между примитивными типами. */
функция главная
{
    // Смешанная арифметика: Целое -> Дробное -> Действительное.
    переменная целое = 2
    переменная дробное = 1.5
    переменная действительное = 0.25

    утверждать целое + дробное == 3.5
    утверждать дробное + действительное == 1.75

    // Целое <-> Символ (код точки), Целое <-> Байт (усечение).
    утверждать (Целое) 'a' == 97
    утверждать (Символ) 97 == 'a'
    утверждать (Целое) 'я' == 1103
    утверждать (Целое) (Байт) 300 == 44
    утверждать (Целое) (Байт) 44 == 44

    // Строка <-> Целое/Действительное - десятичная запись и разбор.
    утверждать (Строка) 42 == "42"
    утверждать (Целое) "42" == 42
    утверждать (Действительное) "1.5" == 1.5

    // Строка <-> Символ - именно один символ, не код.
    утверждать (Символ) "ю" == 'ю'
    утверждать (Строка) 'ю' == "ю"

    // Байт <-> Строка - как число.
    утверждать (Строка) (Байт) 65 == "65"

    // Символ/Байт сравниваются по величине.
    утверждать 'а' < 'б'
    утверждать (Байт) 10 < (Байт) 20

    // Каст в тот же самый тип - тождество.
    утверждать (Целое) целое == целое
}
