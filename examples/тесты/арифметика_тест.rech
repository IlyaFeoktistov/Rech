// Тестовый файл - обычная программа Rech со своей "главная", ничем не
// отличается от любого другого примера, кроме имени: суффикс "_тест.rech"
// - это то, что "rech test" ищет при обходе каталога (рекурсивно). Файл
// без этого суффикса "rech test" не найдёт, даже если внутри есть
// "утверждать" - соглашение только об имени файла.
//
// Проверить этот файл: rech test examples/тесты/арифметика_тест.rech
// Найти и проверить все тесты в каталоге: rech test examples/тесты

/** Складывает два целых числа. */
функция сложить(а: Целое, б: Целое): Целое
{
    вернуть а + б
}

/** Возвращает среднее арифметическое двух чисел. */
функция среднее(а: Действительное, б: Действительное): Действительное
{
    вернуть (а + б) / 2.0
}

/** Проверяет "сложить"/"среднее" через "утверждать". */
функция главная
{
    // "утверждать <условие>" - условие должно быть Логическое (как у
    // "если"/"пока"). Если условие ложно - выполнение немедленно
    // прерывается (аварийное завершение, как rech_panic у встроенных
    // коллекций) с сообщением, где указан номер строки провалившейся
    // проверки - остальные "утверждать" после неё уже не выполняются.
    утверждать сложить(2, 3) == 5
    утверждать сложить(-1, 1) == 0

    // Можно проверять несколько условий сразу через "и"/"или", как в
    // любом другом логическом выражении - не только через отдельные
    // "утверждать" на каждое условие по отдельности.
    утверждать сложить(10, 20) == 30 и сложить(0, 0) == 0

    утверждать среднее(2.0, 4.0) == 3.0

    // Необязательный второй аргумент через запятую - "сообщение" (Строка) -
    // дописывается к стандартному тексту при провале ("ожидалось X,
    // получено Y" - вызывающий код строит его сам обычной конкатенацией/
    // кастами, тот же принцип, что и у второго аргумента t.Errorf в Go).
    переменная сумма = сложить(7, 8)
    утверждать сумма == 15, "сложить(7, 8): ожидалось 15, получено " + (Строка) сумма

    // "утверждать" - обычная инструкция языка, а не специальная
    // синтаксическая форма теста: её можно использовать где угодно, в том
    // числе внутри "если"/"пока"/"для".
    для i от 1 до 5 {
        утверждать сложить(i, 0) == i
    }
}
