// Тестовый файл (см. examples/тесты/арифметика_тест.rech про сам принцип
// "_тест.rech") - демонстрирует "равен" у "Список<T>"/"Словарь<К, В>"
// (docs/SPEC.md, раздел 8): "==" для этих коллекций (как и для любой
// сущности) сравнивает по identity, "равен" - по СОДЕРЖИМОМУ, ровно то,
// чего не хватало для проверки построенных в тесте списков/словарей на
// равенство без ручного цикла по элементам.
//
// Проверить: rech test examples/тесты/коллекции_тест.rech

структура Точка
{
    имеет:
        Целое x
        Целое y
}

функция главная
{
    переменная а = [1, 2, 3]
    переменная б = [1, 2, 3]
    переменная г = [1, 2, 4]

    утверждать не (а == б), "== для Список<T> - identity, разные объекты не равны, даже с одинаковым содержимым"
    утверждать а.равен(б), "равен - по содержимому, одинаковые элементы по порядку"
    утверждать не а.равен(г), "разное содержимое - равен возвращает ложь"

    // Вложенные списки - "равен" рекурсивно сравнивает КАЖДЫЙ вложенный
    // список тоже по содержимому, не по identity его самого.
    переменная матрица1 = [[1, 2], [3, 4]]
    переменная матрица2 = [[1, 2], [3, 4]]
    утверждать матрица1.равен(матрица2), "вложенные Список<Список<Целое>> сравниваются рекурсивно"

    // Элемент-"структура" - сравнивается поле-в-поле (та же семантика,
    // что и у "==" структуры самой по себе, docs/SPEC.md).
    переменная точки1 = [новая Точка(1, 2), новая Точка(3, 4)]
    переменная точки2 = [новая Точка(1, 2), новая Точка(3, 4)]
    переменная точки3 = [новая Точка(1, 2), новая Точка(9, 9)]
    утверждать точки1.равен(точки2), "элементы-структуры сравниваются по значению"
    утверждать не точки1.равен(точки3), "разные значения полей элемента - не равны"

    // Словарь - сравнение по содержимому, БЕЗ учёта порядка вставки
    // (хеш-таблица неупорядочена).
    переменная возраста1 = новый Словарь<Строка, Целое>()
    возраста1.установить("Аня", 30)
    возраста1.установить("Боря", 25)

    переменная возраста2 = новый Словарь<Строка, Целое>()
    возраста2.установить("Боря", 25)
    возраста2.установить("Аня", 30)

    утверждать возраста1.равен(возраста2), "тот же набор пар ключ-значение в другом порядке вставки - равны"

    возраста2.установить("Боря", 26)
    утверждать не возраста1.равен(возраста2), "разное значение по общему ключу - не равны"
}
