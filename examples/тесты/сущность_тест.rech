// Тест метода сущности - проверяет мутацию поля через "этот" (см.
// examples/сущности/сущности.rech) с помощью "утверждать".

/** Счётчик по ссылке - демонстрирует разделяемую мутацию "сущность". */
сущность Счётчик
{
    имеет:
        Целое значение

    конструктор(значение: Целое)
    {
        этот.значение = значение
    }

    /** Увеличивает значение на один. */
    увеличить()
    {
        этот.значение = этот.значение + 1
    }
}

/** Проверяет мутацию поля через "этот" и разделяемую семантику "сущность". */
функция главная
{
    переменная счётчик = новый Счётчик(0)
    утверждать счётчик.значение == 0

    счётчик.увеличить()
    счётчик.увеличить()
    счётчик.увеличить()
    утверждать счётчик.значение == 3

    // Сущности - ссылки (шаг 12): присваивание не копирует объект, "копия"
    // и "счётчик" делят один и тот же объект, мутация через любое из имён
    // видна через оба (docs/SPEC.md, раздел 6). Для копирующей семантики -
    // "структура" (examples/тесты/структура_тест.rech).
    переменная копия = счётчик
    счётчик.увеличить()
    утверждать счётчик.значение == 4
    утверждать копия.значение == 4
}
