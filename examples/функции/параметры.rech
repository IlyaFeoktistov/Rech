сущность Пользователь
{
    имеет:
        имя: Строка
}

сущность Права
{
    имеет:
        уровень: Целое
}

// "кого пользователь" - падежная роль "кого" отдельно от отображаемого
// имени "пользователь" (используется в теле функции); "права" - совсем
// без падежной роли, обычный позиционный параметр.
функция оформить(кого пользователь: Пользователь, права: Права)
{
    вывести "Оформлен: " + пользователь.имя
    вывести права.уровень
}

функция главная
{
    переменная пользователь = новый Пользователь("Илья")
    переменная админ = новые Права(1)

    // Строгий вызов - как обычно, по позиции.
    оформить(пользователь, админ)

    // Естественный вызов: "пользователя" (винительный, одушевлённый)
    // связывается с параметром "пользователь" по падежу; "админ" не
    // подходит по падежу ни одному ещё не занятому помеченному параметру,
    // поэтому достаётся оставшемуся непомеченному "права" по остатку.
    оформить пользователя админ
}
