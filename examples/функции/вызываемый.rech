// Функции как значения: "&имя" - ссылка на уже объявленную функцию без
// вызова, лямбда - функция без имени в позиции выражения, обе - значения
// типа "Вызываемый<...>...".

функция удвоить(x: Целое): Целое
{
    вернуть x * 2
}

функция применить(значение: Целое, ф: Вызываемый<Целое>Целое): Целое
{
    вернуть ф(значение)
}

функция главная
{
    вывести применить(21, &удвоить)
    вывести применить(21, функция(x: Целое): Целое { вернуть x + 1 })

    // Замыкание захватывает переменные окружающей области видимости по
    // значению в момент создания - последующая мутация снаружи не видна
    // внутри, а мутация изнутри копится между вызовами ОДНОГО И ТОГО ЖЕ
    // значения лямбды.
    переменная счётчик = 0
    переменная увеличить = функция()
    {
        счётчик = счётчик + 1
        вывести счётчик
    }
    увеличить()
    увеличить()
    вывести счётчик
}
