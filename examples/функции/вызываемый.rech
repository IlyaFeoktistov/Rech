// Функции как значения: "&имя" - ссылка на уже объявленную функцию без
// вызова, лямбда - функция без имени в позиции выражения, обе - значения
// типа "Вызываемый(...)...". В объявлении переменной сигнатуру можно не
// писать - "Вызываемый имя = ..." берёт её из значения справа.

/** Удваивает x. */
функция удвоить(x: Целое): Целое
{
    вернуть x * 2
}

/** Применяет вызываемое значение ф к значению. */
функция применить(значение: Целое, ф: Вызываемый(Целое): Целое): Целое
{
    вернуть ф(значение)
}

/** Демонстрирует "&имя", лямбды и захват переменных замыканием. */
функция главная
{
    вывести `${применить(21, &удвоить)}\n`
    Вызываемый(Целое): Целое удвоение = &удвоить
    вывести `${удвоение(5)}\n`
    вывести `${применить(21, функция (x: Целое): Целое { вернуть x + 1 })}\n`

    // Замыкание захватывает переменные окружающей области видимости по
    // значению в момент создания - последующая мутация снаружи не видна
    // внутри, а мутация изнутри копится между вызовами ОДНОГО И ТОГО ЖЕ
    // значения лямбды.
    Целое счётчик        = 0
    Вызываемый увеличить = функция () {
        счётчик++
        вывести `${счётчик}\n`
    }
    увеличить()
    увеличить()
    вывести `${счётчик}\n`

    // Явный список захвата "[x, &y]" - заменяет неявный захват целиком:
    // видно только перечисленное (плюс параметры). Голое имя - копия
    // (как и без списка), "&имя" - по ссылке: запись видна снаружи сразу
    // после вызова, без ручного "Указатель<T>".
    Целое база          = 100
    Целое итог          = 0
    Вызываемый накопить = функция (x: Целое): Пусто [база, &итог] {
        итог = итог + x + база
    }
    накопить(1)
    накопить(2)
    вывести `${итог   // (1 + 100) + (2 + 100) = 203}\n`
}
