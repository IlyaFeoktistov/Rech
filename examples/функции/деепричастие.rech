// Деепричастный вызов (шаг 6.5): "<деепричастие>(<арг>, ...)" открывает
// блок инструкций с бОльшим отступом (без фигурных скобок), внутри
// которого доступна переменная "результат" со значением вызова. Функция
// обязана объявлять тип результата - иначе "результат" не от чего
// образовать.
//
// Деепричастная форма определяется в двух источниках: (1) автоматически,
// через морфологический словарь (gomorphy) - для "сложить" это "сложив" без
// единой пометки в исходнике, как ниже; (2) явным тегом
// `деепричастие:слово`, если автоматическое определение не сработало или
// дало не то слово, что нужно - см. "необычно_названная_функция" ниже.

/** Складывает два целых числа. */
функция сложить(а: Целое, б: Целое): Целое
{
    вернуть а + б
}

/** Умножает два целых числа. */
функция умножить(а: Целое, б: Целое): Целое
{
    вернуть а * б
}

/** Имя не подсказывает деепричастную форму само по себе - задана явно. */
функция необычно_названная_функция(а: Целое): Целое `деепричастие:почудив`
{
    вернуть а * 1000
}

/** Демонстрирует деепричастный вызов: автоматическую форму, явный тег и
    вложенность (внутренний вызов временно затеняет внешний "результат"). */
функция главная
{
    сложив(2, 3)
        вывести результат
        вывести результат * 2

    почудив(7)
        вывести результат

    сложив(10, 20)
        вывести результат
        умножив(результат, 2)
            вывести результат
        // здесь снова видно внешний "результат" - вложенный блок уже
        // завершился, затенение действовало только внутри него
        вывести результат
}
