/** Приветствует кого-то в каком-то месте. */
функция поприветствовать(кого: Строка, где: Строка)
{
    вывести "Привет, " + кого + "! Добро пожаловать в " + где
}

/** Складывает два числа. */
функция сложить(что: Целое, кем: Целое): Целое
{
    вернуть что + кем
}

/** Демонстрирует строгий синтаксис вызова (скобки, аргументы по позиции). */
функция главная
{
    переменная пользователь = "Илья"
    переменная система      = "чат"

    // Строгий синтаксис: скобки, аргументы по позиции - как в большинстве
    // языков программирования. Сравните с
    // examples/функции/естественный_вызов.rech - там та же функция
    // "поприветствовать" вызывается без скобок, падежным сопоставлением.
    поприветствовать(пользователь, система)

    // Строгий вызов работает и там, где нужен сам результат как значение -
    // естественный синтаксис пока умеет только самостоятельную инструкцию
    // (см. комментарий в естественный_вызов.rech).
    вывести сложить(2, 3)
}
