// Перегрузка функций (по эталону C#): несколько функций верхнего уровня с
// одним и тем же именем, но разными списками типов параметров (в т. ч.
// разным их количеством) - какую из них вызвать, решает семантический
// анализ по естественным типам переданных аргументов, ДО генерации кода
// (см. internal/semantic/overload.go). Числового приведения в языке нет
// вообще (Целое НЕ приводится к Действительное) - выбор идёт только по
// точному совпадению типа или отношению подтип/интерфейс, без C#-подобной
// лестницы промоций.
//
// v1: только функции верхнего уровня и простые (не абстрактные, не
// статические) методы сущностей, без переопределения перегруженного метода
// в наследнике. "&имя" (взятие адреса функции) не поддерживает
// перегруженное имя - неясно, какую из перегрузок взять без вызова.

/** Сложение двух целых чисел. */
функция сложить(а: Целое, б: Целое): Целое
{
    вернуть а + б
}

/** Перегрузка по ТИПУ параметров - конкатенация строк тем же именем. */
функция сложить(а: Строка, б: Строка): Строка
{
    вернуть а + б
}

/** Перегрузка по КОЛИЧЕСТВУ параметров - три слагаемых. */
функция сложить(а: Целое, б: Целое, ц: Целое): Целое
{
    вернуть а + б + ц
}

/**
 * Методы сущности перегружаются тем же способом - только простые (не
 * абстрактные, не статические), без переопределения перегруженного метода
 * в наследнике.
 */
сущность Калькулятор
{
    сложить(а: Целое, б: Целое): Целое
    {
        вернуть а + б
    }

    сложить(а: Строка, б: Строка): Строка
    {
        вернуть а + б
    }
}

функция главная
{
    вывести сложить(2, 3)              // 5 - сложить(Целое, Целое)
    вывести сложить("привет, ", "мир") // "привет, мир" - сложить(Строка, Строка)
    вывести сложить(1, 2, 3)           // 6 - сложить(Целое, Целое, Целое)

    переменная калькулятор = новый Калькулятор()
    вывести калькулятор.сложить(10, 20)         // 30
    вывести калькулятор.сложить("а", "б")       // "аб"
}
