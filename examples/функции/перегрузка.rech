// Перегрузка функций (по эталону C#): несколько функций верхнего уровня с
// одним и тем же именем, но разными списками типов параметров (в т. ч.
// разным их количеством) - какую из них вызвать, решает семантический
// анализ по естественным типам переданных аргументов, ДО генерации кода
// (см. internal/semantic/overload.go). Числового приведения в языке нет
// вообще (Целое НЕ приводится к Действительное) - выбор идёт только по
// точному совпадению типа или отношению подтип/интерфейс, без C#-подобной
// лестницы промоций.
//
// Перегружаются функции верхнего уровня и простые (не абстрактные, не
// статические) методы сущностей - в т. ч. поверх унаследованного метода:
// варианты потомка объединяются с вариантами базовой сущности.

/** Сложение двух целых чисел. */
функция сложить(а: Целое, б: Целое): Целое
{
    вернуть а + б
}

/** Перегрузка по ТИПУ параметров - конкатенация строк тем же именем. */
функция сложить(а: Строка, б: Строка): Строка
{
    вернуть а + б
}

/** Перегрузка по КОЛИЧЕСТВУ параметров - три слагаемых. */
функция сложить(а: Целое, б: Целое, ц: Целое): Целое
{
    вернуть а + б + ц
}

/**
 * Методы сущности перегружаются тем же способом - только простые (не
 * абстрактные, не статические).
 */
сущность Калькулятор
{
    сложить(а: Целое, б: Целое): Целое
    {
        вернуть а + б
    }

    сложить(а: Строка, б: Строка): Строка
    {
        вернуть а + б
    }
}

/**
 * Перегрузка поверх унаследованного метода: варианты потомка объединяются
 * с вариантами базовой сущности. Тот же список параметров -
 * переопределение (вызов через базовый тип попадает в потомка), другой -
 * ещё одна перегрузка.
 */
сущность НаучныйКалькулятор наследует Калькулятор
{
    публичный сложить(а: Целое, б: Целое): Целое
    {
        вернуть (а + б) * 10
    }

    публичный сложить(а: Действительное, б: Действительное): Действительное
    {
        вернуть а + б
    }
}

функция главная
{
    вывести `${сложить(2, 3)}\n`               // 5 - сложить(Целое, Целое)
    вывести `${сложить("привет, ", "мир")}\n`  // "привет, мир" - сложить(Строка, Строка)
    вывести `${сложить(1, 2, 3)}\n`            // 6 - сложить(Целое, Целое, Целое)

    переменная калькулятор = новый Калькулятор()
    вывести `${калькулятор.сложить(10, 20)}\n`    // 30
    вывести `${калькулятор.сложить("а", "б")}\n`  // "аб"

    переменная научный = новый НаучныйКалькулятор()
    вывести `${научный.сложить(1, 2)}\n`      // 30 - переопределён в потомке
    вывести `${научный.сложить(0.5, 0.25)}\n`  // 0.75 - новая перегрузка потомка
    вывести `${научный.сложить("в", "г")}\n`   // "вг" - унаследована как есть

    Калькулятор через_базу = научный
    вывести `${через_базу.сложить(1, 2)}\n`  // 30 - через базовый тип тоже потомок

    // "&имя" перегруженной функции выбирает перегрузку по ожидаемому типу
    // "Вызываемый(...)" - переменной, параметра, поля или результата.
    Вызываемый(Строка, Строка): Строка склеить = &сложить
    вывести `${склеить("в", "г")}\n`  // "вг" - сложить(Строка, Строка)
}
