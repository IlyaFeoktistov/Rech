/** Приветствует кого-то в каком-то месте. */
функция поприветствовать(кого: Строка, где: Строка)
{
    вывести "Привет, " + кого + "! Добро пожаловать в " + где + `\n`
}

/** Складывает два числа. */
функция сложить(что: Целое, кем: Целое): Целое
{
    вернуть что + кем
}

/** Демонстрирует естественный синтаксис вызова (падежное сопоставление аргументов). */
функция главная
{
    переменная пользователь = "Илья"
    переменная система      = "чат"

    // Естественный синтаксис: без скобок - падеж словоформы аргумента
    // определяет параметр, а не порядок слов или позиция в предложении.
    // Сравните со строгой формой в examples/функции/строгий_вызов.rech -
    // это тот же самый вызов "поприветствовать".
    //
    // "пользователя" - винительный, одушевлённый -> связывается с "кого";
    // "в системе" - предложный -> связывается с "где" (предлог "в" -
    // декоративный, падеж работает и без него - переставьте слова местами,
    // смысл не изменится).
    поприветствовать пользователя в системе

    переменная число      = 2
    переменная показатель = 3

    // Результат естественного вызова можно использовать как значение -
    // тремя способами (docs/SPEC.md, "Вызов функции (естественный
    // синтаксис)"). Число слов фразы известно заранее (по параметрам
    // "сложить"), поэтому граница фразы не гадается по следующему токену.

    // 1. Как обычное выражение - справа от "=", аргументом "вывести" и т. п.
    переменная сумма = сложить число с показателем
    вывести `${сумма}\n`

    // 2. "и вывести" - печатает результат сразу же, без промежуточной
    // переменной.
    сложить число с показателем и вывести
    вывести `\n`

    // 3. "и положить в <переменная>" - сохраняет результат в переменную,
    // объявленную здесь же без значения ("отложенное объявление" - тип
    // выводится из результата вызова).
    переменная итог
    сложить число с показателем и положить в итог
    вывести `${итог}\n`
}
