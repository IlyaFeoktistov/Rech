// Значение по умолчанию у трейлингового параметра ("=" выражение после
// типа) - функция, метод и явный конструктор можно вызвать без указания
// такого параметра, тогда подставляется вычисленное значение по умолчанию.
// Как и у значений по умолчанию полей сущности - только ХВОСТ списка
// параметров (параметр без значения по умолчанию после параметра со
// значением - ошибка компиляции).

сущность Счётчик
{
    имеет:
        значение: Целое

    // Второй параметр конструктора необязателен.
    конструктор(начало: Целое, шаг: Целое = 1)
    {
        этот.значение = начало + шаг
    }
}

/** Складывает два числа, второе по умолчанию - 10. */
функция сложить(а: Целое, б: Целое = 10): Целое
{
    вернуть а + б
}

/** "?Тип = Ничто" - значение по умолчанию у nullable-параметра. */
функция поприветствовать(имя: Строка, обращение: ?Строка = Ничто): Строка
{
    если обращение != Ничто {
        вернуть обращение + ", " + имя
    }
    вернуть "Привет, " + имя
}

/** Демонстрирует значения по умолчанию у функции, метода и конструктора. */
функция главная
{
    вывести сложить(5)      // 5 + 10 (по умолчанию)
    вывести сложить(5, 1)   // 5 + 1 (передано явно)

    переменная счётчик = новый Счётчик(0)      // шаг по умолчанию - 1
    вывести счётчик.значение
    переменная счётчик2 = новый Счётчик(0, 5)  // шаг передан явно
    вывести счётчик2.значение

    вывести поприветствовать("Аня")
    вывести поприветствовать("Аня", "Уважаемая")
}
