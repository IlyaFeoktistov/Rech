/**
 * Полный набор падежных ролей параметра (docs/SPEC.md, "Параметры и тип
 * результата"): базовые кто/кого/кому/кем/где/что (см. также
 * examples/функции/естественный_вызов.rech) и их неодушевлённые пары
 * чему/чем, плюс роли с обязательным (не декоративным) предлогом - с кем/с
 * чем, для кого/для чего, куда, откуда.
 *
 * чем - творительный, неодушевлённый (пара к "кем").
 */
функция сложить(что слагаемое: Целое, чем остаток: Целое): Целое
{
    вернуть слагаемое + остаток
}

/** чему - дательный, неодушевлённый (пара к "кому"). */
функция равняться(чему показатель: Целое): Логическое
{
    вернуть показатель == 5
}

/** с чем/с_чем - творительный, обязательное "с" перед аргументом. */
функция умножить(что число: Целое, с_чем множитель: Целое): Целое
{
    вернуть число * множитель
}

/** для чего/для_чего - родительный, обязательное "для". */
функция удвоить_для_чего(для_чего работа: Целое): Целое
{
    вернуть работа * 2
}

/** куда/откуда - винительный/родительный, обязательные "в"/"от" или "из". */
функция переместить(куда место: Целое, откуда старт: Целое): Целое
{
    вернуть место - старт
}

функция главная
{
    переменная слагаемое = 2
    переменная остаток   = 3
    переменная сумма     = сложить слагаемое остатком
    вывести `${сумма}\n`

    переменная показатель = 5
    переменная равно      = равняться показателю
    вывести `${равно}\n`

    переменная число        = 4
    переменная множитель    = 6
    переменная произведение = умножить число с множителем
    вывести `${произведение}\n`

    переменная работа    = 7
    переменная удвоенная = удвоить_для_чего для работы
    вывести `${удвоенная}\n`

    переменная место   = 10
    переменная старт   = 3
    переменная разница = переместить в место от старта
    вывести `${разница}\n`
}
