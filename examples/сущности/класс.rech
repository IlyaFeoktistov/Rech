// "класс" - точный синоним "сущность": та же самая конструкция, выбор
// слова - вопрос стиля, компилятор их не различает.
/** Точка на плоскости - демонстрирует "класс" как синоним "сущность". */
класс Точка
{
    имеет:
        x: Целое
        y: Целое

    конструктор(x: Целое, y: Целое)
    {
        этот.x = x
        этот.y = y
    }

    /** Сдвигает точку на (dx, dy). */
    сместить(dx: Целое, dy: Целое)
    {
        этот.x = этот.x + dx
        этот.y = этот.y + dy
    }
}

/** Демонстрирует, что "класс" - точный синоним "сущность". */
функция главная
{
    переменная точка = новая Точка(1, 2)
    вывести точка.x
    вывести точка.y

    точка.сместить(3, 4)
    вывести точка.x
    вывести точка.y
}
