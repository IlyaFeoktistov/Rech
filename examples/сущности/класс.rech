// "класс" - точный синоним "сущность": та же самая конструкция, выбор
// слова - вопрос стиля, компилятор их не различает.
класс Точка
{
    имеет:
        x: Целое
        y: Целое

    сместить(dx: Целое, dy: Целое)
    {
        этот.x = этот.x + dx
        этот.y = этот.y + dy
    }
}

функция главная
{
    переменная точка = новая Точка(1, 2)
    вывести точка.x
    вывести точка.y

    точка.сместить(3, 4)
    вывести точка.x
    вывести точка.y
}
