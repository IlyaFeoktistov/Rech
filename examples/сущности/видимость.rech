сущность Пользователь
{
    имеет:
        приватный пароль: Строка
        имя: Строка // без модификатора - публичное поле (видимость по умолчанию)

    // Приватный метод - вспомогательная проверка, не должна вызываться
    // снаружи сущности.
    приватный проверить_пароль(попытка: Строка): Логическое
    {
        вернуть этот.пароль == попытка
    }

    // Публичный метод - можно и без модификатора, "публичный" здесь просто
    // для наглядности (по умолчанию видимость и так публичная).
    публичный войти(попытка: Строка): Логическое
    {
        вернуть этот.проверить_пароль(попытка)
    }
}

функция главная
{
    переменная пользователь = новый Пользователь(пароль: "секрет", имя: "Аня")

    вывести пользователь.имя
    вывести пользователь.войти("секрет")
    вывести пользователь.войти("неверно")

    // Ошибка компиляции, если раскомментировать - "пароль" и
    // "проверить_пароль" видны только изнутри методов сущности "Пользователь":
    // вывести пользователь.пароль
    // пользователь.проверить_пароль("секрет")
}
