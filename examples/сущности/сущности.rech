/** Базовая демонстрация полей, методов, "этот" и константы сущности. */
сущность Пользователь
{
    /** Верхняя граница разумного возраста. */
    константа МАКСИМАЛЬНЫЙ_ВОЗРАСТ = 150

    имеет:
        имя: Строка
        возраст: Целое

    /** Увеличивает возраст на один год. */
    состариться()
    {
        этот.возраст = этот.возраст + 1
    }

    /** Возвращает имя пользователя. */
    представиться(): Строка
    {
        вернуть этот.имя
    }
}

/** Демонстрирует поля, методы, "этот" и константу сущности. */
функция главная
{
    переменная пользователь = новый Пользователь("Илья", 30)
    вывести пользователь.имя
    вывести пользователь.возраст

    пользователь.возраст = 31
    вывести пользователь.возраст

    вывести пользователь.представиться()
    пользователь.состариться()
    вывести пользователь.возраст

    вывести пользователь.МАКСИМАЛЬНЫЙ_ВОЗРАСТ
}
