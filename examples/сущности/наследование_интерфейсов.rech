/**
 * Интерфейс может наследовать один или несколько других интерфейсов
 * ("наследует А, Б") - методы каждого становятся частью его собственного
 * контракта тоже, поэтому сущность, реализующая производный интерфейс,
 * обязана реализовать и унаследованные методы, и удовлетворяет всем
 * интерфейсам в цепочке сразу (не только самому производному).
 */
интерфейс Именуемый
{
    имя(): Строка
}

/**
 * Наследует "Именуемый" - контракт "Звучащий" включает оба метода:
 * свой "издать_звук" и унаследованный "имя".
 */
интерфейс Звучащий наследует Именуемый
{
    издать_звук(): Строка
}

/**
 * Кошка реализует только "Звучащий" - но этого достаточно, чтобы
 * удовлетворять и "Именуемый": она обязана реализовать оба метода.
 */
сущность Кошка реализует Звучащий
{
    имеет:
        кличка: Строка

    конструктор(кличка: Строка)
    {
        этот.кличка = кличка
    }

    имя(): Строка
    {
        вернуть этот.кличка
    }

    издать_звук(): Строка
    {
        вернуть "мяу"
    }
}

/**
 * Принимает любую сущность, удовлетворяющую "Именуемый" - "Звучащий"
 * подходит, потому что наследует "Именуемый".
 */
функция представить(х: Именуемый): Строка
{
    вернуть х.имя()
}

/** Принимает любую сущность, реализующую именно "Звучащий". */
функция озвучить(х: Звучащий): Строка
{
    вернуть х.издать_звук()
}

/**
 * Демонстрирует наследование интерфейсов: одна реализация удовлетворяет
 * всей цепочке.
 */
функция главная
{
    переменная кошка = новая Кошка("Мурка")

    вывести озвучить(кошка)
    вывести представить(кошка)
}
