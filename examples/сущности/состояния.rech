/** Пользователь с состояниями "неавторизован"/"авторизован". */
сущность Пользователь
{
    состояние: неавторизован авторизован

    имеет:
        имя: Строка

    /** Переводит пользователя в состояние "авторизован". */
    авторизовать()
    {
        этот становится авторизован
    }
}

// Производный тип состояния ("авторизован" + муж. род "Пользователь" ->
// "АвторизованныйПользователь") можно использовать как тип параметра -
// шаг 4.1, упрощённая версия: проверка того, что объект действительно
// прошёл переход "становится авторизован" перед вызовом, ещё не
// гарантируется статически (это шаг 5, явный слой IR) - здесь готовы
// только синтаксис и представление в AST.
/** Принимает только пользователя, доказанно прошедшего "авторизовать()". */
функция показать_профиль(пользователь: АвторизованныйПользователь)
{
    вывести "Профиль: " + пользователь.имя
}

/** Демонстрирует typestate: производный тип состояния как тип параметра. */
функция главная
{
    переменная пользователь = новый Пользователь("Илья")
    пользователь.авторизовать()
    показать_профиль(пользователь)
}
