/** Пользователь с состояниями "неавторизован"/"авторизован". */
сущность Пользователь
{
    состояние: неавторизован авторизован

    имеет:
        имя: Строка

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }

    /** Переводит пользователя в состояние "авторизован". */
    авторизовать()
    {
        этот становится авторизованным
    }
}

// Производный тип состояния ("авторизован" + муж. род "Пользователь" ->
// "АвторизованныйПользователь") можно использовать как тип параметра.
// "становится" требует полную форму, согласованную по роду сущности И
// творительным падежом - "авторизованным" здесь, а не краткое "авторизован".
/** Принимает только пользователя, доказанно прошедшего "авторизовать()". */
функция показать_профиль(пользователь: АвторизованныйПользователь)
{
    вывести "Профиль: " + пользователь.имя
}

// Компилятор доказывает переход по ходу анализа тела функции/метода
// (established) - только в его пределах: он не знает, что делает ЧУЖАЯ
// функция с переданной ей сущностью. "авторизовать_пользователя" ниже
// реально вызывает "авторизовать()" внутри своего тела, но снаружи это не
// видно - established для параметра "показать_профиль" здесь недоказан, но
// это не ошибка компиляции: вместо неё вставляется рантайм-проверка
// (бросает перехватываемое "Исключение", если объект и правда не прошёл
// переход - см. docs/SPEC.md, "Состояния").
/** Функция с непрозрачным для вызывающей стороны эффектом ("этот" не виден снаружи её тела). */
функция авторизовать_пользователя(пользователь: Пользователь)
{
    пользователь.авторизовать()
}

/** Демонстрирует typestate: доказанный переход (без рантайм-проверки) и недоказанный (с ней). */
функция главная
{
    // established доказывает переход в пределах этого же тела - без
    // рантайм-проверки.
    переменная илья = новый Пользователь("Илья")
    илья.авторизовать()
    показать_профиль(илья)

    // established не может проследить эффект чужой функции - рантайм-
    // проверка вставляется, но объект РЕАЛЬНО авторизован - проверка
    // проходит незаметно.
    переменная аня = новый Пользователь("Аня")
    авторизовать_пользователя(аня)
    показать_профиль(аня)

    // объект НЕ авторизован - рантайм-проверка бросает исключение вместо
    // падения сборки заведомо корректной программы.
    переменная оля = новый Пользователь("Оля")
    попытаться
    {
        показать_профиль(оля)
    }
    поймать (иск: Исключение)
    {
        вывести иск.сообщение
    }

    // "относится к" с производным типом состояния - вопрос "объект СЕЙЧАС
    // в этом состоянии?" (текущий статус, времени исполнения), не проверка
    // типа - в отличие от рантайм-проверки выше, никогда не бросает.
    если оля относится к АвторизованныйПользователь
    {
        вывести "Оля авторизована"
    }
    иначе
    {
        вывести "Оля не авторизована"
    }
}
