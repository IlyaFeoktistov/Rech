// Вложенная сущность как поле - тип поля может быть именем другой
// сущности, а не только "Строка"/"Целое"/"Действительное"/"Логическое". Единственное
// ограничение: сущность-тип поля должна быть объявлена в файле раньше
// сущности, которая её использует (в отличие от функций - сущности не
// разрешают взаимные ссылки друг на друга).
/** Почтовый адрес - хранит только город. */
сущность Адрес
{
    имеет:
        город: Строка

    конструктор(город: Строка)
    {
        этот.город = город
    }
}

/** Пользователь с вложенным полем-сущностью "адрес". */
сущность Пользователь
{
    имеет:
        имя: Строка
        адрес: Адрес

    конструктор(имя: Строка, адрес: Адрес)
    {
        этот.имя = имя
        этот.адрес = адрес
    }
}

// Тип результата функции тоже может быть сущностью, а не только
// "Строка"/"Целое"/"Действительное"/"Логическое".
/** Создаёт "Адрес" с указанным городом. */
функция создать_адрес(город: Строка): Адрес
{
    вернуть новый Адрес(город)
}

/** Демонстрирует вложенное поле-сущность: чтение и переприсваивание целиком. */
функция главная
{
    переменная пользователь = новый Пользователь("Илья", новый Адрес("Москва"))

    // Чтение вложенного поля - обычная цепочка "." без ограничений.
    вывести пользователь.имя
    вывести пользователь.адрес.город

    // Присваивание полю ограничено ОДНИМ уровнем "." - "receiver.поле = ...",
    // где receiver - переменная или "этот", не сам доступ к полю. Поэтому
    // "пользователь.адрес.город = ..." - ошибка компиляции; чтобы заменить
    // город, нужно целиком переприсвоить вложенную сущность "адрес".
    пользователь.адрес = новый Адрес("Санкт-Петербург")
    вывести пользователь.адрес.город

    переменная новый_адрес = создать_адрес("Казань")
    вывести новый_адрес.город
}
