/** Пользователь с обратимым переходом состояния через "противоположность". */
сущность Пользователь
{
    состояние: вошедший

    имеет:
        имя: Строка

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }

    /** Переводит пользователя в состояние "вошедший". */
    войти(): Пользователь
    {
        этот становится вошедшим
        вернуть этот
    }

    /** Снимает состояние "вошедший" - тег объявляет "выйти" обратным
        переходом для "войти": вызов "выйти()" отменяет ровно те состояния,
        которые устанавливает "войти" (здесь - "вошедший"), даже без
        собственного "становится" в теле. */
    выйти() `противоположность:войти`
    {
    }

    /** Принимает только доказанно вошедшего пользователя. */
    представиться(п: ВошедшийПользователь): Строка
    {
        вернуть п.имя
    }
}

/** Демонстрирует обратимый typestate: после "войти()" производный тип
    состояния доступен, после "выйти()" - нет (доказательство снято). */
функция главная
{
    переменная пользователь = новый Пользователь("Аня")
    пользователь = пользователь.войти()
    вывести пользователь.представиться(пользователь)
    пользователь.выйти()
    // Здесь пользователь.представиться(пользователь) была бы ошибкой
    // компиляции - "выйти" сняло доказанное состояние "вошедший".
}
