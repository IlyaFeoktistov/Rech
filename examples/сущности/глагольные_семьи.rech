/** Пользователь с обратимым переходом состояния через "противоположность". */
сущность Пользователь
{
    состояние: вошедший

    имеет:
        имя: Строка

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }

    /** Переводит пользователя в состояние "вошедший". */
    войти(): Пользователь
    {
        этот становится вошедшим
        вернуть этот
    }

    /** Снимает состояние "вошедший" - тег объявляет "выйти" обратным
        переходом для "войти": вызов "выйти()" отменяет ровно те состояния,
        которые устанавливает "войти" (здесь - "вошедший"), даже без
        собственного "становится" в теле. */
    выйти() `противоположность:войти`
    {
    }

    /** Принимает только доказанно вошедшего пользователя. */
    представиться(п: ВошедшийПользователь): Строка
    {
        вернуть п.имя
    }
}

// Established теряется и при передаче сущности ЧУЖОЙ, непрозрачной для
// анализа функции - established не видит, что делает "выйти()" внутри её
// тела, поэтому доказательство "вошедший" считается снятым СРАЗУ после
// такого вызова (консервативно, а не только когда чужая функция реально
// его сняла).
функция обернуть_выход(п: Пользователь)
{
    п.выйти()
}

/** Демонстрирует обратимый typestate: после "войти()" производный тип
    состояния доступен, после "выйти()" - нет (established больше не
    доказывает переход, но и рантайм-хранилище состояния реально снято -
    "выйти" не эмитит "становится" в своём теле, но всё равно чистит бит). */
функция главная
{
    переменная пользователь = новый Пользователь("Аня")
    пользователь = пользователь.войти()
    вывести пользователь.представиться(пользователь)
    пользователь.выйти()

    // established больше не доказывает "вошедший" - здесь вставляется
    // рантайм-проверка вместо ошибки компиляции; "выйти()" выше реально
    // снял бит, поэтому проверка не проходит и бросает исключение.
    попытаться
    {
        вывести пользователь.представиться(пользователь)
    }
    поймать (иск: Исключение)
    {
        вывести иск.сообщение
    }

    // "относится к" подтверждает: бит рантайм-хранилища действительно
    // снят, а не только доказательство на этапе компиляции.
    если пользователь относится к ВошедшийПользователь
    {
        вывести "БАГ: всё ещё вошедший"
    }
    иначе
    {
        вывести "больше не вошедший"
    }

    // тот же сценарий через непрозрачную обёртку: established для "борис"
    // сбрасывается уже самим фактом передачи в "обернуть_выход" - established
    // не видит, что она реально вызывает "выйти()" внутри, поэтому здесь
    // тоже вставляется рантайм-проверка (а не тихо неверное "доказано").
    переменная борис = новый Пользователь("Борис")
    борис = борис.войти()
    обернуть_выход(борис)
    попытаться
    {
        вывести борис.представиться(борис)
    }
    поймать (иск: Исключение)
    {
        вывести иск.сообщение
    }
}
