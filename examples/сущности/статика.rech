/**
 * Статические члены ("статическое поле"/"статический метод") -
 * принадлежат самой сущности, не экземпляру: одно общее хранилище на всю
 * программу, доступ только через "Тип::имя" (никогда через
 * получатель-экземпляр). Константа тоже доступна через "::" наравне с
 * уже привычным ".". Не наследуются - "Тип::имя" валиден только для
 * точного имени объявившей их сущности.
 */
сущность Человек
{
    имеет:
        статическое Целое счёт_созданных = 0
        Строка            имя

    константа МАКСИМАЛЬНЫЙ_ВОЗРАСТ = 150

    конструктор(имя: Строка)
    {
        этот.имя = имя
        Человек::счёт_созданных = Человек::счёт_созданных + 1
    }

    статический количество(): Целое
    {
        вернуть Человек::счёт_созданных
    }
}

/**
 * Считает вызовы, не создавая новый счётчик при каждом обращении -
 * "статическая переменная" инициализируется РОВНО один раз.
 */
функция следующий_номер(): Целое
{
    статическая переменная счётчик = 0
    счётчик = счётчик + 1
    вернуть счётчик
}

функция главная
{
    вывести `${Человек::МАКСИМАЛЬНЫЙ_ВОЗРАСТ}\n`

    переменная илья = новый Человек("Илья")
    переменная анна = новый Человек("Анна")
    вывести `${Человек::количество()}\n`
    вывести `${Человек::счёт_созданных}\n`

    вывести `${следующий_номер()}\n`
    вывести `${следующий_номер()}\n`
    вывести `${следующий_номер()}\n`
}
