/**
 * Демонстрирует естественный (падежный) вызов МЕТОДА сущности - без точки
 * и без скобок, тем же принципом, что и уже работающий естественный вызов
 * свободной функции (examples/функции/естественный_вызов.rech), но слева от
 * имени метода стоит получатель ("этот" или переменная известного
 * сущностного типа - см. docs/SPEC.md, "Методы и `этот`"). Строгий вызов
 * ("receiver.метод(...)") остаётся рабочим как
 * есть - оба синтаксиса всегда доступны одновременно, выбор за автором
 * кода.
 */
сущность Пользователь
{
    имеет:
        Строка пароль
        Целое  попыток

    конструктор(пароль: Строка)
    {
        этот.пароль = пароль
        этот.попыток = 0
    }

    публичный авторизовать(кем пароль: Строка): Логическое
    {
        этот.попыток = этот.попыток + 1
        вернуть этот.пароль == пароль
    }

    /**
     * Естественный вызов метода работает и на "этот" внутри тела другого
     * метода того же типа - получатель не обязан быть переменной снаружи.
     */
    публичный проверить_с_другим_паролем(): Логическое
    {
        переменная подделка = "неверный_пароль"
        вернуть этот авторизовать подделкой
    }
}

функция главная
{
    переменная   пароль       = "секрет"
    Пользователь пользователь = новый Пользователь(пароль)

    // Естественный вызов метода - "получатель метод [падежные аргументы]",
    // без точки и без скобок; "паролем" - творительный падеж переменной
    // "пароль", связывается с параметром "кем пароль" по падежу.
    пользователь авторизовать паролем и вывести
    вывести `\n`

    // Строгий вызов того же метода - синоним, доступен всегда.
    вывести `${пользователь.авторизовать(пароль)}\n`

    вывести `${пользователь.попыток}\n`

    // "этот"-вызов внутри другого метода (см. Пользователь.проверить_с_другим_паролем).
    вывести `${пользователь.проверить_с_другим_паролем()}\n`
    вывести `${пользователь.попыток}\n`
}
