// Перегрузка бинарного оператора для сущности/структуры - "статический
// публичный оператор <символ>(a: Тип, b: Тип): ТипРезультата" - тот же
// статический метод (см. examples/сущности/статика.rech), только имя -
// один из "+ - * / % == != < > <= >=" вместо обычного идентификатора.
// "a + b" резолвится в "Вектор::оператор+(a, b)" уже на этапе
// семантического анализа (internal/semantic/operator.go) - оба backend'а
// видят обычный вызов статического метода, ничего не знают про операторы.
//
// Обязателен "статический" (у оператора нет получателя - оба операнда
// приходят параметрами), ровно 2 параметра и явный тип результата.
// Перегрузка резолвится только по типу ЛЕВОГО операнда - "число + Вектор"
// не сработает, только "Вектор + число" (если такая перегрузка объявлена).

структура Вектор
{
    имеет:
        x: Действительное
        y: Действительное

    статический публичный оператор +(a: Вектор, b: Вектор): Вектор
    {
        вернуть новый Вектор(a.x + b.x, a.y + b.y)
    }

    статический публичный оператор -(a: Вектор, b: Вектор): Вектор
    {
        вернуть новый Вектор(a.x - b.x, a.y - b.y)
    }

    статический публичный оператор *(a: Вектор, коэффициент: Действительное): Вектор
    {
        вернуть новый Вектор(a.x * коэффициент, a.y * коэффициент)
    }

    // Перекрывает встроенное "== для структур" (сравнение поле-в-поле) -
    // здесь оно совпадает по смыслу, но объявлено явно, чтобы показать, что
    // перегруженный оператор главнее умолчания.
    статический публичный оператор ==(a: Вектор, b: Вектор): Логическое
    {
        вернуть a.x == b.x и a.y == b.y
    }
}

функция главная
{
    переменная a = новый Вектор(1.0, 2.0)
    переменная b = новый Вектор(3.0, 4.0)

    переменная сумма = a + b
    вывести "сумма: (" + (Строка) сумма.x + ", " + (Строка) сумма.y + ")"

    переменная разность = a - b
    вывести "разность: (" + (Строка) разность.x + ", " + (Строка) разность.y + ")"

    переменная растянутый = a * 2.0
    вывести "растянутый: (" + (Строка) растянутый.x + ", " + (Строка) растянутый.y + ")"

    если a == a {
        вывести "a равен a"
    }
    если не (a == b) {
        вывести "a не равен b"
    }
}
