/** Фигура - абстрактная: у неё есть общее поле и один метод без реализации. */
абстрактная сущность Фигура
{
    имеет:
        имя: Строка

    /** Площадь у каждой конкретной фигуры своя - реализации здесь нет. */
    площадь(): Действительное

    /**
     * Общий для всех фигур метод - вызывает абстрактный "площадь"
     * полиморфно, через vtable, независимо от того, какая именно фигура
     * стоит за "этот" в момент вызова.
     */
    описать(): Строка
    {
        вернуть этот.имя + ": площадь " + (Строка) этот.площадь()
    }
}

/**
 * Круг переопределяет "площадь" - обязательное условие, иначе сущность
 * сама осталась бы абстрактной.
 */
сущность Круг наследует Фигуру
{
    имеет:
        радиус: Действительное

    конструктор(имя: Строка, радиус: Действительное)
    {
        этот.имя = имя
        этот.радиус = радиус
    }

    площадь(): Действительное
    {
        вернуть 3.14159 * этот.радиус * этот.радиус
    }
}

/** Прямоугольник - вторая конкретная реализация того же контракта. */
сущность Прямоугольник наследует Фигуру
{
    имеет:
        ширина: Действительное
        высота: Действительное

    конструктор(имя: Строка, ширина: Действительное, высота: Действительное)
    {
        этот.имя = имя
        этот.ширина = ширина
        этот.высота = высота
    }

    площадь(): Действительное
    {
        вернуть этот.ширина * этот.высота
    }
}

/**
 * Демонстрирует абстрактную сущность: общее поведение в базовом методе,
 * полиморфный вызов недостающей реализации через наследников.
 */
функция главная
{
    переменная круг          = новый Круг(имя: "круг", радиус: 2.0)
    переменная прямоугольник = новый Прямоугольник(имя: "прямоугольник", ширина: 3.0, высота: 4.0)

    вывести `${круг.описать()}\n`
    вывести `${прямоугольник.описать()}\n`

    // Ошибка компиляции, если раскомментировать - "Фигура" абстрактная,
    // создать экземпляр напрямую нельзя, только унаследовать и реализовать
    // недостающий метод "площадь":
    // переменная х = новая Фигура(имя: "?")
}
