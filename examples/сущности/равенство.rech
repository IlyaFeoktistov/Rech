/**
 * "сущность"/"класс" - ссылочная семантика: "==" сравнивает IDENTITY (тот
 * же ли это объект), не содержимое полей.
 */
сущность Пользователь
{
    имеет:
        Строка имя

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }
}

/**
 * "структура" - семантика значения: "==" сравнивает поле за полем (в т. ч.
 * рекурсивно - вложенная "структура" полем сравнивается тем же способом),
 * не identity.
 */
структура Точка
{
    имеет:
        Целое x
        Целое y
}

/** Вложенная "структура" полем - "==" рекурсирует в неё же. */
структура Отрезок
{
    имеет:
        Точка начало
        Точка конец
}

функция сравнение_сущностей
{
    переменная а = новый Пользователь("Аня")
    переменная б = а
    переменная г = новый Пользователь("Аня")
    вывести `${а == б}\n`
    вывести `${а == г}\n`
    вывести `${а != г}\n`
}

функция сравнение_структур
{
    переменная а = новая Точка(1, 2)
    переменная б = новая Точка(1, 2)
    переменная г = новая Точка(9, 9)
    вывести `${а == б}\n`
    вывести `${а == г}\n`

    переменная отрезок1 = новый Отрезок(новая Точка(0, 0), новая Точка(1, 1))
    переменная отрезок2 = новый Отрезок(новая Точка(0, 0), новая Точка(1, 1))
    вывести `${отрезок1 == отрезок2}\n`
}

функция главная
{
    сравнение_сущностей()
    сравнение_структур()
}
