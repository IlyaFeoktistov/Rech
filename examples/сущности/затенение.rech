/**
 * "ДатаВремя" - имя встроенной сущности (docs/SPEC.md, раздел 6,
 * "Затенение встроенных сущностей"), но входит в курируемый список тех,
 * что можно объявить заново своей версией. Действует внутри ЭТОГО файла
 * (и любого файла, явно "использовать ДатаВремя из ..." именно на эту
 * сущность) - файл, который не объявил и не импортировал свою версию,
 * продолжает видеть настоящую встроенную "ДатаВремя" с полным набором
 * календарных полей (см. examples/основы/время.rech).
 *
 * Здесь версия для игрового счёта времени - только "тик" симуляции,
 * без месяца/дня/часа - "время_как_дата"/"день_недели"/"дату_в_строку" и
 * прочие builtin-функции семейства "ДатаВремя" на эту версию не
 * рассчитаны (ожидают оригинальный набор полей) и здесь не вызываются.
 */
сущность ДатаВремя
{
    имеет:
        Целое тик

    конструктор(тик: Целое)
    {
        этот.тик = тик
    }

    публичный следующий(): ДатаВремя
    {
        вернуть новая ДатаВремя(этот.тик + 1)
    }
}

функция главная
{
    переменная момент    = новая ДатаВремя(0)
    переменная следующий = момент.следующий()

    вывести `${момент.тик}\n`
    вывести `${следующий.тик}\n`
}
