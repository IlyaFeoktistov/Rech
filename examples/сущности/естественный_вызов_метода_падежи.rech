/**
 * Показывает несколько падежных аргументов на одном естественном вызове
 * метода и то, что порядок слов не важен - падеж словоформы сам определяет,
 * какому параметру она достанется (тот же принцип, что и у естественного
 * вызова свободной функции, examples/функции/естественный_вызов.rech).
 */
сущность Банк
{
    имеет:
        Целое баланс

    конструктор()
    {
        этот.баланс = 0
    }

    публичный начислить(кому клиент: Строка, что сумма: Целое): Целое
    {
        этот.баланс = этот.баланс + сумма
        вернуть этот.баланс
    }
}

функция главная
{
    переменная банк: Банк = новый Банк()
    переменная клиент     = "Мария"
    переменная сумма      = 500

    // "сумму" (винительный) и "клиенту" (дательный) - порядок обратный
    // объявлению параметров ("кому клиент, что сумма"), падеж всё равно
    // связывает словоформу с нужным параметром.
    банк начислить сумму клиенту и вывести
    вывести `\n`
}
