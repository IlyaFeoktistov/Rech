// Значение сущности, реализующей интерфейс, подходит везде, где ожидается
// сам интерфейс: параметр функции и метода, поле, результат, переменная
// (ей потом можно присвоить другую реализацию), элемент списка и словаря,
// параметр лямбды, "?Интерфейс". Через интерфейс видны только его методы.

интерфейс Фигура
{
    площадь(): Целое
}

сущность Квадрат реализует Фигуру
{
    публичный площадь(): Целое
    {
        вернуть 4
    }
}

сущность Круг реализует Фигуру
{
    публичный площадь(): Целое
    {
        вернуть 3
    }
}

сущность Холст
{
    имеет:
        публичная Фигура главная_фигура

    конструктор(ф: Фигура)
    {
        этот.главная_фигура = ф
    }

    публичный добавить(ф: Фигура): Целое
    {
        вернуть ф.площадь() + этот.главная_фигура.площадь()
    }
}

функция площадь_фигуры(ф: Фигура): Целое
{
    вернуть ф.площадь()
}

функция любая_фигура(круг: Логическое): Фигура
{
    если круг {
        вернуть новый Круг()
    }
    вернуть новый Квадрат()
}

функция главная
{
    вывести `параметр функции: ${площадь_фигуры(новый Квадрат())}\n`
    Холст х = новый Холст(новый Круг())
    вывести `поле + параметр метода: ${х.добавить(новый Квадрат())}\n`
    вывести `результат функции: ${любая_фигура(истина).площадь()}\n`
    Список<Фигура> фигуры = [новый Квадрат(), новый Круг()]
    Целое          сумма  = 0
    для ф в фигурах {
        сумма += ф.площадь()
    }
    вывести `список: ${сумма}\n`
    Словарь<Строка, Фигура> по_имени = новый Словарь<Строка, Фигура>()
    по_имени.установить("к", новый Круг())
    вывести `словарь: ${по_имени.получить("к").площадь()}\n`
    Вызываемый(Фигура): Целое лямбда = функция (ф: Фигура): Целое {
        вернуть ф.площадь() * 10
    }
    вывести `лямбда: ${лямбда(новый Круг())}\n`
    ?Фигура может = Ничто
    может = новый Квадрат()
    если может != Ничто {
        вывести `nullable: ${может.площадь()}\n`
    }
}
