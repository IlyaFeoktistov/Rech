/** Демонстрирует позиционную и именованную формы вызова явного
конструктора. Без своего "конструктор(...)" сущность создаётся только без
аргументов ("новый Пользователь()") - поля получают значения по умолчанию
или зануляются; чтобы задать их при создании, нужен явный конструктор. */
сущность Пользователь
{
    имеет:
        имя: Строка
        возраст: Целое

    конструктор(имя: Строка, возраст: Целое)
    {
        этот.имя = имя
        этот.возраст = возраст
    }
}

/** Демонстрирует форму ключевого слова "новая" (женский род). */
сущность Сова
{
    имеет:
        кличка: Строка

    конструктор(кличка: Строка)
    {
        этот.кличка = кличка
    }
}

/** Демонстрирует форму ключевого слова "новое" (средний род). */
сущность Окно
{
    имеет:
        ширина: Целое
        высота: Целое

    конструктор(ширина: Целое, высота: Целое)
    {
        этот.ширина = ширина
        этот.высота = высота
    }
}

/** Демонстрирует форму ключевого слова "новые" (множественное число). */
сущность Права
{
    имеет:
        уровень: Целое

    конструктор(уровень: Целое)
    {
        этот.уровень = уровень
    }
}

/** Позиционная и именованная формы конструктора, согласование "новый/новая/новое/новые". */
функция главная
{
    // Позиционная форма - как обычный вызов функции, аргументы по порядку
    // параметров конструктора.
    переменная пользователь = новый Пользователь("Илья", 30)

    // Именованная форма - метки внутри тех же скобок, порядок не важен,
    // но обязательны все параметры (у параметра, в отличие от поля, нет
    // собственного значения по умолчанию). Решает проблему "легко
    // перепутать порядок" у конструктора со многими одноимёнными по типу
    // параметрами.
    переменная админ = новый Пользователь(возраст: 30, имя: "Пётр")

    // Ключевое слово конструктора согласуется по роду и числу с именем
    // сущности - как в обычной русской речи: новый/новая/новое/новые.
    переменная сова = новая Сова("Мудрая")
    переменная окно = новое Окно(ширина: 800, высота: 600)
    переменная права = новые Права(1)

    вывести пользователь.имя
    вывести админ.возраст
    вывести сова.кличка
    вывести окно.ширина
    вывести окно.высота
    вывести права.уровень
}
