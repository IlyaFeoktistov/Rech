// "этот" можно объявить не только как выражение внутри тела метода, но и
// как ТИП результата ("имя(...): этот") - ковариантный "self type": в
// отличие от обычного объявленного типа результата (статический, ровно тот,
// что написан), "этот" типизируется КОНКРЕТНЫМ статическим типом получателя
// в месте вызова. Нужно для "цепочек" вызовов через наследование:
// неизменённый унаследованный метод, вызванный на производной сущности,
// должен давать значение производного типа, а не базового - иначе следующий
// вызов метода, объявленного только у производной сущности, не прошёл бы
// проверку типов. Вызов метода не может быть получателем следующего вызова
// напрямую (получателем может быть только переменная/поле/"этот" - у
// результата вызова нет постоянного адреса), поэтому каждый шаг цепочки
// сохраняется в отдельную переменную.
сущность СтроительА
{
    имеет:
        имя_поле: Строка

    задать_имя(значение: Строка): этот
    {
        этот.имя_поле = значение
        вернуть этот
    }
}

// "СтроительБ" не переопределяет "задать_имя" - использует его как есть.
сущность СтроительБ наследует СтроительА
{
    имеет:
        доп_поле: Целое

    задать_доп(значение: Целое): этот
    {
        этот.доп_поле = значение
        вернуть этот
    }
}

функция главная
{
    переменная б = новый СтроительБ("", 0)
    // б2 типизируется как "СтроительБ" (тип б в месте вызова), не
    // "СтроительА" (тип, где объявлен "задать_имя") - поэтому следующий
    // вызов "задать_доп" (только у СтроительБ) проходит проверку типов.
    переменная б2 = б.задать_имя("Илья")
    б2.задать_доп(42)

    вывести б.имя_поле
    вывести б.доп_поле
}
