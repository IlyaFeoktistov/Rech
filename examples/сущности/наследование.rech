интерфейс Звучащий
{
    издать_звук(): Строка
}

/** Базовое животное - реализует "Звучащий" и умеет представиться по имени. */
сущность Животное реализует Звучащий
{
    имеет:
        Строка имя

    /** Звук по умолчанию для неопределённого животного. */
    издать_звук(): Строка
    {
        вернуть "..."
    }

    /** Возвращает имя животного. */
    представиться(): Строка
    {
        вернуть этот.имя
    }
}

// "Кошка" переопределяет "издать_звук" и заодно наследует "представиться"
// от "Животное" неизменённым - вызывается он через настоящую vtable-
// диспетчеризацию, не статически.
/** Кошка - животное с породой, переопределяет звук на "мяу". */
сущность Кошка наследует Животное
{
    имеет:
        Строка порода

    конструктор(имя: Строка, порода: Строка)
    {
        этот.имя = имя
        этот.порода = порода
    }

    /** Кошка мяукает. */
    издать_звук(): Строка
    {
        вернуть "мяу"
    }
}

// "Собака" реализует тот же интерфейс напрямую, без наследования от
// "Животное" - обе сущности взаимозаменяемы через "Звучащий".
/** Собака - реализует "Звучащий" напрямую, без наследования от "Животное". */
сущность Собака реализует Звучащий
{
    /** Собака лает. */
    издать_звук(): Строка
    {
        вернуть "гав"
    }
}

/** Озвучивает любую сущность, реализующую интерфейс "Звучащий". */
функция озвучить(х: Звучащий): Строка
{
    вернуть х.издать_звук()
}

/** Демонстрирует наследование, переопределение метода и интерфейсы. */
функция главная
{
    переменная кошка  = новая Кошка("Мурка", "сиамская")
    переменная собака = новая Собака()

    вывести `${озвучить(кошка)}\n`
    вывести `${озвучить(собака)}\n`
    вывести `${кошка.представиться()}\n`
}
