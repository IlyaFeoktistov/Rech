// Сущность-наследник подходит везде, где ожидается её базовая сущность:
// параметр функции и метода, поле, результат, переменная, элемент списка и
// словаря, параметр лямбды, "?База", аргумент типа generic-сущности.
// Вызывается переопределённый метод наследника.

сущность Животное
{
    публичный голос(): Строка
    {
        вернуть "..."
    }
}

сущность Кошка наследует Животное
{
    публичный голос(): Строка
    {
        вернуть "мяу"
    }
}

сущность Собака наследует Животное
{
    публичный голос(): Строка
    {
        вернуть "гав"
    }
}

сущность Приют
{
    имеет:
        публичный житель: Животное

    конструктор(ж: Животное)
    {
        этот.житель = ж
    }

    публичный вместе(ж: Животное): Строка
    {
        вернуть ж.голос() + этот.житель.голос()
    }
}

сущность Коробка<T>
{
    имеет:
        публичное содержимое: T

    конструктор(значение: T)
    {
        этот.содержимое = значение
    }
}

функция голос_животного(ж: Животное): Строка
{
    вернуть ж.голос()
}

функция любое(кошка: Логическое): Животное
{
    если кошка {
        вернуть новая Кошка()
    }
    вернуть новая Собака()
}

функция главная
{
    вывести `параметр функции: ${голос_животного(новая Кошка())}\n`
    Приют п = новый Приют(новая Собака())
    вывести `поле + параметр метода: ${п.вместе(новая Кошка())}\n`
    п.житель = новая Кошка()
    вывести `присваивание полю: ${п.житель.голос()}\n`
    вывести `результат: ${любое(ложь).голос()}\n`
    Список<Животное> кошки = [новая Кошка(), новая Собака()]
    кошки.добавить(новая Кошка())
    Строка хор = ""
    для ж в кошках {
        хор += ж.голос()
    }
    вывести `список: ${хор}\n`
    Словарь<Строка, Животное> по_кличке = новый Словарь<Строка, Животное>()
    по_кличке.установить("мурка", новая Кошка())
    вывести `словарь: ${по_кличке.получить("мурка").голос()}\n`
    Вызываемый(Животное): Строка лямбда = функция (ж: Животное): Строка {
        вернуть ж.голос() + "!"
    }
    вывести `лямбда: ${лямбда(новая Собака())}\n`
    ?Животное может = Ничто
    может = новая Кошка()
    если может != Ничто {
        вывести `nullable: ${может.голос()}\n`
    }
    Коробка<Животное> коробка = новая Коробка<Животное>(новая Собака())
    вывести `generic: ${коробка.содержимое.голос()}\n`
}
