// Получателем вызова метода И присваивания полю может быть результат
// ДРУГОГО вызова (метода, свободной функции, конструктора) - не только
// переменная/поле/"этот" - для сущности-ссылки (по умолчанию, не
// "структура") она уже указатель сама по себе, поэтому "&" для C this_ ей
// не нужен. Цепочка любой длины, включая присваивание полю в конце. См.
// docs/SPEC.md, разделы "Методы и этот" и "Присваивание полю".

/** Пишет сообщения об ошибках. */
сущность Логгер
{
    публичный ошибка(текст: Строка)
    {
        вывести "ОШИБКА: " + текст
    }
}

/** Простой счётчик - демонстрирует присваивание полю через цепочку. */
сущность Счётчик
{
    имеет:
        число: Целое
}

/** Контейнер отдаёт логгер и счётчик МЕТОДАМИ (не полями) - типичный
    DI-паттерн, где зависимость возвращается фабричным методом, а не
    хранится открытым полем. */
сущность Контейнер
{
    имеет:
        приватный логгер_: Логгер
        приватный счётчик_: Счётчик

    конструктор()
    {
        этот.логгер_ = новый Логгер()
        этот.счётчик_ = новый Счётчик()
    }

    публичный логгер(): Логгер
    {
        вернуть этот.логгер_
    }

    публичный счётчик(): Счётчик
    {
        вернуть этот.счётчик_
    }
}

/** Отдаёт готовый контейнер - для демонстрации цепочки, начатой прямо со
    свободной функции, а не с переменной. */
функция создать_контейнер(): Контейнер
{
    вернуть новый Контейнер()
}

/** Демонстрирует вызов метода и присваивание полю прямо на результате
    другого вызова. */
функция главная
{
    переменная контейнер = новый Контейнер()

    // Раньше - ошибка компиляции ("получателем вызова метода может быть
    // только переменная, поле или "этот""), поэтому пришлось бы заводить
    // промежуточную переменную:
    //     переменная логгер = контейнер.логгер()
    //     логгер.ошибка("...")
    // Теперь работает без неё - "контейнер.логгер()" возвращает ссылку на
    // "Логгер", и метод вызывается прямо на ней.
    контейнер.логгер().ошибка("тест цепочки вызовов")

    // То же самое - для присваивания полю: "счётчик()" возвращает ссылку
    // на "Счётчик", "число" присваивается прямо в него, без промежуточной
    // переменной.
    контейнер.счётчик().число = 41
    контейнер.счётчик().число += 1
    вывести контейнер.счётчик().число

    // Цепочка не обязана начинаться с переменной - результат вызова
    // СВОБОДНОЙ функции тоже годится базой для продолжения "."
    создать_контейнер().логгер().ошибка("вызов прямо на результате функции")

    // Ограничение остаётся в силе для "структура" (получатель-значение,
    // не ссылка) - у неё в сгенерированном C нет постоянного адреса,
    // взять "&" от временного значения нельзя. "структура"-версия того же
    // паттерна потребовала бы промежуточную переменную.
}
