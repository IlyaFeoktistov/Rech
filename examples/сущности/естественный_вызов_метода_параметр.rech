/**
 * Показывает, что получателем естественного вызова метода может быть не
 * только локальная переменная (см. естественный_вызов_метода.rech), но и
 * ПАРАМЕТР другого метода/функции - у параметра тип всегда указан явно,
 * того же достаточно, что и у "Тип x".
 */
сущность Книга
{
    имеет:
        Строка     название
        Логическое выдана

    конструктор(название: Строка)
    {
        этот.название = название
        этот.выдана = ложь
    }

    /**
     * Метод без параметров - естественный вызов сводится к двум словам
     * "получатель метод", без падежных аргументов вовсе.
     */
    публичный выдать()
    {
        этот.выдана = истина
    }
}

сущность Библиотекарь
{
    имеет:
        Строка имя

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }

    публичный обработать(что книга: Книга)
    {
        // "книга" - параметр САМОГО этого метода, типизированный явно
        // "Книга" - естественный вызов на нём работает так же, как на
        // локальной переменной.
        книга выдать
        вывести `${книга.выдана}\n`
    }
}

функция главная
{
    Книга книга               = новая Книга("Мастер и Маргарита")
    Библиотекарь библиотекарь = новый Библиотекарь("Анна")

    библиотекарь обработать книгу
}
