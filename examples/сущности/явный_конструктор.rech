// В отличие от examples/сущности/конструктор.rech (неявная позиционная/
// именованная форма - поля присваиваются один-в-один без своей логики),
// здесь у сущности есть СОБСТВЕННОЕ тело конструктора: параметры не обязаны
// совпадать с полями, конструктор сам решает, что и как присвоить.
/** Пользователь с явным конструктором - принимает только имя. */
сущность Пользователь
{
    имеет:
        имя: Строка
        возраст: Целое

    конструктор(имя: Строка)
    {
        этот.имя = имя
        // Поле, которое конструктор не присвоил явно, остаётся нулевым
        // значением своего типа (0 для Целое) - "возраст" ниже задан явно
        // только чтобы показать это на контрасте.
        этот.возраст = 0
    }
}

// "Сотрудник" наследует "Пользователя" ("наследует" - переходный глагол,
// управляет винительным падежом, как и "реализует" у интерфейсов) и
// вызывает "родитель(...)" первой инструкцией своего конструктора - это
// выполняет тело конструктора "Пользователь" на том же самом объекте (не
// создаёт новый), после чего "Сотрудник" присваивает уже свои собственные
// поля.
/** Сотрудник - наследует "Пользователя" и вызывает его конструктор через "родитель(...)". */
сущность Сотрудник наследует Пользователя
{
    имеет:
        зарплата: Целое

    конструктор(имя: Строка, зарплата: Целое)
    {
        родитель(имя)
        этот.зарплата = зарплата
    }

    /** Возвращает имя сотрудника. */
    представиться(): Строка
    {
        вернуть этот.имя
    }
}

/** Демонстрирует явный конструктор и вызов конструктора базовой сущности "родитель(...)". */
функция главная
{
    переменная пользователь = новый Пользователь("Илья")
    вывести пользователь.имя
    вывести пользователь.возраст

    переменная сотрудник = новый Сотрудник("Аня", 1000)
    вывести сотрудник.представиться()
    вывести сотрудник.возраст
    вывести сотрудник.зарплата
}
