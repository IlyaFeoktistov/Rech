/** Пользователь с состоянием "вошедший" (typestate через действительное причастие). */
сущность Пользователь
{
    состояние: вошедший

    имеет:
        имя: Строка

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }

    /** Переводит пользователя в состояние "вошедший". */
    войти(): Пользователь
    {
        этот становится вошедшим
        вернуть этот
    }

    /** Принимает только доказанно вошедшего пользователя (ВошедшийПользователь). */
    представиться(п: ВошедшийПользователь): Строка
    {
        вернуть п.имя
    }
}

/** Демонстрирует typestate через действительное причастие ("вошедший"). */
функция главная
{
    переменная пользователь = новый Пользователь("Аня")
    пользователь = пользователь.войти()
    вывести `${пользователь.представиться(пользователь)}\n`
}
