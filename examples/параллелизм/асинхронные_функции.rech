/** Удваивает х - демонстрирует "асинхронная функция". */
асинхронная функция удвоить(х: Целое): Целое
{
    вернуть х * 2
}

/** Демонстрирует "асинхронная функция" - сахар над "запустить"/"дождаться":
 *  "дождаться удвоить(...)" запускает функцию в отдельном потоке ОС и ждёт
 *  результат (как "дождаться запустить удвоить(...)"), а прямой вызов
 *  "удвоить(...)" без "дождаться" - обычный синхронный вызов на текущем
 *  потоке, без какого-либо потока/задачи. */
функция главная
{
    переменная синхронно = удвоить(21)
    вывести синхронно

    переменная задача1 = запустить удвоить(1)
    переменная результат2 = дождаться удвоить(2)
    вывести дождаться задача1
    вывести результат2
}
