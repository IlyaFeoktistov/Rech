/** Общий счёт, доступ к балансу которого защищён "Блокировкой" - без нёе
    несколько задач, одновременно списывающих деньги, потеряли бы часть
    обновлений. */
сущность Счёт
{
    имеет:
        баланс: Целое
        блокировка: Блокировка

    /** Списывает сумму под захваченной блокировкой. */
    списать(сумма: Целое)
    {
        этот.блокировка.захватить()
        этот.баланс = этот.баланс - сумма
        этот.блокировка.освободить()
    }
}

/** Списывает по одному тысячу раз подряд. */
функция обработать(счёт: Счёт)
{
    переменная i = 0
    пока i < 1000
    {
        счёт.списать(1)
        i = i + 1
    }
}

/** Демонстрирует "Блокировку": две задачи одновременно списывают с одного
    счёта - итог точен благодаря захватить()/освободить() вокруг мутации. */
функция главная
{
    переменная счёт = новый Счёт(200000, новая Блокировка())

    переменная задача1 = запустить обработать(счёт)
    переменная задача2 = запустить обработать(счёт)

    дождаться задача1
    дождаться задача2

    вывести счёт.баланс
}
