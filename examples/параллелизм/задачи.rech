/** Выбрасывается сломанной задачей. */
публичная сущность ОшибкаВвода наследует Исключение
{
    конструктор(сообщение: Строка)
    {
        родитель(сообщение)
    }
}

/** Работа над числом - сигнатура задач ниже. */
публичный синоним Работа = Вызываемый(Целое): Целое

/** Прибавляет к числу постоянный шаг. */
публичная сущность Прибавка
{
    имеет:
        публичное Целое шаг

    конструктор(шаг: Целое)
    {
        этот.шаг = шаг
    }

    /** Число плюс шаг. */
    публичный применить(число: Целое): Целое
    {
        вернуть число + этот.шаг
    }
}

/** Удваивает х. */
публичная функция удвоить(х: Целое): Целое
{
    вернуть х * 2
}

/** Всегда выбрасывает ОшибкаВвода - демонстрирует исключение из "запустить"-задачи. */
публичная функция сломать()
{
    выбросить новая ОшибкаВвода("не удалось")
}

/**
 * Демонстрирует "запустить"/"дождаться": функцию, лямбду из переменной и
 * метод в одном списке задач одной сигнатуры, и исключение из задачи.
 */
публичная функция главная
{
    переменная задача1 = запустить удвоить(1)
    переменная задача2 = запустить удвоить(2)
    переменная задача3 = запустить удвоить(3)

    вывести `${дождаться задача1}\n`
    вывести `${дождаться задача2}\n`
    вывести `${дождаться задача3}\n`

    // Тип задачи - сигнатура запущенного, поэтому функция, лямбда и метод
    // одной сигнатуры складываются в один список.
    Работа     квадрат  = функция (число: Целое): Целое { вернуть число * число }
    переменная прибавка = новая Прибавка(100)

    Список<Задача<Работа>> задачи = []
    задачи.добавить(запустить удвоить(10))
    задачи.добавить(запустить квадрат(10))
    задачи.добавить(запустить прибавка.применить(10))
    для задача в задачах {
        вывести `${дождаться задача}\n`
    }

    переменная сломанная = запустить сломать()
    попытаться {
        дождаться сломанная
    } поймать(иск: ОшибкаВвода) {
        вывести `поймано: \n`
        вывести `${иск.сообщение}\n`
    }
}
