/**
 * Число одновременно "работающих" задач, защищённое отдельной
 * "Блокировкой" - без неё само измерение (текущих/максимум) гонялось бы
 * между потоками так же, как обычное поле без синхронизации.
 */
сущность Счётчики
{
    имеет:
        текущих:    Целое
        максимум:   Целое
        блокировка: Блокировка

    конструктор(блокировка: Блокировка)
    {
        этот.текущих = 0
        этот.максимум = 0
        этот.блокировка = блокировка
    }

    /**
 * Входит в критический участок - обновляет максимум, если сейчас
 * активных больше, чем когда-либо раньше.
 */
    войти()
    {
        этот.блокировка.захватить()
        этот.текущих = этот.текущих + 1
        если этот.текущих > этот.максимум {
            этот.максимум = этот.текущих
        }
        этот.блокировка.освободить()
    }

    выйти()
    {
        этот.блокировка.захватить()
        этот.текущих = этот.текущих - 1
        этот.блокировка.освободить()
    }
}

/**
 * "Работа" - подождать своей очереди на семафоре, отметиться в счётчиках,
 * провести время внутри (цикл вместо настоящего ввода-вывода - пример без
 * внешних зависимостей), выйти и отпустить разрешение.
 */
функция поработать(доступ: Семафор, счётчики: Счётчики)
{
    доступ.захватить()
    счётчики.войти()
    переменная i = 0
    пока i < 3000000 {
        i = i + 1
    }
    счётчики.выйти()
    доступ.освободить()
}

/**
 * Демонстрирует "Семафор": 5 задач запускаются одновременно, но
 * "Семафор(2)" пропускает не более двух одновременно - максимум
 * "текущих" никогда не превысит 2, хотя все 5 стартовали сразу. Тот же
 * приём ограничивает, например, число одновременно обрабатываемых
 * TCP-соединений (`examples/проекты/http_сервер`).
 */
функция главная
{
    переменная доступ   = новый Семафор(2)
    переменная счётчики = новые Счётчики(новая Блокировка())

    переменная задача1 = запустить поработать(доступ, счётчики)
    переменная задача2 = запустить поработать(доступ, счётчики)
    переменная задача3 = запустить поработать(доступ, счётчики)
    переменная задача4 = запустить поработать(доступ, счётчики)
    переменная задача5 = запустить поработать(доступ, счётчики)

    дождаться задача1
    дождаться задача2
    дождаться задача3
    дождаться задача4
    дождаться задача5

    вывести счётчики.максимум
}
