использовать создать_токен из "токен"
использовать проверить_токен из "токен"

/**
 * Тестовый файл - покрывает "токен.rech" (JWT-подобный "заголовок.тело.
 * подпись", HMAC-SHA256) целиком - создание, успешную проверку, и три
 * способа испортить токен так, чтобы "проверить_токен" вернул "Ничто"
 * вместо имени пользователя: испорченная подпись, лишний обрезанный
 * символ (тоже ломает подпись) и структурно неверный токен без точек.
 *
 * Проверить: rech test examples/проекты/http_сервер/исходники/токен/токен_тест.rech
 */
функция главная
{
    переменная токен = создать_токен("Аня")

    // "заголовок.тело.подпись" - ровно две точки-разделителя.
    утверждать позиция_в_строке(токен, ".") >= 0, "токен должен содержать хотя бы одну точку-разделитель"

    переменная имя = проверить_токен(токен)
    утверждать имя != Ничто, "только что созданный токен должен пройти проверку"
    утверждать (Строка) имя == "Аня", "проверить_токен должна вернуть то же имя, что было передано в создать_токен"

    // Испорченная подпись (последний символ токена - часть HEX-подписи,
    // подмена ломает совпадение с пересчитанной подписью).
    переменная испорченный = подстрока(токен, 0, длина_строки(токен) - 1) + "0"
    утверждать проверить_токен(испорченный) == Ничто, "подделанная подпись должна отклоняться"

    // Обрезанный токен - подпись неполная, тоже не совпадёт.
    переменная обрезанный = подстрока(токен, 0, длина_строки(токен) - 5)
    утверждать проверить_токен(обрезанный) == Ничто, "обрезанный токен должен отклоняться"

    // Структурно неверный токен - "проверить_токен" должна вернуть "Ничто",
    // а не аварийно завершиться (ищет точки сама, до любой попытки декодировать).
    утверждать проверить_токен("совсем не токен") == Ничто, "токен без точек-разделителей - Ничто, не паника"
    утверждать проверить_токен("заголовок.тело_без_второй_точки") == Ничто, "ровно одна точка (нет второй, для подписи) - тоже Ничто, не паника"

    // Токены двух разных пользователей не совпадают как строки и оба
    // независимо проверяются на СВОЁ собственное имя.
    переменная токен_другого = создать_токен("Боря")
    утверждать токен != токен_другого, "токены разных пользователей должны отличаться"
    утверждать (Строка) проверить_токен(токен_другого) == "Боря", "второй токен должен проверяться на своё собственное имя"
    утверждать (Строка) проверить_токен(токен) == "Аня", "первый токен всё ещё проверяется на своё имя после создания второго"
}
