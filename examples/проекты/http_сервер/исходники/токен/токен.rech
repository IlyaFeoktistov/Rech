использовать ПретензииТокена из "претензии_токена"

/**
 * Токен вида "заголовок.тело.подпись" - тем же принципом, что и JWT (HS256):
 * заголовок/тело - настоящий base64url JSON, подпись - HMAC-SHA256 всей
 * подписываемой части ("заголовок.тело"). Подпись здесь - HEX, не
 * base64url, как в настоящем JWT (docs/SPEC.md, раздел 11 - причина та же,
 * что и у HEX в "хеш"/"подпись_hmac_sha256": "Строка" в cbackend не
 * несёт отдельно хранимую длину, сырой бинарный дайджест подписи мог бы
 * содержать 0x00 внутри). Токен САМОДОСТАТОЧЕН (stateless) - сервер не
 * хранит список выданных токенов (в отличие от прежней версии этого
 * примера с таблицей "sessions") - "выход из системы" для такого токена
 * означает только "клиент перестал его посылать", отозвать один конкретный
 * токен до истечения срока действия НЕЛЬЗЯ (для этого нужен отдельный
 * список отозванных токенов - за пределами этого среза).
 */
// НАЙДЕННАЯ АНОМАЛИЯ (не разобрана до конца, обойдена здесь - см. итог
// сессии): "константа <имя> = ..." уровня модуля, используемая внутри
// функции ЭТОГО ЖЕ файла, давала "переменная %q не объявлена" при сборке
// ВСЕГО проекта (много файлов, включая generic-функцию в другом файле), но
// НЕ воспроизвелась ни в одном изолированном 2-3-файловом повторении той
// же формы - подозрение на state, не переинициализируемый между файлами
// при большом графе импортов (internal/semantic.Analyzer.moduleConstExprs).
// Обойдено здесь - обе константы заменены приватными функциями (тот же
// работающий путь, что и у обычных функций).

приватная функция jwt_заголовок_json(): Строка
{
    вернуть "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
}

/**
 * Секрет подписи - из переменной окружения RECH_JWT_SECRET, если она
 * установлена (12-factor: секрет НЕ должен лежать в исходнике/бинарнике
 * production-сборки); запасное значение ниже - только для локального
 * запуска примера без какой-либо настройки, менять на каждом настоящем
 * развёртывании. API_КЛЮЧ (авторизация.rech), для сравнения, - тот же
 * захардкоженный демо-секрет БЕЗ переменной окружения (сознательно
 * оставлен как есть - показать оба варианта в одном примере).
 */
приватная функция jwt_секрет(): Строка
{
    вернуть получить_переменную_окружения("RECH_JWT_SECRET") ?? "секретный-ключ-jwt-по-умолчанию-меняйте-в-production"
}

/**
 * Строит подписанный токен для имени - "заголовок.тело.подпись" - живёт
 * час (3600 секунд), истёкший токен "проверить_токен" отклоняет тем же
 * "Ничто", что и подделанную подпись, не отдельным кодом ошибки.
 */
функция создать_токен(имя: Строка): Строка
{
    переменная данные = новые ПретензииТокена()
    данные.пользователь = имя
    данные.истечение = время() + 3600

    переменная заголовок           = закодировать_base64url(jwt_заголовок_json())
    переменная тело                = закодировать_base64url(сериализовать JSON данные)
    переменная подписываемая_часть = заголовок + "." + тело
    вернуть подписываемая_часть + "." + подпись_hmac_sha256(подписываемая_часть, jwt_секрет())
}

/**
 * "декодировать_base64url" на некорректном base64url - аварийное завершение
 * ПРОЦЕССА (в языке ещё нет исключений, которыми это можно поймать,
 * docs/SPEC.md, раздел 11) - недопустимо для сервера: одна подделанная
 * cookie от любого клиента убила бы весь процесс, а не только этот запрос.
 * Проверяет алфавит САМА, посимвольно, ДО вызова decode - единственная
 * защита от этого в текущем срезе языка (нет ни try/catch вокруг паники,
 * ни regex).
 */
приватная функция это_валидный_base64url(текст: Строка): Логическое
{
    переменная алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    переменная i       = 0
    пока i < длина_строки(текст) {
        если не содержит(алфавит, подстрока(текст, i, 1)) {
            вернуть ложь
        }
        i = i + 1
    }
    вернуть истина
}

/**
 * Проверяет токен - подпись должна совпасть (пересчитана из уже
 * прочитанных заголовка/тела, не доверяем присланной подписи слепо) и срок
 * действия не истечь. Разбор "заголовок.тело.подпись" вручную через
 * "позиция_в_строке"/"подстрока" - в языке ещё нет функции разбиения
 * строки на части по разделителю (docs/ROADMAP.md, "разбить").
 */
функция проверить_токен(токен: Строка): ?Строка
{
    переменная первая_точка = позиция_в_строке(токен, ".")
    если первая_точка < 0 {
        вернуть Ничто
    }
    переменная хвост        = подстрока(токен, первая_точка + 1, длина_строки(токен) - первая_точка - 1)
    переменная вторая_точка = позиция_в_строке(хвост, ".")
    если вторая_точка < 0 {
        вернуть Ничто
    }

    переменная заголовок = подстрока(токен, 0, первая_точка)
    переменная тело      = подстрока(хвост, 0, вторая_точка)
    переменная подпись   = подстрока(хвост, вторая_точка + 1, длина_строки(хвост) - вторая_точка - 1)

    переменная подписываемая_часть = заголовок + "." + тело
    если подпись_hmac_sha256(подписываемая_часть, jwt_секрет()) != подпись {
        вернуть Ничто
    }

    попытаться {
        переменная данные = разобрать JSON декодировать_base64url(тело) как ПретензииТокена
        если время() >= данные.истечение {
            вернуть Ничто
        }
        вернуть данные.пользователь
    } поймать (иск: ОшибкаРазбора) {
        вернуть Ничто
    }
}
