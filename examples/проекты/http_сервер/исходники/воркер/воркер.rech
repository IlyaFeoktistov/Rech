/**
 * Фиктивный воркер: "тяжёлая_задача" имитирует CPU-тяжёлую работу (наивный
 * перебор простых чисел БЕЗ решета - специально неоптимизированный, чтобы
 * заметно занять поток) и складывает результат в общий "ХранилищеЗадач",
 * защищённый "Блокировка" (docs/SPEC.md, раздел 15 - потоки ОС, не
 * зелёные) - HTTP-обработчик, запустивший задачу через "запустить", не
 * блокируется на неё "дождаться" (иначе смысла в фоновой задаче не было
 * бы) - статус опрашивается отдельным маршрутом (см. "сервер.rech").
 * Осознанное следствие модели параллелизма - задача, у которой никогда не
 * вызвали "дождаться", это потерянное (в данном случае - никогда не
 * бывшее) исключение, docs/SPEC.md, раздел 15.
 */
сущность Задача
{
    имеет:
        готова:    Логическое
        результат: Строка
}

/**
 * Хранилище задач по id - Словарь не потокобезопасен сам по себе (docs/
 * SPEC.md, раздел 8), поэтому каждый доступ - под "Блокировка". Значение
 * словаря - боксированное "Значение" ("(Значение) задача"), не голая
 * "Задача" - НАЙДЕННОЕ ОГРАНИЧЕНИЕ языка: встроенная коллекция с
 * пользовательской сущностью-элементом допустима локальной переменной/
 * параметром/результатом функции, но НЕ полем другой сущности/структуры
 * (docs/ROADMAP.md, Шаг 39 - "Словарь<Строка, Задача>" полем "ХранилищеЗадач"
 * не компилируется). Боксирование - тот же приём, что и в "../ди/контейнер.rech".
 */
сущность ХранилищеЗадач
{
    имеет:
        приватные задачи:     Словарь<Строка, Значение>
        приватная блокировка: Блокировка

    конструктор()
    {
        этот.задачи = новый Словарь<Строка, Значение>()
        этот.блокировка = новая Блокировка()
    }

    /** Заводит запись о задаче id - "не готова", результат ещё пуст. */
    начать(id: Строка)
    {
        этот.блокировка.захватить()
        переменная задача = новая Задача()
        задача.готова = ложь
        задача.результат = ""
        этот.задачи.установить(id, (Значение) задача)
        этот.блокировка.освободить()
    }

    /** Отмечает задачу id завершённой с результатом. */
    завершить(id: Строка, результат: Строка)
    {
        этот.блокировка.захватить()
        переменная боксированная = этот.задачи.получить(id)
        переменная задача        = боксированная как Задача
        задача.готова = истина
        задача.результат = результат
        этот.блокировка.освободить()
    }

    /** Текущий статус задачи id - Ничто, если такой задачи не заводили. */
    статус(id: Строка): ?Задача
    {
        этот.блокировка.захватить()
        если не этот.задачи.содержит(id) {
            этот.блокировка.освободить()
            вернуть Ничто
        }
        переменная боксированная = этот.задачи.получить(id)
        этот.блокировка.освободить()
        вернуть боксированная как Задача
    }
}

/**
 * Наивная проверка простоты - специально O(n), не O(sqrt(n)), чтобы
 * "тяжёлая_задача" ниже заняла заметное время на разумном n.
 */
приватная функция простое(n: Целое): Логическое
{
    если n < 2 {
        вернуть ложь
    }
    переменная делитель = 2
    пока делитель < n {
        если n % делитель == 0 {
            вернуть ложь
        }
        делитель = делитель + 1
    }
    вернуть истина
}

/**
 * "Тяжёлая задача" - считает простые числа до границы и кладёт результат
 * в хранилище под тем же id, что вызывающий код запомнил себе сразу после
 * "запустить" (см. обработать_запуск_задачи, сервер.rech).
 */
функция тяжёлая_задача(id: Строка, граница: Целое, хранилище: ХранилищеЗадач)
{
    переменная количество = 0
    переменная i          = 2
    пока i < граница {
        если простое(i) {
            количество = количество + 1
        }
        i = i + 1
    }
    хранилище.завершить(id, "простых чисел до " + (Строка) граница + ": " + (Строка) количество)
}
