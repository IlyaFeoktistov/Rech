использовать ОтветОшибки из "ответ_с_ошибкой"

/**
 * Готовый JSON-"Ответ" вида {"ошибка": текст} с заданным HTTP-кодом -
 * используется маршрутизатором (404), middleware авторизации (401) и
 * обработчиками маршрутов (400 на некорректный JSON запроса).
 */
функция ответ_ошибки(код: Целое, текст: Строка): Ответ
{
    переменная тело = новый ОтветОшибки()
    тело.ошибка = текст
    вернуть новый Ответ(код, "Content-Type: application/json", сериализовать JSON тело)
}
