использовать хешировать_пароль, сгенерировать_соль из "пароль"

/**
 * Инициализация SQLite-хранилища сервера: единственная таблица "users"
 * (username, password_hash, salt) - хеш пароля с собственной солью на
 * каждого пользователя (см. package doc "пароль.rech"), не пароль как
 * есть. Никакой отдельной таблицы "sessions" больше нет (в отличие от
 * прежней версии этого примера) - сессионный токен теперь самодостаточный
 * подписанный JWT-подобный токен (см. "../токен/токен.rech"), проверяемый
 * без обращения к БД вообще.
 *
 * Имена таблиц/колонок - латиницей, тем же соглашением, что и
 * examples/бд/подключение.rech.
 */
функция инициализировать_бд(строка_подключения: Строка): БД
{
    переменная бд = подключиться_к_бд(строка_подключения)
    // Третий аргумент ("параметры") необязателен - по умолчанию пустой
    // список, для запроса без единого "?" незачем писать его явно
    // (internal/semantic/db.go, dbNoParamsDefault).
    бд.выполнить("CREATE TABLE users (username TEXT PRIMARY KEY, password_hash TEXT, salt TEXT)")

    переменная соль      = сгенерировать_соль()
    переменная параметры = новый Список<Значение>()
    параметры.добавить((Значение) "admin")
    параметры.добавить((Значение) хешировать_пароль("secret123", соль))
    параметры.добавить((Значение) соль)
    бд.выполнить("INSERT INTO users (username, password_hash, salt) VALUES (?, ?, ?)", параметры)

    вернуть бд
}
