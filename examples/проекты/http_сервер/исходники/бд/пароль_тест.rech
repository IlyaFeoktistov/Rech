использовать сгенерировать_соль из "пароль"
использовать хешировать_пароль из "пароль"
использовать длина_строки из стандарт/строки

/**
 * Тестовый файл - покрывает "пароль.rech" (хеш пароля с солью, package doc
 * там же - известное осознанное упрощение примера: SHA-256, не bcrypt/
 * Argon2). "сгенерировать_соль" сама по себе случайна (случайное_целое) -
 * точное значение непроверяемо, только свойства: непустая, разная при
 * каждом вызове, влияет на итоговый хеш.
 *
 * Проверить: rech test examples/проекты/http_сервер/исходники/бд/пароль_тест.rech
 */
функция главная
{
    переменная соль1 = сгенерировать_соль()
    переменная соль2 = сгенерировать_соль()
    утверждать длина_строки(соль1) > 0, "соль не должна быть пустой строкой"
    утверждать соль1 != соль2, "две сгенерированные соли не должны совпасть (случайная основа)"

    // Один и тот же пароль/соль - один и тот же хеш (детерминированность
    // самой функции хеширования, необходимая для последующей проверки при
    // логине - сверяются хеши, не исходные пароли).
    переменная хеш1 = хешировать_пароль("секрет123", соль1)
    переменная хеш2 = хешировать_пароль("секрет123", соль1)
    утверждать хеш1 == хеш2, "тот же пароль с той же солью - тот же хеш"

    // Разная соль у одного и того же пароля - разный хеш (сама причина,
    // по которой соль вообще нужна - см. package doc "пароль.rech").
    переменная хеш3 = хешировать_пароль("секрет123", соль2)
    утверждать хеш1 != хеш3, "тот же пароль, но другая соль - другой хеш"

    // Разный пароль с той же солью - тоже другой хеш.
    переменная хеш4 = хешировать_пароль("другой-пароль", соль1)
    утверждать хеш1 != хеш4, "другой пароль с той же солью - другой хеш"
}
