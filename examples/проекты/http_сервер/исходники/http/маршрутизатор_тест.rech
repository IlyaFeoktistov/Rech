использовать Маршрутизатор из "маршрутизатор"

/**
 * Тестовый файл - покрывает "маршрутизатор.rech" (таблица "МЕТОД путь" ->
 * обработчик) напрямую, без реального сокета: "обработать" принимает
 * обычный "Запрос" (docs/SPEC.md, раздел 11 - те же поля, что и у
 * настоящего "принять_http", просто собранные здесь вручную) и вызывает
 * зарегистрированный обработчик-лямбду.
 *
 * Проверить: rech test examples/проекты/http_сервер/исходники/http/маршрутизатор_тест.rech
 */
функция главная
{
    переменная маршрутизатор = новый Маршрутизатор()
    маршрутизатор.зарегистрировать("GET", "/привет", функция (запрос: Запрос): Ответ {
        вернуть новый Ответ(200, "", "привет, " + запрос.путь)
    })
    маршрутизатор.зарегистрировать("POST", "/эхо", функция (запрос: Запрос): Ответ {
        вернуть новый Ответ(200, "", запрос.тело)
    })

    переменная ответ1 = маршрутизатор.обработать(новый Запрос("GET", "127.0.0.1", 8080, "/привет", "", ""))
    утверждать ответ1.код == 200, "зарегистрированный маршрут GET /привет должен найтись"
    утверждать ответ1.тело == "привет, /привет", "обработчик получает тот же Запрос, что и передан"

    // Query-строка ("?...") отсекается ДО поиска по таблице маршрутов -
    // "GET /привет?имя=Аня" должен найти маршрут "GET /привет".
    переменная ответ2 = маршрутизатор.обработать(новый Запрос("GET", "127.0.0.1", 8080, "/привет?имя=Аня", "", ""))
    утверждать ответ2.код == 200, "query-строка не должна мешать поиску маршрута"

    переменная ответ3 = маршрутизатор.обработать(новый Запрос("POST", "127.0.0.1", 8080, "/эхо", "", "текст запроса"))
    утверждать ответ3.тело == "текст запроса", "тело запроса доходит до обработчика без изменений"

    // Неизвестный маршрут - 404 (ответ_ошибки, HTTPКод.НеНайдено).
    переменная ответ4 = маршрутизатор.обработать(новый Запрос("GET", "127.0.0.1", 8080, "/такогонет", "", ""))
    утверждать ответ4.код == HTTPКод.НеНайдено, "незарегистрированный маршрут - 404"

    // Тот же путь, но другой метод, - тоже не найден: ключ таблицы включает МЕТОД.
    переменная ответ5 = маршрутизатор.обработать(новый Запрос("DELETE", "127.0.0.1", 8080, "/привет", "", ""))
    утверждать ответ5.код == HTTPКод.НеНайдено, "тот же путь, но незарегистрированный метод - тоже 404"
}
