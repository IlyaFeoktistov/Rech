/**
 * Конфигурация приложения - порт HTTP, верхняя граница числа одновременно
 * обрабатываемых соединений, путь файла лога, строка подключения к БД -
 * читается ОДНИМ файлом ("config.yaml", рядом с исходниками, см.
 * "Конфигурация::загрузить" ниже), а не аргументами командной строки/
 * переменными окружения по одной на настройку. TLS-сертификат/ключ
 * (RECH_TLS_CERT/RECH_TLS_KEY) сюда сознательно НЕ входят - это секреты
 * окружения, не настройки приложения, им место в переменных окружения
 * (docs/SPEC.md, "Переменные окружения"), не в файле, который может
 * случайно попасть в систему контроля версий.
 *
 * Три вложенные сущности (Сервер/БазаДанных/Логгер) вместо одного плоского
 * списка полей - секции конфигурации в YAML-файле ("сервер:"/"бд:"/
 * "логгер:") отображаются на них напрямую (разбор YAML - раздел 18
 * SPEC.md, "ключ:" - имя поля буквально), а не разбираются вручную по
 * строкам.
 */
сущность НастройкиСервера
{
    имеет:
        порт:                          Целое
        макс_одновременных_соединений: Целое
}

сущность НастройкиБД
{
    имеет:
        строка_подключения: Строка
}

сущность НастройкиЛоггера
{
    имеет:
        путь: Строка
}

сущность Конфигурация
{
    имеет:
        сервер: НастройкиСервера
        бд:     НастройкиБД
        логгер: НастройкиЛоггера

    /**
     * Загружает и разбирает config.yaml по пути путь - аварийное
     * завершение при отсутствии файла ("прочитать_файл") или при
     * несовпадении со схемой (ОшибкаРазбора, здесь НЕ перехватывается
     * нарочно) - неверный/отсутствующий файл конфигурации ближе к ошибке
     * запуска программы, чем к ожидаемому рантайм-случаю, который стоило
     * бы обрабатывать по месту вызова.
     */
    статический загрузить(путь: Строка): Конфигурация
    {
        переменная текст = прочитать_файл(путь)
        вернуть разобрать YAML текст как Конфигурация
    }
}
