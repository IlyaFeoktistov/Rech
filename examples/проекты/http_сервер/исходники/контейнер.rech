использовать ХранилищеЗадач из "воркер/воркер"

/**
 * "ЛоггерИнтерфейс" - контракт логирования по уровням (docs/SPEC.md,
 * раздел 6, "Наследование и интерфейсы") - две независимые реализации,
 * "ФайловыйЛоггер"/"КонсольныйЛоггер" ниже, взаимозаменяемые за
 * интерфейсом через поле "Контейнер.логгер". Живёт В ОДНОМ ФАЙЛЕ с
 * "Контейнер" (не в отдельном "логгер.rech", как в более ранней версии
 * этого примера) - НАЙДЕННОЕ ОГРАНИЧЕНИЕ: "использовать" вообще не умеет
 * импортировать интерфейс из другого файла (internal/module/module.go,
 * declaredNames - "интерфейсы... не участвуют в системе импортов"), а
 * "Контейнер" ниже несёт поле именно этого типа - будь "ЛоггерИнтерфейс" в
 * отдельном файле, "Контейнер" не смог бы на него сослаться вообще никак.
 */
интерфейс ЛоггерИнтерфейс
{
    инфо(сообщение: Строка)
    предупреждение(сообщение: Строка)
    ошибка(сообщение: Строка)
}

/** Общее форматирование строки лога - "[ГГГГ-ММ-ДД ЧЧ:ММ:СС] [УРОВЕНЬ]
 * сообщение" - одно место для обеих реализаций (не дублировать между
 * "ФайловыйЛоггер"/"КонсольныйЛоггер"). */
приватная функция отформатировать_запись(уровень: Строка, сообщение: Строка): Строка
{
    переменная метка_времени = дату_в_строку(время_как_дата(время()))
    вернуть "[" + метка_времени + "] [" + уровень + "] " + сообщение
}

/**
 * Пишет в файл "сервер.log" в рабочем каталоге, одна строка на сообщение.
 * "дописать_в_файл" - каждый вызов сам открывает/закрывает файл (в языке
 * нет отдельного постоянно открытого дескриптора для этого) - на сервере с
 * высокой частотой запросов это заметная стоимость на запись, известное
 * упрощение этого среза.
 */
сущность ФайловыйЛоггер реализует ЛоггерИнтерфейс
{
    имеет:
        приватный путь: Строка

    конструктор(путь: Строка)
    {
        этот.путь = путь
    }

    инфо(сообщение: Строка)
    {
        дописать_в_файл(этот.путь, отформатировать_запись("ИНФО", сообщение) + "\n")
    }

    предупреждение(сообщение: Строка)
    {
        дописать_в_файл(этот.путь, отформатировать_запись("ВНИМАНИЕ", сообщение) + "\n")
    }

    ошибка(сообщение: Строка)
    {
        дописать_в_файл(этот.путь, отформатировать_запись("ОШИБКА", сообщение) + "\n")
    }
}

/** Пишет в стандартный вывод процесса - удобно для локальной разработки
 * (видно сразу в терминале, без "хвоста" файла лога отдельной командой). */
сущность КонсольныйЛоггер реализует ЛоггерИнтерфейс
{
    инфо(сообщение: Строка)
    {
        вывести отформатировать_запись("ИНФО", сообщение)
    }

    предупреждение(сообщение: Строка)
    {
        вывести отформатировать_запись("ВНИМАНИЕ", сообщение)
    }

    ошибка(сообщение: Строка)
    {
        вывести отформатировать_запись("ОШИБКА", сообщение)
    }
}

/**
 * DI-контейнер: единственное место, где собираются вместе сервисы этого
 * сервера (БД, логгер, хранилище фоновых задач) - строится один раз в
 * "главная" (сервер.rech) и передаётся дальше обработчикам ЦЕЛИКОМ, вместо
 * того, чтобы каждый обработчик принимал отдельным параметром ровно те
 * сервисы, которые ему нужны.
 *
 * Типизированные поля/геттеры, НЕ рефлексия ("Словарь<Строка, Значение>" +
 * "тип"/"разрешить(т: Тип): Значение") - хотя рефлексия в языке есть и
 * работает для многого (docs/SPEC.md, раздел 19; см. examples/основы/
 * крипто.rech и др.), сервис-локатор на ней для ЭТОГО конкретного набора
 * сервисов уперся в ЧЕТЫРЕ независимые находки этого среза, каждая -
 * реальный, воспроизводимый предел компилятора (не мой баг проектирования,
 * все проверены на минимальных примерах отдельно от этого проекта):
 *   1. "(Значение) x" для сущности с полем-generic-коллекцией (у
 *      "ХранилищеЗадач" - "Словарь<Строка, Значение>") падает "рефлексия
 *      по неизвестному типу" - cbackend не строит дескриптор ТАКОГО поля.
 *   2. "значение как ИмяИнтерфейса" требует ТОЧНОГО совпадения типа -
 *      боксированная конкретная реализация ("ФайловыйЛоггер") не
 *      распаковывается как интерфейс, который она реализует.
 *   3. "тип ИмяИнтерфейса" (дескриптор для САМОГО интерфейса) не
 *      существует вообще - cbackend не эмитит статический
 *      "rech_type_meta_t" для интерфейсов, только для сущностей/примитивов.
 *   4. "использовать" вообще не умеет импортировать интерфейс из другого
 *      файла - см. package doc "ЛоггерИнтерфейс" выше.
 * Итог - типизированные поля здесь честнее и надёжнее произвольного
 * сервис-локатора, пока эти четыре не закрыты (записаны для другой сессии,
 * не этой - см. итог в конце).
 */
сущность Контейнер
{
    имеет:
        приватный бд: БД
        приватный логгер: ЛоггерИнтерфейс
        приватный хранилище_задач: ХранилищеЗадач

    конструктор(бд: БД, логгер: ЛоггерИнтерфейс, хранилище_задач: ХранилищеЗадач)
    {
        этот.бд = бд
        этот.логгер = логгер
        этот.хранилище_задач = хранилище_задач
    }

    бд(): БД
    {
        вернуть этот.бд
    }

    логгер(): ЛоггерИнтерфейс
    {
        вернуть этот.логгер
    }

    задачи(): ХранилищеЗадач
    {
        вернуть этот.хранилище_задач
    }
}
