использовать ХранилищеЗадач из "воркер/воркер"
использовать ЛоггерИнтерфейс из "логгер/логгер"

/**
 * DI-контейнер: единственное место, где собираются вместе сервисы этого
 * сервера (БД, логгер, хранилище фоновых задач) - строится один раз в
 * "главная" (сервер.rech) и передаётся дальше обработчикам ЦЕЛИКОМ, вместо
 * того, чтобы каждый обработчик принимал отдельным параметром ровно те
 * сервисы, которые ему нужны.
 *
 * Хранилище - Список<Значение> боксированных сервисов, не поле на каждый
 * сервис (было раньше, до перехода на рефлексию - "приватный бд: БД" и
 * т. п.): добавить 10001-ю зависимость - боксировать её при вызове
 * конструктора ("сервер.rech", один аргумент в список), ни новое поле, ни
 * новый геттер здесь для этого не нужны - "разрешить" ниже находит любой
 * зарегистрированный тип рефлексией ("тип"/"тип_значения"/"реализует_ли" -
 * Шаги 47-53, см. историю в). "разрешить(тип Х)" - публичный
 * рефлексивный доступ (`контейнер.разрешить(тип ЛоггерИнтерфейс) как
 * ЛоггерИнтерфейс`); три типизированных геттера (бд/логгер/задачи) - тонкие
 * обёртки над ним для типобезопасности на стороне вызывающих
 * (авторизация.rech и т. п.), не отдельное хранилище на каждый сервис.
 */
сущность Контейнер
{
    имеет:
        приватный Список<Значение> сервисы

    конструктор(сервисы: Список<Значение>)
    {
        этот.сервисы = сервисы
    }

    /**
     * Находит среди зарегистрированных сервисов боксированное значение,
     * чей ФАКТИЧЕСКИЙ (не статический) тип совпадает с запрошенным именем
     * либо реализует его как интерфейс - запрошенный может быть
     * интерфейсом ("ЛоггерИнтерфейс"), а зарегистрирован конкретный
     * "ФайловыйЛоггер"/"КонсольныйЛоггер", поэтому точного совпадения имён
     * недостаточно, нужна ещё и проверка "реализует_ли". Не найдено -
     * аварийное завершение с именем запрошенного типа в сообщении
     * ("выбросить", необработанное - запрошенный сервис не зарегистрирован,
     * это ошибка сборки контейнера, не ожидаемый рантайм-случай). Индексный
     * цикл (не "для X в Y") - "Y" обязана быть
     * ГОЛОЙ переменной в предложном падеже (docs/SPEC.md, "Коллекции"),
     * а падежный словарь пока не распознаёт множественное число
     * заимствованных слов вроде "сервис" в этой позиции (найденный
     * недочёт морфологии, отдельный от этой фичи).
     */
    публичный разрешить(запрошенный: Тип): Значение
    {
        переменная сервисы = этот.сервисы
        для i от 0 до (сервисы.длина() - 1) {
            переменная сервис      = сервисы.получить(i)
            переменная фактический = сервис.тип_значения()
            если фактический.имя() == запрошенный.имя() || фактический.реализует_ли(запрошенный) {
                вернуть сервис
            }
        }
        // Сюда доходим, только если запрошенный тип вообще не
        // зарегистрирован - баг сборки контейнера (забыли добавить
        // зависимость в "сервер.rech"), не ожидаемый рантайм-случай -
        // "выбросить" с именем запрошенного типа в сообщении, необработанное
        // (никто выше не "поймать(Исключение)" вокруг разрешения сервисов) -
        // само завершает процесс с этим сообщением и кодом выхода 1.
        выбросить новое Исключение("неразрешённая зависимость: " + запрошенный.имя())
    }

    публичный бд(): БД
    {
        вернуть этот.разрешить(тип БД) как БД
    }

    публичный логгер(): ЛоггерИнтерфейс
    {
        вернуть этот.разрешить(тип ЛоггерИнтерфейс) как ЛоггерИнтерфейс
    }

    публичный задачи(): ХранилищеЗадач
    {
        вернуть этот.разрешить(тип ХранилищеЗадач) как ХранилищеЗадач
    }
}
