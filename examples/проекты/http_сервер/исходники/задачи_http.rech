использовать ответ_ошибки из "хелперы_ответов"
использовать Контейнер из "контейнер"
использовать тяжёлая_задача, ХранилищеЗадач, Задача из "воркер/воркер"
использовать ОтветЗадачи из "ответ_задачи"

/**
 * Обработчик POST /tasks (защищён "с_авторизацией") - заводит запись в
 * "ХранилищеЗадач" СИНХРОННО (чтобы GET .../статус сразу после этого
 * гарантированно нашёл id, а не поймал гонку с ещё не начавшимся
 * потоком), затем запускает "тяжёлая_задача" в отдельном потоке ОС
 * ("запустить") и немедленно отвечает id, не дожидаясь её завершения
 * ("дождаться" здесь принципиально не вызывается - иначе результат был бы
 * синхронным, а не фоновым).
 */
функция обработать_запуск_задачи(запрос: Запрос, имя_пользователя: Строка, контейнер: Контейнер): Ответ
{
    переменная id = имя_пользователя + "-" + (Строка) случайное_целое(0, 9999999999999999)
    переменная хранилище = контейнер.задачи()
    хранилище.начать(id)
    // 80000 - O(n) проверка простоты (не O(sqrt(n)), см. package doc
    // "воркер/воркер.rech") на каждое из n чисел даёт O(n^2) суммарно -
    // при n = 3000000 (изначальный выбор) это несколько ЧАСОВ, не секунд;
    // 80000^2 ~= 6.4*10^9 операций - несколько секунд, достаточно, чтобы
    // GET .../status застал "не готова" хотя бы раз при ручной проверке.
    переменная фон = запустить тяжёлая_задача(id, 80000, хранилище)
    переменная логгер = контейнер.логгер()
    логгер.инфо(имя_пользователя + " запустил задачу " + id)
    переменная тело = новый ОтветЗадачи()
    тело.id = id
    вернуть новый Ответ(HTTPКод.Принято, "Content-Type: application/json", сериализовать JSON тело)
}

/**
 * Достаёт значение параметра "id=..." из query-строки "путь" вручную,
 * через "позиция_в_строке"/"подстрока" - НЕ встроенная "параметры_пути"
 * (docs/SPEC.md, раздел 11). НАЙДЕННЫЙ БАГ: "параметры_пути" в программе,
 * где ГДЕ-ЛИБО ЕЩЁ есть хоть одно боксирование "(Значение) x" (рефлексия,
 * здесь она есть - JWT/DI-контейнер), генерирует C с типом-значением
 * "rech_T_slovar_of_stroka_stroka" там, где вызывающий код ожидает
 * указатель на него ("incompatible types when initializing type ... using
 * type ...") - воспроизведено на минимальном примере (два builtin'а без
 * иной связи между собой) отдельно от этого проекта.
 */
приватная функция значение_параметра(путь: Строка, имя: Строка): ?Строка
{
    переменная маркер = имя + "="
    переменная индекс_вопроса = позиция_в_строке(путь, "?")
    если индекс_вопроса < 0
    {
        вернуть Ничто
    }
    переменная запрос_часть = подстрока(путь, индекс_вопроса + 1, длина_строки(путь) - индекс_вопроса - 1)
    переменная начало = позиция_в_строке(запрос_часть, маркер)
    если начало < 0
    {
        вернуть Ничто
    }
    переменная от_значения = подстрока(запрос_часть, начало + длина_строки(маркер), длина_строки(запрос_часть) - начало - длина_строки(маркер))
    переменная конец_относительно = позиция_в_строке(от_значения, "&")
    если конец_относительно < 0
    {
        вернуть от_значения
    }
    вернуть подстрока(от_значения, 0, конец_относительно)
}

/** Обработчик GET /tasks/status?id=... (защищён "с_авторизацией"). */
функция обработать_статус_задачи(запрос: Запрос, имя_пользователя: Строка, контейнер: Контейнер): Ответ
{
    переменная id_параметр = значение_параметра(запрос.путь, "id")
    если id_параметр == Ничто
    {
        вернуть ответ_ошибки(HTTPКод.НеправильныйЗапрос, "не хватает параметра id")
    }
    // "если == Ничто { вернуть }" (ранний выход) НЕ сужает "id_параметр"
    // для остального тела функции - НАЙДЕННОЕ ОГРАНИЧЕНИЕ (docs/SPEC.md,
    // раздел 20 - сужение применяется только ВНУТРИ ветки "!= Ничто", не
    // после раннего "== Ничто") - "??" с недостижимым запасным значением
    // извлекает гарантированно непустую "Строка" явно, тот же приём, что и
    // у "гарантированная_задача" ниже.
    переменная хранилище = контейнер.задачи()
    переменная задача = хранилище.статус(id_параметр ?? "")
    если задача != Ничто
    {
        // "сериализовать JSON" не умеет принять "?Задача" напрямую (только
        // примитивы/сущности/Список<T>, не nullable-обёртку) - НАЙДЕННОЕ
        // ОГРАНИЧЕНИЕ: сужение "если задача != Ничто" на это НЕ
        // распространяется (в отличие от обычного присваивания/аргумента,
        // docs/SPEC.md, раздел 20) - "??" с недостижимым запасным
        // значением извлекает гарантированно ненулевую "Задача" явно.
        переменная гарантированная_задача = задача ?? новая Задача()
        вернуть новый Ответ(HTTPКод.ОК, "Content-Type: application/json", сериализовать JSON гарантированная_задача)
    }
    вернуть ответ_ошибки(HTTPКод.НеНайдено, "задача не найдена")
}
