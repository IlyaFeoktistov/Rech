/**
 * "ЛоггерИнтерфейс" - контракт логирования по уровням (docs/SPEC.md,
 * раздел 6, "Наследование и интерфейсы") - две независимые реализации,
 * "ФайловыйЛоггер"/"КонсольныйЛоггер" ниже, взаимозаменяемые за
 * интерфейсом через поле "Контейнер.логгер" (см. "контейнер.rech").
 * Живёт В ОТДЕЛЬНОМ ФАЙЛЕ, а не внутри "контейнер.rech" (как в более
 * ранней версии этого примера) - находка, ранее блокировавшая это
 * разделение, закрыта (Шаг 50): "использовать" теперь
 * умеет импортировать интерфейс из другого файла по имени, тем же
 * способом, что и функцию/сущность.
 */
интерфейс ЛоггерИнтерфейс
{
    инфо(сообщение: Строка)
    предупреждение(сообщение: Строка)
    ошибка(сообщение: Строка)
}

/**
 * Общее форматирование строки лога - "[ГГГГ-ММ-ДД ЧЧ:ММ:СС] [УРОВЕНЬ]
 * сообщение" - одно место для обеих реализаций (не дублировать между
 * "ФайловыйЛоггер"/"КонсольныйЛоггер").
 */
приватная функция отформатировать_запись(уровень: Строка, сообщение: Строка): Строка
{
    переменная метка_времени = дату_в_строку(время_как_дата(время()))
    вернуть "[" + метка_времени + "] [" + уровень + "] " + сообщение
}

/**
 * Пишет в файл "сервер.log" в рабочем каталоге, одна строка на сообщение.
 * "дописать_в_файл" - каждый вызов сам открывает/закрывает файл (в языке
 * нет отдельного постоянно открытого дескриптора для этого) - на сервере с
 * высокой частотой запросов это заметная стоимость на запись, известное
 * упрощение этого среза.
 */
сущность ФайловыйЛоггер реализует ЛоггерИнтерфейс
{
    имеет:
        приватный путь: Строка

    конструктор(путь: Строка)
    {
        этот.путь = путь
    }

    инфо(сообщение: Строка)
    {
        дописать_в_файл(этот.путь, отформатировать_запись("ИНФО", сообщение) + "\n")
    }

    предупреждение(сообщение: Строка)
    {
        дописать_в_файл(этот.путь, отформатировать_запись("ВНИМАНИЕ", сообщение) + "\n")
    }

    ошибка(сообщение: Строка)
    {
        дописать_в_файл(этот.путь, отформатировать_запись("ОШИБКА", сообщение) + "\n")
    }
}

/**
 * Пишет в стандартный вывод процесса - удобно для локальной разработки
 * (видно сразу в терминале, без "хвоста" файла лога отдельной командой).
 */
сущность КонсольныйЛоггер реализует ЛоггерИнтерфейс
{
    инфо(сообщение: Строка)
    {
        вывести отформатировать_запись("ИНФО", сообщение)
    }

    предупреждение(сообщение: Строка)
    {
        вывести отформатировать_запись("ВНИМАНИЕ", сообщение)
    }

    ошибка(сообщение: Строка)
    {
        вывести отформатировать_запись("ОШИБКА", сообщение)
    }
}
