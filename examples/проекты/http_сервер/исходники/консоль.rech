использовать Контейнер из "контейнер"

/**
 * Консоль управления - читает команды из стандартного ввода В ОТДЕЛЬНОМ
 * потоке ОС ("запустить консоль_управления(...)" в "сервер.rech"),
 * параллельно с основным циклом "принять"/"принять_http" на сокете -
 * настоящий, а не кооперативный, параллелизм (docs/SPEC.md, раздел 15):
 * два блокирующих чтения (stdin и accept) одновременно, каждое в своём
 * потоке. Оператор сервера может спросить текущее время или список
 * зарегистрированных пользователей, не останавливая обслуживание запросов.
 */
функция консоль_управления(контейнер: Контейнер)
{
    вывести `консоль управления: 'время', 'пользователи', 'выход'\n`
    пока истина {
        переменная команда = прочитать_строку()
        если команда == "время" {
            вывести `${"время сервера (UTC): " + дату_в_строку(время_как_дата(время()))}\n`
        } иначе {
            если команда == "пользователи" {
                переменная бд     = контейнер.бд()
                переменная строки = бд.запросить("SELECT username FROM users", новый Список<Значение>())
                переменная i      = 0
                пока i < строки.длина() {
                    переменная строка = строки.получить(i)
                    вывести `${"- " + (строка.получить("username") как Строка)}\n`
                    i = i + 1
                }
            } иначе {
                если команда == "выход" {
                    вернуть
                } иначе {
                    вывести `${`неизвестная команда "` + команда + `" - доступны 'время'/'пользователи'/'выход'`}\n`
                }
            }
        }
    }
}
