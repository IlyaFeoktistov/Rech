/**
 * Тело ответа POST /sum при успехе - "пользователь" пришёл из контекста
 * авторизации (middleware "с_авторизацией" передаёт имя вызвавшего
 * пользователя обработчику вторым аргументом, не как отдельная проверка
 * внутри самого обработчика).
 */
сущность Сумма
{
    имеет:
        значение:      Целое
        время_сервера: Целое
        пользователь:  Строка
}
