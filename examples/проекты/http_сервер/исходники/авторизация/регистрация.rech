использовать ответ_ошибки из "@http/хелперы_ответов"
использовать хешировать_пароль, сгенерировать_соль из "@бд/пароль"
использовать Контейнер из "@контейнер"
использовать ЗапросЛогина из "запрос_логина"
использовать УспешныйОтвет из "успешный_ответ"

/**
 * Обработчик POST /register - заводит нового пользователя (тело - то же
 * "имя"/"пароль", что и у /login, отдельной сущности не нужно). "username
 * TEXT PRIMARY KEY" (бд/бд.rech) сам защищает от повторной регистрации -
 * дублирующий INSERT падает ошибкой "выполнить" (ошибка нарушения
 * первичного ключа в тексте СУБД, не отдельный код), "выполнить" на такой
 * ошибке - аварийное завершение (в языке ещё нет исключений для
 * ошибок БД - известное ограничение этого среза), поэтому имя ПРОВЕРЯЕТСЯ
 * заранее отдельным SELECT, а не полагается на ошибку INSERT.
 */
функция обработать_регистрацию(запрос: Запрос, контейнер: Контейнер): Ответ
{
    попытаться {
        переменная данные = разобрать JSON запрос.тело как ЗапросЛогина
        если длина_строки(данные.имя) == 0 || длина_строки(данные.пароль) < 8 {
            вернуть ответ_ошибки(HTTPКод.НеправильныйЗапрос, "имя обязательно, пароль - не короче 8 символов")
        }

        переменная бд                 = контейнер.бд()
        переменная параметры_проверки = новый Список<Значение>()
        параметры_проверки.добавить((Значение) данные.имя)
        переменная существующие = запросить(бд, "SELECT username FROM users WHERE username = ?", параметры_проверки)
        если существующие.длина() > 0 {
            вернуть ответ_ошибки(HTTPКод.Конфликт, "пользователь с таким именем уже существует")
        }

        переменная соль      = сгенерировать_соль()
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) данные.имя)
        параметры.добавить((Значение) хешировать_пароль(данные.пароль, соль))
        параметры.добавить((Значение) соль)
        выполнить(бд, "INSERT INTO users (username, password_hash, salt) VALUES (?, ?, ?)", параметры)

        контейнер.логгер().инфо("новая регистрация: " + данные.имя)
        переменная тело = новый УспешныйОтвет()
        тело.успех = истина

        вернуть новый Ответ(HTTPКод.Создано, "Content-Type: application/json", сериализовать JSON тело)
    } поймать (иск: ОшибкаРазбора) {
        вернуть ответ_ошибки(HTTPКод.НеправильныйЗапрос, "некорректное тело запроса: " + иск.сообщение)
    }
}
