использовать ответ_ошибки из "@http/хелперы_ответов"
использовать создать_токен, проверить_токен из "@токен/токен"
использовать хешировать_пароль из "@бд/пароль"
использовать Контейнер из "@контейнер"
использовать ЗапросЛогина из "запрос_логина"
использовать УспешныйОтвет из "успешный_ответ"

// "приватная функция", не "константа" - НАЙДЕННАЯ АНОМАЛИЯ, см. package
// doc "токен/токен.rech" (тот же обход).
приватная функция api_ключ(): Строка
{
    вернуть "секретный-ключ-42"
}

/**
 * Определяет ИМЯ вошедшего пользователя по запросу - заголовок "X-Api-Key"
 * (точное совпадение через "содержит" - в языке нет разбора произвольного
 * заголовка по имени) даёт синтетическую личность "api-клиент"; иначе -
 * сессионный токен из cookie, проверенный подписью и сроком действия
 * (см. "токен/токен.rech") - БЕЗ обращения к БД: токен самодостаточен
 * (stateless), не ссылка на запись в таблице, как в прежней версии этого
 * примера. ?Строка - вместо отдельного булева "авторизован" сразу несёт
 * ЛИЧНОСТЬ вызвавшего (контекст, который дальше идёт в обработчик), Ничто -
 * если ни один способ не подтвердил личность.
 */
приватная функция имя_пользователя_по_токену(запрос: Запрос): ?Строка
{
    если содержит(запрос.заголовки, "X-Api-Key: " + api_ключ())
    {
        вернуть "api-клиент"
    }

    переменная токен = значение_куки(запрос, "session")
    если токен != Ничто
    {
        вернуть проверить_токен(токен)
    }
    вернуть Ничто
}

/**
 * Middleware: оборачивает "следующий" (обработчик, ожидающий уже
 * АУТЕНТИФИЦИРОВАННЫЙ контекст - имя пользователя вторым параметром) в
 * НОВУЮ лямбду совместимого с "Маршрутизатор" типа - без валидной
 * авторизации запрос до "следующий" не доходит вообще, вместо него - 401.
 * Обработчику не нужно САМОМУ проверять токен - middleware уже решило
 * "кто вызвал" и передаёт готовый результат дальше как контекст.
 *
 * "следующий" несёт только "Запрос, Строка" - "Контейнер" передаётся
 * дальше обычным замыканием, объявленным в "сервер.rech", а не третьим
 * параметром "Вызываемый" - решение читаемости (каждое middleware решает
 * свою узкую задачу, не перечисляет весь контекст программы в своей
 * сигнатуре), не обход ограничения компилятора: тип пользовательской
 * сущности внутри "Вызываемый(...)" из НЕ-entry файла (как этот) исправно
 * резолвится/переименовывается при связывании нескольких файлов
 * (internal/module/walk.go, resolveTypeRef).
 */
функция с_авторизацией(следующий: Вызываемый(Запрос, Строка): Ответ): Вызываемый(Запрос): Ответ
{
    вернуть функция(запрос: Запрос): Ответ
    {
        переменная имя = имя_пользователя_по_токену(запрос)
        если имя != Ничто
        {
            вернуть следующий(запрос, имя)
        }
        вернуть ответ_ошибки(HTTPКод.НеАвторизован, "требуется авторизация - войдите через /login, зарегистрируйтесь через /register или передайте X-Api-Key")
    }
}

/** Обработчик POST /login - проверяет пару имя/пароль ПО БД (хеш + соль,
 * см. "бд/пароль.rech"), выдаёт подписанный токен (не сравнивает пароль
 * как есть и не заводит запись в отдельной таблице сессий). */
функция обработать_логин(запрос: Запрос, контейнер: Контейнер): Ответ
{
    попытаться
    {
        переменная данные = разобрать JSON запрос.тело как ЗапросЛогина
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) данные.имя)
        переменная бд = контейнер.бд()
        переменная строки = запросить(бд, "SELECT password_hash, salt FROM users WHERE username = ?", параметры)
        если строки.длина() == 0
        {
            вернуть ответ_ошибки(HTTPКод.НеАвторизован, "неверное имя пользователя или пароль")
        }
        переменная строка = строки.получить(0)
        переменная соль = (строка.получить("salt") как Строка)
        переменная хеш_в_бд = (строка.получить("password_hash") как Строка)
        если хешировать_пароль(данные.пароль, соль) != хеш_в_бд
        {
            вернуть ответ_ошибки(HTTPКод.НеАвторизован, "неверное имя пользователя или пароль")
        }

        переменная куки = строка_куки("session", создать_токен(данные.имя), новые ОпцииКуки(путь: "/", только_http: истина))
        переменная тело = новый УспешныйОтвет()
        тело.успех = истина
        переменная логгер = контейнер.логгер()
        логгер.инфо("вход в систему: " + данные.имя)
        вернуть новый Ответ(HTTPКод.ОК, "Content-Type: application/json\r\n" + куки, сериализовать JSON тело)
    }
    поймать (иск: ОшибкаРазбора)
    {
        вернуть ответ_ошибки(HTTPКод.НеправильныйЗапрос, "некорректное тело запроса: " + иск.сообщение)
    }
}
