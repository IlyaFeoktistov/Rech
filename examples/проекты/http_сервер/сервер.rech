// HTTP-сервер с маршрутизатором и авторизацией: два маршрута -
// POST /login (выдаёт сессионную cookie по имени/паролю, проверенным по
// SQLite) и POST /sum (складывает два числа, возвращает время сервера и
// имя вызвавшего) - "/sum" закрыт middleware'ом: без входа (валидная
// cookie ИЛИ заголовок X-Api-Key) запрос до самого сложения не доходит
// вообще. Middleware сам решает, КТО вызвал (запросом к таблице
// "sessions"), и передаёт готовое имя обработчику вторым параметром -
// обработчику не нужно самому знать про cookie/заголовки/БД (см. package
// doc "авторизация.rech").
//
// Точка сборки программы: только "функция главная" здесь - остальное
// (сущности, маршрутизатор, БД, middleware авторизации) - в отдельных
// файлах, подключённых через "использовать" (docs/SPEC.md, "Импорты").
//
// Требует -lsqlite3 при сборке (docs/SPEC.md, "БД") - toolchain линкует
// его безусловно вместе с -lpq/-lmysqlclient, даже когда программа
// использует только SQLite - на системе без всех трёх клиентских
// библиотек сборка не слинкуется вообще.
//
// Проверить вручную (из этого каталога):
//   rech run
//   curl -i -X POST http://127.0.0.1:8080/sum -d '{"первое":2,"второе":3}'
//       -> 401, нет авторизации
//   curl -i -X POST http://127.0.0.1:8080/login -d '{"имя":"admin","пароль":"secret123"}'
//       -> 200, Set-Cookie: session=...
//   curl -i -X POST http://127.0.0.1:8080/sum -d '{"первое":2,"второе":3}' -b "session=<из предыдущего ответа>"
//       -> 200, {"значение":5,"время_сервера":...,"пользователь":"admin"}
//   curl -i -X POST http://127.0.0.1:8080/sum -d '{"первое":2,"второе":3}' -H "X-Api-Key: секретный-ключ-42"
//       -> 200, тот же результат через заголовок вместо cookie ("пользователь":"api-клиент")

использовать ЗапросЛогина из "запрос_логина"
использовать ЗапросСложения из "запрос_сложения"
использовать УспешныйОтвет из "успешный_ответ"
использовать Сумма из "сумма"
использовать ответ_ошибки из "хелперы_ответов"
использовать Маршрутизатор из "маршрутизатор"
использовать с_авторизацией из "авторизация"
использовать инициализировать_бд из "бд"

/** Обработчик POST /login - проверяет пару имя/пароль ПО БД, заводит
 * сессию (тоже строкой в БД, не в памяти процесса). */
функция обработать_логин(запрос: Запрос, бд: БД): Ответ
{
    попытаться
    {
        переменная данные = разобрать JSON запрос.тело как ЗапросЛогина
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) данные.имя)
        переменная строки = запросить(бд, "SELECT password FROM users WHERE username = ?", параметры)
        если строки.длина() == 0
        {
            вернуть ответ_ошибки(401, "неверное имя пользователя или пароль")
        }
        переменная строка = строки.получить(0)
        переменная пароль_в_бд = (строка.получить("password") как Строка)
        если пароль_в_бд != данные.пароль
        {
            вернуть ответ_ошибки(401, "неверное имя пользователя или пароль")
        }

        переменная токен = данные.имя + "-" + (Строка) случайное_целое(0, 9999999999999999)
        переменная параметры_сессии = новый Список<Значение>()
        параметры_сессии.добавить((Значение) токен)
        параметры_сессии.добавить((Значение) данные.имя)
        выполнить(бд, "INSERT INTO sessions (token, username) VALUES (?, ?)", параметры_сессии)

        переменная куки = строка_куки("session", токен, новые ОпцииКуки(путь: "/", только_http: истина))
        переменная тело = новый УспешныйОтвет()
        тело.успех = истина
        вернуть новый Ответ(200, "Content-Type: application/json\r\n" + куки, сериализовать JSON тело)
    }
    поймать (иск: ОшибкаРазбора)
    {
        вернуть ответ_ошибки(400, "некорректное тело запроса: " + иск.сообщение)
    }
}

/**
 * Обработчик POST /sum - складывает два числа из тела запроса. Получает
 * "имя_пользователя" КОНТЕКСТОМ от middleware "с_авторизацией" - сам не
 * проверяет и не знает, ЧЕМ пользователь подтвердил личность (cookie или
 * X-Api-Key), только использует уже готовый результат.
 */
функция обработать_сложение(запрос: Запрос, имя_пользователя: Строка): Ответ
{
    попытаться
    {
        переменная данные = разобрать JSON запрос.тело как ЗапросСложения
        переменная сумма = новая Сумма()
        сумма.значение = данные.первое + данные.второе
        сумма.время_сервера = время()
        сумма.пользователь = имя_пользователя
        вернуть новый Ответ(200, "Content-Type: application/json", сериализовать JSON сумма)
    }
    поймать (иск: ОшибкаРазбора)
    {
        вернуть ответ_ошибки(400, "некорректное тело запроса: " + иск.сообщение)
    }
}

функция главная
{
    // Единственный источник истины для пользователей/сессий - SQLite
    // (см. package doc "бд.rech"), не Словарь в памяти процесса.
    переменная бд = инициализировать_бд()

    переменная маршрутизатор = новый Маршрутизатор()
    маршрутизатор.зарегистрировать("POST", "/login", функция(запрос: Запрос): Ответ
    {
        вернуть обработать_логин(запрос, бд)
    })
    маршрутизатор.зарегистрировать("POST", "/sum", с_авторизацией(&обработать_сложение, бд))

    переменная слушатель = слушать_tcp(8080)
    вывести "слушаю порт 8080"

    пока истина
    {
        переменная соединение = принять(слушатель)
        переменная запрос = принять_http(соединение)
        переменная ответ = маршрутизатор.обработать(запрос)
        отправить_http_ответ(соединение, ответ)
        закрыть_сокет(соединение)
    }
}
