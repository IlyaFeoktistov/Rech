/**
 * Минимальный HTTP-сервер: слушает порт 8080, отвечает на "GET /ping"
 * JSON-телом {"success": true, "time": <unix-метка>} (собрано из DTO-
 * сущности через "сериализовать JSON", не строкой вручную), на всё
 * остальное - 404. Проверить вручную: rech run (из этого каталога) и в
 * другом окне curl http://127.0.0.1:8080/ping
 */
сущность ОтветPing
{
    имеет:
        success: Логическое
        time: Целое
}

функция главная
{
    переменная слушатель = слушать_tcp(8080)
    вывести "слушаю порт 8080"

    пока истина
    {
        переменная соединение = принять(слушатель)
        переменная запрос = принять_http(соединение)

        если запрос.метод == "GET" и запрос.путь == "/ping"
        {
            переменная данные = новый ОтветPing(истина, время())
            переменная тело = сериализовать JSON данные
            переменная ответ = новый Ответ(200, "Content-Type: application/json", тело)
            отправить_http_ответ(соединение, ответ)
        } иначе {
            переменная ответ = новый Ответ(404, "Content-Type: text/plain", "не найдено")
            отправить_http_ответ(соединение, ответ)
        }

        закрыть_сокет(соединение)
    }
}
