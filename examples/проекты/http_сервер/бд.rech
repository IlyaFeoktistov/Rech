/**
 * Инициализация SQLite-хранилища сервера: таблица "users" (демо-логин,
 * пароль хранится как есть - в языке пока нет крипто-хеш-функции,
 * docs/ROADMAP.md, в реальном сервисе так пароли не хранят) и "sessions"
 * (токен -> имя пользователя, кто вошёл). Единственный источник истины для
 * авторизации во ВСЕХ обработчиках сразу - в отличие от Словарь<Строка,
 * Строка> в памяти процесса (что и было в первой версии этого примера),
 * "БД" (rech_db_t*) - непрозрачный указатель на одно и то же соединение,
 * без риска разойтись на независимые копии при передаче в разные функции/
 * замыкания (см. package doc examples/проекты/http_сервер/сервер.rech про
 * найденный на этом баг компилятора с Словарь/Список - docs/ROADMAP.md).
 *
 * Имена таблиц/колонок - латиницей, тем же соглашением, что и
 * examples/бд/подключение.rech.
 */
функция инициализировать_бд(): БД
{
    переменная бд = подключиться_к_бд("sqlite::memory:")
    выполнить(бд, "CREATE TABLE users (username TEXT PRIMARY KEY, password TEXT)", новый Список<Значение>())
    выполнить(бд, "CREATE TABLE sessions (token TEXT PRIMARY KEY, username TEXT)", новый Список<Значение>())

    переменная параметры = новый Список<Значение>()
    параметры.добавить((Значение) "admin")
    параметры.добавить((Значение) "secret123")
    выполнить(бд, "INSERT INTO users (username, password) VALUES (?, ?)", параметры)

    вернуть бд
}
