использовать ответ_ошибки из "хелперы_ответов"

/**
 * Определяет ИМЯ вошедшего пользователя по запросу - заголовок "X-Api-Key"
 * (точное совпадение через "содержит" - в языке пока нет разбора
 * произвольного заголовка по имени, docs/ROADMAP.md) даёт синтетическую
 * личность "api-клиент"; иначе - сессионная cookie, проверенная запросом к
 * таблице "sessions" в БД (не Словарь в памяти процесса - см. package doc
 * "бд.rech"). ?Строка - вместо отдельного булева "авторизован" сразу несёт
 * ЛИЧНОСТЬ вызвавшего (контекст, который дальше идёт в обработчик), Ничто -
 * если ни один способ не подтвердил личность.
 */
приватная функция имя_пользователя_по_токену(запрос: Запрос, бд: БД): ?Строка
{
    константа API_КЛЮЧ = "секретный-ключ-42"
    если содержит(запрос.заголовки, "X-Api-Key: " + API_КЛЮЧ)
    {
        вернуть "api-клиент"
    }

    переменная токен = значение_куки(запрос, "session")
    если токен != Ничто
    {
        переменная параметры = новый Список<Значение>()
        // "(Значение) токен" напрямую не компилируется - явный каст не
        // учитывает доказанную здесь непустоту nullable-переменной (в
        // отличие от обычного присваивания/аргумента вызова), поэтому
        // непустое значение сначала достаётся через "??" (docs/ROADMAP.md).
        параметры.добавить((Значение) (токен ?? ""))
        переменная строки = запросить(бд, "SELECT username FROM sessions WHERE token = ?", параметры)
        если строки.длина() > 0
        {
            переменная строка = строки.получить(0)
            вернуть (строка.получить("username") как Строка)
        }
    }
    вернуть Ничто
}

/**
 * Middleware: оборачивает "следующий" (обработчик, ожидающий уже
 * АУТЕНТИФИЦИРОВАННЫЙ контекст - имя пользователя вторым параметром) в
 * НОВУЮ лямбду совместимого с "Маршрутизатор" типа - без валидной
 * авторизации запрос до "следующий" не доходит вообще, вместо него - 401.
 * Обработчику не нужно САМОМУ проверять логин - middleware уже решило
 * "кто вызвал" и передаёт готовый ответ дальше как контекст, а не как
 * повторную проверку внутри каждого защищённого маршрута.
 */
функция с_авторизацией(следующий: Вызываемый(Запрос, Строка): Ответ, бд: БД): Вызываемый(Запрос): Ответ
{
    вернуть функция(запрос: Запрос): Ответ
    {
        переменная имя = имя_пользователя_по_токену(запрос, бд)
        если имя != Ничто
        {
            вернуть следующий(запрос, имя)
        }
        вернуть ответ_ошибки(401, "требуется авторизация - войдите через /login или передайте X-Api-Key")
    }
}
