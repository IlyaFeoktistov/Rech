# Пример-проект: минимальный HTTP-сервер (rech build/run без явного пути к
# файлу - подхватывает этот .rechproj из текущего каталога).
проект:
  имя: http_сервер
  версия: 0.1.0

файлы:
  главный: исходники/сервер.rech
  выход: сборка

# Порт слушателя (определить_порт, сервер.rech) - вместо
# "RECH_HTTP_PORT=9090 rech run" перед каждым запуском.
окружение:
  RECH_HTTP_PORT: 8080
