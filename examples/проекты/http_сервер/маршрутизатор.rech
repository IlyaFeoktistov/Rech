использовать ответ_ошибки из "хелперы_ответов"

/**
 * Таблица маршрутов "МЕТОД путь" -> обработчик. Ключ - простая конкатенация
 * (не отдельный тип "Маршрут") - двух полей достаточно. Точное совпадение
 * по ключу - оба маршрута этого сервера принимают тело POST-запроса, а не
 * query-строку в пути, поэтому "путь" входящего запроса всегда совпадает с
 * зарегистрированным буквально (без query-строки маршрутизации по
 * подстроке/срезу пути не нужно - в языке и нет такой функции).
 */
сущность Маршрутизатор
{
    имеет:
        приватный маршруты: Словарь<Строка, Вызываемый(Запрос): Ответ>

    конструктор()
    {
        этот.маршруты = новый Словарь<Строка, Вызываемый(Запрос): Ответ>()
    }

    /** Регистрирует обработчик под ключом "метод путь" - "POST /login". */
    зарегистрировать(метод: Строка, путь: Строка, обработчик: Вызываемый(Запрос): Ответ)
    {
        этот.маршруты.установить(метод + " " + путь, обработчик)
    }

    /** Находит и вызывает обработчик для запроса - 404, если такого маршрута нет. */
    обработать(запрос: Запрос): Ответ
    {
        переменная ключ = запрос.метод + " " + запрос.путь
        если этот.маршруты.содержит(ключ)
        {
            переменная обработчик = этот.маршруты.получить(ключ)
            вернуть обработчик(запрос)
        }
        вернуть ответ_ошибки(404, "маршрут не найден")
    }
}
