# Пример-проект: условная компиляция по платформе на уровне ЦЕЛОГО файла
# (docs/SPEC.md) - главный.rech использует "получить_значение из "значение""
# без указания платформы - резолвинг импорта сам выбирает
# значение_linux.rech/значение_windows.rech под текущую платформу сборки.
#
# "сборка.библиотеки_linux"/"сборка.библиотеки_windows" - у КАЖДОЙ
# платформы своя внешняя библиотека (libm/kernel32) - без разбивки по
# платформе линковщик пытался бы найти ОБЕ сразу, даже ту, чьё объявление
# вообще не попадает в эту сборку (значение_windows.rech никогда не читается
# при сборке под Linux, и наоборот).
проект:
  имя: условная_компиляция
  версия: 0.1.0

файлы:
  исходники: "*.rech"
  главный: главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки_linux: m
  библиотеки_windows: kernel32
