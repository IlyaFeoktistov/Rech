# Пример-проект: TCP-сканер портов - диапазон портов делится на пачки по
# 256, каждая пачка сканируется в отдельной задаче ("запустить"), результаты
# собираются через "дождаться" - демонстрирует "Список<Задача<Сканирование>>":
# один список хранит дескрипторы ВСЕХ запущенных задач одной сигнатуры,
# чтобы дождаться каждую по очереди (docs/SPEC.md, разделы 8, 15 и 29).
проект:
  имя: сканер_портов
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка
