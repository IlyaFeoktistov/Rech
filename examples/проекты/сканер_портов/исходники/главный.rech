использовать сетевой_узел, СетевойПротокол, закрыть_сокет из стандарт/сеть

// Коды завершения: 0 - успех, 2 - неверные аргументы командной строки.
константа КОД_УСПЕХА           = 0
константа КОД_НЕВЕРНОГО_ВЫЗОВА = 2

/** Проверка одного диапазона портов: хост, начало, конец -> открытые порты. */
синоним Сканирование = Вызываемый(Строка, Целое, Целое): Список<Целое>

/**
 * Проверяет диапазон TCP-портов на хосте.
 */
функция сканировать_диапазон(
    хост: Строка,
    начало: Целое,
    конец: Целое,
): Список<Целое> {
    переменная открытые = новый Список<Целое>()

    переменная порт = начало

    пока порт <= конец {
        попытаться {
            переменная сокет = сетевой_узел(
                СетевойПротокол.TCP,
                хост,
                порт,
            )

            открытые.добавить(порт)
            закрыть_сокет(сокет)
        } поймать(ошибка: ОшибкаСети) {
            // Порт закрыт или соединение не удалось.
        }

        порт += 1
    }

    вернуть открытые
}

/**
 * TCP-сканер портов - диапазон делится на пачки по 256 портов, каждая
 * пачка сканируется в отдельной задаче ("запустить сканировать_диапазон"),
 * все задачи одной сигнатуры собираются в ОДИН "Список<Задача<Сканирование>>"
 * (docs/SPEC.md, разделы 8, 15 и 29) - затем дожидается каждая по очереди, а
 * найденные открытые порты объединяются в общий список.
 */
функция главная(аргументы: Список<Строка>): Целое
{
    если аргументы.длина() < 1 {
        вывести `Использование: сканер <хост> [начало] [конец]\n`

        вернуть КОД_НЕВЕРНОГО_ВЫЗОВА
    }

    переменная хост = аргументы.первый()

    переменная начало = 1
    переменная конец  = 65535

    если аргументы.длина() >= 2 {
        начало = (Целое) аргументы.получить(1)
    }

    если аргументы.длина() >= 3 {
        конец = (Целое) аргументы.получить(2)
    }

    если начало < 1 {
        начало = 1
    }

    если конец > 65535 {
        конец = 65535
    }

    если начало > конец {
        вывести `Неверный диапазон портов\n`

        вернуть КОД_НЕВЕРНОГО_ВЫЗОВА
    }

    вывести `Сканирование ${хост}: ${начало}-${конец}\n`

    переменная задачи = новый Список<Задача<Сканирование>>()

    // По 256 портов на один поток.
    переменная размер_пачки = 256
    переменная текущий      = начало

    пока текущий <= конец {
        переменная конец_пачки = текущий + размер_пачки - 1

        если конец_пачки > конец {
            конец_пачки = конец
        }

        переменная задача = запустить сканировать_диапазон(
            хост,
            текущий,
            конец_пачки,
        )

        задачи.добавить(задача)

        текущий = конец_пачки + 1
    }

    переменная открытые = новый Список<Целое>()

    для задача в задачи {
        переменная результат = дождаться задача

        для порт в результате {
            открытые.добавить(порт)
        }
    }

    вывести `\n`
    вывести `Открытые TCP-порты:\n`

    если открытые.пусто() {
        вывести `не найдены\n`

        вернуть КОД_УСПЕХА
    }

    для порт в открытые {
        вывести `порт ${порт}\n`
    }
    вернуть КОД_УСПЕХА
}
