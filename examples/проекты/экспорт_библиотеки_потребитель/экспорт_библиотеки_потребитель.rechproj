# Пример-проект: потребитель библиотеки, написанной на Rech (examples/
# проекты/экспорт_библиотеки/ РЯДОМ - собрать сначала ЕЁ, ПОТОМ этот
# проект, порядок важен - линковщик ищет уже готовый .so/.dylib/.dll).
#
# "сборка.библиотеки: экспорт_библиотеки" - "-lэкспорт_библиотеки" для
# cc/ld (docs/SPEC.md, раздел 12) - ищет "libэкспорт_библиотеки.so".
# "путь_библиотек:" ниже указывает, ГДЕ искать - помимо стандартных
# системных путей линковщика - без него пришлось бы вручную выставлять
# LIBRARY_PATH (сборка)/LD_LIBRARY_PATH (запуск) перед каждым "rech
# build/run" или устанавливать библиотеку в систему. На Linux/macOS этот
# путь ЕЩЁ и зашивается в сам бинарник как rpath - готовый бинарник
# находит библиотеку сам при запуске, без переменных окружения вовсе
# (на Windows аналога rpath у DLL нет - см. docs/SPEC.md).
проект:
  имя: экспорт_библиотеки_потребитель
  версия: 0.1.0

файлы:
  исходники: *.rech
  главный: главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки: экспорт_библиотеки
  путь_библиотек: ../экспорт_библиотеки/сборка
