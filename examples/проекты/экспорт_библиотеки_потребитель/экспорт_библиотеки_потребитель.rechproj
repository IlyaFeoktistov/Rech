# Пример-проект: потребитель библиотеки, написанной на Rech (examples/
# проекты/экспорт_библиотеки/ РЯДОМ - собрать сначала ЕЁ, ПОТОМ этот
# проект, порядок важен - линковщик ищет уже готовый .so/.dylib/.dll).
#
# "сборка.библиотеки: экспорт_библиотеки" - "-lэкспорт_библиотеки" для
# cc/ld (docs/SPEC.md, раздел 12) - ищет "libэкспорт_библиотеки.so" В
# СТАНДАРТНЫХ путях линковщика (системные каталоги библиотек, плюс то,
# что перечислено в переменных окружения LIBRARY_PATH при сборке/
# LD_LIBRARY_PATH при запуске - .rechproj пока не умеет указывать
# ПРОИЗВОЛЬНЫЙ локальный путь к библиотеке напрямую, docs/ROADMAP.md).
# Библиотека этого примера собрана РЯДОМ, не системно установлена -
# соберите и запустите так (или см. check_examples.sh в корне репозитория,
# который делает то же самое автоматически для ВСЕХ примеров разом):
#
#   LIBRARY_PATH=../экспорт_библиотеки/сборка \
#   LD_LIBRARY_PATH=../экспорт_библиотеки/сборка \
#   rech run
проект:
  имя: экспорт_библиотеки_потребитель
  версия: 0.1.0

файлы:
  исходники: "*.rech"
  главный: главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки: экспорт_библиотеки
