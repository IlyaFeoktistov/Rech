# Пример-проект: потребитель закрытого (бинарного) Rech-пакета (docs/
# SPEC.md, "Закрытые (бинарные) пакеты") - examples/проекты/
# закрытый_пакет/ РЯДОМ, уже собранный в libзакрытый_пакет.so/.dylib/.dll
# (собрать сначала ЕГО, потом этот проект - порядок важен, как и у
# examples/проекты/экспорт_библиотеки_потребитель/). В отличие от того
# примера, главный.rech здесь - буквальная копия автогенерированного
# .rechi (см. его комментарий), без единой ручной "внешняя ..."-строки.
#
# "сборка.библиотеки"/"путь_библиотек" ниже - ровно то же самое, что и у
# examples/проекты/экспорт_библиотеки_потребитель/ (см. её package doc) -
# при настоящей поставке через "зависимости:" оба поля были бы не нужны
# вовсе: internal/pkgfetch собирает их автоматически из *.rechproj самого
# пакета (docs/SPEC.md).
проект:
  имя: закрытый_пакет_потребитель
  версия: 0.1.0

файлы:
  главный: главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки: закрытый_пакет
  путь_библиотек: ../закрытый_пакет/сборка
