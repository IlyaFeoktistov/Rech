# Пример-проект: секция "опции:" (docs/SPEC.md, раздел 12.2) - СЫРОЙ,
# ПОЛНОЦЕННЫЙ YAML (в отличие от остальных секций этого файла - списки,
# произвольная вложенность, кавычки) - программа сама решает, во что его
# превратить, через уже существующее "разобрать YAML опции_проекта() как
# <Тип>", а не через отдельный API по строковым ключам.
проект:
  имя: опции_проекта
  версия: 0.1.0

файлы:
  главный: главный.rech
  выход: сборка

опции:
  почта:
    хост: smtp.example.com
    порт: 587
    адреса:
      - admin@example.com
      - ops@example.com
