// Секция "опции:" .rechproj - произвольный, ПОЛНОЦЕННЫЙ YAML (списки,
// вложенность, в отличие от остального файла проекта) - "опции_проекта()"
// отдаёт его как есть, программа сама разбирает через УЖЕ существующее
// "разобрать YAML ... как <Тип>" (docs/SPEC.md, раздел 18) - schema-first,
// без отдельного API по строковым ключам.
сущность Почта
{
    имеет:
        публичный хост:   Строка
        публичный порт:   Целое
        публичные адреса: Список<Строка>
}

сущность КонфигПроекта
{
    имеет:
        публичная почта: Почта
}

/**
 * Читает секцию "опции:" через "разобрать YAML", меняет значение и
 * показывает, что "установить_опции_проекта" видно СРАЗУ следующим
 * "опции_проекта()" - но только в памяти ЭТОГО запуска (PHP ini_set-стиль),
 * .rechproj на диске не меняется - следующий запуск снова увидит порт 587.
 */
функция главная
{
    переменная конфигурация = разобрать YAML опции_проекта() как КонфигПроекта
    вывести `${конфигурация.почта.хост}:${конфигурация.почта.порт}\n`
    переменная адреса = конфигурация.почта.адреса
    для i от 0 до адреса.длина() - 1 {
        вывести `- ${адреса.получить(i)}\n`
    }

    конфигурация.почта.порт = 2525
    установить_опции_проекта(сериализовать YAML конфигурация)

    переменная обновлённый = разобрать YAML опции_проекта() как КонфигПроекта
    вывести `новый порт (только в этой сессии): ${обновлённый.почта.порт}\n`
}
