# Пример-проект: центр уведомлений - сервер держит МНОГО одновременно
# открытых, по большей части простаивающих TCP-соединений на ОДНОМ потоке
# ОС ("асинхронная функция" + "поручить") - см.
# package doc исходники/главный.rech. rech build/run без явного пути к
# файлу подхватывает этот .rechproj из текущего каталога.
проект:
  имя: центр_уведомлений
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка
