использовать обслужить_подписчика из "подписчик"

/**
 * Основной цикл приёма подключений - "принять" внутри "асинхронная
 * функция" тоже корутино-осведомлено (Шаг 132): не занимает поток ОС в
 * ожидании следующего клиента. "поручить" (не "дождаться") - решающая
 * часть: обработка ПРИНЯТОГО соединения запускается ФОНОВО и НЕ
 * блокирует этот цикл - он сразу же возвращается к "принять" за
 * следующим клиентом, пока предыдущие ждут своих событий где-то на
 * epoll/kqueue. Без "поручить" (просто "дождаться обслужить_подписчика(...)"
 * здесь) цикл обслуживал бы подписчиков по очереди, один за другим -
 * ни один новый клиент не был бы принят, пока предыдущий не закрыл
 * соединение (см. package doc главный.rech).
 */
асинхронная функция слушать_подключения(слушатель: Сокет)
{
    пока истина {
        переменная соединение     = (Сокет) слушатель.принять()
        переменная фоновая_задача = поручить обслужить_подписчика(соединение)
    }
}
