/**
 * Обслуживает ОДНОГО подписчика: ждёт от него одно событие (без реального
 * протокола - просто строка, для примера), подтверждает получение и
 * закрывает соединение. Ожидание "получить" внутри "асинхронная функция" -
 * корутино-осведомлённое (Шаг 132): не блокирует поток ОС, пока подписчик
 * ничего не присылает - именно это и позволяет держать открытыми тысячи
 * таких соединений одновременно на одном потоке (см. package doc
 * главный.rech).
 */
асинхронная функция обслужить_подписчика(соединение: Сокет)
{
    переменная событие = соединение.получить(1024)
    соединение.отправить("принято: " + событие)
    соединение.закрыть()
}
