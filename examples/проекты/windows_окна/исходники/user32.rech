// FFI-биндинги к WinAPI (user32.dll/gdi32.dll/kernel32.dll) - только
// объявления (структуры/функции), без единой строчки логики. Собраны в
// отдельном файле, чтобы главный.rech и обработчик_окна.rech не путали
// "как позвать WinAPI" и "что с ним делать" - см. docs/SPEC.md, раздел 12
// (FFI) и раздел 22 (Указатель<T>).
//
// "Указатель<Байт>" здесь - универсальный непрозрачный C-хендл (HWND/HDC/
// HINSTANCE/...) - Rech не различает их номинально, только по размеру
// (адрес), да и сам WinAPI внутри тоже просто разные struct-теги над одним
// и тем же понятием "адрес". "Ничто" (раздел 22) - буквальный NULL для
// любого из них, без ручного "адреса нулевой переменной".

// WNDCLASSW - "W" (Unicode) вариант: имя класса и меню - буферы UTF-16LE
// (юникод.rech, в_utf16), не "Строка" (та была бы UTF-8 байтами).
внешняя структура WNDCLASSW как ОконныйКласс
{
    имеет:
        стиль:                       Натуральное32
        обработчик:                  Вызываемый(Указатель<Байт>, Натуральное32, Целое, Целое): Целое
        дополнительные_байты_класса: Целое32
        дополнительные_байты_окна:   Целое32
        экземпляр:                   Указатель<Байт>
        значок:                      Указатель<Байт>
        курсор:                      Указатель<Байт>
        кисть:                       Указатель<Байт>
        меню:                        Указатель<Байт>
        имя_класса:                  Указатель<Байт>
}

// libc - под буферы PAINTSTRUCT/MSG/текста (WinAPI ожидает адрес готовой
// памяти нужного размера, не заводит её сам).
внешняя функция malloc как выделить(размер: Целое): Указатель<Байт>
внешняя функция free как освободить(блок: Указатель<Байт>)

внешняя функция GetModuleHandleW как получить_модуль(
    имя: Указатель<Байт>,
): Указатель<Байт>

внешняя функция RegisterClassW как зарегистрировать_класс(
    оконный_класс: Указатель<ОконныйКласс>,
): Натуральное16

// Одна и та же функция создаёт и главное окно, и дочерние элементы
// (кнопки/поле ввода/подписи - по имени системного класса, элементы_окна.rech).
внешняя функция CreateWindowExW как создать_окно(
    расширенный_стиль: Натуральное32,
    имя_класса: Указатель<Байт>,
    заголовок: Указатель<Байт>,
    стиль: Натуральное32,
    x: Целое32,
    y: Целое32,
    ширина: Целое32,
    высота: Целое32,
    родительское_окно: Указатель<Байт>,
    меню: Указатель<Байт>,
    экземпляр: Указатель<Байт>,
    параметры: Указатель<Байт>,
): Указатель<Байт>

внешняя функция ShowWindow как показать_окно(
    окно: Указатель<Байт>,
    режим: Целое32,
): Логическое

внешняя функция UpdateWindow как обновить_окно(
    окно: Указатель<Байт>,
): Логическое

внешняя функция GetMessageW как получить_сообщение(
    сообщение: Указатель<Байт>,
    окно: Указатель<Байт>,
    минимум: Натуральное32,
    максимум: Натуральное32,
): Целое32

внешняя функция TranslateMessage как перевести_сообщение(
    сообщение: Указатель<Байт>,
): Логическое

внешняя функция DispatchMessageW как отправить_сообщение(
    сообщение: Указатель<Байт>,
): Целое

внешняя функция BeginPaint как начать_рисование(
    окно: Указатель<Байт>,
    окраска: Указатель<Байт>,
): Указатель<Байт>

внешняя функция EndPaint как закончить_рисование(
    окно: Указатель<Байт>,
    окраска: Указатель<Байт>,
): Логическое

// "текст" - буфер UTF-16LE (юникод.rech, в_utf16), "длина" - в WCHAR.
внешняя функция TextOutW как вывести_текст(
    контекст: Указатель<Байт>,
    x: Целое32,
    y: Целое32,
    текст: Указатель<Байт>,
    длина: Целое32,
): Логическое

внешняя функция PostQuitMessage как завершить_сообщения(
    код: Целое32,
)

внешняя функция DefWindowProcW как стандартная_обработка(
    окно: Указатель<Байт>,
    сообщение: Натуральное32,
    параметр1: Целое,
    параметр2: Целое,
): Целое

// Дочерний элемент по его идентификатору (GWLP_ID, константы_winapi.rech).
внешняя функция GetDlgItem как найти_элемент(
    окно: Указатель<Байт>,
    идентификатор: Целое32,
): Указатель<Байт>

// Ячейки окна (индексы GWLP_* в константы_winapi.rech): идентификатор
// элемента и свободная ячейка под данные программы (счётчик нажатий).
внешняя функция GetWindowLongPtrW как прочитать_ячейку_окна(
    окно: Указатель<Байт>,
    индекс: Целое32,
): Целое

внешняя функция SetWindowLongPtrW как записать_ячейку_окна(
    окно: Указатель<Байт>,
    индекс: Целое32,
    значение: Целое,
): Целое

// Текст элемента - буферы UTF-16LE; "размер_буфера" - в WCHAR, с
// завершающим нулём.
внешняя функция GetWindowTextW как прочитать_текст_окна(
    окно: Указатель<Байт>,
    буфер: Указатель<Байт>,
    размер_буфера: Целое32,
): Целое32

внешняя функция SetWindowTextW как записать_текст_окна(
    окно: Указатель<Байт>,
    текст: Указатель<Байт>,
): Логическое

внешняя функция SendMessageW как отправить_элементу(
    окно: Указатель<Байт>,
    сообщение: Натуральное32,
    параметр1: Указатель<Байт>,
    параметр2: Целое,
): Целое

внешняя функция GetSysColorBrush как системная_кисть(
    индекс_цвета: Целое32,
): Указатель<Байт>

внешняя функция GetStockObject как стандартный_объект(
    индекс: Целое32,
): Указатель<Байт>

// Рисование текста в контексте устройства (gdi32.dll): режим фона и
// выбор шрифта (возвращают прежние значения - здесь не нужны).
внешняя функция SetBkMode как режим_фона(
    контекст: Указатель<Байт>,
    режим: Целое32,
): Целое32

внешняя функция SelectObject как выбрать_объект(
    контекст: Указатель<Байт>,
    объект: Указатель<Байт>,
): Указатель<Байт>

// Миллисекунды с запуска Windows - демонстрирует, что обработчик окна
// свободно вызывает ЛЮБУЮ внешнюю функцию, не только "рисующие" (раздел
// WM_PAINT в обработчик_окна.rech).
внешняя функция GetTickCount как тиков_с_запуска(): Натуральное32
