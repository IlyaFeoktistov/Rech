// Окно WinAPI есть только на Windows: на другой ОС программа собирается из
// ветки "#иначе" и только сообщает об этом - биндинги user32.rech и
// заголовок windows.h в такую сборку не попадают вовсе (docs/SPEC.md,
// раздел 27 "Условная компиляция по платформе").
#если ОС.Windows {
    использовать ОконныйКласс, получить_модуль, зарегистрировать_класс, создать_окно,
    показать_окно, обновить_окно, выделить, освободить, получить_сообщение,
    перевести_сообщение, отправить_сообщение, системная_кисть из "user32"
    использовать обработать_окно из "обработчик_окна"
    использовать создать_элементы из "элементы_окна"
    использовать в_utf16 из "юникод"
    использовать CS_HREDRAW, CS_VREDRAW, WS_OVERLAPPEDWINDOW, WS_EX_NONE, SW_SHOW, COLOR_BTNFACE,
    РАЗМЕР_MSG из "константы_winapi"

    константа ИМЯ_КЛАССА      = "RechWindow"
    константа ЗАГОЛОВОК_ОКНА  = "Моё первое окно на Rech"
    константа ОКНО_X          = (Целое32) 100
    константа ОКНО_Y          = (Целое32) 100
    константа ОКНО_ШИРИНА     = (Целое32) 800
    константа ОКНО_ВЫСОТА     = (Целое32) 600
    константа БЕЗ_ДОП_БАЙТ    = (Целое32) 0
    // GetMessageW: 0 - WM_QUIT, -1 - ошибка; продолжать, пока больше нуля.
    константа КОНЕЦ_СООБЩЕНИЙ = (Целое32) 0
    // Фильтр GetMessageW "любые сообщения" (минимум = максимум = 0).
    константа ВСЕ_СООБЩЕНИЯ   = (Натуральное32) 0

    /**
     * Настоящее окно Windows через FFI, без единой строчки C - только
     * "внешняя функция"/"внешняя структура" (user32.rech) поверх user32.dll/
     * gdi32.dll/kernel32.dll: кнопка "+1" со счётчиком, поле ввода и кнопка
     * "Ввод" (элементы_окна.rech). Логика окна - обработчик_окна.rech, здесь -
     * только регистрация класса, создание окна и цикл сообщений (docs/SPEC.md,
     * раздел 12 "FFI"/раздел 22 "Указатели"/раздел 17 "Вызываемый").
     *
     * Все вызовы - "W"-варианты WinAPI (UTF-16, юникод.rech): кириллица в
     * заголовке, подписях и поле ввода не зависит от кодовой страницы системы.
     */
    публичная функция главная()
    {
        // "Ничто" - настоящий NULL: GetModuleHandleW(NULL) - дескриптор
        // ТЕКУЩЕГО процесса, не поиск загруженного модуля по имени.
        Указатель<Байт> экземпляр  = получить_модуль(Ничто)
        Указатель<Байт> имя_класса = в_utf16(ИМЯ_КЛАССА)
        Указатель<Байт> заголовок  = в_utf16(ЗАГОЛОВОК_ОКНА)

        ОконныйКласс оконный_класс = новый ОконныйКласс(
            CS_HREDRAW | CS_VREDRAW,
            &обработать_окно,
            БЕЗ_ДОП_БАЙТ,
            БЕЗ_ДОП_БАЙТ,
            экземпляр,
            Ничто,
            Ничто,
            системная_кисть(COLOR_BTNFACE),
            Ничто,
            имя_класса,
        )
        зарегистрировать_класс(&оконный_класс)

        Указатель<Байт> окно = создать_окно(
            WS_EX_NONE,
            имя_класса,
            заголовок,
            WS_OVERLAPPEDWINDOW,
            ОКНО_X,
            ОКНО_Y,
            ОКНО_ШИРИНА,
            ОКНО_ВЫСОТА,
            Ничто,
            Ничто,
            экземпляр,
            Ничто,
        )
        создать_элементы(окно, экземпляр)

        показать_окно(окно, SW_SHOW)
        обновить_окно(окно)

        Указатель<Байт> сообщение = выделить(РАЗМЕР_MSG)
        пока получить_сообщение(сообщение, Ничто, ВСЕ_СООБЩЕНИЯ, ВСЕ_СООБЩЕНИЯ) > КОНЕЦ_СООБЩЕНИЙ {
            перевести_сообщение(сообщение)
            отправить_сообщение(сообщение)
        }

        освободить(сообщение)
        освободить(заголовок)
        освободить(имя_класса)
    }
} #иначе {
    константа ТОЛЬКО_WINDOWS = "Этот пример открывает окно WinAPI и работает только на Windows"

    /** На других ОС окна WinAPI нет - программа только сообщает об этом. */
    публичная функция главная()
    {
        вывести `${ТОЛЬКО_WINDOWS}\n`
    }
}
