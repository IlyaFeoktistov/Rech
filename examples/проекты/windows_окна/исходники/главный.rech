использовать ОконныйКласс, получить_модуль, зарегистрировать_класс, создать_окно,
показать_окно, обновить_окно, выделить, освободить, получить_сообщение,
перевести_сообщение, отправить_сообщение из "user32"
использовать обработать_окно из "обработчик_окна"
использовать CS_HREDRAW_VREDRAW, WS_OVERLAPPEDWINDOW, SW_SHOW из "константы_winapi"

/**
 * Настоящее окно Windows через FFI, без единой строчки C - только
 * "внешняя функция"/"внешняя структура" (user32.rech) поверх user32.dll/
 * gdi32.dll/kernel32.dll. Логика окна - обработчик_окна.rech, здесь -
 * только регистрация класса, создание окна и цикл сообщений (docs/SPEC.md,
 * раздел 12 "FFI"/раздел 22 "Указатели"/раздел 17 "Вызываемый").
 *
 * Требует сборку под Windows ("сборка.библиотеки: user32, gdi32" в
 * windows_окна.rechproj) - на Linux/macOS не соберётся (нет самих
 * user32.dll/gdi32.dll).
 *
 * Заголовок окна и текст внутри него (обработчик_окна.rech) - латиницей
 * НАМЕРЕННО: CreateWindowExA/TextOutA - "A"-варианты WinAPI (ANSI, не
 * Unicode), ожидают байты в системной кодовой странице (CP1251 и т. п.), а
 * строковый литерал Rech - всегда UTF-8 - переданный как есть, кириллический
 * текст в этих двух местах превратился бы в "кракозябры" НА ЛЮБОЙ системе
 * (несовпадение самой кодировки байт, не кодовой страницы) - "W"-варианты
 * (CreateWindowExW/TextOutW) исправили бы это, но потребовали бы отдельной
 * конвертации UTF-8 -> UTF-16, которой в этом примере нет.
 */
функция главная
{
    // "Ничто" - настоящий NULL: GetModuleHandleA(NULL) - дескриптор
    // ТЕКУЩЕГО процесса, не поиск загруженного модуля по имени (раздел 22
    // SPEC.md - без "Ничто" передать буквальный NULL было бы нечем).
    переменная экземпляр = получить_модуль(Ничто)

    переменная оконный_класс = новый ОконныйКласс(
        CS_HREDRAW_VREDRAW,
        &обработать_окно,
        (Символ) 0,
        (Символ) 0,
        экземпляр,
        Ничто,
        Ничто,
        Ничто,
        "main",
        "RechWindow",
    )
    зарегистрировать_класс(&оконный_класс)

    переменная окно = создать_окно(
        (Символ) 0,
        "RechWindow",
        "My first Rech window",
        WS_OVERLAPPEDWINDOW,
        (Символ) 100,
        (Символ) 100,
        (Символ) 800,
        (Символ) 600,
        Ничто,
        Ничто,
        экземпляр,
        Ничто,
    )

    показать_окно(окно, SW_SHOW)
    обновить_окно(окно)

    // MSG на Windows x64 занимает 48 байт.
    переменная сообщение = выделить(48)

    пока получить_сообщение(сообщение, Ничто, (Символ) 0, (Символ) 0) > (Символ) 0 {
        перевести_сообщение(сообщение)
        отправить_сообщение(сообщение)
    }

    освободить(сообщение)
}
