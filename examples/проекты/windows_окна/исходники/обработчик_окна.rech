использовать выделить, освободить, начать_рисование, закончить_рисование, вывести_текст,
уничтожить_окно, завершить_сообщения, стандартная_обработка, тиков_с_запуска из "user32"
использовать WM_PAINT, WM_LBUTTONDOWN, WM_DESTROY из "константы_winapi"

/**
 * Оконная процедура (WndProc) - обычная Rech-функция, переданная в
 * ОконныйКласс.обработчик (главный.rech) как "&обработать_окно". Windows
 * зовёт её сама на каждое сообщение цикла - раздел 17 SPEC.md ("Вызываемый"
 * как значение) и раздел 12 (колбэк из C в Rech).
 */
функция обработать_окно(
    окно: Указатель<Байт>,
    сообщение: Символ,
    параметр1: Целое,
    параметр2: Целое,
): Целое {
    // Перерисовать содержимое окна.
    если сообщение == WM_PAINT {
        // PAINTSTRUCT на Windows x64 занимает 72 байта.
        переменная окраска = выделить(72)
        переменная контекст = начать_рисование(окно, окраска)

        // ASCII, чтобы пример не зависел от системной кодовой страницы.
        вывести_текст(контекст, (Символ) 40, (Символ) 40, "Hello, Rech!", (Символ) 12)

        // Латиницей по той же причине, что и "Hello, Rech!" выше -
        // TextOutA не понимает UTF-8 (главный.rech, doc-комментарий).
        переменная тиков   = (Строка) тиков_с_запуска()
        переменная строка2 = "Windows uptime, ms: " + тиков
        вывести_текст(контекст, (Символ) 40, (Символ) 60, строка2, (Символ) длина_строки(строка2))

        закончить_рисование(окно, окраска)
        освободить(окраска)

        вернуть 0
    }

    // Щелчок левой кнопкой мыши закрывает окно (обычный "уничтожить_окно"
    // запускает WM_DESTROY ниже, тот же путь, что и системный крестик в
    // заголовке).
    если сообщение == WM_LBUTTONDOWN {
        уничтожить_окно(окно)
        вернуть 0
    }

    // Окно уже уничтожено, пора остановить цикл сообщений (главный.rech).
    если сообщение == WM_DESTROY {
        завершить_сообщения((Символ) 0)
        вернуть 0
    }

    вернуть стандартная_обработка(окно, сообщение, параметр1, параметр2)
}
