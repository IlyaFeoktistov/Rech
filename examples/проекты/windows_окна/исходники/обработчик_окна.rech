использовать выделить, освободить, начать_рисование, закончить_рисование,
вывести_текст_юникод, уничтожить_окно, завершить_сообщения, стандартная_обработка,
тиков_с_запуска из "user32"
использовать WM_PAINT, WM_LBUTTONDOWN, WM_DESTROY из "константы_winapi"
использовать в_utf16 из "юникод"

// Расположение текста в окне (TextOutA - x/y в пикселях от левого верхнего
// угла клиентской области) - именованы, не голыми числами внутри
// обработать_окно ниже, чтобы поменять расположение/добавить строку можно
// было в одном месте.
константа ОТСТУП_СЛЕВА = (Символ) 40
константа СТРОКА_1_Y   = (Символ) 40
константа СТРОКА_2_Y   = (Символ) 60

/**
 * Оконная процедура (WndProc) - обычная Rech-функция, переданная в
 * ОконныйКласс.обработчик (главный.rech) как "&обработать_окно". Windows
 * зовёт её сама на каждое сообщение цикла - раздел 17 SPEC.md ("Вызываемый"
 * как значение) и раздел 12 (колбэк из C в Rech).
 */
функция обработать_окно(
    окно: Указатель<Байт>,
    сообщение: Символ,
    параметр1: Целое,
    параметр2: Целое,
): Целое {
    // Перерисовать содержимое окна.
    если сообщение == WM_PAINT {
        // PAINTSTRUCT на Windows x64 занимает 72 байта.
        переменная окраска = выделить(72)
        переменная контекст = начать_рисование(окно, окраска)

        // TextOutW (юникод.rech, в_utf16) - не TextOutA - понимает кириллицу
        // корректно (главный.rech, doc-комментарий про "A"-варианты).
        переменная строка1 = "Привет, Rech!"
        переменная utf16_1 = в_utf16(строка1)
        вывести_текст_юникод(контекст, ОТСТУП_СЛЕВА, СТРОКА_1_Y, utf16_1, (Символ) длина_строки(строка1))
        освободить(utf16_1)

        переменная тиков   = (Строка) тиков_с_запуска()
        переменная строка2 = "Тиков с запуска Windows: " + тиков
        переменная utf16_2 = в_utf16(строка2)
        вывести_текст_юникод(контекст, ОТСТУП_СЛЕВА, СТРОКА_2_Y, utf16_2, (Символ) длина_строки(строка2))
        освободить(utf16_2)

        закончить_рисование(окно, окраска)
        освободить(окраска)

        вернуть 0
    }

    // Щелчок левой кнопкой мыши закрывает окно (обычный "уничтожить_окно"
    // запускает WM_DESTROY ниже, тот же путь, что и системный крестик в
    // заголовке).
    если сообщение == WM_LBUTTONDOWN {
        уничтожить_окно(окно)
        вернуть 0
    }

    // Окно уже уничтожено, пора остановить цикл сообщений (главный.rech).
    если сообщение == WM_DESTROY {
        завершить_сообщения((Символ) 0)
        вернуть 0
    }

    вернуть стандартная_обработка(окно, сообщение, параметр1, параметр2)
}
