использовать выделить, освободить, начать_рисование, закончить_рисование, вывести_текст,
завершить_сообщения, стандартная_обработка, тиков_с_запуска, режим_фона, выбрать_объект,
стандартный_объект из "user32"
использовать WM_PAINT, WM_COMMAND, WM_DESTROY, МАСКА_МЛАДШЕГО_СЛОВА, РАЗМЕР_PAINTSTRUCT,
КОД_УСПЕХА, TRANSPARENT, DEFAULT_GUI_FONT из "константы_winapi"
использовать в_utf16 из "юникод"
использовать обработать_команду из "элементы_окна"
использовать длина_строки из стандарт/строки

// Расположение текста, который окно рисует само (TextOutW - x/y в
// пикселях от левого верхнего угла клиентской области).
константа ОТСТУП_ТЕКСТА = (Целое32) 40
константа СТРОКА_1_Y    = (Целое32) 40
константа СТРОКА_2_Y    = (Целое32) 60

константа ПРИВЕТСТВИЕ   = "Привет, Rech!"
константа ПОДПИСЬ_ТИКОВ = "Тиков с запуска Windows: "

// Результат оконной процедуры "сообщение обработано".
константа ОБРАБОТАНО = 0

/**
 * Оконная процедура (WndProc) - обычная Rech-функция, переданная в
 * ОконныйКласс.обработчик (главный.rech) как "&обработать_окно". Windows
 * зовёт её сама на каждое сообщение цикла - раздел 17 SPEC.md ("Вызываемый"
 * как значение) и раздел 12 (колбэк из C в Rech).
 */
публичная функция обработать_окно(
    окно: Указатель<Байт>,
    сообщение: Натуральное32,
    параметр1: Целое,
    параметр2: Целое,
): Целое {
    // Перерисовать содержимое окна.
    если сообщение == WM_PAINT {
        нарисовать(окно)

        вернуть ОБРАБОТАНО
    }

    // Нажата кнопка (элементы_окна.rech) - LOWORD(wParam) - её идентификатор.
    если сообщение == WM_COMMAND {
        Целое32 идентификатор = (Целое32) (параметр1 & МАСКА_МЛАДШЕГО_СЛОВА)
        если обработать_команду(окно, идентификатор) {
            вернуть ОБРАБОТАНО
        }
    }

    // Окно закрыто - пора остановить цикл сообщений (главный.rech).
    если сообщение == WM_DESTROY {
        завершить_сообщения(КОД_УСПЕХА)

        вернуть ОБРАБОТАНО
    }

    вернуть стандартная_обработка(окно, сообщение, параметр1, параметр2)
}

приватная функция нарисовать(окно: Указатель<Байт>)
{
    Указатель<Байт> окраска  = выделить(РАЗМЕР_PAINTSTRUCT)
    Указатель<Байт> контекст = начать_рисование(окно, окраска)
    режим_фона(контекст, TRANSPARENT)
    выбрать_объект(контекст, стандартный_объект(DEFAULT_GUI_FONT))

    нарисовать_строку(контекст, СТРОКА_1_Y, ПРИВЕТСТВИЕ)
    нарисовать_строку(контекст, СТРОКА_2_Y, ПОДПИСЬ_ТИКОВ + (Строка) тиков_с_запуска())

    закончить_рисование(окно, окраска)
    освободить(окраска)
}

// TextOutW (не TextOutA) понимает кириллицу - текст переводится в UTF-16.
приватная функция нарисовать_строку(контекст: Указатель<Байт>, y: Целое32, текст: Строка)
{
    Указатель<Байт> текст_utf16 = в_utf16(текст)
    вывести_текст(контекст, ОТСТУП_ТЕКСТА, y, текст_utf16, (Целое32) длина_строки(текст))
    освободить(текст_utf16)
}
