использовать создать_окно, найти_элемент, прочитать_ячейку_окна, записать_ячейку_окна,
прочитать_текст_окна, записать_текст_окна, отправить_элементу, стандартный_объект,
выделить, освободить из "user32"
использовать WS_CHILD, WS_VISIBLE, WS_BORDER, ES_AUTOHSCROLL, WS_EX_NONE, КЛАСС_КНОПКИ,
КЛАСС_ПОЛЯ_ВВОДА, КЛАСС_ПОДПИСИ, GWLP_ID, GWLP_USERDATA, WM_SETFONT,
DEFAULT_GUI_FONT из "константы_winapi"
использовать в_utf16, БАЙТ_НА_WCHAR из "юникод"

// Дочерние элементы окна: кнопка "+1" со счётчиком нажатий и поле ввода с
// кнопкой "Ввод", которая показывает введённый текст в подписи рядом.
// Элементы - системные классы Windows (BUTTON/EDIT/STATIC); нажатие кнопки
// приходит в оконную процедуру сообщением WM_COMMAND с идентификатором
// элемента (обработчик_окна.rech -> обработать_команду ниже).

// Идентификаторы элементов (GWLP_ID): по ним WM_COMMAND сообщает, какая
// кнопка нажата, и по ним же найти_элемент достаёт хендл поля/подписи.
константа ИД_КНОПКИ_СЧЁТЧИКА  = (Целое32) 101
константа ИД_ПОДПИСИ_СЧЁТЧИКА = (Целое32) 102
константа ИД_ПОЛЯ_ВВОДА       = (Целое32) 103
константа ИД_КНОПКИ_ВВОДА     = (Целое32) 104
константа ИД_ПОДПИСИ_ВВОДА    = (Целое32) 105

// Тексты элементов.
константа ТЕКСТ_КНОПКИ_СЧЁТЧИКА = "+1"
константа ТЕКСТ_КНОПКИ_ВВОДА    = "Ввод"
константа ПОДПИСЬ_СЧЁТЧИКА      = "Нажатий: "
константа ТЕКСТ_ПУСТОЙ          = ""

// Начальное значение счётчика и шаг кнопки "+1".
константа НАЧАЛО_СЧЁТЧИКА = 0
константа ШАГ_СЧЁТЧИКА    = 1

// Стиль, добавляемый к WS_CHILD | WS_VISIBLE: у кнопок и подписей - ничего
// (BS_PUSHBUTTON/SS_LEFT - нули), у поля ввода - рамка и прокрутка.
константа БЕЗ_ДОП_СТИЛЯ    = (Натуральное32) 0
константа СТИЛЬ_ПОЛЯ_ВВОДА = WS_BORDER | ES_AUTOHSCROLL

// Расположение элементов (пиксели от левого верхнего угла клиентской
// области): ряд счётчика и ряд поля ввода.
константа ОТСТУП_СЛЕВА      = (Целое32) 40
константа ИНТЕРВАЛ          = (Целое32) 12
константа ВЫСОТА_ЭЛЕМЕНТА   = (Целое32) 28
константа РЯД_СЧЁТЧИКА_Y    = (Целое32) 110
константа РЯД_ВВОДА_Y       = (Целое32) 160
константа ШИРИНА_КНОПКИ     = (Целое32) 90
константа ШИРИНА_ПОЛЯ_ВВОДА = (Целое32) 260
константа ШИРИНА_ПОДПИСИ    = (Целое32) 300
// Текст STATIC прижат к верху элемента, текст кнопки - по центру: сдвиг
// ставит их на одну линию.
константа СДВИГ_ПОДПИСИ_Y = (Целое32) 6

// Сколько WCHAR поместится в буфер текста поля ввода (с завершающим нулём).
константа РАЗМЕР_БУФЕРА_ВВОДА = (Целое32) 256

// lParam у WM_SETFONT - перерисовать элемент сразу после смены шрифта.
константа ПЕРЕРИСОВАТЬ = 1

/** Создаёт все элементы окна и задаёт им шрифт интерфейса. */
публичная функция создать_элементы(окно: Указатель<Байт>, экземпляр: Указатель<Байт>)
{
    Целое32 x_подписи_счётчика = ОТСТУП_СЛЕВА + ШИРИНА_КНОПКИ + ИНТЕРВАЛ
    Целое32 y_подписи_счётчика = РЯД_СЧЁТЧИКА_Y + СДВИГ_ПОДПИСИ_Y
    Строка  текст_счётчика     = ПОДПИСЬ_СЧЁТЧИКА + (Строка) НАЧАЛО_СЧЁТЧИКА
    создать_элемент(окно, экземпляр, КЛАСС_КНОПКИ, ТЕКСТ_КНОПКИ_СЧЁТЧИКА, БЕЗ_ДОП_СТИЛЯ,
        ОТСТУП_СЛЕВА, РЯД_СЧЁТЧИКА_Y, ШИРИНА_КНОПКИ, ИД_КНОПКИ_СЧЁТЧИКА)
    создать_элемент(окно, экземпляр, КЛАСС_ПОДПИСИ, текст_счётчика, БЕЗ_ДОП_СТИЛЯ,
        x_подписи_счётчика, y_подписи_счётчика, ШИРИНА_ПОДПИСИ, ИД_ПОДПИСИ_СЧЁТЧИКА)

    Целое32 x_кнопки_ввода  = ОТСТУП_СЛЕВА + ШИРИНА_ПОЛЯ_ВВОДА + ИНТЕРВАЛ
    Целое32 x_подписи_ввода = x_кнопки_ввода + ШИРИНА_КНОПКИ + ИНТЕРВАЛ
    Целое32 y_подписи_ввода = РЯД_ВВОДА_Y + СДВИГ_ПОДПИСИ_Y
    создать_элемент(окно, экземпляр, КЛАСС_ПОЛЯ_ВВОДА, ТЕКСТ_ПУСТОЙ, СТИЛЬ_ПОЛЯ_ВВОДА,
        ОТСТУП_СЛЕВА, РЯД_ВВОДА_Y, ШИРИНА_ПОЛЯ_ВВОДА, ИД_ПОЛЯ_ВВОДА)
    создать_элемент(окно, экземпляр, КЛАСС_КНОПКИ, ТЕКСТ_КНОПКИ_ВВОДА, БЕЗ_ДОП_СТИЛЯ,
        x_кнопки_ввода, РЯД_ВВОДА_Y, ШИРИНА_КНОПКИ, ИД_КНОПКИ_ВВОДА)
    создать_элемент(окно, экземпляр, КЛАСС_ПОДПИСИ, ТЕКСТ_ПУСТОЙ, БЕЗ_ДОП_СТИЛЯ,
        x_подписи_ввода, y_подписи_ввода, ШИРИНА_ПОДПИСИ, ИД_ПОДПИСИ_ВВОДА)
}

/**
 * Реакция на WM_COMMAND: "+1" увеличивает счётчик, "Ввод" переносит текст
 * поля ввода в подпись рядом. Истина - команда относится к этим элементам.
 */
публичная функция обработать_команду(окно: Указатель<Байт>, идентификатор: Целое32): Логическое
{
    если идентификатор == ИД_КНОПКИ_СЧЁТЧИКА {
        увеличить_счётчик(окно)

        вернуть истина
    }
    если идентификатор == ИД_КНОПКИ_ВВОДА {
        показать_введённое(окно)

        вернуть истина
    }
    вернуть ложь
}

приватная функция создать_элемент(
    окно: Указатель<Байт>,
    экземпляр: Указатель<Байт>,
    имя_класса: Строка,
    текст: Строка,
    доп_стиль: Натуральное32,
    x: Целое32,
    y: Целое32,
    ширина: Целое32,
    идентификатор: Целое32,
) {
    Указатель<Байт> класс_utf16 = в_utf16(имя_класса)
    Указатель<Байт> текст_utf16 = в_utf16(текст)
    Указатель<Байт> элемент     = создать_окно(
        WS_EX_NONE,
        класс_utf16,
        текст_utf16,
        WS_CHILD | WS_VISIBLE | доп_стиль,
        x,
        y,
        ширина,
        ВЫСОТА_ЭЛЕМЕНТА,
        окно,
        Ничто,
        экземпляр,
        Ничто,
    )
    освободить(класс_utf16)
    освободить(текст_utf16)

    записать_ячейку_окна(элемент, GWLP_ID, (Целое) идентификатор)
    отправить_элементу(элемент, WM_SETFONT, стандартный_объект(DEFAULT_GUI_FONT), ПЕРЕРИСОВАТЬ)
}

// Счётчик нажатий хранится в ячейке GWLP_USERDATA самого окна: оконная
// процедура вызывается заново на каждое сообщение, своего состояния между
// вызовами у неё нет.
приватная функция увеличить_счётчик(окно: Указатель<Байт>)
{
    Целое счётчик = прочитать_ячейку_окна(окно, GWLP_USERDATA) + ШАГ_СЧЁТЧИКА
    записать_ячейку_окна(окно, GWLP_USERDATA, счётчик)
    записать_текст(найти_элемент(окно, ИД_ПОДПИСИ_СЧЁТЧИКА), ПОДПИСЬ_СЧЁТЧИКА + (Строка) счётчик)
}

// Текст поля ввода копируется в подпись как есть, в UTF-16 - без
// промежуточной "Строка".
приватная функция показать_введённое(окно: Указатель<Байт>)
{
    Указатель<Байт> буфер = выделить((Целое) РАЗМЕР_БУФЕРА_ВВОДА * БАЙТ_НА_WCHAR)
    прочитать_текст_окна(найти_элемент(окно, ИД_ПОЛЯ_ВВОДА), буфер, РАЗМЕР_БУФЕРА_ВВОДА)
    записать_текст_окна(найти_элемент(окно, ИД_ПОДПИСИ_ВВОДА), буфер)
    освободить(буфер)
}

приватная функция записать_текст(элемент: Указатель<Байт>, текст: Строка)
{
    Указатель<Байт> текст_utf16 = в_utf16(текст)
    записать_текст_окна(элемент, текст_utf16)
    освободить(текст_utf16)
}
