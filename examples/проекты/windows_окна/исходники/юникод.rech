использовать выделить из "user32"

/**
 * UTF-8 (Rech-строка) -> UTF-16LE (то, что понимают "W"-варианты WinAPI,
 * например TextOutW, user32.rech) - через настоящую WinAPI-функцию
 * kernel32.dll, а не самописный конвертер. "A"-варианты (TextOutA и т. п.)
 * ожидают байты в системной кодовой странице, не UTF-8 - переданный им
 * напрямую кириллический Rech-литерал превратился бы в "кракозябры" на
 * любой системе (главный.rech, doc-комментарий) - в_utf16 ниже даёт
 * настоящий обходной путь, не просто описание проблемы.
 */
// CP_UTF8 (winnls.h) - кодовая страница, в которой уже лежит любая
// Rech-строка (Rech хранит текст в UTF-8 изнутри).
константа CP_UTF8 = (Символ) 65001

внешняя функция MultiByteToWideChar(
    кодовая_страница: Символ,
    флаги: Символ,
    исходная_строка: Строка,
    длина_исходной: Символ,
    буфер: Указатель<Байт>,
    длина_буфера_wchar: Символ,
): Символ

// в_utf16 - буфер UTF-16LE для текст, с завершающим нулевым WCHAR
// (длина_строки(текст) не учитывает его, WinAPI ожидает буфер на
// один WCHAR больше). "длина_строки" считает КОДОВЫЕ ТОЧКИ (docs/SPEC.md,
// раздел 11) - для кириллицы/латиницы это те же самые code point'ы, что и
// WCHAR-единицы UTF-16 (ни один символ этого примера не выходит за
// Basic Multilingual Plane, суррогатные пары не нужны) - вызывать
// MultiByteToWideChar дважды (сначала узнать нужный размер) незачем.
функция в_utf16(текст: Строка): Указатель<Байт>
{
    переменная колво_символов = длина_строки(текст)
    переменная буфер          = выделить((колво_символов + 1) * 2)
    MultiByteToWideChar(CP_UTF8, (Символ) 0, текст, (Символ) -1, буфер, (Символ) (колво_символов + 1))
    вернуть буфер
}
