использовать выделить из "user32"
использовать CP_UTF8, MB_NO_FLAGS, ДО_НУЛЯ из "константы_winapi"
использовать длина_строки из стандарт/строки

// Размер одного символа UTF-16 (WCHAR) в байтах.
константа БАЙТ_НА_WCHAR = 2

внешняя функция MultiByteToWideChar(
    кодовая_страница: Натуральное32,
    флаги: Натуральное32,
    исходная_строка: Строка,
    длина_исходной: Целое32,
    буфер: Указатель<Байт>,
    длина_буфера_wchar: Целое32,
): Целое32

/**
 * UTF-8 (Rech-строка) -> UTF-16LE (то, что понимают "W"-варианты WinAPI -
 * CreateWindowExW/TextOutW/SetWindowTextW, user32.rech) - через настоящую
 * WinAPI-функцию kernel32.dll, а не самописный конвертер. "A"-варианты
 * ожидают байты в системной кодовой странице, не UTF-8 - кириллический
 * Rech-литерал превратился бы в них в "кракозябры".
 *
 * Буфер - с завершающим нулевым WCHAR (длина_строки(текст) его не
 * учитывает). "длина_строки" считает кодовые точки (docs/SPEC.md,
 * раздел 11) - для кириллицы/латиницы это те же WCHAR-единицы UTF-16
 * (символы этого примера не выходят за Basic Multilingual Plane,
 * суррогатные пары не нужны), поэтому узнавать размер отдельным вызовом
 * MultiByteToWideChar незачем. Буфер освобождает вызывающий ("освободить").
 */
публичная функция в_utf16(текст: Строка): Указатель<Байт>
{
    Целое           длина_wchar = длина_строки(текст) + 1
    Указатель<Байт> буфер       = выделить(длина_wchar * БАЙТ_НА_WCHAR)
    MultiByteToWideChar(CP_UTF8, MB_NO_FLAGS, текст, ДО_НУЛЯ, буфер, (Целое32) длина_wchar)
    вернуть буфер
}
