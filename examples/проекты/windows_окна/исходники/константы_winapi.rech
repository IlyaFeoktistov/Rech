/**
 * Именованные константы WinAPI (winuser.h) вместо магических чисел в
 * обработчик_окна.rech/главный.rech - те же имена/значения, что в
 * настоящих заголовках Windows, поэтому легко сверить с MSDN/winuser.h.
 * Тип "Символ" - тот же, что у параметра "сообщение"/стиля окна везде в
 * user32.rech (WinAPI-константы - все 32-битные).
 */

// Сообщения окна (параметр "сообщение" обработать_окно.rech).
константа WM_DESTROY     = (Символ) 0x0002
константа WM_PAINT       = (Символ) 0x000F
константа WM_LBUTTONDOWN = (Символ) 0x0201

// Стиль класса окна (WNDCLASSA.стиль) - "перерисовывать целиком при
// изменении ширины/высоты" (CS_HREDRAW | CS_VREDRAW из winuser.h - здесь
// одной константой, не двумя через "|": побитовые операторы Rech пока не
// определены для "Символ", см. docs/SPEC.md, "Побитовые операторы").
константа CS_HREDRAW_VREDRAW = (Символ) 0x0003

// Стиль самого окна - обычное окно с рамкой/заголовком/системным меню/
// кнопками свернуть-развернуть-закрыть.
константа WS_OVERLAPPEDWINDOW = (Символ) 0x00CF0000

// Режим показа окна (ShowWindow) - "показать как обычно" (не свёрнутым/
// развёрнутым).
константа SW_SHOW = (Символ) 5
