// Именованные константы WinAPI (winuser.h/winnls.h) вместо магических чисел -
// те же имена и значения, что в настоящих заголовках Windows, поэтому их
// легко сверить с MSDN. Тип - тот же, что у C-параметра, куда константа
// передаётся: UINT/DWORD - "Натуральное32", int - "Целое32".

// Сообщения окна (UINT - параметр "сообщение" оконной процедуры).
константа WM_DESTROY = (Натуральное32) 0x0002
константа WM_PAINT   = (Натуральное32) 0x000F
константа WM_SETFONT = (Натуральное32) 0x0030
константа WM_COMMAND = (Натуральное32) 0x0111

// Стиль класса окна (WNDCLASSW.стиль): перерисовывать целиком при
// изменении ширины/высоты.
константа CS_VREDRAW = (Натуральное32) 0x0001
константа CS_HREDRAW = (Натуральное32) 0x0002

// Стили окон (DWORD): обычное окно с рамкой/заголовком/кнопками; дочерний
// видимый элемент; рамка и горизонтальная прокрутка у поля ввода.
константа WS_OVERLAPPEDWINDOW = (Натуральное32) 0x00CF0000
константа WS_CHILD            = (Натуральное32) 0x40000000
константа WS_VISIBLE          = (Натуральное32) 0x10000000
константа WS_BORDER           = (Натуральное32) 0x00800000
константа ES_AUTOHSCROLL      = (Натуральное32) 0x0080
константа WS_EX_NONE          = (Натуральное32) 0

// Системные классы элементов (регистрирует сам Windows).
константа КЛАСС_КНОПКИ     = "BUTTON"
константа КЛАСС_ПОЛЯ_ВВОДА = "EDIT"
константа КЛАСС_ПОДПИСИ    = "STATIC"

// Режим показа окна (ShowWindow) - "показать как обычно".
константа SW_SHOW = (Целое32) 5

// Индексы GetWindowLongPtrW/SetWindowLongPtrW (int, отрицательные в
// winuser.h): GWLP_ID - идентификатор дочернего элемента (приходит в
// WM_COMMAND), GWLP_USERDATA - свободная ячейка окна под данные программы.
константа GWLP_ID       = (Целое32) -12
константа GWLP_USERDATA = (Целое32) -21

// Цвет фона диалогов (GetSysColorBrush) - тот же, что у фона подписей
// STATIC, - и шрифт интерфейса (GetStockObject) вместо жирного системного.
константа COLOR_BTNFACE    = (Целое32) 15
константа DEFAULT_GUI_FONT = (Целое32) 17

// Режим фона текста (SetBkMode): не заливать прямоугольник под буквами.
константа TRANSPARENT = (Целое32) 1

// LOWORD(wParam) у WM_COMMAND - идентификатор элемента.
константа МАСКА_МЛАДШЕГО_СЛОВА = 0xFFFF

// Кодовая страница UTF-8 (MultiByteToWideChar) - в ней лежит любая
// Rech-строка; длина -1 - "до завершающего нуля".
константа CP_UTF8     = (Натуральное32) 65001
константа MB_NO_FLAGS = (Натуральное32) 0
константа ДО_НУЛЯ     = (Целое32) -1

// Размеры структур Windows x64, под которые программа сама выделяет память.
константа РАЗМЕР_MSG         = 48
константа РАЗМЕР_PAINTSTRUCT = 72

// Код завершения цикла сообщений (PostQuitMessage).
константа КОД_УСПЕХА = (Целое32) 0
