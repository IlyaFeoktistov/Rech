# Настоящее окно Windows через FFI (user32.dll/gdi32.dll/kernel32.dll) -
# см. исходники/user32.rech (биндинги)/обработчик_окна.rech (WndProc)/
# главный.rech (регистрация класса, создание окна, цикл сообщений).
#
# Собирается ТОЛЬКО под Windows ("библиотеки_windows" ниже - user32/gdi32
# там просто нет на Linux/macOS).
проект:
  имя: windows_окна
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки_windows: user32, gdi32
