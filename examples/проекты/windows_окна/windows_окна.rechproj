# Настоящее окно Windows через FFI (user32.dll/gdi32.dll/kernel32.dll) -
# см. исходники/user32.rech (биндинги)/обработчик_окна.rech (WndProc)/
# главный.rech (регистрация класса, создание окна, цикл сообщений).
#
# "заголовки_windows: windows.h" - настоящий заголовок делает видимым
# НАСТОЯЩИЙ прототип каждой WinAPI-функции из user32.rech - компилятор
# больше не пишет для них свой собственный (docs/SPEC.md, раздел 12,
# "Внешние функции (FFI)").
#
# Собирается ТОЛЬКО под Windows - "платформа: windows" ниже (user32.dll/
# gdi32.dll/windows.h там просто нет на Linux/macOS) даёт явную ошибку
# сборки на другой ОС вместо молчаливой попытки.
проект:
  имя: windows_окна
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: windows
  библиотеки_windows: user32, gdi32
  заголовки_windows: windows.h
