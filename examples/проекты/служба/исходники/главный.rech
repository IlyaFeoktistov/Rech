использовать дату_в_строку, время_как_дата, время, спать_мс из стандарт/время
использовать дописать_в_файл из стандарт/файлы
использовать запрошена_остановка из стандарт/система

// Служба раз в секунду дописывает в журнал строку и завершается по команде
// остановки: SIGTERM от systemd, "Остановить" в диспетчере служб Windows,
// Ctrl+C при запуске из консоли - всё это "запрошена_остановка()". Рабочий
// каталог службы - каталог её программы, поэтому журнал лежит рядом с ней.
константа ЖУРНАЛ      = "служба.log"
константа ПАУЗА_МС    = 1000
константа ЗАПУЩЕНА    = "запущена"
константа РАБОТАЕТ    = "работает"
константа ОСТАНОВЛЕНА = "остановлена"

/** Дописывает в журнал строку с текущим временем. */
публичная функция записать_в_журнал(событие: Строка)
{
    Строка метка = дату_в_строку(время_как_дата(время()))
    дописать_в_файл(ЖУРНАЛ, `${метка} ${событие}\n`)
}

/** Точка входа службы: работает, пока система не попросит остановиться. */
публичная функция главная
{
    записать_в_журнал(ЗАПУЩЕНА)
    пока не запрошена_остановка() {
        записать_в_журнал(РАБОТАЕТ)
        спать_мс(ПАУЗА_МС)
    }
    записать_в_журнал(ОСТАНОВЛЕНА)
}
