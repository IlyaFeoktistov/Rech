# Пример-проект: служба ("сборка.тип: служба") - фоновая программа под
# управлением системы. "rech build" кладёт рядом с программой файлы
# установки: на Linux - юнит systemd (<имя>.service), на Windows -
# <имя>_установить.cmd/<имя>_удалить.cmd (sc.exe); саму систему не трогает.
# "имя_службы" - имя службы/юнита латиницей (без него - транслитерация
# проект.имя). Установка на Linux:
#   sudo cp сборка/journal-logger.service /etc/systemd/system/
#   sudo systemctl enable --now journal-logger
# На Windows - запустить сборка/journal-logger_установить.cmd от имени
# администратора.
проект:
  имя: служба_журнала
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  тип: служба
  имя_службы: journal-logger
