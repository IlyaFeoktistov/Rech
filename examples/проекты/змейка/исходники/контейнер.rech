/**
 * Одна регистрация в DI-контейнере - ПАРА (тип, фабрика), не готовый
 * экземпляр: "тип" здесь - тот же дескриптор рефлексии, что "тип X" вообще
 * (то же самое, что "X::class" в PHP - имя типа без создания объекта),
 * "фабрика" вызывается лениво, только когда кто-то реально запросит этот
 * тип через "Контейнер.разрешить" - не в момент регистрации.
 */
сущность Регистрация
{
    имеет:
        приватный Тип                    тип_сервиса
        приватный Вызываемый(): Значение фабрика

    конструктор(тип_сервиса: Тип, фабрика: Вызываемый(): Значение)
    {
        этот.тип_сервиса = тип_сервиса
        этот.фабрика     = фабрика
    }

    публичный подходит(запрошенный: Тип): Логическое
    {
        вернуть этот.тип_сервиса.имя() == запрошенный.имя() или этот.тип_сервиса.реализует_ли(запрошенный)
    }

    публичный создать(): Значение
    {
        вернуть этот.фабрика()
    }
}

/**
 * DI-контейнер - хранит ТОЛЬКО описания зависимостей (тип + фабрика,
 * "Регистрация" выше), не построенные объекты: "главный.rech" регистрирует
 * "тип ИсточникВвода"/"тип Рендерер"/"тип ИсточникСлучайности" каждый со
 * своей фабрикой, а настоящий "новый КлавиатурныйВвод()" и т. п. выполняется
 * только внутри "разрешить", в момент, когда "Игра" реально запрашивает
 * зависимость - откладывание создания до первого использования, а не
 * список готовых экземпляров (в отличие от более раннего варианта этого
 * файла/examples/проекты/http_сервер/исходники/контейнер.rech, где сервисы
 * строятся заранее, до передачи в контейнер).
 *
 * Каждый вызов "разрешить" для одного и того же типа создаёт НОВЫЙ
 * экземпляр (фабрика вызывается заново, без кеша) - осознанно просто:
 * ни одна из трёх зависимостей этой игры не хранит состояние, которое
 * нужно делить между несколькими потребителями (единственный потребитель
 * каждой - "Игра", резолвит каждую ровно один раз в своём конструкторе), так
 * что кеширование единственного экземпляра (singleton) ничего бы не дало,
 * кроме лишнего кода - добавить его (поле "?Значение" на кеш внутри
 * "Регистрация") тривиально, если появится стейтфул-зависимость с более чем
 * одним потребителем.
 */
сущность Контейнер
{
    имеет:
        приватный Список<Регистрация> регистрации

    конструктор(регистрации: Список<Регистрация>)
    {
        этот.регистрации = регистрации
    }

    публичный разрешить(запрошенный: Тип): Значение
    {
        переменная регистрации = этот.регистрации
        для i от 0 до (регистрации.длина() - 1) {
            переменная регистрация = регистрации.получить(i)
            если регистрация.подходит(запрошенный) {
                вернуть регистрация.создать()
            }
        }
        выбросить новое Исключение("неразрешённая зависимость: " + запрошенный.имя())
    }
}
