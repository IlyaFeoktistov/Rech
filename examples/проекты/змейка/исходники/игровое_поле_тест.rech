использовать ИгровоеПоле из "поле/игровое_поле"
использовать ИсточникСлучайности из "случайность/источник_случайности"
использовать Направление из "направление"

/**
 * Фиктивный генератор - всегда предлагает ОДНУ и ту же точку из очереди
 * координат (по одной паре x/y за вызов "целое_в_диапазоне": первый вызов
 * в паре возвращает x, второй - y - тот же порядок, которым
 * "ИгровоеПоле.новая_еда" их запрашивает). Даёт тестам знать заранее, где
 * появится еда - настоящий "ГенераторСлучайности" (../случайность/
 * генератор_случайности.rech) для этого непригоден.
 */
сущность ФиктивнаяСлучайность реализует ИсточникСлучайности
{
    имеет:
        приватные координаты: Список<Целое>
        приватная позиция:    Целое

    конструктор(координаты: Список<Целое>)
    {
        этот.координаты = координаты
        этот.позиция    = 0
    }

    публичный целое_в_диапазоне(мин: Целое, макс: Целое): Целое
    {
        переменная значение = этот.координаты.получить(этот.позиция)
        этот.позиция = (этот.позиция + 1) % этот.координаты.длина()
        вернуть значение
    }
}

/**
 * Покрывает "поле/игровое_поле.rech" - всю игровую логику - без единого
 * обращения к терминалу (см. её package doc). "rech test
 * examples/проекты/змейка/исходники/игровое_поле_тест.rech".
 */
функция главная
{
    // Еда сразу справа от начальной головы (5, 5) на поле 10x10 - один шаг
    // "продвинуть" вправо (направление по умолчанию) должен её съесть.
    переменная координаты_еды = новый Список<Целое>()
    координаты_еды.добавить(6)
    координаты_еды.добавить(5)
    координаты_еды.добавить(0)
    координаты_еды.добавить(0)
    переменная генератор = новая ФиктивнаяСлучайность(координаты_еды)
    переменная поле      = новое ИгровоеПоле(10, 10, генератор)

    утверждать поле.жива(), "новое поле должно быть живым"
    утверждать поле.очки() == 0, "новое поле должно начинаться с нулём очков"
    утверждать поле.тело().длина() == 1, "новая змейка должна состоять из одного сегмента"

    поле.продвинуть()
    утверждать поле.жива(), "поле должно остаться живым после поедания еды"
    утверждать поле.очки() == 1, "поедание еды должно увеличить очки на 1"
    утверждать поле.тело().длина() == 2, "поедание еды должно увеличить длину змейки"

    // Следующий шаг НЕ на еду (0, 0 занято следующим кандидатом только
    // если змейка там - на этом поле пусто) - длина не должна расти дальше.
    поле.продвинуть()
    утверждать поле.жива(), "поле должно остаться живым на обычном шаге"
    утверждать поле.тело().длина() == 2, "обычный шаг не должен менять длину змейки"
    утверждать поле.очки() == 1, "обычный шаг не должен менять очки"

    // Столкновение со стеной: маленькое поле 3x3, змейка стартует в центре
    // (1,1) и идёт вправо - следующий шаг (2,1) ещё в поле, шаг за ним
    // (3,1) уже за пределами (размер_x=3, допустимые x: 0..2).
    переменная генератор2 = новая ФиктивнаяСлучайность(координаты_еды)
    переменная маленькое  = новое ИгровоеПоле(3, 3, генератор2)
    маленькое.продвинуть()
    утверждать маленькое.жива(), "шаг внутри границ поля не должен завершать игру"
    маленькое.продвинуть()
    утверждать не маленькое.жива(), "шаг за границу поля должен завершать игру"

    // Разворот на 180 градусов должен игнорироваться: змейка идёт вправо,
    // "сменить_направление(Влево)" не должен применяться - следующий шаг
    // всё равно вправо, а не в себя же.
    переменная генератор3 = новая ФиктивнаяСлучайность(координаты_еды)
    переменная поле3      = новое ИгровоеПоле(10, 10, генератор3)
    переменная голова_до  = поле3.тело().последний()
    поле3.сменить_направление(Направление.Влево)
    поле3.продвинуть()
    утверждать поле3.жива(), "игнорируемый разворот не должен завершать игру столкновением с собой"
    // "тело().последний()" - голова (см. package doc "поле/игровое_поле.rech":
    // тело хранится от хвоста к голове) - именно эта точка сейчас, а не
    // "получить(0)", которая после роста (еда была на пути) осталась бы
    // старым хвостом.
    переменная голова_после = поле3.тело().последний()
    утверждать голова_после.x == голова_до.x + 1 и голова_после.y == голова_до.y, "после игнорируемого разворота змейка должна продолжить движение в прежнем направлении"

    вывести `все проверки ИгровоеПоле пройдены\n`
}
