использовать войти_в_альтернативный_экран, выйти_из_альтернативного_экрана, скрыть_курсор, показать_курсор из "рендер/ansi"
использовать ИсточникСлучайности из "случайность/источник_случайности"
использовать ГенераторСлучайности из "случайность/генератор_случайности"
использовать ИсточникВвода из "ввод/источник_ввода"
использовать КлавиатурныйВвод из "ввод/клавиатурный_ввод"
использовать Рендерер из "рендер/рендерер"
использовать ТерминальныйРендерер из "рендер/терминальный_рендерер"
использовать Регистрация, Контейнер из "контейнер"
использовать Игра из "игра"
использовать установить_сырой_режим из стандарт/консоль

/**
 * Классическая змейка в терминале - структура проекта создана через
 * "rech init змейка" (.rechproj + исходники/главный.rech), дальше
 * дописана вручную по файлам, по одной теме на файл (направление/точка/
 * игровое поле/ввод/рендер/DI-контейнер/игра). Вся игровая логика -
 * "поле/игровое_поле.rech", покрыта отдельным тестом
 * ("игровое_поле_тест.rech", запускается "rech test", не завязан на
 * терминал вовсе); этот файл только собирает настоящие реализации и
 * запускает интерактивный цикл ("игра.rech").
 *
 * w/a/s/d (либо те же клавиши под ЙЦУКЕН - ц/ф/ы/в) или стрелки -
 * направление, q (либо й) - выход раньше проигрыша.
 *
 * Регистрация - только ПАРА (тип, фабрика) на каждую зависимость, ни одна
 * реализация не строится в момент регистрации (см. package doc
 * "контейнер.rech") - "новый КлавиатурныйВвод()" и т. п. выполняется
 * позже, внутри "контейнер.разрешить(...)" ниже, ГДЕ ЭТОТ ФАЙЛ его сам и
 * вызывает: composition root - единственное место, которое вообще знает
 * про "Контейнер" и про конкретные имена реализаций ("ГенераторСлучайности"/
 * "КлавиатурныйВвод"/"ТерминальныйРендерер") - "Игра" (игра.rech) получает
 * уже готовые интерфейсы через конструктор, ей "Контейнер" не нужен.
 */
функция главная
{
    переменная регистрации = новый Список<Регистрация>()
    регистрации.добавить(новая Регистрация(тип ИсточникСлучайности, функция (): Значение {
        вернуть (Значение) новый ГенераторСлучайности()
    }))
    регистрации.добавить(новая Регистрация(тип ИсточникВвода, функция (): Значение {
        вернуть (Значение) новый КлавиатурныйВвод()
    }))
    регистрации.добавить(новая Регистрация(тип Рендерер, функция (): Значение {
        вернуть (Значение) новый ТерминальныйРендерер()
    }))
    переменная контейнер = новый Контейнер(регистрации)

    переменная генератор = контейнер.разрешить(тип ИсточникСлучайности) как ИсточникСлучайности
    переменная ввод      = контейнер.разрешить(тип ИсточникВвода) как ИсточникВвода
    переменная рендерер  = контейнер.разрешить(тип Рендерер) как Рендерер

    установить_сырой_режим(истина)
    войти_в_альтернативный_экран()
    скрыть_курсор()

    переменная игра = новая Игра(30, 15, генератор, ввод, рендерер)
    игра.играть()

    показать_курсор()
    выйти_из_альтернативного_экрана()
    установить_сырой_режим(ложь)
}
