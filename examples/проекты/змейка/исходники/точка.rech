/**
 * Координата клетки на игровом поле - структура (тип по значению): элемент
 * "тело: Список<Точка>" копируется при добавлении/чтении, движение змейки
 * не должно случайно делить один и тот же экземпляр между сегментами.
 * "==" сравнивает поля x/y как обычно у структур (Шаг 120), отдельный
 * метод сравнения не нужен.
 */
структура Точка
{
    имеет:
        x: Целое
        y: Целое
}
