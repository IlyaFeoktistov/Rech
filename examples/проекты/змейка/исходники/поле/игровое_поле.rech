использовать Точка из "../точка"
использовать Направление из "../направление"
использовать ИсточникСлучайности из "../случайность/источник_случайности"

/**
 * Вся игровая логика змейки, БЕЗ единого обращения к терминалу/клавиатуре -
 * то, что реально стоит юнит-тестировать (../игровое_поле_тест.rech), в
 * отличие от интерактивного цикла "Игра.играть" (../игра.rech). Именно
 * ради этой границы "ИсточникСлучайности" внедряется через конструктор
 * (настоящий DI, см. package doc "случайность/источник_случайности.rech"),
 * а не берётся напрямую builtin-функцией "случайное_целое" здесь же - тест
 * подставляет предсказуемую фиктивную реализацию вместо настоящей.
 *
 * "тело" хранит сегменты от ХВОСТА к ГОЛОВЕ ("последний()" - голова) -
 * generic-коллекция умеет только "добавить" в конец/"удалить" по индексу
 * (нет отдельного метода "в начало"), этот порядок делает и рост
 * ("добавить" новую голову), и обычный шаг ("добавить" + "удалить(0)"
 * старого хвоста) операциями над концами списка, без сдвига индексов.
 */
сущность ИгровоеПоле
{
    имеет:
        приватный размер_x:    Целое
        приватный размер_y:    Целое
        приватное тело:        Список<Точка>
        приватное направление: Целое
        приватная еда:         Точка
        приватная жива:        Логическое
        приватные очки:        Целое
        приватный генератор:   ИсточникСлучайности

    конструктор(размер_x: Целое, размер_y: Целое, генератор: ИсточникСлучайности)
    {
        этот.размер_x    = размер_x
        этот.размер_y    = размер_y
        этот.генератор   = генератор
        этот.тело        = новый Список<Точка>()
        этот.тело.добавить(новая Точка(размер_x / 2, размер_y / 2))
        этот.направление = Направление.Вправо
        этот.жива        = истина
        этот.очки        = 0
        этот.еда         = этот.новая_еда()
    }

    публичный размер_x(): Целое
    {
        вернуть этот.размер_x
    }

    публичный размер_y(): Целое
    {
        вернуть этот.размер_y
    }

    публичный тело(): Список<Точка>
    {
        вернуть этот.тело
    }

    публичный еда(): Точка
    {
        вернуть этот.еда
    }

    публичный жива(): Логическое
    {
        вернуть этот.жива
    }

    публичный очки(): Целое
    {
        вернуть этот.очки
    }

    /**
     * Меняет направление на следующем "продвинуть" - разворот на 180
     * градусов (голова врезалась бы во второй сегмент тела на следующем же
     * шаге) молча игнорируется, тем же принципом, что и в любой настоящей
     * змейке: иначе одно случайное нажатие противоположной клавиши сразу
     * заканчивало бы игру.
     */
    публичный сменить_направление(запрошенное: Целое)
    {
        если этот.противоположно(запрошенное, этот.направление) {
            вернуть
        }
        этот.направление = запрошенное
    }

    // Перенос строки перед "или" незначим (docs/SPEC.md, раздел 2) -
    // длинное условие удобно разбить по одной паре направлений на строку.
    приватный противоположно(a: Целое, b: Целое): Логическое
    {
        вернуть (a == Направление.Вверх и b == Направление.Вниз)
        или (a == Направление.Вниз и b == Направление.Вверх)
        или (a == Направление.Влево и b == Направление.Вправо)
        или (a == Направление.Вправо и b == Направление.Влево)
    }

    /**
     * Один шаг игры: считает новую голову по текущему направлению,
     * проверяет столкновение со стеной/собой, иначе перемещает змейку - с
     * ростом (голова попала на еду) или без. Ничего не делает, если игра
     * уже окончена ("жива" ложь) - вызывающему ("Игра.играть") не нужно
     * самому проверять это перед каждым вызовом.
     */
    публичный продвинуть()
    {
        если не этот.жива {
            вернуть
        }

        переменная голова       = этот.тело.последний()
        переменная новая_голова = этот.следующая_точка(голова)

        если новая_голова.x < 0
        или новая_голова.x >= этот.размер_x
        или новая_голова.y < 0
        или новая_голова.y >= этот.размер_y {
            этот.жива = ложь

            вернуть
        }
        если этот.занято(новая_голова) {
            этот.жива = ложь

            вернуть
        }

        этот.тело.добавить(новая_голова)
        если новая_голова == этот.еда {
            этот.очки = этот.очки + 1
            этот.еда  = этот.новая_еда()
        } иначе {
            этот.тело.удалить(0)
        }
    }

    приватный следующая_точка(из_точки: Точка): Точка
    {
        если этот.направление == Направление.Вверх {
            вернуть новая Точка(из_точки.x, из_точки.y - 1)
        }
        если этот.направление == Направление.Вниз {
            вернуть новая Точка(из_точки.x, из_точки.y + 1)
        }
        если этот.направление == Направление.Влево {
            вернуть новая Точка(из_точки.x - 1, из_точки.y)
        }
        вернуть новая Точка(из_точки.x + 1, из_точки.y)
    }

    приватный занято(точка: Точка): Логическое
    {
        для i от 0 до (этот.тело.длина() - 1) {
            если этот.тело.получить(i) == точка {
                вернуть истина
            }
        }
        вернуть ложь
    }

    /**
     * Находит свободную клетку под новую еду. "генератор" может (особенно
     * фиктивный в тестах) какое-то время подряд предлагать занятую клетку -
     * ограниченное число попыток (размер_x*размер_y с запасом), после
     * которых прямой перебор поля гарантированно находит первую свободную
     * (или не находит вовсе - тело занимает всё поле, что в этом срезе не
     * разбирается отдельно как "победа").
     */
    приватный новая_еда(): Точка
    {
        для i от 0 до (этот.размер_x * этот.размер_y) {
            переменная кандидат = новая Точка(этот.генератор.целое_в_диапазоне(0, этот.размер_x - 1), этот.генератор.целое_в_диапазоне(0, этот.размер_y - 1))
            если не этот.занято(кандидат) {
                вернуть кандидат
            }
        }
        для y от 0 до (этот.размер_y - 1) {
            для x от 0 до (этот.размер_x - 1) {
                переменная кандидат = новая Точка(x, y)
                если не этот.занято(кандидат) {
                    вернуть кандидат
                }
            }
        }
        вернуть новая Точка(0, 0)
    }
}
