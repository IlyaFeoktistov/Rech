использовать Направление из "../направление"
использовать ИсточникВвода из "источник_ввода"
использовать прочитать_код_клавиши, КодКлавиши из стандарт/консоль

/**
 * Альтернатива "клавиатурный_ввод.rech" - читает физический КОД клавиши
 * ("прочитать_код_клавиши", docs/SPEC.md, StandardEnums["КодКлавиши"]),
 * не байты терминала - WASD/стрелки распознаются по ПОЗИЦИИ клавиши,
 * независимо от раскладки (ЙЦУКЕН, любая другая), без отдельного разбора
 * кириллических байт, которым занят "клавиатурный_ввод.rech".
 *
 * НЕ используется по умолчанию (см. "../../главный.rech" - там
 * зарегистрирован "КлавиатурныйВвод") - раскладко-независимое чтение
 * требует прав на устройство ввода на Linux (группа "input" или root),
 * которых обычно НЕТ (в т. ч. ВСЕГДА нет внутри WSL2/через SSH без
 * дополнительной настройки, см. StandardEnums["КодКлавиши"]) -
 * "прочитать_код_клавиши" в этом случае всегда -1, игра тогда не реагирует
 * на клавиатуру вовсе, хотя и не падает. Выбрать эту реализацию вместо
 * "КлавиатурныйВвод" - заменить фабрику ИсточникВвода в "главный.rech" на
 * "новый РаскладконезависимыйВвод()", на своей машине с нужными правами
 * (или на Windows, где такие права не нужны).
 */
сущность РаскладконезависимыйВвод реализует ИсточникВвода
{
    публичный прочитать_направление(): Целое
    {
        переменная код = прочитать_код_клавиши(0)

        если код == КодКлавиши.W или код == КодКлавиши.Вверх {
            вернуть Направление.Вверх
        }
        если код == КодКлавиши.S или код == КодКлавиши.Вниз {
            вернуть Направление.Вниз
        }
        если код == КодКлавиши.A или код == КодКлавиши.Влево {
            вернуть Направление.Влево
        }
        если код == КодКлавиши.D или код == КодКлавиши.Вправо {
            вернуть Направление.Вправо
        }
        если код == КодКлавиши.Escape {
            вернуть -2
        }
        вернуть -1
    }
}
