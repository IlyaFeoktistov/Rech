использовать Направление из "../направление"
использовать ИсточникВвода из "источник_ввода"
использовать стандартный_ввод из стандарт/файлы

/**
 * Настоящее чтение клавиатуры - и WASD (плюс те же физические клавиши под
 * кириллической ЙЦУКЕН-раскладкой - Ц/Ф/Ы/В/Й шлют ровно те же байты, что
 * W/A/S/D/Q под этой раскладкой, не буквенное соответствие, а совпадение
 * позиций клавиш), и стрелки (многобайтовые ANSI CSI-последовательности,
 * не зависят от раскладки вовсе - см. examples/консоль/клавиши.rech для
 * полного разбора с различением одинокого Escape; здесь тот же разбор
 * адаптирован под неблокирующий опрос вместо блокирующего чтения). Требует
 * "установить_сырой_режим(истина)" - без него ввод построчный, отдельные
 * байты недоступны (см. игра.rech).
 *
 * "можно_прочитать_байт(вход, 0)" - НЕблокирующий опрос (0 мс - не ждать
 * вовсе): игровой цикл вызывает "прочитать_направление" раз в кадр и не
 * должен зависать в ожидании клавиши, если игрок ничего не нажал.
 */
сущность КлавиатурныйВвод реализует ИсточникВвода
{
    публичный прочитать_направление(): Целое
    {
        константа ESC               = (Строка) (Символ) 27
        константа ТАЙМАУТ_ESCAPE_МС = 30

        переменная вход = стандартный_ввод()
        если не вход.можно_прочитать_байт(0) {
            вернуть -1
        }
        переменная символ = вход.прочитать(1)

        если символ == ESC {
            если не вход.можно_прочитать_байт(ТАЙМАУТ_ESCAPE_МС) {
                вернуть -1
            }
            переменная второй = вход.прочитать(1)
            если второй != "[" {
                вернуть -1
            }
            переменная третий = вход.прочитать(1)
            если третий == "A" {
                вернуть Направление.Вверх
            }
            если третий == "B" {
                вернуть Направление.Вниз
            }
            если третий == "C" {
                вернуть Направление.Вправо
            }
            если третий == "D" {
                вернуть Направление.Влево
            }

            вернуть -1
        }

        если символ == "w" {
            вернуть Направление.Вверх
        }
        если символ == "s" {
            вернуть Направление.Вниз
        }
        если символ == "a" {
            вернуть Направление.Влево
        }
        если символ == "d" {
            вернуть Направление.Вправо
        }
        если символ == "q" {
            вернуть -2
        }

        // Кириллица в UTF-8 - 2 байта ("прочитать" читает БАЙТЫ, не символы -
        // см. docs/SPEC.md), первого байта недостаточно для сравнения с
        // буквой ЙЦУКЕН-раскладки; терминал шлёт оба байта одним пакетом,
        // почти мгновенно - второй уже готов к моменту, когда первый не
        // совпал ни с одной из проверок выше.
        если не вход.можно_прочитать_байт(0) {
            вернуть -1
        }
        символ = символ + вход.прочитать(1)

        если символ == "ц" {
            вернуть Направление.Вверх
        }
        если символ == "ы" {
            вернуть Направление.Вниз
        }
        если символ == "ф" {
            вернуть Направление.Влево
        }
        если символ == "в" {
            вернуть Направление.Вправо
        }
        если символ == "й" {
            вернуть -2
        }
        вернуть -1
    }
}
