использовать Направление из "../направление"
использовать ИсточникВвода из "источник_ввода"

/**
 * Настоящее чтение клавиатуры - WASD, не стрелки: стрелки на терминале -
 * многобайтовые ANSI-последовательности (см. examples/консоль/клавиши.rech
 * для полного разбора с различением одинокого Escape), лишняя сложность
 * ради того, что WASD решает с одним байтом на нажатие и без неё. Требует
 * "установить_сырой_режим(истина)" - без него ввод построчный, отдельные
 * байты недоступны (см. игра.rech).
 *
 * "можно_прочитать_байт(вход, 0)" - НЕблокирующий опрос (0 мс - не ждать
 * вовсе): игровой цикл вызывает "прочитать_направление" раз в кадр и не
 * должен зависать в ожидании клавиши, если игрок ничего не нажал.
 */
сущность КлавиатурныйВвод реализует ИсточникВвода
{
    публичный прочитать_направление(): Целое
    {
        переменная вход = стандартный_ввод()
        если не вход.можно_прочитать_байт(0) {
            вернуть -1
        }
        переменная символ = вход.прочитать(1)
        если символ == "w" {
            вернуть Направление.Вверх
        }
        если символ == "s" {
            вернуть Направление.Вниз
        }
        если символ == "a" {
            вернуть Направление.Влево
        }
        если символ == "d" {
            вернуть Направление.Вправо
        }
        если символ == "q" {
            вернуть -2
        }
        вернуть -1
    }
}
