использовать стандартный_вывод из стандарт/файлы
использовать RGBЦвет из стандарт/консоль

/**
 * ANSI-вывод (курсор/цвет/стиль) - тот же набор и имена, что и в
 * examples/проекты/tui_htop/исходники/ansi.rech - разные .rechproj не
 * могут "использовать" файл друг друга, поэтому копия, не переиспользование.
 */
константа ESC = (Строка) (Символ) 27

публичная функция вывод_без_переноса(текст: Строка)
{
    стандартный_вывод().записать(текст)
}

публичная функция очистить_экран()
{
    вывод_без_переноса(ESC + "[2J" + ESC + "[H")
}

публичная функция войти_в_альтернативный_экран()
{
    вывод_без_переноса(ESC + "[?1049h")
}

публичная функция выйти_из_альтернативного_экрана()
{
    вывод_без_переноса(ESC + "[?1049l")
}

публичная функция скрыть_курсор()
{
    вывод_без_переноса(ESC + "[?25l")
}

публичная функция показать_курсор()
{
    вывод_без_переноса(ESC + "[?25h")
}

публичная функция цвет_фона(цвет: RGBЦвет)
{
    вывод_без_переноса(ESC + "[48;2;" + (Строка) цвет.красный + ";" + (Строка) цвет.зелёный + ";" + (Строка) цвет.синий + "m")
}

публичная функция жирный_текст()
{
    вывод_без_переноса(ESC + "[1m")
}

публичная функция сбросить_стиль()
{
    вывод_без_переноса(ESC + "[0m")
}
