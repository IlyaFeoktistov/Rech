использовать очистить_экран, вывод_без_переноса, цвет_фона, жирный_текст, сбросить_стиль из "ansi"
использовать ИгровоеПоле из "../поле/игровое_поле"
использовать Точка из "../точка"
использовать Рендерер из "рендерер"

/**
 * Настоящая отрисовка на терминале, тем же ANSI-подходом, что и
 * examples/проекты/tui_htop ("ansi.rech" здесь - урезанная копия того же
 * набора функций, отдельный проект не может "использовать" файл из ЧУЖОГО
 * .rechproj). Печатает поле построчно: голова/тело змейки одним цветом,
 * еда - другим, пустая клетка - точкой.
 */
сущность ТерминальныйРендерер реализует Рендерер
{
    публичный нарисовать(поле: ИгровоеПоле)
    {
        очистить_экран()
        жирный_текст()
        вывод_без_переноса("Змейка - очки: " + (Строка) поле.очки() + "  (w/a/s/d, q - выход)\n\n")
        сбросить_стиль()

        для y от 0 до (поле.размер_y() - 1) {
            для x от 0 до (поле.размер_x() - 1) {
                переменная клетка = новая Точка(x, y)
                если клетка == поле.еда() {
                    цвет_фона(новый RGBЦвет((Байт) 200, (Байт) 40, (Байт) 40))
                    вывод_без_переноса("  ")
                    сбросить_стиль()
                } иначе {
                    если этот.содержит(поле, клетка) {
                        цвет_фона(новый RGBЦвет((Байт) 40, (Байт) 160, (Байт) 60))
                        вывод_без_переноса("  ")
                        сбросить_стиль()
                    } иначе {
                        вывод_без_переноса(" .")
                    }
                }
            }
            вывод_без_переноса("\n")
        }

        если не поле.жива() {
            вывод_без_переноса("\nИгра окончена.\n")
        }
    }

    приватный содержит(поле: ИгровоеПоле, точка: Точка): Логическое
    {
        переменная тело = поле.тело()
        для i от 0 до (тело.длина() - 1) {
            если тело.получить(i) == точка {
                вернуть истина
            }
        }
        вернуть ложь
    }
}
