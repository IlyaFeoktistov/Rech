использовать ИгровоеПоле из "поле/игровое_поле"
использовать ИсточникСлучайности из "случайность/источник_случайности"
использовать ИсточникВвода из "ввод/источник_ввода"
использовать Рендерер из "рендер/рендерер"

/**
 * Интерактивный игровой цикл - в отличие от "ИгровоеПоле" (вся логика,
 * покрыта тестами), эта сущность НЕ тестируется юнитами: она читает
 * настоящую клавиатуру, рисует настоящий терминал и ждёт настоящее время
 * между кадрами.
 *
 * Зависимости приходят уже РАЗРЕШЁННЫМИ, конструктор не принимает
 * "Контейнер" и не вызывает "разрешить" сам - вся рефлексивная резолюция
 * (composition root) - в "главный.rech", единственном месте, которое
 * действительно должно знать про "Контейнер". "Игра" знает только три
 * интерфейса, ни одного конкретного имени реализации.
 */
сущность Игра
{
    имеет:
        приватное поле:     ИгровоеПоле
        приватный ввод:     ИсточникВвода
        приватный рендерер: Рендерер

    конструктор(размер_x: Целое, размер_y: Целое, генератор: ИсточникСлучайности, ввод: ИсточникВвода, рендерер: Рендерер)
    {
        этот.поле      = новая ИгровоеПоле(размер_x, размер_y, генератор)
        этот.ввод      = ввод
        этот.рендерер  = рендерер
    }

    публичный играть()
    {
        пока этот.поле.жива() {
            переменная ввод = этот.ввод.прочитать_направление()
            если ввод == -2 {
                прервать
            }
            если ввод != -1 {
                этот.поле.сменить_направление(ввод)
            }
            этот.поле.продвинуть()
            этот.рендерер.нарисовать(этот.поле)
            спать_мс(150)
        }
        вывести `${"Игра окончена. Очки: " + (Строка) этот.поле.очки()}\n`
    }
}
