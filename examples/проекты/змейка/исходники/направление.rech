/**
 * Направление движения змейки - значения используются как обычные Целое
 * (Направление.Вверх и т. п.) везде, где нужно сравнение/присваивание, в
 * том числе через интерфейс "ИсточникВвода" (см. ввод/источник_ввода.rech) -
 * там нет отдельного nullable-варианта "?Направление", "нет ввода в этом
 * тике" кодируется отдельным целым -1 (см. её package doc).
 */
перечисление Направление
{
    Вверх,
    Вниз,
    Влево,
    Вправо
}
