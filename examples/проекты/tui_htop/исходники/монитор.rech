использовать вывод_без_переноса, цвет_фона, сбросить_стиль из "ansi"

/**
 * Чтение /proc и отрисовка данных - Linux-специфично, на другой ОС файлы
 * просто не существуют, попытаться/поймать превращает это в понятный
 * откат ("н/д"/0%), не падение.
 *
 * "нарисовать_процессы" - НЕ настоящий листинг каталога (в языке пока нет
 * встроенной функции для этого, см. docs/ROADMAP.md) - перебор PID от 1 до
 * МАКС_PID с попыткой открыть "/proc/<pid>/comm": несуществующий PID просто
 * ловится как паника и пропускается. Работает для обычной демонстрации, не
 * масштабируется на системы с PID выше МАКС_PID.
 */
константа МАКС_PID = 4096
константа ШИРИНА_ПОЛОСЫ = 40

публичная функция обрезать_перенос(строка: Строка): Строка
{
    переменная длина = длина_строки(строка)
    если длина > 0 и подстрока(строка, длина - 1, 1) == "\n" {
        вернуть подстрока(строка, 0, длина - 1)
    }
    вернуть строка
}

публичная функция прочитать_файл_целиком(путь: Строка): Строка
{
    переменная файл       = открыть(путь)
    переменная содержимое = файл.прочитать(65536)
    файл.закрыть()
    вернуть содержимое
}

публичная функция найти_первое_число(строка: Строка): Целое
{
    переменная совпадения = регулярное(строка, "[0-9]+")
    если совпадения.длина() > 0 {
        вернуть (Целое) совпадения.получить(0).текст
    }
    вернуть 0
}

публичная функция средняя_загрузка(): Строка
{
    попытаться {
        вернуть обрезать_перенос(прочитать_файл_целиком("/proc/loadavg"))
    } поймать(x: Паника) {
        вернуть "н/д"
    }
}

публичная функция процент_памяти(): Целое
{
    попытаться {
        переменная данные   = прочитать_файл_целиком("/proc/meminfo")
        переменная строки   = разбить(данные, "\n")
        переменная всего    = 0
        переменная доступно = 0
        переменная i        = 0
        пока i < строки.длина() {
            переменная строка = строки.получить(i)
            если позиция_в_строке(строка, "MemTotal:") == 0 {
                всего = найти_первое_число(строка)
            } иначе {
                если позиция_в_строке(строка, "MemAvailable:") == 0 {
                    доступно = найти_первое_число(строка)
                }
            }
            i = i + 1
        }
        если всего <= 0 {
            вернуть 0
        }

        вернуть ((всего - доступно) * 100) / всего
    } поймать(x: Паника) {
        вернуть 0
    }
}

публичная функция цвет_по_проценту(процент: Целое): RGBЦвет
{
    если процент >= 85 {
        вернуть новый RGBЦвет((Байт) 220, (Байт) 60, (Байт) 60)
    }
    если процент >= 60 {
        вернуть новый RGBЦвет((Байт) 230, (Байт) 200, (Байт) 60)
    }
    вернуть новый RGBЦвет((Байт) 80, (Байт) 200, (Байт) 80)
}

публичная функция нарисовать_полосу(процент: Целое)
{
    переменная заполнено = (процент * ШИРИНА_ПОЛОСЫ) / 100
    переменная цвет      = цвет_по_проценту(процент)
    вывод_без_переноса("[")
    переменная i = 0
    пока i < ШИРИНА_ПОЛОСЫ {
        если i < заполнено {
            цвет_фона(цвет)
            вывод_без_переноса(" ")
            сбросить_стиль()
        } иначе {
            вывод_без_переноса(" ")
        }
        i = i + 1
    }
    вывод_без_переноса("] " + (Строка) процент + "%")
}

публичная функция нарисовать_процессы(максимум_строк: Целое)
{
    переменная напечатано = 0
    переменная pid        = 1
    пока pid <= МАКС_PID и напечатано < максимум_строк {
        попытаться {
            переменная имя = обрезать_перенос(прочитать_файл_целиком("/proc/" + (Строка) pid + "/comm"))
            вывод_без_переноса((Строка) pid + "\t" + имя + "\n")
            напечатано = напечатано + 1
        } поймать(x: Паника) {
        }
        pid = pid + 1
    }
}
