использовать Блокировка из стандарт/параллельность

/**
 * Флаг "пора выйти", общий для главного потока и потока чтения клавиш
 * (клавиши.rech) - ссылочная сущность, оба потока делят одно и то же
 * состояние (docs/SPEC.md, раздел 15), доступ - под "Блокировкой".
 */
сущность СостояниеПриложения
{
    имеет:
        приватная Блокировка замок
        приватное Логическое выход_запрошен

    конструктор()
    {
        этот.замок = новая Блокировка()
        этот.выход_запрошен = ложь
    }

    публичный запросить_выход()
    {
        этот.замок.захватить()
        этот.выход_запрошен = истина
        этот.замок.освободить()
    }

    публичный нужен_выход(): Логическое
    {
        этот.замок.захватить()
        переменная результат = этот.выход_запрошен
        этот.замок.освободить()
        вернуть результат
    }
}
