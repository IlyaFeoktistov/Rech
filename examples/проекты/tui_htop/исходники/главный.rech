использовать СостояниеПриложения из "состояние_приложения"
использовать очистить_экран, скрыть_курсор, показать_курсор, цвет_фона, жирный_текст,
сбросить_стиль, вывод_без_переноса, войти_в_альтернативный_экран,
выйти_из_альтернативного_экрана из "ansi"
использовать средняя_загрузка, процент_памяти, нарисовать_полосу, нарисовать_процессы из "монитор"
использовать читать_клавиши из "клавиши"
использовать установить_сырой_режим, RGBЦвет, высота_терминала из стандарт/консоль
использовать спать_мс из стандарт/время

/**
 * Минимальный интерактивный TUI в духе htop - структура проекта создана
 * через "rech init tui_htop" (.rechproj + исходники/главный.rech), дальше
 * дописана вручную и разнесена по файлам (состояние_приложения.rech,
 * ansi.rech, монитор.rech, клавиши.rech) - по одной сущности/теме на файл.
 *
 * "q" - выход. Поток чтения клавиш - отдельный ("запустить"), делит с
 * главным потоком СостояниеПриложения (ссылочная сущность).
 */
функция главная
{
    переменная приложение = новое СостояниеПриложения()
    установить_сырой_режим(истина)
    войти_в_альтернативный_экран()
    скрыть_курсор()
    переменная задача = запустить читать_клавиши(приложение)

    пока не приложение.нужен_выход() {
        очистить_экран()
        цвет_фона(новый RGBЦвет(40, 60, 140))
        жирный_текст()
        вывод_без_переноса(" RechTop ")
        сбросить_стиль()
        вывод_без_переноса(`\n\n`)

        жирный_текст()
        вывод_без_переноса("загрузка: ")
        сбросить_стиль()
        вывод_без_переноса(средняя_загрузка() + `\n`)

        жирный_текст()
        вывод_без_переноса("память:   ")
        сбросить_стиль()
        нарисовать_полосу(процент_памяти())
        вывод_без_переноса(`\n\n`)

        жирный_текст()
        вывод_без_переноса(`PID\tИМЯ`)
        сбросить_стиль()
        вывод_без_переноса(`\n`)
        нарисовать_процессы(высота_терминала() - 10)

        вывод_без_переноса(`\n`)
        жирный_текст()
        вывод_без_переноса("q")
        сбросить_стиль()
        вывод_без_переноса(` - выход\n`)
        спать_мс(700)
    }

    дождаться задача
    показать_курсор()
    выйти_из_альтернативного_экрана()
    установить_сырой_режим(ложь)
    вывести `RechTop завершён.\n`
}
