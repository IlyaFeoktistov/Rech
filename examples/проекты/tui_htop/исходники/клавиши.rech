использовать СостояниеПриложения из "состояние_приложения"

/**
 * Поток чтения клавиш - "q" запрашивает выход через СостояниеПриложения,
 * общую с главным потоком (docs/SPEC.md, раздел 15).
 */
публичная функция читать_клавиши(приложение: СостояниеПриложения)
{
    переменная вход = стандартный_ввод()
    пока не приложение.нужен_выход() {
        переменная символ = вход.прочитать(1)
        если символ == "q" {
            приложение.запросить_выход()
        }
    }
}
