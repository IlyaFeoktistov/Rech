проект:
  имя: tui_htop
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка

сборка:
  режим: отладка
  # /proc/loadavg, /proc/meminfo, /proc/<pid>/comm (исходники/монитор.rech) -
  # специфично для Linux, не для Unix вообще (/proc нет на macOS).
  платформа: linux
