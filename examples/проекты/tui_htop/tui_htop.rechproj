проект:
  имя: tui_htop
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка

сборка:
  режим: отладка
  # /proc (исходники/монитор.rech) есть только на Linux - на других ОС
  # данные о системе заменены "н/д" через "#если ОС.Linux".
  платформа: текущая
