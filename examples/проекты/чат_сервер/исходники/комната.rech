использовать Клиент из "клиент"
использовать СообщениеЧата из "модель"

/**
 * Комната чата - Mediator (docs/GoF): клиенты никогда не обращаются друг к
 * другу напрямую (у "Клиент", клиент.rech, нет ни единой ссылки на другой
 * "Клиент") - только через эту сущность, единственную, что держит их
 * список ("клиенты" полем - Список<Клиент>, до этого проекта такое поле
 * было запрещено компилятором, docs/ROADMAP.md - найденный и снятый по
 * ходу этого проекта недочёт). "блокировка" защищает и сам список (новое
 * подключение), и перебор при рассылке - оба потенциально из РАЗНЫХ
 * потоков одновременно ("обслужить_клиента", обработчик.rech, - по потоку
 * на соединение).
 */
сущность КомнатаЧата
{
    имеет:
        приватные клиенты:    Список<Клиент>
        приватная блокировка: Блокировка

    конструктор()
    {
        этот.клиенты = новый Список<Клиент>()
        этот.блокировка = новая Блокировка()
    }

    публичный подключить(клиент: Клиент): Пусто
    {
        этот.блокировка.захватить()
        этот.клиенты.добавить(клиент)
        этот.блокировка.освободить()
    }

    /** Рассылает одну реплику ВСЕМ активным клиентам (включая автора - сервер не различает "своё"/"чужое", это дело клиента чата). */
    публичный разослать(сообщение: СообщениеЧата): Пусто
    {
        переменная строка = "[" + сообщение.автор + "] " + сообщение.текст

        этот.блокировка.захватить()
        переменная i = 0
        пока i < этот.клиенты.длина() {
            переменная получатель = этот.клиенты.получить(i)
            если получатель.активен {
                получатель.отправить_строку(строка)
            }
            i++
        }
        этот.блокировка.освободить()
    }

    /** Служебное сообщение от имени самой комнаты (подключение/отключение/переименование) - та же рассылка, свой "автор". */
    публичный объявить(текст: Строка): Пусто
    {
        этот.разослать(новое СообщениеЧата("комната", текст))
    }
}
