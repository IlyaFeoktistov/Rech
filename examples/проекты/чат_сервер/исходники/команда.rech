использовать Клиент из "клиент"
использовать КомнатаЧата из "комната"
использовать СообщениеЧата из "модель"

/**
 * Command (docs/GoF) - одна строка, полученная от клиента ("обработчик.rech"),
 * разобранная (Factory Method - "разбор.rech") в одну из трёх реализаций
 * ниже. "комната.rech" (Mediator) и "клиент.rech" ничего не знают о самих
 * командах - только эта сторона знает и о комнате, и о клиенте разом,
 * поэтому интерфейс принимает ОБОИХ параметрами "выполнить" (Observer.
 * на_событие у examples/проекты/супервизор_процессов - тот же приём:
 * контракт интерфейса, ссылающийся на сущность программы, стал возможен
 * ровно по ходу этого же проекта, docs/ROADMAP.md). Все три реализации
 * ниже названы с "Команда" ПЕРВЫМ словом (не "ВыходКоманда"/
 * "СообщениеКоманда") НАМЕРЕННО - CompoundNounAgreement
 * (internal/morph/exceptions.go) согласует род составного имени по ЕГО
 * ПЕРВОМУ слову, а не по всему имени целиком - разный порядок слов у трёх
 * похожих сущностей раньше требовал бы разного рода у "новый"/"новая"/
 * "новое" для каждой (найдено здесь же: "ВыходКоманда" требовала "новый",
 * не "новая", хотя "Команда" сама по себе - женский род). У "реализует"
 * (винительный падеж имени интерфейса, ниже - "КомандаЧату") падеж
 * склоняется по ПОСЛЕДНЕМУ слову - другое правило, чем у рода после
 * "новый"/"новая"/"новое" выше (по ПЕРВОМУ) - для составных имён это
 * несогласованность между двумя независимыми склоняющими механизмами
 * компилятора, стоит иметь в виду при выборе имени.
 */
интерфейс КомандаЧата
{
    выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
}

/** Обычная реплика - рассылается всем как есть. */
сущность КомандаСообщение реализует КомандаЧату
{
    имеет:
        приватный текст: Строка

    конструктор(текст: Строка)
    {
        этот.текст = текст
    }

    публичный выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
    {
        комната.разослать(новое СообщениеЧата(клиент.имя, этот.текст))
    }
}

/** "/ник ИМЯ" - меняет имя, под которым клиент виден остальным, оповещает комнату о смене. */
сущность КомандаНик реализует КомандаЧату
{
    имеет:
        приватное новое_имя: Строка

    конструктор(новое_имя: Строка)
    {
        этот.новое_имя = новое_имя
    }

    публичный выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
    {
        переменная старое_имя = клиент.имя
        клиент.имя = этот.новое_имя
        комната.объявить(старое_имя + " теперь известен как " + этот.новое_имя)
    }
}

/** "/выход" - клиент помечается неактивным (см. package doc клиент.rech про "активен"), оповещает комнату об уходе. */
сущность КомандаВыход реализует КомандаЧату
{
    публичный выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
    {
        клиент.активен = ложь
        комната.объявить(клиент.имя + " покинул чат")
    }
}
