использовать КомандаСообщение из "команда/сообщение"
использовать КомандаНик из "команда/ник"
использовать КомандаВыход из "команда/выход"
использовать КомандаЧата из "команда/команда"
использовать позиция_в_строке, длина_строки, подстрока из стандарт/строки

константа ПРЕФИКС_НИК   = "/ник "
константа ПРЕФИКС_ВЫХОД = "/выход"

/**
 * Factory Method (docs/GoF) - единственное место программы, решающее, какая
 * именно реализация "КомандаЧата" (команда.rech) соответствует сырой строке
 * от клиента - "обработчик.rech" вызывает только эту функцию, ни разу не
 * упоминая ни одну из трёх сущностей-команд по имени напрямую.
 */
публичная функция разобрать_команду(строка: Строка): КомандаЧата
{
    если позиция_в_строке(строка, ПРЕФИКС_ВЫХОД) == 0 {
        вернуть новая КомандаВыход()
    }
    если позиция_в_строке(строка, ПРЕФИКС_НИК) == 0 {
        переменная длина_префикса = длина_строки(ПРЕФИКС_НИК)
        переменная имя            = подстрока(строка, длина_префикса, длина_строки(строка) - длина_префикса)

        вернуть новая КомандаНик(имя)
    }

    вернуть новая КомандаСообщение(строка)
}
