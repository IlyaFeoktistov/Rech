/**
 * Одно подключение - сокет, под которым клиент известен чату, и его
 * текущее имя (переименовывается "/ник ИМЯ", см. "команда.rech"). "активен"
 * - вместо настоящего удаления из "Список<Клиент>" КомнатыЧата
 * (комната.rech): у Список ЕСТЬ "удалить(индекс): T" (добавлен по ходу
 * этого же проекта - раньше не было вовсе), но найти
 * ИНДЕКС именно этого клиента в списке требует сравнения объектов по
 * ссылке - у сущностей нет "==" (тоже найдено этим проектом, тоже в
 * бэклоге, не исправлено) - оставаться при имени (Строка) ненадёжно (два
 * гостя могут переименоваться в одно и то же). Флаг вместо удаления к тому
 * же безопаснее и без "==": рассылка ("КомнатаЧата.разослать") и без того
 * уже перебирает список под "Блокировкой" - удаление посреди перебора
 * инвалидировало бы текущий индекс цикла, отдельная забота, которой флаг
 * попросту избегает.
 */
сущность Клиент
{
    имеет:
        приватный сокет:   Сокет
        публичное имя:     Строка
        публичный активен: Логическое

    конструктор(сокет: Сокет, имя: Строка)
    {
        этот.сокет = сокет
        этот.имя = имя
        этот.активен = истина
    }

    /**
     * Отправляет текст этому клиенту - если сокет уже разорван с ДРУГОЙ
     * стороны (клиент закрыл соединение сам, до того как сервер успел это
     * заметить в своём собственном цикле чтения, "обработчик.rech"),
     * "отправить" паникует ("Паника",
     * поймать в |-списке) - помечаем клиента неактивным вместо падения
     * всего потока рассылки.
     */
    публичный отправить_строку(текст: Строка): Пусто
    {
        попытаться {
            этот.сокет.отправить(текст + "\n")
        } поймать (ошибка: Паника) {
            этот.активен = ложь
        }
    }

    /**
     * Читает одно сообщение целиком (см. package doc "обработчик.rech" про
     * границы сообщений) - "" значит "собеседник закрыл соединение (тем же
     * значением отвечает и настоящая ошибка чтения - resetнутое TCP-
     * соединение и т. п., "получить" паникует - см. package doc
     * "отправить_строку" выше, та же причина, симметрично для чтения).
     *
     * НАЙДЕННЫЙ ЖИВЬЁМ НЕДОЧЁТ: непойманная "Паника" В
     * ЛЮБОМ потоке ("запустить") завершает ВЕСЬ процесс целиком (rech_panic,
     * cbackend, - безусловный exit(1), не только свой поток) - без этого
     * "попытаться"/"поймать" здесь ОДНО оборвавшееся соединение (например,
     * клиент сети, а не команды "/выход") валило бы ВЕСЬ чат-сервер разом,
     * для ВСЕХ подключённых, не только для себя - воспроизведено вживую при
     * тестировании этого же проекта. Для высоконагруженного продакшена это
     * означает: КАЖДЫЙ поток, обслуживающий отдельное соединение/задачу,
     * обязан сам оборачивать себя в "попытаться"/"поймать (Паника)" на
     * границе - рантайм не даёт такой изоляции бесплатно.
     */
    публичный получить_строку(): Строка
    {
        попытаться {
            вернуть этот.сокет.получить(4096)
        } поймать (ошибка: Паника) {
            этот.активен = ложь

            вернуть ""
        }
    }

    публичный закрыть_соединение(): Пусто
    {
        этот.сокет.закрыть()
    }
}
