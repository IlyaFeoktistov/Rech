/**
 * Одна реплика чата - кто сказал и что именно. "структура" (не "сущность") -
 * неизменяемое значение без собственного состояния, передаётся по значению
 * (docs/SPEC.md, "структура" против "сущность"/"класс") - тот же приём, что
 * и у СобытиеПроцесса в examples/проекты/супервизор_процессов/исходники/
 * модель.rech.
 */
структура СообщениеЧата
{
    имеет:
        автор: Строка
        текст: Строка
}
