использовать Клиент из "@клиент"
использовать КомнатаЧата из "@комната"
использовать КомандаЧата из "команда"

/** "/выход" - клиент помечается неактивным (см. package doc клиент.rech про "активен"), оповещает комнату об уходе. */
сущность КомандаВыход реализует КомандаЧата
{
    публичный выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
    {
        клиент.активен = ложь
        комната.объявить(клиент.имя + " покинул чат")
    }
}
