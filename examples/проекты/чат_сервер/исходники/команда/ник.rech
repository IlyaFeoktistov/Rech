использовать Клиент из "@клиент"
использовать КомнатаЧата из "@комната"
использовать КомандаЧата из "команда"

/** "/ник ИМЯ" - меняет имя, под которым клиент виден остальным, оповещает комнату о смене. */
сущность КомандаНик реализует КомандаЧата
{
    имеет:
        приватное новое_имя: Строка

    конструктор(новое_имя: Строка)
    {
        этот.новое_имя = новое_имя
    }

    публичный выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
    {
        переменная старое_имя = клиент.имя
        клиент.имя = этот.новое_имя
        комната.объявить(старое_имя + " теперь известен как " + этот.новое_имя)
    }
}
