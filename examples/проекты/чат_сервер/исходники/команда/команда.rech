использовать Клиент из "@клиент"
использовать КомнатаЧата из "@комната"

/**
 * Command (docs/GoF) - одна строка, полученная от клиента (обработчик.rech),
 * разобранная (Factory Method - разбор.rech) в одну из трёх реализаций
 * рядом (команда/сообщение.rech, команда/ник.rech, команда/выход.rech).
 * "комната.rech" (Mediator) и "клиент.rech" ничего не знают о самих
 * командах - только эта сторона знает и о комнате, и о клиенте разом,
 * поэтому интерфейс принимает ОБОИХ параметрами "выполнить" (Observer.
 * на_событие у examples/проекты/супервизор_процессов - тот же приём:
 * контракт интерфейса, ссылающийся на сущность программы, стал возможен
 * ровно по ходу этого же проекта). Все три реализации
 * названы с "Команда" ПЕРВЫМ словом (не "ВыходКоманда"/"СообщениеКоманда")
 * НАМЕРЕННО - CompoundNounAgreement (internal/morph/exceptions.go)
 * согласует род составного имени по ЕГО ПЕРВОМУ слову, а не по всему имени
 * целиком - разный порядок слов у трёх похожих сущностей раньше требовал
 * бы разного рода у "новый"/"новая"/"новое" для каждой (найдено здесь же:
 * "ВыходКоманда" требовала "новый", не "новая", хотя "Команда" сама по
 * себе - женский род).
 */
интерфейс КомандаЧата
{
    выполнить(клиент: Клиент, комната: КомнатаЧата): Пусто
}
