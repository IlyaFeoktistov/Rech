использовать Клиент из "клиент"
использовать КомнатаЧата из "комната"
использовать обслужить_клиента из "обработчик"

/**
 * Чат-сервер - в отличие от examples/сеть/эхо_сервер (одно соединение,
 * один ответ), слушает БЕССРОЧНО и держит СКОЛЬКО УГОДНО клиентов разом -
 * поток на соединение (запустить обслужить_клиента), общая "КомнатаЧата"
 * (Mediator, комната.rech) - единственное общее состояние, защищённое
 * собственной "Блокировкой". Останавливается по Ctrl+C/SIGTERM
 * ("запрошена_остановка", тот же принцип, что и у супервизора процессов) -
 * "принять" внутри цикла блокируется до следующего подключения, поэтому
 * сам цикл проверяет остановку только МЕЖДУ подключениями, не мгновенно.
 */
функция главная
{
    переменная порт           = 18090
    переменная слушатель      = сетевой_узел(СетевойПротокол.TCP, "", порт)
    переменная комната        = новая КомнатаЧата()
    переменная счётчик_гостей = 0

    // Без таймаута "принять" блокируется до подключения БЕЗУСЛОВНО -
    // "запрошена_остановка" в теле цикла ниже проверялась бы только МЕЖДУ
    // подключениями, а не в разумный срок после Ctrl+C/SIGTERM без
    // единого нового клиента. 500мс - тот же порядок величины, что и у
    // паузы перед перезапуском в examples/проекты/супервизор_процессов.
    установить_таймаут(слушатель, 500)

    вывести "чат-сервер слушает порт " + (Строка) порт

    пока не запрошена_остановка() {
        переменная соединение = принять(слушатель)
        если !соединение {
            продолжить
        }
        // "соединение" уже доказанно Сокет, не ?Сокет (guard clause выше с
        // "продолжить" сужает его ТЕМ ЖЕ established-механизмом, что и
        // "вернуть"/"выбросить" - docs/ROADMAP.md, найденный по ходу этого
        // же проекта недочёт, снятый) - явный каст "(Сокет) соединение"
        // больше не нужен.
        счётчик_гостей++
        переменная клиент = новый Клиент(соединение, "гость_" + (Строка) счётчик_гостей)
        комната.подключить(клиент)
        переменная задача = запустить обслужить_клиента(клиент, комната)
    }

    закрыть_сокет(слушатель)
}
