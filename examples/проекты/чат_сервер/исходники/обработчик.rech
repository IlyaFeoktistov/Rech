использовать Клиент из "клиент"
использовать КомнатаЧата из "комната"
использовать разобрать_команду из "разбор"
использовать обрезать, длина_строки из стандарт/строки

/**
 * Обслуживает ОДНОГО клиента до отключения - СВОБОДНАЯ функция, не метод
 * "Клиента"/"КомнатыЧата" (у метода есть неявный получатель "этот",
 * совместное владение между потоками не поддержано, docs/SPEC.md, раздел
 * 15 - тот же приём, что у "супервизировать_один" в examples/проекты/
 * супервизор_процессов/исходники/супервизор.rech): "главный.rech" запускает
 * ровно одну такую функцию на каждое принятое соединение ("запустить").
 *
 * Один вызов "получить_строку" (клиент.rech) - ровно ОДНО сообщение: как и
 * examples/сеть/эхо_сервер, эта демонстрация намеренно не решает задачу
 * восстановления границ сообщений внутри TCP-потока (клиент, отправляющий
 * несколько "отправить" подряд одним куском данных, здесь не
 * предусмотрен) - только рассылку всем подключённым. "обрезать" (встроенная
 * функция, добавлена по ходу этого же проекта - раньше её
 * не было, обрезка пробелов писалась вручную прямо здесь) нужна ровно
 * потому, что "получить_строку" не отделяет границы сообщений - настоящий
 * клиент чата (telnet/nc, интерактивный ввод) неизбежно шлёт завершающий
 * перевод строки вместе с текстом.
 */
публичная функция обслужить_клиента(клиент: Клиент, комната: КомнатаЧата): Пусто
{
    комната.объявить(клиент.имя + " присоединился к чату")

    пока клиент.активен {
        переменная строка = обрезать(клиент.получить_строку())
        если длина_строки(строка) == 0 {
            клиент.активен = ложь
            комната.объявить(клиент.имя + " отключился")

            прервать
        }
        разобрать_команду(строка).выполнить(клиент, комната)
    }

    клиент.закрыть_соединение()
}
