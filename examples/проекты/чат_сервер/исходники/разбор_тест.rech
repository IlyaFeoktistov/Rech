использовать разобрать_команду из "разбор"
использовать КомандаНик из "команда/ник"
использовать КомандаСообщение из "команда/сообщение"
использовать КомандаВыход из "команда/выход"

/**
 * Тестовый файл - покрывает "разбор.rech" (Factory Method): по сырой
 * строке от клиента решает, какая ИМЕННО реализация "КомандаЧата" нужна.
 * "выполнить" самих команд здесь НЕ проверяется - ему нужны настоящие
 * "Клиент" (обязательный "Сокет" полем) и "КомнатаЧата", без реального
 * TCP-соединения не сконструировать - за пределами этого среза (см.
 * examples/сеть/эхо_клиент.rech + эхо_сервер.rech про сам приём открытия
 * loopback-соединения, если понадобится тестировать "выполнить" отдельно).
 *
 * Проверить: rech test examples/проекты/чат_сервер/исходники/разбор_тест.rech
 */
функция главная
{
    утверждать разобрать_команду("привет всем") относится к КомандаСообщение, "обычная реплика без префикса - КомандаСообщение"
    утверждать разобрать_команду("/ник Гость42") относится к КомандаНик, `префикс "/ник " - КомандаНик`
    утверждать разобрать_команду("/выход") относится к КомандаВыход, `"/выход" - КомандаВыход`

    // Префикс - только В НАЧАЛЕ строки (позиция_в_строке(...) == 0,
    // разбор.rech) - "/ник" посреди обычной реплики не должен считаться
    // командой.
    утверждать разобрать_команду("а я не знаю /ник этого человека") относится к КомандаСообщение, `"/ник" не в начале строки - обычная реплика`

    // "/выход" - точный префикс без пробела после (в отличие от "/ник ") -
    // "/выходной" тоже начинается с "/выход", значит тоже распознаётся как
    // КомандаВыход (позиция_в_строке ищет ТОЛЬКО префикс, не слово целиком) -
    // задокументированное поведение разбора.rech, не ошибка теста.
    утверждать разобрать_команду("/выходной") относится к КомандаВыход, "разбор.rech сверяет только префикс, не слово целиком"
}
