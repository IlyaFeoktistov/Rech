# Пример-проект: чат-сервер с рассылкой всем подключённым клиентам (в
# отличие от examples/сеть/эхо_сервер - один клиент, один ответ) - здесь
# сообщение ОДНОГО клиента рассылается ВСЕМ остальным, поток на соединение,
# общий список клиентов под "Блокировкой". rech build/run без явного пути к
# файлу подхватывает этот .rechproj из текущего каталога.
проект:
  имя: чат_сервер
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка
