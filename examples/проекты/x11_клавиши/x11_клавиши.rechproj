# Раскладко-независимое чтение клавиши через X11 (libX11), БЕЗ единой
# правки компилятора - см. исходники/x11_клавиши.rech (биндинги + опрос)/
# главный.rech (демо). Альтернатива встроенному "прочитать_код_клавиши"
# (internal/interp/keycode_linux.go) для сессий без прав на /dev/input, но
# с рабочим X11 ($DISPLAY) - SSH с "-X", WSLg, Xvfb.
#
# Собирается ТОЛЬКО на Linux ("_linux" ниже - libX11 там нет на Windows/
# macOS) - тот же принцип, что и у examples/проекты/windows_окна (WinAPI
# наоборот, только Windows).
проект:
  имя: x11_клавиши
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки_linux: X11
