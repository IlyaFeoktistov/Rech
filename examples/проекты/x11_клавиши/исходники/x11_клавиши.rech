/**
 * Раскладко-независимое чтение клавиши через X11 (libX11, "сборка.
 * библиотеки_linux: X11" - см. ../x11_клавиши.rechproj), БЕЗ единой правки
 * компилятора - весь этот файл обычный Rech-код над "внешняя функция"/
 * "внешняя структура" (docs/SPEC.md, раздел 12), тот же приём, что и у
 * examples/проекты/windows_окна/исходники/user32.rech (там - WinAPI).
 *
 * Мотивация - встроенный "прочитать_код_клавиши" (internal/interp/
 * keycode_linux.go) читает /dev/input/eventN (evdev) напрямую, а это
 * требует прав на устройство: обычно их даёт systemd-logind (ACL "uaccess"
 * на активную СЕАНСОВУЮ сессию рабочего стола), поэтому на настоящем
 * desktop-логине evdev обычно и так работает без явной настройки - но НЕ
 * работает там, где logind-сессии нет вовсе (SSH, WSL2, большинство
 * контейнеров/CI). X11 - другой путь К ТОМУ ЖЕ результату: клиент спрашивает
 * не устройство напрямую, а X-сервер (у него самого есть нужные права
 * через тот же logind) через обычный протокол - работает в любой X11-сессии
 * (в т. ч. WSLg/VcXsrv/SSH с "-X"), без единого специального права у самой
 * программы.
 *
 * "XQueryKeymap" - глобальное состояние клавиатуры (какие клавиши СЕЙЧАС
 * зажаты), НЕ привязано к фокусу окна (в отличие от обычных X11 key-
 * событий, которые идут только окну с фокусом) - тот же смысл, что у
 * GetAsyncKeyState в WinAPI, ничего похожего на XGrabKeyboard/окно/цикл
 * событий не нужно. Возвращает битовую карту 256 клавиш (32 байта, бит N -
 * клавиша с X11-кейкодом N) - "внешняя структура" из 32 полей "Байт" ниже
 * даёт ей ОДИНАКОВЫЙ C-макет с "char[32]", хотя реальная C-функция и не
 * знает об этом синтетическом типе (сборка НЕ подключает настоящий
 * заголовок Xlib.h - компилятор пишет прототип сам, тем же путём, что и у
 * strlen/atoi/sqrt в examples/основы/внешние_функции.rech - для чистого C
 * ABI указателей/целых этого достаточно).
 *
 * X11-кейкод = evdev-кейкод (linux/input-event-codes.h, тот же список, что
 * использует встроенный "прочитать_код_клавиши") + 8 - фиксированное
 * смещение X-сервера с драйвером evdev, практически универсальное на
 * современном Linux.
 */
// "Display*" представлен как "Указатель<Байт>", не отдельная "внешняя
// сущность" - опаковые внешние сущности НЕ поддерживают сравнение с
// "Ничто" (в отличие от Указатель<T>, docs/SPEC.md, раздел 22/12), а без
// него нечем было бы отличить "нет X11-сессии" (XOpenDisplay возвращает
// NULL) от настоящего хендла. Rech не заглядывает за этот адрес - для её
// целей "Указатель<Байт>" не отличим от опакового хендла.
внешняя функция XOpenDisplay как открыть_дисплей_x11(имя: Строка): Указатель<Байт>
внешняя функция XCloseDisplay как закрыть_дисплей_x11(дисплей: Указатель<Байт>): Целое

внешняя структура rech_x11_keymap32 как КартаКлавишX11
{
    имеет:
        б00: Байт
        б01: Байт
        б02: Байт
        б03: Байт
        б04: Байт
        б05: Байт
        б06: Байт
        б07: Байт
        б08: Байт
        б09: Байт
        б10: Байт
        б11: Байт
        б12: Байт
        б13: Байт
        б14: Байт
        б15: Байт
        б16: Байт
        б17: Байт
        б18: Байт
        б19: Байт
        б20: Байт
        б21: Байт
        б22: Байт
        б23: Байт
        б24: Байт
        б25: Байт
        б26: Байт
        б27: Байт
        б28: Байт
        б29: Байт
        б30: Байт
        б31: Байт
}

внешняя функция XQueryKeymap как опросить_клавиши_x11(дисплей: Указатель<Байт>, карта: Указатель<КартаКлавишX11>): Целое

/** Пустая (все клавиши "не нажаты") карта - параметр-заготовка для "опросить_клавиши_x11". */
функция новая_пустая_карта(): КартаКлавишX11
{
    константа Н = (Байт) 0
    вернуть новая КартаКлавишX11(
        Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н,
        Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н, Н,
    )
}

/** Бит "позиция" (0..7) значения "байт" - истина, если клавиша с этим кейкодом сейчас зажата. */
функция нажата_ли(байт: Байт, позиция: Целое): Логическое
{
    вернуть (байт & (1 << (Байт) позиция)) != 0
}

/**
 * Открывает соединение с X-сервером ($DISPLAY, обычно ":0") - Ничто, если
 * не удалось (нет X-сервера вовсе - обычная ситуация в headless-сессии без
 * WSLg/Xvfb, тем же принципом, что и "прочитать_код_клавиши" без прав на
 * evdev: не паника, просто "этот способ недоступен здесь").
 */
функция открыть_x11(): Указатель<Байт>
{
    переменная имя     = получить_переменную_окружения("DISPLAY") ?? ":0"
    переменная дисплей = открыть_дисплей_x11(имя)
    если дисплей == Ничто {
        вернуть Ничто
    }
    вернуть дисплей
}

/**
 * Ordinal КодКлавиши (тот же индекс, что у встроенного "прочитать_код_
 * клавиши" - см. docs/SPEC.md, StandardEnums["КодКлавиши"]) для клавиши,
 * зажатой ПРЯМО СЕЙЧАС - только подмножество, нужное геймплейному коду
 * (WASD + стрелки + Escape, тот же набор, что и у ../../змейка/исходники/
 * ввод/раскладконезависимый_ввод.rech) - -1, если ни одна из них не зажата.
 * В отличие от builtin'а - УРОВНЕВЫЙ опрос ("зажата ли клавиша сейчас"), не
 * событие "только что нажали" - для непрерывного движения в игре разницы
 * нет (проверяется каждый кадр).
 */
функция код_зажатой_клавиши(дисплей: Указатель<Байт>): Целое
{
    переменная карта = новая_пустая_карта()
    опросить_клавиши_x11(дисплей, &карта)

    если нажата_ли(карта.б03, 1) {
        вернуть КодКлавиши.W
    }
    если нажата_ли(карта.б04, 6) {
        вернуть КодКлавиши.A
    }
    если нажата_ли(карта.б04, 7) {
        вернуть КодКлавиши.S
    }
    если нажата_ли(карта.б05, 0) {
        вернуть КодКлавиши.D
    }
    если нажата_ли(карта.б13, 7) {
        вернуть КодКлавиши.Вверх
    }
    если нажата_ли(карта.б14, 1) {
        вернуть КодКлавиши.Влево
    }
    если нажата_ли(карта.б14, 2) {
        вернуть КодКлавиши.Вправо
    }
    если нажата_ли(карта.б14, 4) {
        вернуть КодКлавиши.Вниз
    }
    если нажата_ли(карта.б01, 1) {
        вернуть КодКлавиши.Escape
    }
    вернуть -1
}

/**
 * "прочитать_код_клавиши(миллисекунды)" через X11 - тот же контракт, что и
 * у встроенного одноимённого builtin'а (тот же ordinal, -1 - ничего за
 * отведённое время), опрашивает "код_зажатой_клавиши" в цикле со сном
 * между попытками ("спать_мс") - X11 (в отличие от evdev/poll) не даёт
 * заблокироваться на "появилось новое состояние", только мгновенный снимок.
 */
функция прочитать_код_клавиши_x11(дисплей: Указатель<Байт>, миллисекунды: Целое): Целое
{
    константа ШАГ_МС = 15
    переменная осталось = миллисекунды

    пока истина {
        переменная код = код_зажатой_клавиши(дисплей)
        если код != -1 {
            вернуть код
        }
        если миллисекунды >= 0 {
            если осталось <= 0 {
                вернуть -1
            }
            осталось = осталось - ШАГ_МС
        }
        спать_мс(ШАГ_МС)
    }
}
