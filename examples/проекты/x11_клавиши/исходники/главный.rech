// X11 (libX11) есть только на Linux: на другой ОС программа собирается из
// ветки "#иначе" и только сообщает об этом - биндинги x11_клавиши.rech в
// такую сборку не попадают (docs/SPEC.md, раздел 27).
#если ОС.Linux {
    использовать открыть_x11, закрыть_дисплей_x11, прочитать_код_клавиши_x11 из "x11_клавиши"

    /**
     * Демонстрирует раскладко-независимое чтение клавиши через X11 (см.
     * package doc "x11_клавиши.rech") - тот же WASD/стрелки/Escape сценарий,
     * что и examples/консоль/демо_код_клавиши.rech, но БЕЗ встроенного
     * "прочитать_код_клавиши" (доказывает, что того же результата можно
     * добиться и без единой правки компилятора, через обычный FFI).
     *
     * Требует настоящую X11-сессию ($DISPLAY, обычно ":0" - есть в WSLg/
     * реальном рабочем столе Linux, нет в headless-сессии без Xvfb) -
     * "открыть_x11" возвращает Ничто, если её нет, эта программа тогда
     * печатает соответствующее сообщение и завершается, не падая.
     */
    функция главная
    {
        переменная дисплей = открыть_x11()
        если !дисплей {
            вывести `${"нет X11-сессии ($DISPLAY) - этот способ здесь недоступен"}\n`

            вернуть
        }

        вывести `WASD/стрелки - направление, Escape - выход (окно терминала должно быть в фокусе)\n`

        переменная работает = истина
        пока работает {
            переменная код = прочитать_код_клавиши_x11(дисплей, 1000)
            если код == КодКлавиши.W или код == КодКлавиши.Вверх {
                вывести `вверх\n`
            } иначе если код == КодКлавиши.S или код == КодКлавиши.Вниз {
                вывести `вниз\n`
            } иначе если код == КодКлавиши.A или код == КодКлавиши.Влево {
                вывести `влево\n`
            } иначе если код == КодКлавиши.D или код == КодКлавиши.Вправо {
                вывести `вправо\n`
            } иначе если код == КодКлавиши.Escape {
                работает = ложь
            }
        }

        закрыть_дисплей_x11(дисплей)
        вывести `выход\n`
    }
} #иначе {
    константа ТОЛЬКО_LINUX = "этот пример читает клавиши через X11 и работает только на Linux"

    /** На других ОС X11 нет - программа сообщает об этом. */
    публичная функция главная
    {
        вывести `${ТОЛЬКО_LINUX}\n`
    }
}
