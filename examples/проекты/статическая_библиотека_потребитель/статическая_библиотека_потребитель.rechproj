# Пример-проект: программа, в которую при линковке вшивается статическая
# библиотека на Rech (examples/проекты/статическая_библиотека/ рядом -
# собрать сначала её). "библиотеки: статистика_текста" -
# "-lстатистика_текста", линковщик находит libстатистика_текста.a в
# "путь_библиотек". Готовой программе файл библиотеки больше не нужен.
проект:
  имя: статическая_библиотека_потребитель
  версия: 0.1.0

файлы:
  исходники: *.rech
  главный: главный.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  библиотеки: статистика_текста
  путь_библиотек: ../статическая_библиотека/сборка
