// Нейронная сеть с одним скрытым слоем (2 входа -> СКРЫТЫХ_НЕЙРОНОВ ->
// 1 выход, сигмоида на обоих слоях), обучается решать XOR обратным
// распространением ошибки (градиентный спуск) - с нуля, без внешней
// библиотеки линейной алгебры: XOR не разделим одной прямой (нужен хотя
// бы один скрытый слой), классический минимальный пример именно поэтому.

константа СКРЫТЫХ_НЕЙРОНОВ = 4
константа СКОРОСТЬ_ОБУЧЕНИЯ = 0.5
константа ЭПОХ = 20000

/**
 * Сеть с одним скрытым слоем. Веса скрытого слоя - Список<Список<
 * Действительное>> (СКРЫТЫХ_НЕЙРОНОВ строк по 2 веса - у XOR всегда ровно
 * 2 входа), веса выхода - один Список<Действительное> длиной
 * СКРЫТЫХ_НЕЙРОНОВ (единственный выходной нейрон принимает выход каждого
 * скрытого). Оба смещения - отдельными полями/списком, как обычно у
 * backprop-реализаций с нуля.
 */
сущность Сеть
{
    имеет:
        приватная веса_скрытого: Список<Список<Действительное>>
        приватная смещения_скрытого: Список<Действительное>
        приватная веса_выхода: Список<Действительное>
        приватное смещение_выхода: Действительное

    конструктор()
    {
        этот.веса_скрытого = новый Список<Список<Действительное>>()
        этот.смещения_скрытого = новый Список<Действительное>()
        этот.веса_выхода = новый Список<Действительное>()

        для j от 1 до СКРЫТЫХ_НЕЙРОНОВ
        {
            переменная строка = новый Список<Действительное>()
            строка.добавить(этот.случайный_вес())
            строка.добавить(этот.случайный_вес())
            этот.веса_скрытого.добавить(строка)
            этот.смещения_скрытого.добавить(этот.случайный_вес())
            этот.веса_выхода.добавить(этот.случайный_вес())
        }
        этот.смещение_выхода = этот.случайный_вес()
    }

    // Небольшой случайный вес в [-1, 1) - обычный диапазон начальной
    // инициализации для сигмоиды (слишком большие начальные веса быстро
    // насыщают сигмоиду, где производная почти нулевая - обучение
    // застревает).
    приватный случайный_вес(): Действительное
    {
        вернуть (случайное() * 2.0) - 1.0
    }

    приватный сигмоида(x: Действительное): Действительное
    {
        вернуть 1.0 / (1.0 + экспонента(-x))
    }

    // Производная сигмоиды через её же ЗНАЧЕНИЕ y = сигмоида(x), не через
    // x заново - y * (1 - y), стандартное упрощение backprop с сигмоидой.
    приватный производная_сигмоиды(y: Действительное): Действительное
    {
        вернуть y * (1.0 - y)
    }

    // Активации скрытого слоя для одного входного примера (вход - Список
    // длиной 2). Переиспользуется и "предсказать" (только прямой проход),
    // и "обучить_на_примере" (тем же активациям ещё нужно обратное
    // распространение).
    приватный скрытые_активации(вход: Список<Действительное>): Список<Действительное>
    {
        переменная результат = новый Список<Действительное>()
        для j от 0 до (СКРЫТЫХ_НЕЙРОНОВ - 1)
        {
            переменная веса_нейрона = этот.веса_скрытого.получить(j)
            переменная сумма = веса_нейрона.получить(0) * вход.получить(0)
            сумма = сумма + веса_нейрона.получить(1) * вход.получить(1)
            сумма = сумма + этот.смещения_скрытого.получить(j)
            результат.добавить(этот.сигмоида(сумма))
        }
        вернуть результат
    }

    приватный выходная_активация(скрытые: Список<Действительное>): Действительное
    {
        переменная сумма = этот.смещение_выхода
        для j от 0 до (СКРЫТЫХ_НЕЙРОНОВ - 1)
        {
            сумма = сумма + этот.веса_выхода.получить(j) * скрытые.получить(j)
        }
        вернуть этот.сигмоида(сумма)
    }

    /** Только прямой проход - использовать ПОСЛЕ обучения. */
    предсказать(вход: Список<Действительное>): Действительное
    {
        переменная скрытые = этот.скрытые_активации(вход)
        вернуть этот.выходная_активация(скрытые)
    }

    /**
     * Один шаг обучения на одном примере - прямой проход, обратное
     * распространение ошибки, обновление весов (обычный градиентный спуск,
     * без momentum/Adam - для четырёх примеров XOR они не нужны).
     * Возвращает квадрат ошибки этого примера - для отслеживания
     * сходимости в цикле обучения.
     */
    обучить_на_примере(вход: Список<Действительное>, ожидаемый: Действительное): Действительное
    {
        переменная скрытые = этот.скрытые_активации(вход)
        переменная выход = этот.выходная_активация(скрытые)

        переменная ошибка_выхода = ожидаемый - выход
        переменная дельта_выхода = ошибка_выхода * этот.производная_сигмоиды(выход)

        // Дельта каждого скрытого нейрона - вклад в ошибку выхода через
        // его собственный вес, умноженный на производную его же сигмоиды -
        // посчитана здесь, ДО обновления весов выхода ниже (иначе
        // использовала бы уже обновлённые веса, не те, что реально стояли
        // во время прямого прохода).
        переменная дельты_скрытого = новый Список<Действительное>()
        для j от 0 до (СКРЫТЫХ_НЕЙРОНОВ - 1)
        {
            переменная вес_j = этот.веса_выхода.получить(j)
            переменная скрытая_j = скрытые.получить(j)
            переменная дельта_j = дельта_выхода * вес_j * этот.производная_сигмоиды(скрытая_j)
            дельты_скрытого.добавить(дельта_j)
        }

        для j от 0 до (СКРЫТЫХ_НЕЙРОНОВ - 1)
        {
            переменная новый_вес = этот.веса_выхода.получить(j) + СКОРОСТЬ_ОБУЧЕНИЯ * дельта_выхода * скрытые.получить(j)
            этот.веса_выхода.установить(j, новый_вес)
        }
        этот.смещение_выхода = этот.смещение_выхода + СКОРОСТЬ_ОБУЧЕНИЯ * дельта_выхода

        для j от 0 до (СКРЫТЫХ_НЕЙРОНОВ - 1)
        {
            переменная веса_нейрона = этот.веса_скрытого.получить(j)
            переменная дельта_j = дельты_скрытого.получить(j)
            переменная новый_вес0 = веса_нейрона.получить(0) + СКОРОСТЬ_ОБУЧЕНИЯ * дельта_j * вход.получить(0)
            переменная новый_вес1 = веса_нейрона.получить(1) + СКОРОСТЬ_ОБУЧЕНИЯ * дельта_j * вход.получить(1)
            веса_нейрона.установить(0, новый_вес0)
            веса_нейрона.установить(1, новый_вес1)
            переменная новое_смещение = этот.смещения_скрытого.получить(j) + СКОРОСТЬ_ОБУЧЕНИЯ * дельта_j
            этот.смещения_скрытого.установить(j, новое_смещение)
        }

        вернуть ошибка_выхода * ошибка_выхода
    }
}

функция главная
{
    переменная сеть = новая Сеть()

    переменная входы = новый Список<Список<Действительное>>()
    переменная вход1 = новый Список<Действительное>()
    вход1.добавить(0.0)
    вход1.добавить(0.0)
    входы.добавить(вход1)
    переменная вход2 = новый Список<Действительное>()
    вход2.добавить(0.0)
    вход2.добавить(1.0)
    входы.добавить(вход2)
    переменная вход3 = новый Список<Действительное>()
    вход3.добавить(1.0)
    вход3.добавить(0.0)
    входы.добавить(вход3)
    переменная вход4 = новый Список<Действительное>()
    вход4.добавить(1.0)
    вход4.добавить(1.0)
    входы.добавить(вход4)

    переменная ожидаемые = новый Список<Действительное>()
    ожидаемые.добавить(0.0)
    ожидаемые.добавить(1.0)
    ожидаемые.добавить(1.0)
    ожидаемые.добавить(0.0)

    вывести "Обучение (" + (Строка) ЭПОХ + " эпох)..."
    для эпоха от 1 до ЭПОХ
    {
        переменная суммарная_ошибка = 0.0
        для i от 0 до 3
        {
            переменная текущий_вход = входы.получить(i)
            переменная текущий_ожидаемый = ожидаемые.получить(i)
            суммарная_ошибка = суммарная_ошибка + сеть.обучить_на_примере(текущий_вход, текущий_ожидаемый)
        }
        если эпоха % 2000 == 0
        {
            вывести "эпоха " + (Строка) эпоха + " - средняя ошибка: " + (Строка) (суммарная_ошибка / 4.0)
        }
    }

    вывести ""
    вывести "Результат после обучения:"
    для i от 0 до 3
    {
        переменная текущий_вход = входы.получить(i)
        переменная x1 = текущий_вход.получить(0)
        переменная x2 = текущий_вход.получить(1)
        переменная предсказание = сеть.предсказать(текущий_вход)
        переменная ожидаемый = ожидаемые.получить(i)
        вывести (Строка) x1 + " XOR " + (Строка) x2 + " = " + (Строка) предсказание + " (ожидалось " + (Строка) ожидаемый + ")"
    }
}
