использовать Сеть из "сеть"
использовать модуль из стандарт/математика

/**
 * Тестовый файл - покрывает "сеть.rech" (нейросеть с одним скрытым слоем)
 * БЕЗ полного обучения (главный.rech гоняет 20000 эпох x 4 примера - ровно
 * то, что check_examples.sh намеренно не запускает, "долго исполняется",
 * см. её package doc). Веса инициализируются случайно ("случайный_вес") -
 * точных числовых значений здесь не проверить, только СВОЙСТВА: "предсказать"
 * всегда в диапазоне сигмоиды, "обучить_на_примере" в целом уменьшает ошибку
 * на ОДНОМ примере за несколько десятков шагов (не гоняя все 20000 эпох).
 *
 * Проверить: rech test examples/проекты/нейросеть_xor/исходники/сеть_тест.rech
 */
функция главная
{
    переменная сеть = новая Сеть()

    переменная вход = новый Список<Действительное>()
    вход.добавить(1.0)
    вход.добавить(0.0)

    // Сигмоида на выходе - результат всегда строго в (0, 1), независимо от
    // конкретных случайных весов.
    переменная предсказание = сеть.предсказать(вход)
    утверждать предсказание > 0.0 и предсказание < 1.0, "выход сигмоиды должен лежать строго между 0 и 1"

    // Несколько шагов обучения НА ОДНОМ примере (не все 20000 эпох x 4
    // примера, как в главный.rech) - ошибка (квадрат разности) должна в
    // целом пойти вниз: сравниваем ошибку первого шага с ошибкой сильно
    // позже, не шаг за шагом (градиентный спуск не обязан монотонно
    // уменьшать ошибку на КАЖДОМ отдельном шаге).
    переменная ожидаемый     = 1.0
    переменная первая_ошибка = сеть.обучить_на_примере(вход, ожидаемый)
    для i от 1 до 200 {
        сеть.обучить_на_примере(вход, ожидаемый)
    }
    переменная поздняя_ошибка = сеть.обучить_на_примере(вход, ожидаемый)

    утверждать поздняя_ошибка < первая_ошибка, "после 200 шагов обучения на одном примере ошибка должна заметно уменьшиться"

    // Предсказание после обучения должно приблизиться к ожидаемому 1.0
    // сильнее, чем было в самом начале (тот же критерий, что и у ошибки
    // выше, только через "предсказать", а не возвращаемое значение
    // "обучить_на_примере").
    переменная предсказание_после = сеть.предсказать(вход)
    утверждать модуль(предсказание_после - ожидаемый) < модуль(предсказание - ожидаемый), "предсказание должно приблизиться к ожидаемому значению после обучения"
}
