# Пример-проект: нейронная сеть с одним скрытым слоем, обучается решать
# XOR обратным распространением ошибки с нуля - без внешней библиотеки
# линейной алгебры/машинного обучения, только базовая арифметика и
# generic-коллекции языка (rech build/run без явного пути к файлу -
# подхватывает этот .rechproj из текущего каталога).
проект:
  имя: нейросеть_xor
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/сеть.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  # тип: библиотека (по умолчанию - "программа", обычный исполняемый файл)
  # библиотеки: curl, ssl (внешние библиотеки для линковки, через запятую)

# окружение:
#   RECH_HTTP_PORT: 8080 (переменные окружения для "rech run" - вместо
#   "ПЕРЕМЕННАЯ=значение rech run" перед каждым запуском)

# зависимости:
#   имя: https://github.com/пользователь/репозиторий v1.2.0 (URL и версия
#   через пробел - тег/ветка/коммит; "имя" - как зависимость видна в
#   "использовать ... из" внутри исходников проекта)
