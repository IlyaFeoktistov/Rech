# Пример-проект: закрытая (бинарная) поставка Rech-библиотеки (docs/
# SPEC.md, "Закрытые (бинарные) пакеты") - "сборка: тип: библиотека" (тот
# же механизм, что у examples/проекты/экспорт_библиотеки/), но точка.rech
# экспортирует МЕТОДЫ и КОНСТРУКТОР сущности, не только свободные функции -
# "rech build --lib" рядом с .so/.dylib/.dll и .h заодно пишет .rechi
# (публичный интерфейс в синтаксисе САМОГО Rech) - см. examples/проекты/
# закрытый_пакет_потребитель/ рядом, подключающий уже собранный .rechi
# БЕЗ единой ручной "внешняя ..."-строки (в отличие от потребителя
# examples/проекты/экспорт_библиотеки_потребитель/).
#
# "проект.имя" здесь - буквально имя собранного файла ("сборка/<имя>.so"),
# "lib" впереди ОБЯЗАТЕЛЕН - тем же принципом, что и у экспорт_библиотеки
# (см. её package doc .rechproj).
проект:
  имя: libзакрытый_пакет
  версия: 0.1.0

файлы:
  главный: точка.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  тип: библиотека
