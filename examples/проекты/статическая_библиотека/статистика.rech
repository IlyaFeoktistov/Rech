// Статистика текста - библиотека без "функция главная": собирается в архив
// libстатистика_текста.a (см. .rechproj). Наружу видны только функции,
// помеченные "экспортировать", - остальной код, включая рантайм Rech,
// остаётся внутри архива.

константа ПРОБЕЛ = " "

/** Количество слов - частей текста, разделённых пробелами. */
экспортировать функция количество_слов(текст: Строка): Целое
{
    Список<Строка> слова      = разбить(текст, ПРОБЕЛ)
    Целое          количество = 0
    для слово в словах {
        если слово != "" {
            количество++
        }
    }
    вернуть количество
}

/** Длина самого длинного слова в символах. */
экспортировать функция длина_самого_длинного(текст: Строка): Целое
{
    Список<Строка> слова      = разбить(текст, ПРОБЕЛ)
    Целое          наибольшая = 0
    для слово в словах {
        если длина_строки(слово) > наибольшая {
            наибольшая = длина_строки(слово)
        }
    }
    вернуть наибольшая
}
