# Пример-проект: статическая библиотека на Rech ("сборка.тип:
# статическая_библиотека") - архив libстатистика_текста.a + заголовок .h.
# Код библиотеки вшивается в программу-потребителя при линковке (см.
# examples/проекты/статическая_библиотека_потребитель/ рядом) - в отличие от
# examples/проекты/экспорт_библиотеки, рядом с готовой программой не нужен
# отдельный .so/.dylib/.dll.
#
# "lib" в начале имени - соглашение линковщика: "-lстатистика_текста" ищет
# файл "libстатистика_текста.a".
проект:
  имя: libстатистика_текста
  версия: 0.1.0

файлы:
  исходники: *.rech
  главный: статистика.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  тип: статическая_библиотека
