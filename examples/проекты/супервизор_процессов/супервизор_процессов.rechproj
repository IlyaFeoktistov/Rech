# Пример-проект: мини-супервизор процессов (как systemd/supervisord в
# миниатюре) - rech build/run без явного пути к файлу подхватывает этот
# .rechproj из текущего каталога.
проект:
  имя: супервизор_процессов
  версия: 0.1.0

файлы:
  исходники: исходники/**/*.rech
  главный: исходники/главный.rech
  выход: сборка
