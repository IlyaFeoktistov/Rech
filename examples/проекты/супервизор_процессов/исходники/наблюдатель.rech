использовать СобытиеПроцесса из "модель"

/**
 * Наблюдатель (Observer) - реагирует на каждое событие жизненного цикла
 * супервизируемого процесса, не зная заранее, сколько их будет и куда
 * именно они пишут (консоль/файл/куда угодно ещё) - "супервизор.rech"
 * держит их СПИСКОМ и оповещает всех разом, ничего не зная о конкретных
 * реализациях ниже.
 */
интерфейс Наблюдатель
{
    на_событие(событие: СобытиеПроцесса): Пусто
}

/**
 * Общее форматирование строки события - "[ГГГГ-ММ-ДД ЧЧ:ММ:СС] [имя]
 * сообщение" - одно место для обеих реализаций ниже (не дублировать
 * между "КонсольныйНаблюдатель"/"ФайловыйНаблюдатель" - тот же приём,
 * что и у examples/проекты/http_сервер/исходники/логгер/логгер.rech).
 */
приватная функция отформатировать(событие: СобытиеПроцесса): Строка
{
    переменная метка_времени = дату_в_строку(время_как_дата(время()))
    вернуть "[" + метка_времени + "] [" + событие.имя + "] " + событие.сообщение
}

/** Печатает события в стандартный вывод - удобно для интерактивного запуска. */
сущность КонсольныйНаблюдатель реализует Наблюдателя
{
    публичный на_событие(событие: СобытиеПроцесса): Пусто
    {
        вывести отформатировать(событие)
    }
}

/**
 * Дописывает события в файл журнала - для запуска без интерактивного
 * терминала (systemd/docker и т. п.), где смотреть stdout некому.
 */
сущность ФайловыйНаблюдатель реализует Наблюдателя
{
    имеет:
        приватный путь: Строка

    конструктор(путь: Строка)
    {
        этот.путь = путь
    }

    публичный на_событие(событие: СобытиеПроцесса): Пусто
    {
        дописать_в_файл(этот.путь, отформатировать(событие) + "\n")
    }
}
