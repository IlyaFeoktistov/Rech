использовать СобытиеПроцесса из "@модель/событие_процесса"
использовать Наблюдатель из "наблюдатель"
использовать отформатировать из "форматирование"

/**
 * Дописывает события в файл журнала - для запуска без интерактивного
 * терминала (systemd/docker и т. п.), где смотреть stdout некому.
 */
сущность ФайловыйНаблюдатель реализует Наблюдатель
{
    имеет:
        приватная Строка путь

    конструктор(путь: Строка)
    {
        этот.путь = путь
    }

    публичный на_событие(событие: СобытиеПроцесса): Пусто
    {
        дописать_в_файл(этот.путь, отформатировать(событие) + `\n`)
    }
}
