использовать СобытиеПроцесса из "@модель/событие_процесса"
использовать Наблюдатель из "наблюдатель"
использовать отформатировать из "форматирование"

/** Печатает события в стандартный вывод - удобно для интерактивного запуска. */
сущность КонсольныйНаблюдатель реализует Наблюдатель
{
    публичный на_событие(событие: СобытиеПроцесса): Пусто
    {
        вывести отформатировать(событие)
    }
}
