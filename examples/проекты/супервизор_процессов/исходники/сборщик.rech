использовать СпецификацияПроцесса из "модель/спецификация_процесса"
использовать СтратегияПерезапуска из "стратегия/стратегия"
использовать Наблюдатель из "наблюдатель/наблюдатель"
использовать Оповещатель из "оповещатель"
использовать ФабрикаСпецификаций из "фабрика/фабрика"
использовать Супервизор из "супервизор"
использовать Контейнер из "контейнер"

/**
 * Строитель (Builder) супервизора - копит спецификации/наблюдателей по
 * одному (через ковариантный "этот", docs/SPEC.md - каждый шаг всё равно
 * сохраняется в отдельную переменную, "результат вызова метода не может
 * быть получателем следующего вызова напрямую", см. examples/сущности/
 * ковариантный_возврат.rech), затем "собрать()" собирает наблюдателей в
 * "Оповещатель" и отдаёт готовый "Супервизор" одним куском - вызывающая
 * сторона ("главная.rech") не видит ни списков, ни порядка их заполнения.
 * Фабрика спецификаций НЕ передана отдельным параметром конструктора - сам
 * "СборщикСупервизора" резолвит её из переданного DI-контейнера
 * ("контейнер.rech") по типу, разово, в момент первой реальной надобности
 * (публичный "добавить_процесс") - вызывающая сторона ("главный.rech") не
 * решает ЗА него, какую конкретно фабрику дать, только регистрирует её В
 * контейнер вместе с остальными сервисами.
 */
сущность СборщикСупервизора
{
    имеет:
        приватный Контейнер                    контейнер
        приватный Список<СпецификацияПроцесса> спецификации
        приватный Список<Наблюдатель>          наблюдатели

    конструктор(контейнер: Контейнер)
    {
        этот.контейнер = контейнер
        этот.спецификации = новый Список<СпецификацияПроцесса>()
        этот.наблюдатели = новый Список<Наблюдатель>()
    }

    публичный добавить_процесс(имя: Строка, команда: Строка, аргументы: Список<Строка>, стратегия: СтратегияПерезапуска): этот
    {
        переменная фабрика = этот.контейнер.разрешить(тип ФабрикаСпецификаций) как ФабрикаСпецификаций
        этот.спецификации.добавить(фабрика.создать(имя, команда, аргументы, стратегия))
        вернуть этот
    }

    публичный добавить_наблюдателя(наблюдатель: Наблюдатель): этот
    {
        этот.наблюдатели.добавить(наблюдатель)
        вернуть этот
    }

    публичный собрать(): Супервизор
    {
        если этот.спецификации.длина() == 0 {
            выбросить новое Исключение("СборщикСупервизора: нужна хотя бы одна спецификация процесса")
        }
        переменная оповещатель = новый Оповещатель(этот.наблюдатели)
        вернуть новый Супервизор(этот.спецификации, оповещатель)
    }
}
