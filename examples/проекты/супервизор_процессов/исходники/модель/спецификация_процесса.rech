использовать СтратегияПерезапуска из "@стратегия/стратегия"

/**
 * Одна инструкция супервизору: что запускать, чем (аргументы), и как
 * реагировать на завершение ("стратегия" - Strategy, "стратегия/
 * стратегия.rech" - не голое перечисление: сама решает, перезапускать ли,
 * вместо того чтобы супервизор разбирал варианты сам). "структура" (не
 * "сущность") - неизменяемое описание, передаётся по значению,
 * собственного состояния не хранит (см. docs/SPEC.md, "структура" против
 * "сущность"/"класс").
 */
структура СпецификацияПроцесса
{
    имеет:
        Строка               имя
        Строка               команда
        Список<Строка>       аргументы
        СтратегияПерезапуска стратегия
}
