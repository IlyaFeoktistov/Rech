использовать ВсегдаПерезапускать, ПерезапускатьПриОшибке, НикогдаНеПерезапускать из "стратегия"
использовать СтандартнаяФабрика из "фабрика"
использовать КонсольныйНаблюдатель, ФайловыйНаблюдатель из "наблюдатель"
использовать СборщикСупервизора из "сборщик"

/**
 * Мини-супервизор процессов (как systemd/supervisord в миниатюре) -
 * держит несколько внешних команд живыми, перезапуская их по стратегии
 * (Strategy - "стратегия.rech"), и оповещает наблюдателей (Observer -
 * "наблюдатель.rech": консоль + файл журнала "супервизор.log") о каждом
 * запуске/завершении/перезапуске. Всё собрано здесь единственный раз,
 * через Builder ("сборщик.rech") - ни одна сущность не создаёт свои
 * зависимости сама, только принимает их конструктором (DI).
 *
 * Три демонстрационные спецификации:
 *   - "долгоживущий" ("sleep 3", ВсегдаПерезапускать) - имитация
 *     настоящего демона: завершается сам (sleep не бесконечен) и
 *     перезапускается снова и снова, пока супервизор не остановлен.
 *   - "разовая_задача" ("true", НикогдаНеПерезапускать) - завершается
 *     успешно (код 0) и ОДИН РАЗ - стратегия запрещает перезапуск,
 *     независимо от исхода.
 *   - "нестабильный" ("false", ПерезапускатьПриОшибке) - всегда
 *     завершается с кодом 1, значит перезапускается снова и снова (та же
 *     стратегия на успешный код 0 не перезапустила бы).
 *
 * Останавливается по Ctrl+C (SIGINT) или SIGTERM - "запрошена_остановка"
 * замечается КАЖДЫМ из трёх потоков-супервизоров между перезапусками, не
 * только главным потоком.
 */
функция главная
{
    переменная фабрика = новая СтандартнаяФабрика()
    переменная сборщик = новый СборщикСупервизора(фабрика)

    переменная аргументы_сна = новый Список<Строка>()
    аргументы_сна.добавить("3")
    сборщик = сборщик.добавить_процесс("долгоживущий", "sleep", аргументы_сна, новая ВсегдаПерезапускать())

    переменная без_аргументов = новый Список<Строка>()
    сборщик = сборщик.добавить_процесс("разовая_задача", "true", без_аргументов, новая НикогдаНеПерезапускать())
    сборщик = сборщик.добавить_процесс("нестабильный", "false", без_аргументов, новая ПерезапускатьПриОшибке())

    сборщик = сборщик.добавить_наблюдателя(новый КонсольныйНаблюдатель())
    сборщик = сборщик.добавить_наблюдателя(новый ФайловыйНаблюдатель("супервизор.log"))

    переменная супервизор = сборщик.собрать()
    супервизор.запустить_всё()
}
