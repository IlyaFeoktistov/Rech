использовать ВсегдаПерезапускать из "всегда_перезапускать"
использовать НикогдаНеПерезапускать из "никогда_не_перезапускать"
использовать ПерезапускатьПриОшибке из "перезапускать_при_ошибке"

/**
 * Тестовый файл - покрывает три реализации "СтратегияПерезапуска" (Strategy)
 * рядом в этой же папке - каждая решает "нужно_ли_перезапустить" по коду
 * возврата процесса, без реального запуска ни одного процесса.
 *
 * Проверить: rech test examples/проекты/супервизор_процессов/исходники/стратегия/стратегия_тест.rech
 */
функция главная
{
    переменная всегда = новая ВсегдаПерезапускать()
    утверждать всегда.нужно_ли_перезапустить(0), "ВсегдаПерезапускать - истина при успехе"
    утверждать всегда.нужно_ли_перезапустить(1), "ВсегдаПерезапускать - истина и при ошибке"

    переменная никогда = новая НикогдаНеПерезапускать()
    утверждать не никогда.нужно_ли_перезапустить(0), "НикогдаНеПерезапускать - ложь при успехе"
    утверждать не никогда.нужно_ли_перезапустить(1), "НикогдаНеПерезапускать - ложь и при ошибке"

    переменная при_ошибке = новая ПерезапускатьПриОшибке()
    утверждать не при_ошибке.нужно_ли_перезапустить(0), "ПерезапускатьПриОшибке - ложь при успешном завершении (0)"
    утверждать при_ошибке.нужно_ли_перезапустить(1), "ПерезапускатьПриОшибке - истина при ошибке (код != 0)"
    утверждать при_ошибке.нужно_ли_перезапустить(-1), "ПерезапускатьПриОшибке - истина и при отрицательном коде"
}
