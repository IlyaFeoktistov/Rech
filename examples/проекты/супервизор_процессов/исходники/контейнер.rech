/**
 * DI-контейнер (тот же паттерн, что и у examples/проекты/http_сервер/
 * исходники/контейнер.rech) - НАСТОЯЩИЙ контейнер, не просто "конструктор
 * принимает зависимость параметром" (это уже было в "сборщик.rech" и само
 * по себе тоже DI, "poor man's DI", ручное связывание в композиционном
 * корне - "главный.rech" - остаётся ИМ ЖЕ, конкретные реализации по-
 * прежнему собираются через "новый" там же, это правильное место): разница
 * в том, ЧТО получает потребитель - здесь не ссылку на КОНКРЕТНЫЙ объект,
 * а САМ КОНТЕЙНЕР, и уже сам решает, КАКОЙ тип ему нужен, реф­лексивно
 * ("разрешить(тип Х)"), не заранее известным полем/параметром на каждую
 * зависимость поштучно - добавить ещё одну зависимость в будущем не
 * потребует менять сигнатуру ни одного потребителя контейнера.
 *
 * Хранилище - Список<Значение> боксированных сервисов (см. "главный.rech" -
 * "новый Контейнер(сервисы)"), "разрешить" находит среди них тот, чей
 * ФАКТИЧЕСКИЙ тип совпадает с запрошенным именем либо реализует его как
 * интерфейс (тип "фабрика" зарегистрирован как конкретная
 * "СтандартнаяФабрика", а запрошен может быть как интерфейс
 * "ФабрикаСпецификаций").
 */
сущность Контейнер
{
    имеет:
        приватные сервисы: Список<Значение>

    конструктор(сервисы: Список<Значение>)
    {
        этот.сервисы = сервисы
    }

    публичный разрешить(запрошенный: Тип): Значение
    {
        переменная сервисы = этот.сервисы
        для i от 0 до (сервисы.длина() - 1) {
            переменная сервис      = сервисы.получить(i)
            переменная фактический = сервис.тип_значения()
            если фактический.имя() == запрошенный.имя() || фактический.реализует_ли(запрошенный) {
                вернуть сервис
            }
        }
        выбросить новое Исключение("неразрешённая зависимость: " + запрошенный.имя())
    }
}
