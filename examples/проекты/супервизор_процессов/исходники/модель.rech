использовать СтратегияПерезапуска из "стратегия"

/**
 * Одна инструкция супервизору: что запускать, чем (аргументы), и как
 * реагировать на завершение ("стратегия" - Strategy, "стратегия.rech" -
 * не голое перечисление: сама решает, перезапускать ли, вместо того
 * чтобы супервизор разбирал варианты сам). "структура" (не "сущность") -
 * неизменяемое описание, передаётся по значению, собственного состояния
 * не хранит (см. docs/SPEC.md, "структура" против "сущность"/"класс").
 */
структура СпецификацияПроцесса
{
    имеет:
        имя: Строка
        команда: Строка
        аргументы: Список<Строка>
        стратегия: СтратегияПерезапуска
}

/**
 * Один факт из жизни супервизируемого процесса (запуск/завершение/
 * перезапуск) - на это реагируют наблюдатели ("наблюдатель.rech").
 */
структура СобытиеПроцесса
{
    имеет:
        имя: Строка
        сообщение: Строка
}
