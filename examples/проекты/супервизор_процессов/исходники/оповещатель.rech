использовать СобытиеПроцесса из "модель/событие_процесса"
использовать Наблюдатель из "наблюдатель/наблюдатель"

/**
 * Рассылает события всем наблюдателям по очереди - держит их СПИСКОМ
 * (внедрён через конструктор - см. "сборщик.rech"), сама не знает,
 * сколько их и что каждый из них делает. Отдельная сущность, не метод
 * "Супервизора" - именно её, а не сырой Список<Наблюдатель>, принимает
 * свободная функция "супервизировать_один" ("супервизор.rech"), которой
 * нужно рассылать события ИЗ ЧУЖОГО ПОТОКА (см. её package doc про то,
 * почему она вообще свободная, не метод).
 */
сущность Оповещатель
{
    имеет:
        приватный Список<Наблюдатель> наблюдатели

    конструктор(наблюдатели: Список<Наблюдатель>)
    {
        этот.наблюдатели = наблюдатели
    }

    публичный оповестить(имя: Строка, сообщение: Строка): Пусто
    {
        переменная событие = новое СобытиеПроцесса(имя, сообщение)
        переменная i       = 0
        пока i < этот.наблюдатели.длина() {
            этот.наблюдатели.получить(i).на_событие(событие)
            i++
        }
    }
}
