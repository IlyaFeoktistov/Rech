использовать СпецификацияПроцесса из "@модель/спецификация_процесса"
использовать СтратегияПерезапуска из "@стратегия/стратегия"
использовать ФабрикаСпецификаций из "фабрика"

/** Единственная сейчас реализация - проверка входных данных, без внешнего источника конфигурации. */
сущность СтандартнаяФабрика реализует ФабрикаСпецификаций
{
    публичный создать(имя: Строка, команда: Строка, аргументы: Список<Строка>, стратегия: СтратегияПерезапуска): СпецификацияПроцесса
    {
        если длина_строки(команда) == 0 {
            выбросить новое Исключение(`спецификация "` + имя + `": команда не может быть пустой`)
        }
        вернуть новая СпецификацияПроцесса(имя, команда, аргументы, стратегия)
    }
}
