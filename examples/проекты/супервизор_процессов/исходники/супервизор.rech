использовать СпецификацияПроцесса из "модель/спецификация_процесса"
использовать Оповещатель из "оповещатель"
использовать запрошена_остановка, запустить_процесс из стандарт/система
использовать спать_мс из стандарт/время
использовать дождаться_всех_задач из стандарт/параллельность

/**
 * Держит одну спецификацию живой: запускает процесс, блокируется до его
 * завершения, по стратегии - перезапускает. СВОБОДНАЯ функция, не метод
 * "Супервизора" - только свободную функцию можно передать в "запустить"
 * (docs/SPEC.md, раздел 15 - у метода есть неявный получатель "этот",
 * совместное владение которым между потоками не поддержано).
 * "спецификация"/"оповещатель" переданы явно ПАРАМЕТРАМИ ровно поэтому -
 * не через "этот", которого здесь попросту нет; сама "спецификация" несёт
 * СВОЮ "стратегию" (Strategy) - вызывать её метод на переданном объекте
 * ничем не отличается от вызова любого другого метода параметра.
 */
приватная функция супервизировать_один(спецификация: СпецификацияПроцесса, оповещатель: Оповещатель): Пусто
{
    пока не запрошена_остановка() {
        оповещатель.оповестить(спецификация.имя, "запуск: " + спецификация.команда)
        переменная процесс = запустить_процесс(спецификация.команда, спецификация.аргументы)
        переменная код     = процесс.дождаться_завершения()
        оповещатель.оповестить(спецификация.имя, "завершился с кодом " + (Строка) код)

        если запрошена_остановка() || не спецификация.стратегия.нужно_ли_перезапустить(код) {
            вернуть
        }
        // Пауза перед перезапуском (упрощённый backoff - фиксированная
        // задержка, не растущая, как у настоящего supervisord) - иначе
        // спецификация с "ПерезапускатьПриОшибке" и всегда ненулевым кодом
        // долбила бы перезапусками без остановки, забивая и журнал, и
        // процессор.
        спать_мс(500)
        оповещатель.оповестить(спецификация.имя, "перезапуск")
    }
}

/**
 * Композиционный корень: держит спецификации и оповещателя, ОБА
 * ВНЕДРЕНЫ через конструктор (Dependency Injection) - сам "Супервизор"
 * не создаёт ни одной из своих зависимостей, только пользуется ими (см.
 * "сборщик.rech", единственное место, которое их собирает вместе).
 */
сущность Супервизор
{
    имеет:
        приватный Список<СпецификацияПроцесса> спецификации
        приватный Оповещатель                  оповещатель

    конструктор(спецификации: Список<СпецификацияПроцесса>, оповещатель: Оповещатель)
    {
        этот.спецификации = спецификации
        этот.оповещатель = оповещатель
    }

    /**
     * Запускает по потоку ОС на каждую спецификацию и ждёт общей
     * остановки (SIGINT/SIGTERM, "запрошена_остановка") - каждый поток
     * сам решает, продолжать ли супервизировать СВОЙ процесс, дальше.
     */
    публичный запустить_всё(): Пусто
    {
        переменная i = 0
        пока i < этот.спецификации.длина() {
            переменная спецификация = этот.спецификации.получить(i)
            переменная задача       = запустить супервизировать_один(спецификация, этот.оповещатель)
            i++
        }
        пока не запрошена_остановка() {
            спать_мс(200)
        }
        этот.оповещатель.оповестить("супервизор", "получен сигнал остановки, жду завершения потоков")
        дождаться_всех_задач(10000)
    }
}
