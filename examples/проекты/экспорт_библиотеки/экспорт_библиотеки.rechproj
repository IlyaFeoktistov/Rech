# Пример-проект: библиотека на Rech, собираемая в разделяемую библиотеку
# ("сборка: тип: библиотека" ниже) для подключения ДРУГОЙ Rech-программой
# через FFI ("внешняя функция"/"внешняя сущность", docs/SPEC.md, раздел
# 12) - см. examples/проекты/экспорт_библиотеки_потребитель/ рядом,
# использующий уже собранный здесь .so/.dylib/.dll ровно как любую другую
# стороннюю C-библиотеку (libcurl и т. п.), без какого-либо отличия для
# компилятора - тот не знает и не должен знать, что эта конкретная
# библиотека тоже написана на Rech.
#
# "проект.имя" здесь - НЕ производное от имени файла-исходника, а буквально
# то самое имя, что получит собранный файл ("сборка/<имя>.so") - "lib"
# впереди ОБЯЗАТЕЛЕН (тот же принцип именования, что у настоящих системных
# библиотек): "сборка.библиотеки: экспорт_библиотеки" у потребителя ниже
# - это "-lэкспорт_библиотеки" для линковщика, который ищет РОВНО
# "libэкспорт_библиотеки.so" (стандартное соглашение cc/ld об именах
# "-l<имя>" -> "lib<имя>.so" - без префикса "lib" в имени проекта
# потребитель не смог бы найти этот файл вообще, независимо от Rech).
проект:
  имя: libэкспорт_библиотеки
  версия: 0.1.0

файлы:
  исходники: "*.rech"
  главный: точка.rech
  выход: сборка

сборка:
  режим: отладка
  платформа: текущая
  тип: библиотека
