/**
 * Библиотека на Rech - собирается ЭТИМ проектом (см. package doc
 * .rechproj, "сборка: тип: библиотека") в разделяемую .so/.dylib/.dll +
 * заголовок .h, а не в исполняемый файл - у неё сознательно нет
 * "функция главная" (docs/SPEC.md, "Экспорт в разделяемую библиотеку" -
 * "у библиотеки, не исполняемой как программа, точки входа вообще нет").
 * Опаковый указатель наружу (Точка - ссылочная сущность, помеченная
 * "экспортировать") - вызывающая сторона (другой язык - C/Python/Go, ИЛИ
 * другая Rech-программа через "внешняя функция", см. examples/проекты/
 * экспорт_библиотеки_потребитель/) никогда не видит поля напрямую,
 * только через явные функции-геттеры ниже - так же вела бы себя
 * настоящая C-библиотека с непрозрачным хендлом.
 */
экспортировать сущность Точка
{
    имеет:
        x: Целое
        y: Целое

    конструктор(x: Целое, y: Целое)
    {
        этот.x = x
        этот.y = y
    }
}

/**
 * Складывает два целых числа. Doc-комментарий попадает в собранный .h
 * как настоящий C-комментарий - потребитель библиотеки (даже на другом
 * языке) видит документацию автора, не только голую сигнатуру.
 */
экспортировать функция сумма(а: Целое, б: Целое): Целое
{
    вернуть а + б
}

// Сущность в сигнатуре экспортируемой функции допустима, только если сама
// сущность тоже помечена "экспортировать" (Точка выше) - у вызывающей
// стороны снаружи оказывается указатель.
экспортировать функция новая_точка(x: Целое, y: Целое): Точка
{
    вернуть новая Точка(x: x, y: y)
}

// Геттеры - единственный способ прочитать поля Точки снаружи библиотеки
// (опаковый указатель, ни один язык-потребитель не знает реальный layout
// структуры).
экспортировать функция х_точки(п: Точка): Целое
{
    вернуть п.x
}

экспортировать функция у_точки(п: Точка): Целое
{
    вернуть п.y
}
