/** Делит список на равные пары - выходит за границы, если элементов нечётное число. */
функция суммаПарами(числа: Список<Целое>): Целое
{
    переменная сумма  = 0
    переменная индекс = 0
    пока индекс < числа.длина() {
        сумма = сумма + числа.получить(индекс) + числа.получить(индекс + 1)
        индекс = индекс + 2
    }
    вернуть сумма
}

/**
 * Демонстрирует "поймать (x: Паника)" - изоляцию системной паники (выход за
 * границы Список/Стопка/Очередь, "утверждать", несовпадение "как"/рефлексии
 * и т. п.), отдельную от обычного "выбросить"/"поймать(Тип)".
 */
функция главная
{
    переменная числа = новый Список<Целое>()
    числа.добавить(1)
    числа.добавить(2)
    числа.добавить(3)

    попытаться {
        вывести суммаПарами(числа)
    } поймать(сообщение: Паника) {
        вывести "паника перехвачена: "
        вывести сообщение
    }

    // Программа продолжает исполняться после перехвата - паника не
    // аварийно завершает процесс, как обычно.
    вывести "работа продолжается"

    // "поймать(x: Паника)" ловит ТОЛЬКО системную панику - "выбросить"
    // пролетает сквозь него насквозь, до настоящего "поймать(Исключение)".
    попытаться {
        попытаться {
            выбросить новое Исключение("настоящее исключение")
        } поймать(сообщение: Паника) {
            вывести "сюда не попадёт"
        }
    } поймать(иск: Исключение) {
        вывести "поймано снаружи: "
        вывести иск.сообщение
    }
}
