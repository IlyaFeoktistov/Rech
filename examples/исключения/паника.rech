/** Делит список на равные пары - выходит за границы, если элементов нечётное число. */
функция суммаПарами(числа: Список<Целое>): Целое
{
    Целое сумма  = 0
    Целое индекс = 0
    пока индекс < числа.длина() {
        сумма += числа.получить(индекс) + числа.получить(индекс + 1)
        индекс += 2
    }
    вернуть сумма
}

/** Своя паника - ошибка в программе, а не ожидаемая ситуация. */
сущность НарушениеИнварианта наследует Паника
{
    конструктор(сообщение: Строка)
    {
        родитель(сообщение)
    }
}

/**
 * Паника - ошибка в самой программе: выход за границы, деление на ноль,
 * "утверждать", неверный "как" и т. п. Встроенные паники - наследники
 * "Паника" (ВыходЗаГраницы, ДелениеНаНоль, ПустаяКоллекция, КлючНеНайден,
 * НеверноеПриведение, НарушениеУтверждения), ловятся по своему имени или
 * по "Паника". "поймать(Исключение)" паники не ловит - и наоборот.
 */
функция главная
{
    Список<Целое> числа = [1, 2, 3]

    попытаться {
        вывести `${суммаПарами(числа)}\n`
    } поймать(о: ВыходЗаГраницы) {
        вывести `выход за границы: ${о}\n`
    }

    // Программа продолжает исполняться после перехвата.
    вывести `работа продолжается\n`

    попытаться {
        выбросить новое НарушениеИнварианта("баланс отрицательный")
    } поймать(о: Паника) {
        вывести `паника ${о относится к НарушениеИнварианта ? "своя" : "встроенная"}: ${о}\n`
    }

    // "поймать(о: Паника)" не ловит исключение - "выбросить" пролетает
    // сквозь него до настоящего "поймать(Исключение)".
    попытаться {
        попытаться {
            выбросить новое Исключение("настоящее исключение")
        } поймать(о: Паника) {
            вывести `сюда не попадёт\n`
        }
    } поймать(иск: Исключение) {
        вывести `поймано снаружи: ${иск.сообщение}\n`
    }
}
