/**
 * Встроенные исключения времени выполнения: целочисленное "/" на ноль
 * автоматически выбрасывает перехватываемое "ОшибкаДеленияНаНоль"
 * (наследник "Исключение") - без единой строки собственной проверки,
 * в отличие от examples/исключения/деление.rech (там - вручную объявленный
 * класс исключения, проверка "б == 0" на стороне программиста).
 */
функция главная
{
    переменная а = 10
    переменная б = 0

    попытаться {
        вывести `${а / б}\n`
    } поймать(иск: ОшибкаДеленияНаНоль) {
        вывести "поймано: \n"
        вывести `${иск.сообщение}\n`
    }

    // "код" - необязательное целое поле у "Исключение" (Ничто по
    // умолчанию) - удобно нести машиночитаемую причину рядом с текстом.
    попытаться {
        переменная иск = новое Исключение("недостаточно прав")
        иск.код = 403
        выбросить иск
    } поймать(иск: Исключение) {
        вывести `${иск.сообщение}\n`
        вывести `${иск.код ?? -1}\n`
    }
}
