/**
 * Два канала ошибок времени выполнения. Паника - ошибка в самой программе
 * (целочисленное "/" или "%" на ноль, индекс вне границ, "снять" у пустой
 * стопки, неверный "как"): ловится только "поймать(о: Паника)", обычно на
 * границе - обработчик запроса, воркер. Исключение - ожидаемая ситуация,
 * которую вызывающий код обрабатывает по типу: встроенное "ОшибкаРазбора"
 * ("разобрать JSON/XML/YAML" не совпал с типом) или своё, наследник
 * "Исключение".
 */
сущность Точка
{
    имеет:
        публичный x: Целое
}

/** Выполняет действие; ошибку разбора сообщает, а не роняет программу. */
функция разобрать_безопасно(действие: Вызываемый())
{
    попытаться {
        действие()
    } поймать(иск: ОшибкаРазбора) {
        вывести `не разобралось: ${иск.сообщение}\n`
    }
}

функция главная
{
    Целое а = 10
    Целое б = 0

    попытаться {
        вывести `${а / б}\n`
    } поймать(о: Паника) {
        вывести `паника: ${о}\n`
    }

    разобрать_безопасно(функция () {
        Точка т = разобрать JSON "{}" как Точка
        вывести `${т.x}\n`
    })

    // "код" - необязательное целое поле у "Исключение" (Ничто по
    // умолчанию) - удобно нести машиночитаемую причину рядом с текстом.
    попытаться {
        Исключение иск = новое Исключение("недостаточно прав")
        иск.код = 403
        выбросить иск
    } поймать(иск: Исключение) {
        вывести `${иск.сообщение}\n`
        вывести `${иск.код ?? -1}\n`
    }
}
