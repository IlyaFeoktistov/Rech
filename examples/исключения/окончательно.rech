сущность ОшибкаБД наследует Исключение
{
    конструктор(сообщение: Строка)
    {
        родитель(сообщение)
    }
}

/** Несколько "поймать" подряд на одном "попытаться" (цепочка, как несколько
    "иначе если" подряд) - пробуются по порядку, первое совпадение
    отрабатывает. Последний "поймать" здесь смешанный - "Паника" и обычное
    исключение одним обработчиком сразу ("сообщение" внутри него - всегда
    "Строка", доступа к специфичным полям исключения там нет - для этого
    нужен отдельный "поймать(Тип)" рядом). "окончательно" в конце исполняется
    ПОСЛЕДНИМ ВСЕГДА, независимо от того, какая из веток сработала. */
функция обработать(режим: Целое)
{
    попытаться {
        если режим == 1 {
            выбросить новая ОшибкаБД("нет соединения")
        }
        если режим == 2 {
            утверждать ложь
        }
        вывести "успех"
    } поймать (иск: ОшибкаБД) {
        вывести "БД: "
        вывести иск.сообщение
    } поймать (сообщение: Паника|Исключение) {
        вывести "паника или иное исключение: "
        вывести сообщение
    } окончательно {
        вывести "готово для режима "
        вывести режим
    }
}

/** "попытаться { ... } окончательно { ... }" без единого "поймать" - голая
    гарантия очистки, тоже валидный синтаксис. "окончательно" исполняется
    даже при раннем "вернуть" из тела "попытаться". */
функция сВозвратом(): Целое
{
    попытаться {
        вернуть 42
    } окончательно {
        вывести "очистка перед возвратом"
    }
}

функция главная
{
    обработать(1)
    обработать(2)
    обработать(3)
    вывести сВозвратом()
}
