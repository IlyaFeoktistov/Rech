сущность ОшибкаДеления наследует Исключение
{
}

сущность ОшибкаВвода наследует Исключение
{
}

функция делить(а: Целое, б: Целое): Целое
{
    если б == 0 {
        выбросить новая ОшибкаДеления("деление на ноль")
    }
    вернуть а / б
}

функция главная
{
    попытаться {
        вывести делить(10, 0)
    } поймать(иск: ОшибкаДеления|ОшибкаВвода) {
        если иск относится к ОшибкаДелении {
            вывести "деление: "
            вывести иск.сообщение
        } иначе {
            вывести "ввод: "
            вывести иск.сообщение
        }
    }

    // Необработанный внутри вложенного "попытаться" тип (ОшибкаВвода не
    // входит в его "поймать(...)") пробрасывается дальше, до внешнего.
    попытаться {
        попытаться {
            выбросить новая ОшибкаВвода("нет данных")
        } поймать(иск: ОшибкаДеления) {
            вывести "не должно сработать"
        }
    } поймать(иск: Исключение) {
        вывести "снаружи: "
        вывести иск.сообщение
    }
}
