/**
 * "прочитать_код_клавиши" (docs/SPEC.md, StandardEnums["КодКлавиши"]) -
 * физический код нажатой клавиши, НЕ зависящий от раскладки - в отличие от
 * "клавиши.rech"/"можно_прочитать_байт" выше, которые читают БАЙТЫ
 * терминала (те уже прошли раскладку - "w"/"ц" на ЙЦУКЕН это разные байты
 * одной и той же физической клавиши). WASD и стрелки ниже сравниваются с
 * членами КодКлавиши напрямую, без отдельной таблицы "код -> имя" - именно
 * так этот builtin рассчитан на использование в геймплейном коде (см.
 * examples/проекты/змейка).
 *
 * Требует прав на устройство ввода на Linux (группа "input" или root) -
 * без них "прочитать_код_клавиши" всегда возвращает -1, НЕ падает с
 * ошибкой (обычная ситуация внутри контейнера/WSL2/через SSH без доп.
 * настройки). На Windows работает из обычного консольного приложения без
 * специальных прав. Интерактивный пример - не входит в автоматический
 * прогон (check_examples.sh только компилирует, не запускает).
 */
функция главная
{
    установить_сырой_режим(истина)
    вывести "WASD/стрелки - направление, Escape - выход"
    вывести "(если код всегда -1 - нет прав на устройство ввода, см. комментарий выше)"

    переменная работает = истина
    пока работает {
        переменная код = прочитать_код_клавиши(1000)
        если код == -1 {
            продолжить
        }

        если код == КодКлавиши.W или код == КодКлавиши.Вверх {
            вывести "вверх"
        } иначе если код == КодКлавиши.S или код == КодКлавиши.Вниз {
            вывести "вниз"
        } иначе если код == КодКлавиши.A или код == КодКлавиши.Влево {
            вывести "влево"
        } иначе если код == КодКлавиши.D или код == КодКлавиши.Вправо {
            вывести "вправо"
        } иначе если код == КодКлавиши.Escape {
            работает = ложь
        } иначе {
            вывести "код: " + (Строка) код
        }
    }

    установить_сырой_режим(ложь)
    вывести "выход"
}
