/**
 * То же самое, что демо_tui.rech, но цвет - ВСТРОЕННЫЙ (RGBЦвет,
 * rgbцвет_из_hex, rgbцвет_в_hex, реализованы компилятором в обоих
 * backend'ах - internal/semantic/color.go, internal/backend/cbackend/
 * color.go, internal/interp/color.go), без единого "использовать" -
 * никакой библиотеки на самом Rech, в отличие от examples/консоль/цвет.rech.
 * Курсор/стиль текста (курсор_в/очистить_экран/скрыть_курсор/показать_
 * курсор/жирный_текст/сбросить_стиль) по-прежнему из tui.rech - ANSI-код
 * без единого системного вызова, компилятору тут делать нечего, чистый
 * Rech-код остаётся правильным решением именно для этой части.
 */
использовать курсор_в, очистить_экран, скрыть_курсор, показать_курсор,
жирный_текст, сбросить_стиль
из "tui"

функция главная
{
    вывести `${"терминал: " + (Строка) ширина_терминала() + "x" + (Строка) высота_терминала()}\n`

    очистить_экран()
    скрыть_курсор()

    курсор_в(1, 1)
    жирный_текст()
    вывести `Заголовок (встроенный RGBЦвет)\n`
    сбросить_стиль()

    курсор_в(3, 1)
    переменная предупреждение = rgbцвет_из_hex("#FFD700")
    вывести `${"цвет предупреждения: " + rgbцвет_в_hex(предупреждение)}\n`
    вывести `${"  красный=" + (Строка) (Целое) предупреждение.красный}\n`
    вывести `${"  зелёный=" + (Строка) (Целое) предупреждение.зелёный}\n`
    вывести `${"  синий=" + (Строка) (Целое) предупреждение.синий}\n`

    показать_курсор()
}

использовать ширина_терминала, высота_терминала, rgbцвет_из_hex, rgbцвет_в_hex из стандарт/консоль
