/**
 * Демонстрирует "клавиши.rech" - читает клавиши в сыром режиме, печатая,
 * какая именно была нажата (стрелка/Escape/обычный символ), пока не придёт
 * "q". Интерактивный пример (нужен настоящий терминал, не перенаправленный
 * ввод) - не входит в постоянный автоматический прогон (check_examples.sh
 * только компилирует его, не запускает).
 */
использовать прочитать_клавишу, ТипКлавиши, СобытиеКлавиши из "клавиши"

функция главная
{
    установить_сырой_режим(истина)
    вывести "нажимайте стрелки/Escape/обычные клавиши, \"q\" - выход"

    переменная работает = истина
    пока работает {
        переменная клавиша = прочитать_клавишу()
        выбрать клавиша.вид {
            когда ТипКлавиши.Символ:
                если клавиша.символ == "q" {
                    работает = ложь
                } иначе {
                    вывести "символ: " + клавиша.символ
                }
            когда ТипКлавиши.СтрелкаВверх:
                вывести "стрелка вверх"
            когда ТипКлавиши.СтрелкаВниз:
                вывести "стрелка вниз"
            когда ТипКлавиши.СтрелкаВправо:
                вывести "стрелка вправо"
            когда ТипКлавиши.СтрелкаВлево:
                вывести "стрелка влево"
            иначе:
                вывести "Escape"
        }
    }

    установить_сырой_режим(ложь)
    вывести "выход"
}
