/** Отслеживание мыши в терминале - SGR mouse reporting (режимы `1000`
 * "button-event tracking" + `1006` "SGR extended coordinates", ESC-
 * последовательности "ESC[?1000h"/"ESC[?1006h") - ЦЕЛИКОМ библиотека на
 * самом Rech, тем же принципом, что и курсор/цвет в tui.rech: печатает
 * управляющие последовательности, терминал сам их интерпретирует и
 * присылает НАЗАД события мыши как обычные байты на "стандартный_ввод()"
 * (в сыром режиме - "установить_сырой_режим", см. examples/консоль/
 * tui.rech). Режим `1006` (не курируемый список из 8-битных координат
 * старого протокола X10) - нужен для терминалов шире/выше 223
 * столбцов/строк, у которых координата не влезла бы в один байт.
 *
 * Формат одного события - "ESC[<Cb;Cx;CyM"` (нажатие/движение) или тот же
 * префикс, оканчивающийся строчной "m" (отпускание) - "Cb" кодирует номер
 * кнопки в двух младших битах, "Cx"/"Cy" - столбец/строка с 1 (как у
 * курсора, "курсор_в").
 */
использовать ESC, вывод_без_переноса из "tui"

/** Одно событие мыши - "столбец"/"строка" с 1 (как у "курсор_в"), "кнопка" -
 * 0 (левая), 1 (средняя) или 2 (правая), "нажата" - истина при нажатии,
 * ложь при отпускании. */
сущность СобытиеМыши {
    имеет:
        столбец: Целое
        строка: Целое
        кнопка: Целое
        нажата: Логическое

    конструктор(столбец: Целое, строка: Целое, кнопка: Целое, нажата: Логическое)
    {
        этот.столбец = столбец
        этот.строка = строка
        этот.кнопка = кнопка
        этот.нажата = нажата
    }
}

/** Включает присылку событий мыши на "стандартный_ввод()". */
функция включить_отслеживание_мыши()
{
    вывод_без_переноса(ESC + "[?1000h" + ESC + "[?1006h")
}

/** Выключает присылку событий мыши - терминал возвращается к обычному
 * поведению (выделение текста мышью и т. п.). */
функция выключить_отслеживание_мыши()
{
    вывод_без_переноса(ESC + "[?1006l" + ESC + "[?1000l")
}

/** Разбирает один байтовый фрагмент, прочитанный с "стандартный_ввод()", как
 * SGR-событие мыши - Ничто, если "данные" не начинаются с "ESC[<" (не
 * событие мыши вовсе - обычная клавиша). Разбор ПОСЛЕ этой проверки
 * (номера/буква конца) - аварийное завершение при некорректном формате
 * ("подстрока"/"разбить"/каст "(Целое)" - тот же принцип разбора двоичных
 * форматов, что и у остальной стандартной библиотеки: раз префикс уже
 * подтверждён, остаток обязан быть корректным SGR-событием). */
функция разобрать_событие_мыши(данные: Строка): ?СобытиеМыши
{
    константа ПРЕФИКС = ESC + "[<"
    если позиция_в_строке(данные, ПРЕФИКС) != 0 {
        вернуть Ничто
    }

    переменная последний = подстрока(данные, длина_строки(данные) - 1, 1)
    переменная нажата = (последний == "M")

    переменная тело = подстрока(данные, длина_строки(ПРЕФИКС), длина_строки(данные) - длина_строки(ПРЕФИКС) - 1)
    переменная части = разбить(тело, ";")

    переменная кнопка_код = (Целое) части.получить(0)
    переменная столбец = (Целое) части.получить(1)
    переменная строка = (Целое) части.получить(2)

    вернуть новое СобытиеМыши(столбец, строка, кнопка_код & 3, нажата)
}
