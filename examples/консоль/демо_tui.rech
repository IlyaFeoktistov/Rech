использовать курсор_в, очистить_экран, скрыть_курсор, показать_курсор,
цвет_текста, цвет_фона, сбросить_стиль, жирный_текст
из "tui"
использовать Цвет, цвет_из_hex из "цвет"
использовать ширина_терминала, высота_терминала из стандарт/консоль

/**
 * Демонстрирует ANSI-курсор/truecolor-цвет (tui.rech/цвет.rech, чистый
 * Rech-код) и встроенные "ширина_терминала"/"высота_терминала"/
 * "установить_сырой_режим" (нужны настоящие системные вызовы, не
 * библиотека). Не читает ни одной клавиши - только вывод, чтобы пример
 * оставался неинтерактивным (можно собрать и запустить без настоящего
 * терминала, в т. ч. в CI).
 */
функция главная
{
    вывести `${"терминал: " + (Строка) ширина_терминала() + "x" + (Строка) высота_терминала()}\n`

    очистить_экран()
    скрыть_курсор()

    курсор_в(1, 1)
    цвет_текста(новый Цвет(0, 220, 0))
    жирный_текст()
    вывести `Заголовок\n`
    сбросить_стиль()

    курсор_в(3, 1)
    цвет_текста(цвет_из_hex("#000000"))
    цвет_фона(цвет_из_hex("#FFD700"))
    вывести ` предупреждение \n`
    сбросить_стиль()

    показать_курсор()
}
