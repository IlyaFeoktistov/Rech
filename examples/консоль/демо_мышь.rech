/**
 * Демонстрирует "мышь.rech" - разбор SGR-события мыши, прочитанного как
 * обычные байты со "стандартный_ввод()". Здесь - без реального терминала:
 * входная строка подставлена вручную (то же самое пришло бы от терминала в
 * ответ на клик, если бы "включить_отслеживание_мыши" был вызван, а
 * терминал - в сыром режиме).
 */
использовать разобрать_событие_мыши, СобытиеМыши из "мышь"

функция главная
{
    константа ESC = (Строка) (Символ) 27

    // Левая кнопка, нажата, столбец 10, строка 5.
    переменная нажатие = разобрать_событие_мыши(ESC + "[<0;10;5M")
    если нажатие != Ничто {
        вывести `${нажатие.кнопка}\n`
        вывести `${нажатие.столбец}\n`
        вывести `${нажатие.строка}\n`
        вывести `${нажатие.нажата}\n`
    }

    // То же событие, отпускание (строчная "m").
    переменная отпускание = разобрать_событие_мыши(ESC + "[<0;10;5m")
    если отпускание != Ничто {
        вывести `${отпускание.нажата}\n`
    }

    // Обычная клавиша (не мышь) - Ничто.
    переменная не_мышь = разобрать_событие_мыши("q")
    вывести `${не_мышь == Ничто}\n`
}
