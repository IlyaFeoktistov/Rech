/**
 * RGB-цвет (0-255 на канал) - общее представление, годное и для терминала
 * (ANSI truecolor, tui.rech), и для будущей попиксельной работы с
 * изображениями (docs/ROADMAP.md, "работа с изображениями") - один и тот же
 * "Цвет" в обоих случаях, не два разных понятия цвета в одной программе.
 */
структура Цвет
{
    имеет:
        красный: Байт
        зелёный: Байт
        синий:   Байт
}

/**
 * Код одной шестнадцатеричной цифры ('0'-'9'/'a'-'f'/'A'-'F') через
 * арифметику кодовых точек (Строка -> Символ -> Целое), не сравнение с
 * каждой из 22 возможных цифр по отдельности.
 */
функция шестнадцатеричная_цифра(символ: Строка): Целое
{
    переменная код = (Целое) (Символ) символ
    если код >= (Целое) '0' и код <= (Целое) '9' {
        вернуть код - (Целое) '0'
    }
    если код >= (Целое) 'a' и код <= (Целое) 'f' {
        вернуть код - (Целое) 'a' + 10
    }
    если код >= (Целое) 'A' и код <= (Целое) 'F' {
        вернуть код - (Целое) 'A' + 10
    }
    выбросить новое Исключение("не шестнадцатеричная цифра: \"" + символ + "\"")
    вернуть 0
}

/**
 * "#RRGGBB" или "RRGGBB" (символ "#" необязателен) - две шестнадцатеричные
 * цифры на канал, по порядку красный/зелёный/синий.
 */
функция цвет_из_hex(hex: Строка): Цвет
{
    переменная текст = hex
    если длина_строки(текст) > 0 и подстрока(текст, 0, 1) == "#" {
        текст = подстрока(текст, 1, длина_строки(текст) - 1)
    }
    если длина_строки(текст) != 6 {
        выбросить новое Исключение("цвет_из_hex: ожидалось 6 шестнадцатеричных цифр (\"RRGGBB\", опционально с \"#\"), получено \"" + hex + "\"")
    }
    переменная красный_канал = (Байт) (шестнадцатеричная_цифра(подстрока(текст, 0, 1)) * 16 + шестнадцатеричная_цифра(подстрока(текст, 1, 1)))
    переменная зелёный_канал = (Байт) (шестнадцатеричная_цифра(подстрока(текст, 2, 1)) * 16 + шестнадцатеричная_цифра(подстрока(текст, 3, 1)))
    переменная синий_канал   = (Байт) (шестнадцатеричная_цифра(подстрока(текст, 4, 1)) * 16 + шестнадцатеричная_цифра(подстрока(текст, 5, 1)))
    вернуть новый Цвет(красный_канал, зелёный_канал, синий_канал)
}

/**
 * Одна шестнадцатеричная цифра (0-15) как символ - обратная операция к
 * "шестнадцатеричная_цифра".
 */
функция цифра_в_hex(значение: Целое): Строка
{
    если значение < 10 {
        вернуть (Строка) (Символ) ((Целое) '0' + значение)
    }
    вернуть (Строка) (Символ) ((Целое) 'a' + значение - 10)
}

/** Один канал (0-255) как две шестнадцатеричные цифры. */
функция канал_в_hex(значение: Целое): Строка
{
    вернуть цифра_в_hex(значение / 16) + цифра_в_hex(значение % 16)
}

/** "#RRGGBB" - обратная операция к "цвет_из_hex". */
функция цвет_в_hex(цвет: Цвет): Строка
{
    вернуть "#" + канал_в_hex((Целое) цвет.красный) + канал_в_hex((Целое) цвет.зелёный) + канал_в_hex((Целое) цвет.синий)
}
