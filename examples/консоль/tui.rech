/**
 * Курсор/цвет/стиль текста терминала - через ANSI-последовательности (CSI,
 * "ESC[..."), чистым Rech-кодом, без единой правки компилятора: печатает
 * управляющие последовательности прямо в "стандартный_вывод()", тем же
 * "запись(Файл, Строка)", что и обычный вывод - терминал сам их
 * интерпретирует, программе не нужно знать больше про конкретный терминал.
 * Сырой режим ("установить_сырой_режим")/размер терминала
 * ("ширина_терминала"/"высота_терминала") - ОТДЕЛЬНЫЕ встроенные функции
 * (не библиотека) - нужны настоящие системные вызовы (termios/консольный
 * режим Windows), которые чистым Rech-кодом не построить.
 *
 * Цвет - truecolor (ESC[38;2;R;G;Bm/ESC[48;2;R;G;Bm, 24 бита - тот же
 * "Цвет", что и у попиксельной работы с изображениями, см. цвет.rech), не
 * курируемый список из 8 базовых ANSI-цветов - современные терминалы (не
 * только графические эмуляторы - большинство актуальных версий популярных
 * терминалов на всех трёх ОС) truecolor уже поддерживают.
 *
 * Позиции курсор_в - как у терминала: строка и столбец с 1, не с 0 (левый
 * верхний угол - "курсор_в(1, 1)").
 */
использовать Цвет из "цвет"

константа ESC = (Строка) (Символ) 27

/**
 * Печатает текст в стандартный вывод БЕЗ переноса строки в конце - "вывести"
 * (инструкция, не функция) всегда добавляет перенос сам, что портит
 * управляющие последовательности, если между ними напечатать что-то ещё.
 */
функция вывод_без_переноса(текст: Строка)
{
    стандартный_вывод().записать(текст)
}

/** Переносит курсор на (строка, столбец), оба с 1. */
функция курсор_в(строка: Целое, столбец: Целое)
{
    вывод_без_переноса(ESC + "[" + (Строка) строка + ";" + (Строка) столбец + "H")
}

/** Очищает весь экран и переносит курсор в левый верхний угол. */
функция очистить_экран()
{
    вывод_без_переноса(ESC + "[2J" + ESC + "[H")
}

/** Очищает текущую строку целиком (курсор остаётся на месте). */
функция очистить_строку()
{
    вывод_без_переноса(ESC + "[2K")
}

функция скрыть_курсор()
{
    вывод_без_переноса(ESC + "[?25l")
}

функция показать_курсор()
{
    вывод_без_переноса(ESC + "[?25h")
}

/**
 * Цвет последующего текста - действует, пока не встретится другой цвет или
 * "сбросить_стиль".
 */
функция цвет_текста(цвет: Цвет)
{
    вывод_без_переноса(ESC + "[38;2;" + (Строка) цвет.красный + ";" + (Строка) цвет.зелёный + ";" + (Строка) цвет.синий + "m")
}

/** Цвет фона последующего текста. */
функция цвет_фона(цвет: Цвет)
{
    вывод_без_переноса(ESC + "[48;2;" + (Строка) цвет.красный + ";" + (Строка) цвет.зелёный + ";" + (Строка) цвет.синий + "m")
}

функция жирный_текст()
{
    вывод_без_переноса(ESC + "[1m")
}

функция подчёркнутый_текст()
{
    вывод_без_переноса(ESC + "[4m")
}

/** Возвращает цвет/фон/жирность/подчёркивание к значению по умолчанию. */
функция сбросить_стиль()
{
    вывод_без_переноса(ESC + "[0m")
}
