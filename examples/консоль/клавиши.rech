использовать стандартный_ввод из стандарт/файлы

/**
 * Разбор отдельных клавиш ввода терминала - отличает стрелки (многобайтовые
 * ANSI CSI-последовательности - "ESC[A"/"ESC[B"/"ESC[C"/"ESC[D") от
 * одинокого нажатия Escape БЕЗ зависания: одинокий Escape и НАЧАЛО стрелки
 * - один и тот же первый байт (0x1B), различить их можно только подождав
 * ЕЩЁ БАЙТ короткое время - если он не пришёл, это был одинокий Escape (сам
 * терминал не шлёт вслед за клавишей Escape ничего ещё, а следующие байты
 * стрелки приходят одним пакетом, почти мгновенно). "можно_прочитать_байт" -
 * ровно для этого: короткий таймаут вместо блокирующегося "прочитать",
 * которое ждало бы следующий байт сколько угодно, если это был
 * действительно одинокий Escape.
 *
 * Требует сырого режима терминала ("установить_сырой_режим(истина)") - без
 * него ввод построчный, отдельные байты недоступны вовсе.
 */
перечисление ТипКлавиши
{
    Символ,
    СтрелкаВверх,
    СтрелкаВниз,
    СтрелкаВправо,
    СтрелкаВлево,
    Escape
}

/**
 * Одно событие клавиатуры - "символ" заполнен только при "вид ==
 * ТипКлавиши.Символ" (обычный, однобайтовый ввод). "вид" - "Целое", не
 * "ТипКлавиши" (перечисление не может само по себе быть именем типа поля/
 * параметра - только значением константы вроде "ТипКлавиши.Символ", своя
 * особенность языка на сегодняшний день, не оплошность этого файла) -
 * сравнения (`вид == ТипКлавиши.Символ`) и `выбрать`/`когда` по-прежнему
 * работают как обычно, значения остаются теми же самыми целыми числами.
 */
сущность СобытиеКлавиши
{
    имеет:
        Целое  вид
        Строка символ

    конструктор(вид: Целое, символ: Строка)
    {
        этот.вид = вид
        этот.символ = символ
    }
}

/**
 * Сколько мс ждать ВТОРОЙ байт после ESC, прежде чем решить, что это был
 * одинокий Escape, а не начало последовательности - с большим запасом
 * относительно реальной задержки терминала (обычно меньше 1мс - байты
 * стрелки приходят одним пакетом), но заметно меньше, чем человеческая
 * реакция между двумя независимыми нажатиями (иначе быстро набранные "Esc",
 * затем "[" ошибочно приняло бы за стрелку).
 */
константа ТАЙМАУТ_ESCAPE_МС = 30

/** Блокируется до следующего байта ввода, возвращает разобранное событие. */
функция прочитать_клавишу(): СобытиеКлавиши
{
    константа  ESC  = (Строка) (Символ) 27
    переменная вход = стандартный_ввод()

    переменная первый = вход.прочитать(1)
    если первый != ESC {
        вернуть новое СобытиеКлавиши(ТипКлавиши.Символ, первый)
    }

    если не вход.можно_прочитать_байт(ТАЙМАУТ_ESCAPE_МС) {
        вернуть новое СобытиеКлавиши(ТипКлавиши.Escape, "")
    }

    переменная второй = вход.прочитать(1)
    если второй != "[" {
        вернуть новое СобытиеКлавиши(ТипКлавиши.Escape, "")
    }

    переменная третий = вход.прочитать(1)
    если третий == "A" {
        вернуть новое СобытиеКлавиши(ТипКлавиши.СтрелкаВверх, "")
    }
    если третий == "B" {
        вернуть новое СобытиеКлавиши(ТипКлавиши.СтрелкаВниз, "")
    }
    если третий == "C" {
        вернуть новое СобытиеКлавиши(ТипКлавиши.СтрелкаВправо, "")
    }
    если третий == "D" {
        вернуть новое СобытиеКлавиши(ТипКлавиши.СтрелкаВлево, "")
    }

    // Неизвестная последовательность (F-клавиши и т. п. - не разобраны в
    // этом срезе) - не одинокий Escape (второй байт уже был "["), но и не
    // распознанная стрелка.
    вернуть новое СобытиеКлавиши(ТипКлавиши.Escape, "")
}
