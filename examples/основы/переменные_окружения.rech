использовать получить_переменную_окружения из стандарт/система

/**
 * "получить_переменную_окружения(имя): ?Строка" - Ничто, если переменная окружения не
 * установлена (не то же самое, что "установлена, но пустая строка" -
 * разные вещи для типичного 12-factor конфига).
 */
функция главная
{
    переменная неизвестная = получить_переменную_окружения("RECH_ЗАВЕДОМО_НЕ_СУЩЕСТВУЕТ")
    утверждать неизвестная == Ничто

    переменная путь = получить_переменную_окружения("PATH")
    утверждать путь != Ничто
}
