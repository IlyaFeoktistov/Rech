// Числовые типы разной точности (Дробное - 32 бита, Действительное - 64
// бита), Символ (одна кодовая точка Unicode, не байт), Байт (8 бит без
// знака) и явные касты "(Тип) значение" между примитивами.

функция главная
{
    переменная целое = 42
    переменная дробное = 3.5
    переменная действительное = 2.718281828

    // Смешанная арифметика приводит к более широкому типу:
    // Целое -> Дробное -> Действительное.
    вывести целое + дробное
    вывести дробное + действительное

    переменная символ = 'я'
    переменная байт = (Байт) 200

    вывести символ
    вывести байт

    // Целое <-> Символ - числовой код точки.
    вывести (Целое) символ
    вывести (Символ) 97

    // Целое <-> Байт - усечение/расширение.
    вывести (Целое) байт
    вывести (Байт) 1000

    // Число <-> Строка - десятичная запись и обратно (разбор).
    вывести (Строка) действительное
    вывести (Действительное) "1.25"

    // Строка <-> Символ - именно как один символ, не код.
    вывести (Символ) "ю"
    вывести (Строка) 'ю'

    // Байт <-> Строка - как число, не как символ.
    вывести (Строка) байт
}
