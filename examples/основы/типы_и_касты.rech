// Числовые типы разной точности (Дробное - 32 бита, Действительное - 64
// бита), Символ (одна кодовая точка Unicode, не байт), Байт (8 бит без
// знака) и явные касты "(Тип) значение" между примитивами.

/** Числовые типы разной точности, Символ/Байт и явные касты между ними. */
функция главная
{
    переменная целое          = 42
    переменная дробное        = 3.5
    переменная действительное = 2.718281828

    // Смешанная арифметика приводит к более широкому типу:
    // Целое -> Дробное -> Действительное.
    вывести `${целое + дробное}\n`
    вывести `${дробное + действительное}\n`

    // Экспонента ("e"/"E", необязательный знак) - Действительное и без
    // десятичной точки в мантиссе тоже.
    переменная миллиард = 1e9
    переменная тысячная = 2.5e-3
    вывести `${миллиард}\n`
    вывести `${тысячная}\n`

    переменная символ = 'я'
    переменная байт   = (Байт) 200

    вывести `${символ}\n`
    вывести `${байт}\n`

    // Целое <-> Символ - числовой код точки.
    вывести `${(Целое) символ}\n`
    вывести `${(Символ) 97}\n`

    // Целое <-> Байт - усечение/расширение.
    вывести `${(Целое) байт}\n`
    вывести `${(Байт) 1000}\n`

    // Число <-> Строка - десятичная запись и обратно (разбор).
    вывести `${(Строка) действительное}\n`
    вывести `${(Действительное) "1.25"}\n`

    // Строка <-> Символ - именно как один символ, не код.
    вывести `${(Символ) "ю"}\n`
    вывести `${(Строка) 'ю'}\n`

    // Байт <-> Строка - как число, не как символ.
    вывести `${(Строка) байт}\n`
}
