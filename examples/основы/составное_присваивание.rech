// "+= -= *= /=" - сахар над обычным присваиванием: "а += б" разбирается как
// "а = а + б" (и так же для остальных трёх) - работает для всех числовых
// типов и, отдельно, для "Строка" у "+=" (конкатенация, тем же "+", что и в
// обычном выражении). Применимо и к переменной, и к полю сущности.

сущность Счётчик {
    имеет:
        значение: Целое
}

/** "+= -= *= /=" для переменной, поля сущности и строк. */
функция главная
{
    переменная а = 10
    а += 5
    вывести а       // 15
    а -= 3
    вывести а       // 12
    а *= 2
    вывести а       // 24
    а /= 4
    вывести а       // 6

    переменная текст = "привет"
    текст += ", мир"
    вывести текст   // привет, мир

    переменная счётчик = новый Счётчик(0)
    счётчик.значение += 7
    вывести счётчик.значение // 7
}
