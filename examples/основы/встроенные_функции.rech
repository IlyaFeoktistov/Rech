/** Встроенные математические функции и чтение стандартного ввода. */
функция главная
{
    вывести корень(16.0)
    вывести степень(2.0, 10.0)
    вывести округлить(3.6)
    вывести потолок(3.1)
    вывести пол(3.9)
    вывести модуль(-5.5)
    вывести абсолютное_значение_целого(-5)
    вывести знак(-3.5)
    вывести наименьшее(3, 7)
    вывести наибольшее(3, 7)
    вывести ограничить(15.0, 0.0, 10.0)
    вывести остаток(10.5, 3.0)
    вывести степень_целого(2, 10)
    вывести синус_гиперболический(1.0)
    вывести косинус_гиперболический(1.0)
    вывести тангенс_гиперболический(1.0)
    вывести гипотенуза(3.0, 4.0)

    вывести "Как тебя зовут?"
    переменная имя = прочитать_строку()
    вывести имя

    вывести "Сколько тебе лет?"
    переменная возраст = прочитать_целое()
    вывести возраст
}
