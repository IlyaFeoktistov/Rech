/** Встроенные математические функции и чтение стандартного ввода. */
функция главная
{
    вывести `${корень(16.0)}\n`
    вывести `${степень(2.0, 10.0)}\n`
    вывести `${округлить(3.6)}\n`
    вывести `${потолок(3.1)}\n`
    вывести `${пол(3.9)}\n`
    вывести `${модуль(-5.5)}\n`
    вывести `${абсолютное_значение_целого(-5)}\n`
    вывести `${знак(-3.5)}\n`
    вывести `${наименьшее(3, 7)}\n`
    вывести `${наибольшее(3, 7)}\n`
    вывести `${ограничить(15.0, 0.0, 10.0)}\n`
    вывести `${остаток(10.5, 3.0)}\n`
    вывести `${степень_целого(2, 10)}\n`
    вывести `${синус_гиперболический(1.0)}\n`
    вывести `${косинус_гиперболический(1.0)}\n`
    вывести `${тангенс_гиперболический(1.0)}\n`
    вывести `${гипотенуза(3.0, 4.0)}\n`

    вывести `Как тебя зовут?\n`
    переменная имя = прочитать_строку()
    вывести `${имя}\n`

    вывести `Сколько тебе лет?\n`
    переменная возраст = прочитать_целое()
    вывести `${возраст}\n`
}
