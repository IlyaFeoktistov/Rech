// Множественный выбор "выбрать/когда" - без "break": ветки не проваливаются
// одна в другую. Значение ветки "когда" - либо обычное выражение
// (сравнивается через "=="), либо голое имя сущности/интерфейса
// (сравнивается через "относится к" - полиморфно, с учётом наследования).
// "ДеньНедели" ниже - встроенное перечисление (docs/SPEC.md, раздел 13).

сущность Пользователь
{
    имеет:
        имя: Строка

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }
}

сущность Администратор наследует Пользователя
{
    конструктор(имя: Строка)
    {
        этот.имя = имя
    }
}

/** Роль пользователя - демонстрирует сопоставление ветки "когда" по типу. */
функция роль(п: Пользователь): Строка
{
    выбрать п
    {
        когда Администратор:
            вернуть "администратор"
        когда Пользователь:
            вернуть "обычный пользователь"
    }
    вернуть "неизвестно"
}

/** Демонстрирует "выбрать/когда" по значению (с "|") и по типу. */
функция главная
{
    переменная число = 2
    выбрать число
    {
        когда 1:
            вывести "один"
        когда 2|3:
            вывести "два или три"
        иначе:
            вывести "другое число"
    }

    переменная день = ДеньНедели.Суббота
    выбрать день
    {
        когда ДеньНедели.Суббота|ДеньНедели.Воскресенье:
            вывести "выходной"
        иначе:
            вывести "рабочий день"
    }

    переменная аня = новый Администратор("Аня")
    переменная оля = новый Пользователь("Оля")
    вывести роль(аня)
    вывести роль(оля)
}
