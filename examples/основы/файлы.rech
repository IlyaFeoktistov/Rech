// Низкоуровневый файловый ввод-вывод (шаг 8) - только чтение в этом срезе.
// "открыть" читает путь относительно текущего рабочего каталога процесса
// (как обычный open(2)/CreateFileW, не относительно каталога, где лежит
// сам .rech-файл) - запускать этот пример из корня репозитория:
// rech run examples/основы/файлы.rech
//
// Данные читаются из testdata/файлы_данные.txt, не из examples/ - в
// examples/ (.gitignore в корне репозитория) хранятся только исходники на
// Rech, ни один другой файл там не коммитится.
функция главная
{
    переменная ф = открыть("testdata/файлы_данные.txt")

    // "прочитать" - не более max БАЙТ (POSIX read(2), не до перевода
    // строки) - "привет" в UTF-8 занимает 12 байт (6 кириллических букв по
    // 2 байта каждая), не 6, как и strlen в examples/основы/
    // внешние_функции.rech.
    переменная первый_кусок = прочитать(ф, 12)
    вывести первый_кусок

    // Второй вызов продолжает с того места, где остановился первый -
    // дескриптор хранит текущую позицию в файле, как и в C.
    переменная остаток = прочитать(ф, 100)
    вывести остаток

    // Конец файла - пустая Строка, не аварийное завершение (в отличие от
    // прочитать_строку/прочитать_целое/прочитать_число на конце стандартного
    // ввода, шаг 8) - "прочитать" может законно вызываться повторно после
    // EOF и просто продолжать возвращать "".
    переменная конец_файла = прочитать(ф, 10)
    вывести конец_файла == ""

    закрыть(ф)
}
