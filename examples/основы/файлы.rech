// Файловый ввод-вывод (шаг 8). "открыть"/"открыть_для_записи"/
// "открыть_для_дозаписи" читают путь относительно текущего рабочего
// каталога процесса (как обычный fopen/CreateFileW, не относительно
// каталога, где лежит сам .rech-файл) - запускать этот пример из корня
// репозитория: rech run examples/основы/файлы.rech
//
// Данные читаются из testdata/файлы_данные.txt, не из examples/ - в
// examples/ (.gitignore в корне репозитория) хранятся только исходники на
// Rech, ни один другой файл там не коммитится; вывод этого примера пишется
// в testdata/файлы_вывод.txt - тоже не коммитится, это результат запуска,
// не исходник.

/** Открыть/прочитать/записать/закрыть файл (методы на Файл), построчное чтение, обёртки-хелперы. */
функция главная
{
    переменная ф = открыть("testdata/файлы_данные.txt")

    // "ф.прочитать" - не более max БАЙТ (не до перевода строки, как fread) -
    // "привет" в UTF-8 занимает 12 байт (6 кириллических букв по 2 байта
    // каждая), не 6, как и strlen в examples/основы/внешние_функции.rech.
    переменная первый_кусок = ф.прочитать(12)
    вывести `${первый_кусок}\n`

    // Второй вызов продолжает с того места, где остановился первый -
    // дескриптор хранит текущую позицию в файле, как и в C.
    переменная остаток = ф.прочитать(100)
    вывести `${остаток}\n`

    // Конец файла - пустая Строка, не аварийное завершение (в отличие от
    // прочитать_строку/прочитать_целое/прочитать_число на конце стандартного
    // ввода, шаг 8) - "прочитать" может законно вызываться повторно после
    // EOF и просто продолжать возвращать "".
    переменная конец_файла = ф.прочитать(10)
    вывести `${конец_файла == ""}\n`

    ф.закрыть()

    // "открыть_для_записи" обрезает существующее содержимое (как fopen
    // "w"), "открыть_для_дозаписи" - дописывает в конец (как fopen "a").
    переменная запись = открыть_для_записи("testdata/файлы_вывод.txt")
    запись.записать("первая строка\n")
    запись.закрыть()

    переменная дозапись = открыть_для_дозаписи("testdata/файлы_вывод.txt")
    дозапись.записать("вторая строка\n")
    дозапись.закрыть()

    // "для <строка> в <Файл>" - потоковое построчное чтение (не Список<T>,
    // файл не известной заранее длины) - каждая итерация читает ровно одну
    // строку без завершающего переноса строки, цикл сам завершается на
    // конце файла.
    переменная файл = открыть("testdata/файлы_вывод.txt")
    для строка в файле {
        вывести `${строка}\n`
    }
    файл.закрыть()

    // Высокоуровневые обёртки без ручного открыть/закрыть - типичный
    // сценарий "прочитать/записать файл целиком одной функцией".
    записать_в_файл("testdata/файлы_вывод.txt", "перезаписано целиком\n")
    дописать_в_файл("testdata/файлы_вывод.txt", "и дописано\n")
    вывести `${прочитать_файл("testdata/файлы_вывод.txt")}\n`
}
