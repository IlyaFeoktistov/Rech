/**
 * Дробные числа двоичные (IEEE 754, как во всех языках): 0.1 в них не
 * записывается точно, поэтому 0.1 + 0.2 - не ровно 0.3. Печать честная -
 * кратчайшая запись, читающаяся обратно в то же значение, - а сравнивать
 * дробные нужно через "почти_равно", не "==".
 */
функция главная
{
    Действительное сумма = 0.1 + 0.2
    вывести `${сумма}\n`
    вывести `${сумма == 0.3} ${сумма.почти_равно(0.3)}\n`

    // Дробное (float) - свои ~7 знаков: та же сумма в нём ровно 0.3.
    Дробное д1 = 0.1
    Дробное д2 = 0.2
    вывести `${д1 + д2}\n`

    // Допуск по умолчанию - 1e-9 от величины чисел (у малых - абсолютный).
    вывести `${почти_равно(1.0, 1.001)} ${почти_равно(1.0, 1.001, 0.01)}\n`
    вывести `${почти_равно(1e20, 1e20 + 1e5)}\n`

    // Запись: обычная при порядке от -4 до 15, иначе экспонента.
    вывести `${0.0001} ${0.00001} ${1e15} ${1e16} ${(Строка) 2.5}\n`
}
