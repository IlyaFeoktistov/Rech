// Переменные уровня модуля (файла) - объявление вне функции/сущности.
// Значения вычисляются один раз до "главная", по порядку объявления, -
// значение может использовать переменные, объявленные выше. Переменная
// видна из любой функции/метода файла и импортируется через
// "использовать", как функция.

/** Сколько событий записано. */
Целое                    счётчик = 0
переменная               префикс = "событие"
приватный Список<Строка> журнал  = []
Целое                    предел  = 2 + 1

функция отметить(что: Строка)
{
    счётчик++
    журнал.добавить(`${префикс} ${счётчик}: ${что}`)
}

функция главная
{
    отметить("старт")
    отметить("работа")
    для строка в журнале {
        вывести `${строка}\n`
    }
    утверждать счётчик < предел
    вывести `всего: ${счётчик}\n`
}
