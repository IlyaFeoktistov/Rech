// Внешние функции - объявление сигнатуры уже существующей C-функции без
// тела, только уже слинкованные libc/libm (сторонняя библиотека - через
// "сборка.библиотеки" .rechproj, см. docs/SPEC.md, раздел 12). "как"
// переименовывает C-имя в Rech-facing имя - тот же принцип, что и у
// "использовать ... как ...". Rech-facing имя - snake_case (как в POSIX):
// подчёркивание между словами, без camelCase.
внешняя функция strlen как длина_байт(текст: Строка): Целое
внешняя функция atoi(текст: Строка): Целое
внешняя функция srand(семя: Целое)
внешняя функция rand(): Целое
внешняя функция sqrt как квадратный_корень(x: Действительное): Действительное

// "внешняя структура" - прозрачная C-структура по значению, поля в точном
// порядке реальной C-структуры. div_t (<stdlib.h>) - ровно два 4-байтных
// целых поля без выравнивающих промежутков, "Символ" (int32_t) - тот же
// C-тип, что и "int" - подходит для 4-байтного целочисленного поля, не
// только для кодовых точек Unicode (см. docs/SPEC.md, раздел 12).
внешняя структура div_t как ЧастноеОстаток
{
    имеет:
        Символ частное
        Символ остаток
}
внешняя функция div как разделить(делимое: Символ, делитель: Символ): ЧастноеОстаток

// "внешняя сущность" - непрозрачный внешний тип: значение можно только
// получить от внешней функции и передать другой, ни полей, ни методов, ни
// "новый" у него нет. malloc/free - классический пример: снаружи это
// просто указатель, Rech не знает и не описывает, что за ним лежит.
внешняя сущность void как Блок
внешняя функция malloc как выделить(размер: Целое): Блок
внешняя функция free как освободить(блок: Блок)

// Целое8/16/32/64 и Натуральное8/16/32/64 (раздел 4) тоже допустимы -
// реальные C API нередко используют "short"/"unsigned short" там, где
// Rech-стороне нужна не 4/8-байтная ширина. htons (<arpa/inet.h>) -
// перевод хоста в сетевой (big-endian) порядок байт для 16-битного
// значения - на little-endian хосте меняет байты местами.
внешняя функция htons(хостовый_порядок: Натуральное16): Натуральное16

/** Демонстрирует вызов внешних C-функций (libc/libm), внешнюю структуру, непрозрачный внешний тип и fixed-width целые в сигнатуре. */
функция главная
{
    // strlen считает БАЙТЫ, не символы Unicode (в отличие от встроенной
    // "длина_строки", которая уже занята - работает по КОДОВЫМ ТОЧКАМ) -
    // "привет" в UTF-8 занимает 12 байт (6 кириллических букв по 2 байта
    // каждая), не 6.
    вывести `${длина_байт("привет")}\n`

    вывести `${atoi("42")}\n`

    srand(1)
    вывести `${rand()}\n`

    вывести `${квадратный_корень(9.0)}\n`

    переменная частное_остаток = разделить((Символ) 17, (Символ) 5)
    вывести `${(Целое) частное_остаток.частное}\n`
    вывести `${(Целое) частное_остаток.остаток}\n`

    переменная блок = выделить(64)
    освободить(блок)

    вывести `${htons(1)}\n`
}
