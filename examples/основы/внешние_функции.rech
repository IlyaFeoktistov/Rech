// Внешние функции - объявление сигнатуры уже существующей
// C-функции без тела. В этом срезе - только уже слинкованные libc/libm
// (без "из библиотеки ..."), только Целое/Действительное/Строка/Логическое.
// "как" переименовывает C-имя в Rech-facing имя - тот же принцип, что и у
// "использовать ... как ..." (шаг 11). Rech-facing имя - snake_case (как в
// POSIX): подчёркивание между словами, без camelCase.
внешняя функция strlen как длина_строки(текст: Строка): Целое
внешняя функция atoi(текст: Строка): Целое
внешняя функция srand(семя: Целое)
внешняя функция rand(): Целое
внешняя функция sqrt как квадратный_корень(x: Действительное): Действительное

/** Демонстрирует вызов внешних C-функций (libc/libm) через "внешняя функция". */
функция главная
{
    // strlen считает БАЙТЫ, не символы Unicode - "привет" в UTF-8 занимает
    // 12 байт (6 кириллических букв по 2 байта каждая), не 6.
    вывести длина_строки("привет")

    вывести atoi("42")

    srand(1)
    вывести rand()

    вывести квадратный_корень(9.0)
}
