// "Указатель<T>" полем "внешняя структура" (в духе `struct curl_slist
// { char *data; struct curl_slist *next; };` - самоссылающийся связный
// список) и результатом внешней функции (docs/SPEC.md, раздел 12) -
// адрес, пришедший ОТ C, интерпретатор несёт особым, "сырым" способом (не
// тем же, что "&переменная") - для программиста разницы нет, `*p`/`p.поле`
// работают как обычно в обоих backend'ах. Пример строит узел сам, через
// malloc/free (без сторонней библиотеки).
внешняя функция malloc как выделить(размер: Целое): Указатель<Целое>
внешняя функция free как освободить(блок: Указатель<Целое>)

внешняя структура Узел как УзелСписка
{
    имеет:
        Целое            значение
        Указатель<Целое> следующий
}

/** Демонстрирует "Указатель<T>" результатом внешней функции и полем "внешняя структура". */
функция главная
{
    переменная следующее_значение = выделить(8)
    *следующее_значение = 99

    переменная узел = новый УзелСписка(1, следующее_значение)
    вывести `${узел.значение}\n`
    вывести `${*(узел.следующий)}\n`

    освободить(следующее_значение)
}
