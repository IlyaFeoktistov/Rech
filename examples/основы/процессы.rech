использовать РезультатКоманды, выполнить_команду, Процесс, отправить_сигнал, СигналОС, запустить_процесс из стандарт/система

/**
 * Демонстрирует три встроенные функции запуска внешних процессов:
 * "выполнить_команду(команда, каталог)" - блокирующий запуск ЧЕРЕЗ
 * системную оболочку (понимает пайпы/"&&", как в терминале), результат -
 * сущность "РезультатКоманды" с полями "вывод"/"ошибка"/"код_возврата" -
 * и "запустить_процесс(команда, аргументы)"/"процесс.дождаться_завершения()" -
 * неблокирующий запуск БЕЗ оболочки, вместе с уже существующим
 * "отправить_сигнал" (см. examples/основы/сигналы.rech) достаточный, чтобы
 * запустить процесс, получить его pid и остановить его.
 *
 * Код после SIGTERM - 143 (128 + номер сигнала) и на Linux/macOS, и на
 * Windows (там "отправить_сигнал" завершает процесс тем же кодом).
 *
 * "запустить_процесс" здесь намеренно не печатает pid напрямую (число
 * зависит от системы и от запуска, не всегда одно и то же) - только то,
 * что процесс можно остановить и корректно дождаться.
 */
#если ОС.Windows {
    /** Долгий процесс без оболочки: на Windows нет "sleep". */
    функция запустить_долгий(): Процесс
    {
        Список<Строка> аргументы = ["-NoProfile", "-Command", "Start-Sleep 30"]
        вернуть запустить_процесс("powershell", аргументы)
    }
} #иначе {
    /** Долгий процесс без оболочки. */
    функция запустить_долгий(): Процесс
    {
        Список<Строка> аргументы = ["30"]
        вернуть запустить_процесс("sleep", аргументы)
    }
}

функция главная
{
    РезультатКоманды результат = выполнить_команду("echo привет")
    вывести `${результат.вывод}\n`
    вывести `${результат.код_возврата}\n`

    РезультатКоманды неудача = выполнить_команду("exit 7")
    вывести `${неудача.код_возврата}\n`

    Процесс процесс = запустить_долгий()
    отправить_сигнал(процесс.pid, СигналОС.SIGTERM)
    Целое код = процесс.дождаться_завершения()
    вывести `${код}\n`
}
