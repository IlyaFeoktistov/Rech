// Две равнозначные формы объявления переменной (docs/SPEC.md, раздел
// "Nullable-типы"): "переменная имя[: Тип] = значение" (тип по выводу из
// значения или через двоеточие) и, там где тип и так пишется явно,
// "Тип имя = значение" - без слова "переменная", тип первым, привычным по
// C#/Java/C++ порядком. Оба порождают один и тот же узел объявления - у
// компилятора нет разницы между ними, это вопрос стиля.

/** Обе формы объявления переменной бок о бок. */
функция главная
{
    переменная а = 5           // вывод типа из значения, как обычно
    Целое б      = 10                // тот же смысл, тип написан явно первым

    переменная числа1: Список<Целое> = [1, 2, 3]
    Список<Целое> числа2             = [1, 2, 3]

    переменная опция1: ?Целое = Ничто
    ?Целое опция2             = Ничто

    вывести а + б         // 15
    вывести числа1.длина() + числа2.длина() // 6
    вывести (опция1 == Ничто) == (опция2 == Ничто)     // истина

    // Перенос строки вокруг "=" тоже незначим (docs/SPEC.md, раздел 2) -
    // удобно, когда правая часть длинная.
    переменная третья
        = 1
    переменная четвёртая =
        2
    вывести третья + четвёртая         // 3
}
