// "показать" - отладочный вывод: значение вместе с типом, рекурсивно для
// сущностей (поля по порядку объявления) и встроенных коллекций (элементы
// по порядку). В отличие от "вывести" (только Строка/Целое/Действительное/
// Логическое), работает для любого типа.

сущность Точка
{
    имеет:
        x: Целое
        y: Действительное
}

функция главная
{
    показать 5
    показать 3.5
    показать "текст"
    показать истина

    переменная p = новая Точка(1, 2.5)
    показать p

    переменная числа = новый Список<Целое>()
    числа.добавить(10)
    числа.добавить(20)
    показать числа
}
