/**
 * Вариативная C-функция - "..." последним параметром, без имени (как в
 * C: "int sprintf(char *buf, const char *fmt, ...)"). Сверх объявленных
 * параметров вызов передаёт сколько угодно аргументов, каждый своего
 * типа; Дробное расширяется до double, узкие целые и Логическое - до int,
 * как в C. Целое - 64-битное ("%lld"), Целое32 - "%d". См. docs/SPEC.md,
 * раздел 12.
 */
внешняя функция malloc(размер: Целое): *Байт
внешняя функция free(память: *Байт)
внешняя функция sprintf(буфер: *Байт, формат: Строка, ...): Целое32

/** Текст C-строки (UTF-8) по адресу текст - до нулевого байта. */
функция из_c(текст: *Байт): Строка
{
    Список<Байт> байты = []
    для i = 0; текст[i] != 0; i++ {
        байты.добавить(текст[i])
    }
    вернуть строка_из_байт(байты)
}

функция главная
{
    *Байт буфер = malloc(128)

    Целое32 длина = sprintf(буфер, "%lld|%5.2f|%s", 42, 3.14159, "текст")
    вывести `${из_c(буфер)} (${длина} байт)\n`

    Дробное доля = 0.5
    Байт    код  = 65
    sprintf(буфер, "%d %c %.1f %d", (Целое32) -7, код, доля, истина)
    вывести `${из_c(буфер)}\n`

    free(буфер)
}
