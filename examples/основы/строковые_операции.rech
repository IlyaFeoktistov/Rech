/**
 * Индексация строк - по КОДОВЫМ ТОЧКАМ Unicode, не байтам (тем же
 * принципом, что и "Символ" - см. docs/SPEC.md): "длина_строки" считает
 * буквы, а не байты UTF-8, "подстрока"/"позиция_в_строке" индексируют
 * так же. Нет функции разбиения на части ("разбить") - только эти три
 * .
 */
функция главная
{
    переменная текст = "привет, мир!"
    вывести `${длина_строки(текст)}\n`
    вывести `${подстрока(текст, 0, 6)}\n`
    вывести `${подстрока(текст, 8, 3)}\n`
    вывести `${позиция_в_строке(текст, "мир")}\n`
    вывести `${позиция_в_строке(текст, "нет такого")}\n`

    переменная заголовок = "Cookie: session=abc123; тема=1"
    переменная позиция   = позиция_в_строке(заголовок, "session=")
    если позиция != -1 {
        переменная от_значения = подстрока(заголовок, позиция + 8, длина_строки(заголовок) - позиция - 8)
        переменная конец       = позиция_в_строке(от_значения, ";")
        вывести `${подстрока(от_значения, 0, конец)}\n`
    }

    // Те же функции - методами самой строки.
    вывести `${текст.длина()} ${текст.содержит("мир")}\n`
    вывести `${текст.в_верхний_регистр()} ${текст.заменить("мир", "Rech")} ${текст.начинается_с("привет")}\n`
}
