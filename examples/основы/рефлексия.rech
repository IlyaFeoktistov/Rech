// Рефлексия - "тип <Имя>" (дескриптор типа без экземпляра, аналог
// typeof), боксирование "(Значение) x" (значение любого типа), "как"
// (разбоксирование обратно, с проверкой в рантайме) и методы встроенных
// "Тип"/"Значение" - имя типа, поля/методы по индексу, чтение/запись поля
// по имени, вызов метода по имени, динамическое создание экземпляра.

структура Точка
{
    имеет:
        x: Целое
        y: Целое
}

сущность Животное
{
    имеет:
        имя: Строка

    голос(): Строка
    {
        вернуть "..."
    }
}

интерфейс Мяукающий
{
    голос(): Строка
}

сущность Кот наследует Животное реализует Мяукающий
{
    конструктор(имя: Строка)
    {
        этот.имя = имя
    }

    голос(): Строка
    {
        вернуть "мяу"
    }
}

/** Полный обзор рефлексии - типы, поля, методы, боксирование, вызов. */
функция главная
{
    // "тип <Имя>" - дескриптор типа, известного уже во время компиляции.
    переменная типКота = тип Кот
    вывести типКота.имя()
    вывести типКота.число_полей()
    вывести типКота.имя_поля(0)
    вывести типКота.число_методов()

    // Боксирование ("(Значение) x") работает для структуры и сущности
    // одинаково - "как" разбоксирует обратно, с проверкой типа в рантайме.
    переменная точка = новая Точка(3, 4)
    переменная коробкаТочки = (Значение) точка
    переменная соваТочка = коробкаТочки как Точка
    вывести соваТочка.x + соваТочка.y

    переменная кот = новый Кот("Мурка")
    переменная коробкаКота = (Значение) кот

    // Чтение/запись поля по имени - в обход статической проверки типов.
    переменная имяПоле = коробкаКота.получить_поле("имя")
    вывести (имяПоле как Строка)
    коробкаКота.установить_поле("имя", (Значение) "Барсик")
    переменная снова = коробкаКота как Кот
    вывести снова.имя

    // Вызов метода по имени - находит переопределённую версию (Кот, не
    // Животное), тем же принципом, что и обычный полиморфный вызов.
    переменная аргументы = новый Список<Значение>()
    переменная голос = коробкаКота.вызвать("голос", аргументы)
    вывести (голос как Строка)

    // Динамическое создание экземпляра по Тип - аналог
    // Activator.CreateInstance.
    переменная новыеАргументы = новый Список<Значение>()
    новыеАргументы.добавить((Значение) "Рыжик")
    переменная новыйКот = типКота.создать(новыеАргументы) как Кот
    вывести новыйКот.имя

    // "тип <ИмяИнтерфейса>" - дескриптор САМОГО интерфейса (только методы,
    // без полей/конструктора - у интерфейса их нет). "значение как
    // <ИмяИнтерфейса>" - распаковывает боксированную КОНКРЕТНУЮ реализацию
    // как интерфейс, который она реализует (не только точное совпадение
    // типа, как у обычного "как Тип" выше) - вызов метода дальше идёт как
    // обычный полиморфный вызов через интерфейс, не рефлексивный
    // "вызвать".
    переменная типМяукающего = тип Мяукающий
    вывести типМяукающего.имя()
    вывести типМяукающего.число_методов()

    переменная мяукающий = коробкаКота как Мяукающий
    вывести мяукающий.голос()

    // "базовый_тип"/"наследует_ли"/"число_интерфейсов"/"получить_интерфейс"/
    // "реализует_ли" - паритет с C# Type.BaseType/IsSubclassOf/
    // GetInterfaces/IsAssignableFrom.
    переменная базаКота = типКота.базовый_тип()
    вывести базаКота.имя()
    вывести типКота.наследует_ли(тип Животное)
    вывести типКота.число_интерфейсов()
    переменная реализуемый = типКота.получить_интерфейс(0)
    вывести реализуемый.имя()
    вывести типКота.реализует_ли(тип Мяукающий)
}
