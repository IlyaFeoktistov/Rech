/**
 * Демонстрирует "получен_сигнал(сигнал: СигналОС): Логическое" - обобщение
 * "запрошена_остановка" на любой именованный POSIX-сигнал - и обратную
 * сторону, "отправить_сигнал(pid, сигнал)", посылающую именованный сигнал
 * ДРУГОМУ процессу. "получен_сигнал" взводится один раз, при первом
 * получении, и не сбрасывается - программа сама решает, что делать дальше,
 * когда флаг взведён.
 *
 * Живая проверка (не только этот файл, реальная отправка сигнала процессу
 * между ДВУМЯ отдельными запусками). Здесь - просто
 * проверка без единого реального сигнала: обе строки печатают "ложь", пока
 * никто не прислал процессу SIGHUP/SIGUSR1.
 */
функция главная
{
    вывести получен_сигнал(СигналОС.SIGHUP)
    вывести получен_сигнал(СигналОС.SIGUSR1)

    // SIGKILL/SIGSTOP нельзя перехватить ни при каких условиях (ограничение
    // POSIX) - "получен_сигнал" с ними паникует, а не молча регистрирует
    // обработчик, который всё равно никогда не сработает:
    //
    // получен_сигнал(СигналОС.SIGKILL)  // паника: сигнал нельзя перехватить

    // "отправить_сигнал" - наоборот, разрешает SIGKILL/SIGSTOP (отправить
    // другому процессу их можно всегда - POSIX запрещает только их
    // ПЕРЕХВАТ самим адресатом) - паникует, только если отправка не
    // удалась (несуществующий pid - ESRCH):
    попытаться {
        отправить_сигнал(999999999, СигналОС.SIGTERM)
    } поймать(сообщение: Паника) {
        вывести "отправка не удалась (такого pid не существует): "
        вывести сообщение
    }
}
