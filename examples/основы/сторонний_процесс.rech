/**
 * Мини-отладчик - доступ к памяти/выполнению уже запущенного процесса по
 * pid: "подключиться_к_процессу(pid): Процесс" (ptrace(PTRACE_ATTACH) на
 * Linux/DebugActiveProcess на Windows - процесс при этом ОСТАНАВЛИВАЕТСЯ
 * на обеих платформах, как настоящим отладчиком), "процесс.прочитать(адрес,
 * размер): Список<Байт>"/"процесс.записать(адрес, байты)"
 * (ReadProcessMemory/WriteProcessMemory или process_vm_readv/writev),
 * "процесс.найти(шаблон): Список<Целое>" (сканирует ВСЮ читаемую память в
 * поиске байтовой сигнатуры, возвращает адреса всех вхождений),
 * "процесс.регистры()"/"процесс.установить_регистры(р)" (общие регистры
 * amd64), "процесс.точка_останова(адрес)"/"процесс.снять_точку_останова
 * (адрес)"/"процесс.возобновить(): Целое" (программная точка останова -
 * int3, возобновить продолжает до следующей остановки, возвращает адрес),
 * "процесс.отключиться()". См. docs/SPEC.md.
 *
 * Демонстрация - та же "sleep", что и examples/основы/процессы.rech,
 * запущенная как дочерний процесс. "/proc/<pid>/maps" (Linux) даёт
 * настоящий, а не выдуманный, адрес - первая строка всегда начало
 * отображения самого исполняемого файла - первые 4 байта там ОБЯЗАНЫ быть
 * сигнатурой ELF (0x7F 'E' 'L' 'F') - настоящая проверка, что чтение чужой
 * памяти по адресу действительно работает, а не просто не падает.
 * "процесс.найти" затем ищет ТУ ЖЕ сигнатуру уже по всей памяти процесса,
 * без заранее известного адреса - реальный найденный адрес обязан
 * совпасть с уже известным (двойная проверка одного и того же факта двумя
 * независимыми путями).
 * "открыть"+"прочитать_байты", не "прочитать_файл" - "/proc/.../maps" не
 * поддерживает SEEK_END/ftell (виртуальный, генерируется на лету), которым
 * пользуется "прочитать_файл" для размера - обычный fread с заведомо
 * достаточным пределом читает его без проблем.
 *
 * Точка останова ставится по адресу, на котором "sleep" УЖЕ остановлена
 * подключением - это адрес ВОЗВРАТА из системного вызова "nanosleep"
 * (регистры процесса, остановленного ptrace/DebugActiveProcess ВНУТРИ
 * системного вызова, уже указывают на инструкцию сразу после него) -
 * когда "sleep" реально просыпается по истечении времени, выполнение
 * обязано пройти РОВНО через этот адрес, поэтому точка останова
 * гарантированно срабатывает один раз, без угадывания адреса заранее.
 *
 * Сама программа собирается на любой платформе, но по-настоящему
 * проверяема только на Linux (Windows не даёт настолько же простого
 * способа узнать реальный адрес чужого процесса без разбора PE-заголовка,
 * и целевые процессы там сложнее устроены изнутри - MSYS/Cygwin-подобный
 * рантайм "sleep"/"sh" на Windows заметно многопоточнее, чем на Linux).
 */
функция главная
{
    переменная аргументы: Список<Строка> = ["2"]
    переменная цель: Процесс             = запустить_процесс("sleep", аргументы)
    // Эвристика, не гарантия: даёт "sleep" время реально дойти до вызова
    // "nanosleep" - без неё точка останова ниже (адрес возврата из
    // "nanosleep") иногда ставится по адресу, где процесс ещё не был
    // (проверено вживую - без задержки пример падает примерно в 40%
    // запусков). Настоящей гарантии "подключиться РОВНО в момент запуска,
    // без гонки" текущий API не даёт.
    спать_мс(100)

    переменная файл_карт: Файл = открыть(`/proc/${цель.pid}/maps`)
    переменная карты: Строка   = строка_из_байт(прочитать_байты(файл_карт, 4096))
    закрыть(файл_карт)

    переменная первая_строка: Строка = разбить(карты, "\n").первый()
    переменная диапазон: Строка      = разбить(первая_строка, " ").первый()
    переменная начало_шестн: Строка  = разбить(диапазон, "-").первый()
    переменная адрес: Целое          = целое_из_hex(начало_шестн)

    переменная отладчик: Процесс       = подключиться_к_процессу(цель.pid)
    переменная сигнатура: Список<Байт> = отладчик.прочитать(адрес, 4)
    вывести `${сигнатура.первый() // 127 (0x7F) - начало сигнатуры ELF}\n`
    утверждать сигнатура.первый() == (Байт) 127

    переменная найденные: Список<Целое> = отладчик.найти(сигнатура)
    вывести `${найденные.длина() > 0}\n`
    утверждать найденные.первый() == адрес

    переменная регистры: Регистры    = отладчик.регистры()
    переменная адрес_возврата: Целое = регистры.rip
    отладчик.установить_регистры(регистры) // без изменений - проверка, что запись не роняет процесс

    отладчик.точка_останова(адрес_возврата)
    переменная адрес_остановки: Целое = отладчик.возобновить()
    вывести `${адрес_остановки == адрес_возврата}\n`
    утверждать адрес_остановки == адрес_возврата

    отладчик.снять_точку_останова(адрес_возврата)
    отладчик.отключиться()
    цель.дождаться_завершения()
}
