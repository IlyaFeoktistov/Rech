/**
 * Мини-отладчик - доступ к памяти уже запущенного процесса по pid:
 * "подключиться_к_процессу(pid): Процесс" (Linux - ptrace(PTRACE_ATTACH),
 * процесс при этом останавливается, как настоящим отладчиком; Windows -
 * только проверка, что процесс существует и доступен, без остановки),
 * "процесс.прочитать(адрес, размер): Список<Байт>"/"процесс.записать(адрес,
 * байты)" (Windows/Linux - ReadProcessMemory/WriteProcessMemory или
 * process_vm_readv/writev), "процесс.найти(шаблон): Список<Целое>"
 * (сканирует ВСЮ читаемую память в поиске байтовой сигнатуры, возвращает
 * адреса всех вхождений), "процесс.отключиться()". См. docs/SPEC.md.
 *
 * Демонстрация - та же "sleep", что и examples/основы/процессы.rech,
 * запущенная как дочерний процесс. "/proc/<pid>/maps" (Linux) даёт
 * настоящий, а не выдуманный, адрес - первая строка всегда начало
 * отображения самого исполняемого файла - первые 4 байта там ОБЯЗАНЫ быть
 * сигнатурой ELF (0x7F 'E' 'L' 'F') - настоящая проверка, что чтение чужой
 * памяти по адресу действительно работает, а не просто не падает.
 * "процесс.найти" затем ищет ТУ ЖЕ сигнатуру уже по всей памяти процесса,
 * без заранее известного адреса - реальный найденный адрес обязан
 * совпасть с уже известным (двойная проверка одного и того же факта двумя
 * независимыми путями).
 * "открыть"+"прочитать_байты", не "прочитать_файл" - "/proc/.../maps" не
 * поддерживает SEEK_END/ftell (виртуальный, генерируется на лету), которым
 * пользуется "прочитать_файл" для размера - обычный fread с заведомо
 * достаточным пределом читает его без проблем. Сама программа собирается
 * на любой платформе, но по-настоящему проверяема только на Linux (Windows
 * не даёт настолько же простого способа узнать реальный адрес чужого
 * процесса без разбора PE-заголовка).
 */
функция главная
{
    переменная аргументы: Список<Строка> = новый Список<Строка>()
    аргументы.добавить("2")
    переменная цель: Процесс = запустить_процесс("sleep", аргументы)
    спать_мс(100) // дать процессу реально стартовать, прежде чем читать его /proc

    переменная файл_карт: Файл = открыть(`/proc/${цель.pid}/maps`)
    переменная карты: Строка = строка_из_байт(прочитать_байты(файл_карт, 4096))
    закрыть(файл_карт)

    переменная первая_строка: Строка = разбить(карты, "\n").получить(0)
    переменная диапазон: Строка = разбить(первая_строка, " ").получить(0)
    переменная начало_шестн: Строка = разбить(диапазон, "-").получить(0)
    переменная адрес: Целое = целое_из_hex(начало_шестн)

    переменная отладчик: Процесс = подключиться_к_процессу(цель.pid)
    переменная сигнатура: Список<Байт> = отладчик.прочитать(адрес, 4)
    вывести сигнатура.получить(0) // 127 (0x7F) - начало сигнатуры ELF
    утверждать сигнатура.получить(0) == (Байт) 127

    переменная найденные: Список<Целое> = отладчик.найти(сигнатура)
    вывести найденные.длина() > 0
    утверждать найденные.получить(0) == адрес

    отладчик.отключиться()
    цель.дождаться_завершения()
}
