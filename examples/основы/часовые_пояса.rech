использовать время_как_дата, дату_в_строку, ДатаВремя из стандарт/время
использовать содержит из стандарт/строки

/**
 * Часовые пояса (полная база IANA tzdata, с учётом перехода на летнее
 * время) и методы "ДатаВремя" в стиле Carbon (PHP) - синтаксический сахар
 * поверх время_как_дата/дата_как_время/время_как_дата_в_поясе.
 */
функция главная
{
    переменная метка = 1721044800 // 2024-07-15 12:00:00 UTC
    переменная база  = время_как_дата(метка)

    переменная москва = база.в_поясе("Europe/Moscow")
    утверждать москва != Ничто
    вывести `${дату_в_строку(москва ?? база)}\n`

    переменная нью_йорк = база.в_поясе("America/New_York")
    утверждать нью_йорк != Ничто
    вывести `${дату_в_строку(нью_йорк ?? база)}\n`

    переменная неизвестный_пояс = база.в_поясе("Не/Существует")
    утверждать неизвестный_пояс == Ничто

    переменная завтра = база.добавить_дни(1)
    вывести `${дату_в_строку(завтра)}\n`
    утверждать база.раньше(завтра)
    утверждать завтра.позже(база)
    утверждать завтра.разница_в_днях(база) == 1
    утверждать завтра.разница_в_часах(база) == 24

    переменная суббота = новая ДатаВремя(2024, 7, 20, 0, 0, 0)
    утверждать суббота.является_выходным()
    утверждать база.является_выходным() == ложь

    // "в_читаемом_виде" сравнивает с ТЕКУЩИМ моментом - точный текст
    // недетерминирован (зависит от того, когда запущена программа),
    // поэтому здесь проверяется только форма результата, не точное
    // значение (тот же принцип, что и у времени в
    // examples/проекты/супервизор_процессов/наблюдатель/форматирование_тест.rech).
    утверждать содержит(база.в_читаемом_виде(), "назад")
}
