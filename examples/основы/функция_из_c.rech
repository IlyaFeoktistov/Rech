// Указатель на функцию, пришедший ОТ C, становится обычным значением
// "Вызываемый(...)" (docs/SPEC.md, раздел 12): его можно вызвать из Rech и
// передать обратно в C. Здесь указатель ищется по имени в самой C-
// библиотеке - dlsym (Linux/macOS) или GetProcAddress (Windows). Тип
// результата "?Вызываемый(...)" - функции может не быть: для
// несуществующего имени C возвращает NULL, в Rech это Ничто.
#если ОС.Windows {
    внешняя функция GetModuleHandleA как загруженная_библиотека(имя: Строка): Указатель<Байт>
    внешняя функция GetProcAddress как найти_функцию(модуль: Указатель<Байт>, имя: Строка): ?Вызываемый(Целое32): Целое32

    /** Библиотека C, где лежит abs. */
    публичная функция библиотека_c(): Указатель<Байт>
    {
        вернуть загруженная_библиотека("ucrtbase.dll")
    }
} #иначе {
    внешняя функция dlopen(путь: Указатель<Байт>, флаги: Целое32): Указатель<Байт>
    внешняя функция dlsym как найти_функцию(модуль: Указатель<Байт>, имя: Строка): ?Вызываемый(Целое32): Целое32

    /** Сама программа вместе со всеми загруженными библиотеками (dlopen(NULL)). */
    публичная функция библиотека_c(): Указатель<Байт>
    {
        вернуть dlopen(Ничто, (Целое32) 2)
    }
}

/** Применяет преобразование к числу - принимает любую функцию этой сигнатуры. */
публичная функция применить(преобразование: Вызываемый(Целое32): Целое32, число: Целое32): Целое32
{
    вернуть преобразование(число)
}

публичная функция главная
{
    переменная библиотека = библиотека_c()

    переменная модуль_числа = найти_функцию(библиотека, "abs")
    если модуль_числа != Ничто {
        переменная абс: Вызываемый(Целое32): Целое32 = модуль_числа
        вывести `${абс((Целое32) -5)}\n`
        вывести `${применить(абс, (Целое32) -7)}\n`
    }

    переменная нет_такой = найти_функцию(библиотека, "нет_такой_функции")
    вывести `${нет_такой == Ничто}\n`
}
