// Целое8/16/32/64, Натуральное/Натуральное8/16/32/64 (аналоги C int8_t/
// uint32_t/...). Один тип - арифметика в нём же, с переполнением по
// модулю, как в C. Разные типы приводятся к общему: более широкому, а
// знаковое с беззнаковым - к знаковому, вмещающему оба (не как в C, где
// "-1 < 1u" - ложь). Сужение - только явным кастом.

/** Фиксированные ширины/знаковость: арифметика, переполнение, касты. */
функция главная
{
    // "+"/"-"/"*" усекаются/оборачиваются по ширине типа, как C.
    Целое8 а = 100
    Целое8 б = 27
    вывести `${а + б}\n`
    вывести `${а - б}\n`
    вывести `${а * б}\n`  // переполнение Целое8 - оборачивается в отрицательное

    Натуральное8 н1 = 200
    Натуральное8 н2 = 100
    вывести `${н1 + н2}\n`  // переполнение Натуральное8 - оборачивается, не паникует

    // Натуральное64 может нести значение выше того, что помещается в
    // знаковое Целое64 - "0 - 1" оборачивается в максимум диапазона.
    переменная большое = (Натуральное64) 0 - (Натуральное64) 1
    вывести `${большое}\n`
    вывести `${большое / 2}\n`
    вывести `${(Строка) большое}\n`
    вывести `${(Действительное) большое}\n`

    Целое32 х = -5
    вывести `${-х}\n`
    вывести `${(Строка) х}\n`
    вывести `${(Целое32) (Строка) "-2000000000"}\n`

    Натуральное16 у = 5
    у++
    вывести `${у}\n`
    у--
    вывести `${у}\n`

    Натуральное32 п = 10
    вывести `${п < 20}\n`
    вывести `${п == 10}\n`

    // Разные типы - общий тип: Целое32 + Натуральное32 - Целое.
    Целое32 минус = -1
    вывести `${минус < п}\n`
    вывести `${минус + п}\n`
    Целое8 малое = (Целое8) (а + б + минус)
    вывести `${малое}\n`
}
