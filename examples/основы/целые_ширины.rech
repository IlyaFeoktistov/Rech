// Целое8/16/32/64, Натуральное/Натуральное8/16/32/64 (аналоги C int8_t/
// uint32_t/... - шаг 12) - арифметика строго между операндами одного и
// того же типа (никакой неявной промоции между шириной/знаковостью, даже
// к обычному Целое), явный каст переносит значение между ними.

/** Фиксированные ширины/знаковость: арифметика, переполнение, касты. */
функция главная
{
    // "+"/"-"/"*" усекаются/оборачиваются по ширине типа, как C.
    переменная а = (Целое8) 100
    переменная б = (Целое8) 27
    вывести `${а + б}\n`
    вывести `${а - б}\n`
    вывести `${а * б // переполнение Целое8 - оборачивается в отрицательное}\n`

    переменная н1 = (Натуральное8) 200
    переменная н2 = (Натуральное8) 100
    вывести `${н1 + н2 // переполнение Натуральное8 - оборачивается, не паникует}\n`

    // Натуральное64 может нести значение выше того, что помещается в
    // знаковое Целое64 - "0 - 1" оборачивается в максимум диапазона.
    переменная большое = (Натуральное64) 0 - (Натуральное64) 1
    вывести `${большое}\n`
    вывести `${большое / (Натуральное64) 2}\n`
    вывести `${(Строка) большое}\n`
    вывести `${(Действительное) большое}\n`

    переменная х = (Целое32) -5
    вывести `${-х}\n`
    вывести `${(Строка) х}\n`
    вывести `${(Целое32) (Строка) "-2000000000"}\n`

    переменная у = (Натуральное16) 5
    у++
    вывести `${у}\n`
    у--
    вывести `${у}\n`

    переменная п = (Натуральное32) 10
    вывести `${п < (Натуральное32) 20}\n`
    вывести `${п == (Натуральное32) 10}\n`
}
