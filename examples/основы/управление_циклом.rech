// "прервать"/"продолжить" работают в любом из четырёх видов цикла (пока/
// для-диапазон/для-в/общий для) - здесь показаны на "пока" и на общем
// "для", который сам по себе - отдельная тема ниже.

/**
 * "прервать" - немедленный выход из цикла, "продолжить" - пропуск
 * оставшейся части текущей итерации.
 */
функция прервать_и_продолжить
{
    переменная i = 0
    пока i < 10 {
        i = i + 1
        если i == 7 {
            прервать
        }
        если i % 2 == 0 {
            продолжить
        }
        вывести `${i}\n`
    }
}

/**
 * Общий "для <инициализация>; <условие>; <шаг>" - без скобок вокруг трёх
 * секций (в Rech их нигде больше нет вокруг условия) - ";" здесь тот же
 * разделитель инструкций, что и везде в языке. В отличие от диапазонного
 * "для <имя> от <от> до <до>" (только по возрастанию, шаг 1), здесь шаг и
 * направление произвольные.
 */
функция общий_для
{
    для i = 10; i > 0; i = i - 3 {
        вывести `${i}\n`
    }
}

/**
 * "продолжить" внутри общего "для" всё равно выполняет секцию шага перед
 * повторной проверкой условия, ровно как в C - счётчик не застревает.
 */
функция общий_для_с_продолжить
{
    для i = 0; i < 6; i = i + 1 {
        если i % 2 == 0 {
            продолжить
        }
        вывести `${i}\n`
    }
}

/**
 * Все три секции необязательны, независимо друг от друга - "для ;; {...}"
 * (все три пустые) бесконечен, выйти можно только через "прервать" (или
 * "вернуть"/панику/исключение).
 */
функция бесконечный_для
{
    переменная i = 0
    для ;; {
        если i >= 3 {
            прервать
        }
        вывести `${i}\n`
        i = i + 1
    }
}

/**
 * Тип переменной общего "для" можно написать явно - как у объявления
 * "Байт б = 253". Байт после 255 переходит в 0, как unsigned char в C.
 */
функция общий_для_с_типом
{
    для Байт б = 253; б != 1; б++ {
        вывести `${б}\n`
    }
}

/**
 * "прервать N"/"продолжить N" - необязательный числовой аргумент глубины
 * (PHP-стиль "break N"/"continue N" - число уровней вложенности циклов,
 * считая текущий, НЕ именованная метка) - без него, как и раньше, "1"
 * (ближайший охватывающий цикл).
 */
функция вложенные_циклы_с_глубиной
{
    // "прервать 2" изнутри внутреннего "для" останавливает СРАЗУ оба
    // цикла - "i" никогда не доходит до 2.
    для i от 1 до 3 {
        для j от 1 до 3 {
            если j == 2 {
                прервать 2
            }
            вывести `${i}\n`
        }
    }
    // "продолжить 2" останавливает внутренний цикл целиком и переходит к
    // СЛЕДУЮЩЕЙ итерации внешнего - "j" никогда не доходит до 3.
    для i от 1 до 3 {
        для j от 1 до 3 {
            если j == 2 {
                продолжить 2
            }
            вывести `${i}\n`
        }
    }
}

функция главная
{
    прервать_и_продолжить()
    общий_для()
    общий_для_с_продолжить()
    бесконечный_для()
    общий_для_с_типом()
    вложенные_циклы_с_глубиной()
}
