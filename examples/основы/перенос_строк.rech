/**
 * Перенос длинной инструкции на несколько строк (docs/SPEC.md, раздел 2):
 * до и после бинарного оператора и "=", после "(" и запятой, а строка,
 * начинающаяся с "." или ",", всегда продолжает предыдущую - цепочка
 * вызовов и запятая в начале строки.
 */
сущность ЗапросСЗаголовками
{
    имеет:
        приватная Строка         адрес
        приватный Список<Строка> заголовки

    конструктор(адрес: Строка)
    {
        этот.адрес     = адрес
        этот.заголовки = []
    }

    /** Добавляет заголовок и возвращает тот же запрос - для цепочки. */
    публичный с_заголовком(заголовок: Строка): этот
    {
        этот.заголовки.добавить(заголовок)
        вернуть этот
    }

    /** Строка запроса: адрес и число заголовков. */
    публичный описание(): Строка
    {
        вернуть `${этот.адрес} (${этот.заголовки.длина()} заголовка)`
    }
}

/** Сумма трёх чисел - параметры в стиле "запятая в начале строки". */
функция сумма(
    первое: Целое
    , второе: Целое
    , третье: Целое
): Целое {
    вернуть первое + второе + третье
}

функция главная
{
    ЗапросСЗаголовками запрос = новый ЗапросСЗаголовками("https://пример.рф")
        .с_заголовком("Accept: */*")
        .с_заголовком("User-Agent: rech")
    вывести `${запрос.описание()}\n`

    Целое итог = сумма(
        1
        , 2
        , 3
    )
    Список<Строка> имена = [
        "Аня"
        , "Илья"
    ]
    вывести `${итог} ${имена.длина()}\n`
}
