// Стек вызовов при аварийном завершении ("выполнение прервано: ...") -
// печатается вслед за самим сообщением, от места паники вверх до "главная":
// имя функции/метода и строка, на которой этот уровень остановился. У
// метода имя - "Тип.метод". Работает для любой паники рантайма (деление на
// ноль, выход за границы коллекции, необработанное исключение и т. п.), не
// только для приведённого здесь примера.
//
// В отличие от остальных примеров каталога, эта программа намеренно
// завершается ошибкой (`rech run` вернёт ненулевой код) - демонстрирует
// именно это поведение.

функция разделить(делимое: Целое, делитель: Целое): Целое
{
    вернуть делимое / делитель
}

функция вычислить(число: Целое): Целое
{
    переменная результат = разделить(100, число)
    вернуть результат
}

функция главная
{
    вывести вычислить(5)
    вывести вычислить(0)
}
