функция главная
{
    переменная имя = "Илья"
    вывести "Привет, " + имя + "!"

    переменная а = 10
    переменная б = 3
    вывести а + б
    вывести а - б
    вывести а * б
    вывести а / б

    переменная средняя = 2.5
    вывести средняя + 1.5

    переменная можно = истина
    вывести можно

    вывести а > б
    вывести а == б
    вывести (а > б) и не можно
    вывести (а > б) или можно

    а = а + 1
    вывести а
}
