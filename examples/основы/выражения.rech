/**
 * Арифметика, сравнения, логические операторы (словесные и символьные
 * синонимы "&&"/"||") над Целое/Действительное/Логическое/Строка.
 */
функция главная
{
    переменная имя = "Илья"
    вывести `${"Привет, " + имя + "!"}\n`

    переменная а = 10
    переменная б = 3
    вывести `${а + б}\n`
    вывести `${а - б}\n`
    вывести `${а * б}\n`
    вывести `${а / б}\n`
    вывести `${-а}\n`

    переменная средняя = 2.5
    вывести `${средняя + 1.5}\n`

    переменная можно = истина
    вывести `${можно}\n`

    вывести `${а > б}\n`
    вывести `${а == б}\n`
    вывести `${(а > б) и не можно}\n`
    вывести `${(а > б) или можно}\n`

    // "&&"/"||" - символьные синонимы "и"/"или" (тот же токен, что и
    // словесная форма - разница только в написании).
    вывести `${(а > б) && не можно}\n`
    вывести `${(а > б) || можно}\n`

    а = а + 1
    вывести `${а}\n`

    // Перенос строки вокруг бинарного оператора незначим и до, и после
    // него (docs/SPEC.md, раздел 2) - удобно разбивать длинное условие.
    если а > 5
        и б < 5
    {
        вывести "оба условия\n"
    }

    переменная сумма_издалека = а
        + б
    вывести `${сумма_издалека}\n`
}
