/** Целочисленные литералы с явным префиксом системы счисления - "0x"/"0X"
(шестнадцатеричный), "0o"/"0O" (восьмеричный), "0b"/"0B" (двоичный) - все
дают обычное "Целое", тот же тип, что и десятичный литерал. Префикс
определяется явно по первым двум символам, поэтому десятичный литерал с
ведущим нулём ("007") остаётся десятичным, не восьмеричным.

Обратное преобразование (число <-> строка) - отдельные функции, не каст:
"целое_в_hex"/"целое_из_hex" и то же для "_oct"/"_bin" - работают с
БИТОВЫМ ПАТТЕРНОМ числа (не величиной), поэтому "целое_в_hex(-1)" даёт
все 64 бита в виде единиц, не ошибку. */
перечисление ПраваДоступа
{
    ЧТЕНИЕ = 0x01,
    ЗАПИСЬ = 0x02,
    ВЫПОЛНЕНИЕ = 0x04
}

функция главная
{
    переменная адрес = 0xFF00
    переменная маска = 0b1010
    переменная восьмеричное = 0o17

    вывести (Строка) адрес
    вывести (Строка) маска
    вывести (Строка) восьмеричное

    переменная права = ПраваДоступа.ЧТЕНИЕ + ПраваДоступа.ЗАПИСЬ
    вывести (Строка) права

    вывести (Строка) 007

    вывести целое_в_hex(255)
    вывести целое_в_oct(15)
    вывести целое_в_bin(10)
    вывести целое_в_hex(-1)
    вывести (Строка) целое_из_hex("FF")
    вывести (Строка) целое_из_oct("0o17")
    вывести (Строка) целое_из_bin("0b1010")
}
