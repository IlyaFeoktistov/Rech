/** Случайные числа - "случайное"/"случайное_целое" (docs/SPEC.md) -
 * криптографически стойкий источник, не воспроизводимый по seed: каждый
 * запуск даёт другие значения, поэтому пример проверяет ГРАНИЦЫ
 * результата, а не конкретные числа. */
функция главная
{
    переменная дробное = случайное()
    вывести дробное >= 0.0 и дробное < 1.0

    переменная бросок = случайное_целое(1, 6)
    вывести бросок >= 1 и бросок <= 6

    вывести случайное_целое(7, 7)
}
