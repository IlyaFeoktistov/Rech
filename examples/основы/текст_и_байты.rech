// "Строка" - всегда текст: валидный UTF-8 без нулевого байта (docs/
// SPEC.md, раздел 5). Байты, пришедшие извне (файл, сокет, процесс, БД,
// строка_из_байт), становятся Строкой так: каждая невалидная
// последовательность и каждый нулевой байт - символ замены "�" (U+FFFD).
// Двоичные данные - Список<Байт> (прочитать_байты/записать_байты).
//
// Запускается из корня репозитория (путь к файлу - относительный).

/** Печатает кусок в квадратных скобках. */
публичная функция показать_кусок(кусок: Строка)
{
    вывести `[${кусок}]`
}

публичная функция главная
{
    // A, нулевой байт, B и оборванное начало двухбайтового символа.
    переменная байты: Список<Байт> = [65, 0, 66, 208]

    переменная текст = строка_из_байт(байты)
    вывести `${текст}\n`
    вывести `${длина_строки(текст)}\n`

    // Чтение кусками по 3 байта не режет символ пополам: кусок кончается
    // целым символом, остаток достаётся следующему чтению.
    записать_в_файл("testdata/текст_кусками.txt", "привет, мир😀")
    переменная файл  = открыть("testdata/текст_кусками.txt")
    переменная кусок = прочитать(файл, 3)
    пока кусок != "" {
        показать_кусок(кусок)
        кусок = прочитать(файл, 3)
    }
    закрыть(файл)
    вывести `\n`
}
