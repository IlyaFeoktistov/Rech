// "текущая_ос()" - платформа, для которой собрана программа (docs/SPEC.md).
// Нужно для кроссплатформенного кода - например, у стороннего FFI-пакета
// имя/путь подключаемой библиотеки часто отличается между Linux/Windows/
// macOS (docs/SPEC.md, раздел 12) - без такой проверки пришлось бы делать
// три отдельных сборки вместо одной программы, работающей везде.
//
// cbackend - это целевая платформа СБОРКИ (известна уже во время
// компиляции через макросы препроцессора C, не настоящий запрос к ОС в
// рантайме - ноль накладных расходов); interp ("rech test") - настоящий
// хост, на котором запущен сам интерпретатор (у него не бывает отдельной
// "целевой платформы", раз нет отдельного шага сборки).
//
// Нет цепочки "иначе если" (докс/SPEC.md, раздел про условные операторы) -
// вложенность через "если" внутри "иначе", как и везде в языке.
/** Демонстрирует "текущая_ос()" и встроенное перечисление "ОС". */
функция главная
{
    переменная ос = текущая_ос()

    если ос == ОС.Linux {
        вывести `Linux\n`
    } иначе {
        если ос == ОС.Windows {
            вывести `Windows\n`
        } иначе {
            вывести `macOS\n`
        }
    }
}
