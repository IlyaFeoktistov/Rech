// "?Тип"/"Ничто" - значение либо самого Тип, либо отсутствие значения.
// Употребление nullable-значения как обычного Тип без доказанной
// непустоты - ошибка КОМПИЛЯЦИИ (не паника в рантайме, в отличие от NULL в
// C/null в Java) - доказывает "если а != Ничто {...}" (и симметрично
// "иначе" у "если а == Ничто {...} иначе {...}"): внутри такого блока
// значение используется напрямую, без явного разворачивания. Вне такого
// блока - явный каст "(Тип) значение" (паника на "Ничто"). "??"
// (null-coalescing) и "?=" (null-coalescing присваивание) - сокращения
// поверх того же механизма. "!x" - синоним "x == Ничто" (только для
// nullable), а guard clause "если !x { вернуть/прервать/продолжить/
// выбросить }" БЕЗ явного "иначе" доказывает непустоту x для ОСТАЛЬНОГО
// кода того же блока - явный каст/повторная проверка дальше не нужны.

сущность Пользователь
{
    имеет:
        имя: Строка

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }
}

функция найтиПользователя(найден: Логическое): ?Пользователь
{
    если найден {
        вернуть новый Пользователь("Аня")
    }
    вернуть Ничто
}

/**
 * Nullable-типы: объявление, сравнение с "Ничто", сужение внутри "если",
 * "??", "?=", явный каст.
 */
функция главная
{
    переменная а: ?Целое = Ничто
    вывести `${а == Ничто // истина}\n`

    а = 10
    если а != Ничто {
        вывести `${а // 10 - внутри блока используется как обычный Целое}\n`
    }

    вывести `${а ?? 0 // 10 (а уже не Ничто)}\n`

    переменная б: ?Целое = Ничто
    вывести `${б ?? 99 // 99 (запасное значение)}\n`

    б ?= 5   // б было Ничто - присваивается
    б ?= 100 // б уже не Ничто - не меняется
    если б != Ничто {
        вывести `${б // 5}\n`
    }

    вывести `${(Целое) а // 10, явный каст}\n`

    переменная п = найтиПользователя(истина)
    если п != Ничто {
        вывести `${п.имя // Аня}\n`
    } иначе {
        вывести "не найден\n"
    }

    переменная нетп = найтиПользователя(ложь)
    если нетп == Ничто {
        вывести `${"не найден" // не найден}\n`
    }

    если !нетп {
        вывести `${"!x — синоним x == Ничто" // истина здесь, "нетп" - Ничто}\n`
    }

    // guard clause: "если !x { вернуть }" сужает x для ВСЕГО кода дальше в
    // этом блоке, без явного "иначе" и без повторной проверки.
    переменная д = найтиПользователя(истина)
    если !д {
        вернуть
    }
    вывести `${д.имя // Аня - "д" уже доказанно Пользователь}\n`
}
