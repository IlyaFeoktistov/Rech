/** Константа уровня модуля (файла) - "константа <имя> = <значение>" вне
 * функции/сущности. Видна из ЛЮБОЙ функции этого же файла по голому имени,
 * порядок объявления не важен - "раньше" ниже ссылается на "ПОЗЖЕ",
 * объявленную дальше по файлу. Коэкзистирует с явной "функция главная" -
 * это ОБЪЯВЛЕНИЕ, а не инструкция неявной "главная". Не импортируется
 * через "использовать" - видна только в своём файле (docs/ROADMAP.md). */
константа МАКС_ПОПЫТОК = 3
константа ПРИВЕТСТВИЕ = "добро пожаловать"

функция раньше(): Целое
{
    вернуть ПОЗЖЕ
}

константа ПОЗЖЕ = 5

функция главная
{
    вывести МАКС_ПОПЫТОК
    вывести ПРИВЕТСТВИЕ
    вывести раньше()
}
