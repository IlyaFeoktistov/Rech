// Синонимы типов. "синоним Имя = Тип" - другое имя того же самого типа, не
// новый тип: значения присваиваются в обе стороны без приведения.
// Generic-синоним ("синоним Имя<T> = ...") подставляет аргументы в
// параметры при каждом использовании.

/** Набор целых чисел. */
публичный синоним Числа = Список<Целое>

/** Преобразование числа в текст. */
публичный синоним Преобразователь = Вызываемый(Целое): Строка

/** Условие отбора элементов типа T. */
публичный синоним Проверка<T> = Вызываемый(T): Логическое

/** Значение типа T или Ничто. */
публичный синоним ?Может<T> = ?T

/** Числа, сгруппированные по названию. */
приватный синоним Группы = Словарь<Строка, Числа>

/** Применяет преобразование к каждому числу. */
публичная функция применить(числа: Числа, преобразование: Преобразователь): Список<Строка>
{
    переменная итог: Список<Строка> = []
    для число в числах {
        итог.добавить(преобразование(число))
    }

    вернуть итог
}

/** Оставляет только числа, для которых условие истинно. */
публичная функция отобрать(числа: Числа, условие: Проверка<Целое>): Числа
{
    переменная итог: Числа = []
    для число в числах {
        если условие(число) {
            итог.добавить(число)
        }
    }

    вернуть итог
}

/** Первое отрицательное число или Ничто. */
публичная функция первое_отрицательное(числа: Числа): ?Может<Целое>
{
    для число в числах {
        если число < 0 {
            вернуть число
        }
    }

    вернуть Ничто
}

публичная функция главная
{
    переменная числа: Числа = [3, -1, 4, -5, 9]

    // Синоним и исходный тип - один и тот же тип.
    переменная список: Список<Целое> = числа
    вывести `${список.длина()}\n`

    переменная подписи = применить(числа, функция (число: Целое): Строка { вернуть `#${число}` })
    для подпись в подписях {
        вывести `${подпись}\n`
    }

    переменная положительные = отобрать(числа, функция (число: Целое): Логическое { вернуть число > 0 })
    вывести `${положительные.длина()}\n`

    вывести `${первое_отрицательное(числа) ?? 0}\n`
    вывести `${первое_отрицательное(положительные) ?? 0}\n`

    переменная группы = новые Группы()
    группы.установить("положительные", положительные)
    вывести `${группы.получить("положительные").длина()}\n`
}
