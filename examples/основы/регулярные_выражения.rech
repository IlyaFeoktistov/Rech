/**
 * "регулярное(строка, шаблон): Список<Совпадение>" - все непересекающиеся
 * вхождения шаблона. "Совпадение" несёт "текст" (весь совпавший фрагмент),
 * "начало" (позиция начала - те же кодовые точки Unicode, что и
 * "позиция_в_строке", не байты) и "группы" (захваченные скобочные группы,
 * "Список<Строка>" - группа без совпадения при необязательной части
 * шаблона - пустая строка, не Ничто).
 *
 * "\w"/"\d"/"\s" - словесный символ/цифра/пробел, "\w" распознаёт и
 * кириллицу тоже (не только ASCII-буквы) - и на интерпретаторе (Go regexp),
 * и при компиляции в C (POSIX regex.h) - см. internal/interp/regex.go и
 * internal/backend/cbackend/regex.go для перевода этих классов на
 * реальный синтаксис каждого движка. Не поддерживаются (ошибка компиляции
 * шаблона): non-capturing группы "(?:...)", lookahead/lookbehind - только
 * обычные скобочные группы "(...)".
 */
функция главная
{
    переменная слова = регулярное("Привет, Мир! Rech велик.", "\\w+")
    для слово в словах {
        вывести слово.текст
    }

    переменная числа = регулярное("цена: 120, скидка: 15%", "\\d+")
    вывести "первое число: " + числа.первый().текст + ", позиция: " + (Строка) числа.первый().начало

    переменная совпадения = регулярное("пишите на a@b.com или x@y.org", "(\\w+)@(\\w+\\.\\w+)")
    для совпадение в совпадениях {
        вывести "адрес: " + совпадение.текст + ", пользователь: " + совпадение.группы.получить(0) + ", домен: " + совпадение.группы.получить(1)
    }

    переменная нет_совпадений = регулярное("без цифр здесь", "\\d+")
    если нет_совпадений.пусто() {
        вывести "цифр не найдено"
    }

    // "a*" совпадает и с пустой строкой - непересекающиеся совпадения
    // нулевой ширины на каждой позиции, где нет "a" (не бесконечный цикл).
    переменная нулевая_ширина = регулярное("bbb", "a*")
    вывести нулевая_ширина.длина()
}
