/** Работа со временем: текущая метка времени и её представление как даты. */
функция главная
{
    переменная дата = время_как_дата(1700000000)
    вывести дата.год
    вывести дата.месяц
    вывести дата.день
    вывести дата.час
    вывести дата.минута
    вывести дата.секунда
    вывести дату_в_строку(дата)
    вывести дата_как_время(дата)

    переменная метка = время()
    утверждать дата_как_время(время_как_дата(метка)) == метка

    переменная разобранная = разобрать_дату("2026-09-10 12:00:00")
    утверждать разобранная != Ничто
    переменная разобранная_дата = разобранная ?? дата
    вывести дату_в_строку(разобранная_дата)

    переменная неверная = разобрать_дату("не дата")
    утверждать неверная == Ничто
}
