// Пределы числовых типов (Тип::МАКСИМУМ/МИНИМУМ/ШИРИНА) и особые значения
// Действительное/Дробное: бесконечность и "не число" (NaN).

/** Среднее значение списка; у пустого списка - NaN (0.0 / 0.0). */
публичная функция среднее(значения: Список<Действительное>): Действительное
{
    Действительное сумма = 0.0
    для х в значениях {
        сумма += х
    }
    вернуть сумма / (Действительное) значения.длина()
}

/** Пределы целых типов, бесконечность, NaN и их проверки. */
функция главная
{
    вывести `Целое8: от ${Целое8::МИНИМУМ} до ${Целое8::МАКСИМУМ}, ${Целое8::ШИРИНА} бит\n`
    вывести `Натуральное64: до ${Натуральное64::МАКСИМУМ}\n`
    вывести `Целое: до ${Целое::МАКСИМУМ}\n`

    Действительное бесконечность = Действительное::БЕСКОНЕЧНОСТЬ
    вывести `${бесконечность} ${-бесконечность} ${бесконечность > Действительное::МАКСИМУМ}\n`

    // NaN не равен даже самому себе - проверять только методом.
    Действительное пустое = среднее([])
    вывести `${пустое} ${пустое == пустое} ${пустое.не_число()}\n`

    Список<Действительное> замеры = [1.5, Действительное::БЕСКОНЕЧНОСТЬ, 2.5, Действительное::НЕ_ЧИСЛО]

    Целое годных = 0
    для х в замерах {
        если х.конечно() {
            годных++
        }
    }
    вывести `годных замеров: ${годных} из ${замеры.длина()}\n`
}
