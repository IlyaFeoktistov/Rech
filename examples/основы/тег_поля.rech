/**
 * Тег - произвольный текст в обратных кавычках, ни на что не влияющий
 * сам по себе (docs/SPEC.md, "Тег поля") - читает его только рефлексия, по
 * своему ключу. Есть у поля (как и раньше), у сущности целиком (аналог
 * атрибута на классе в C#) и у метода. "тип.тег_XXX(ключ)" ищет один ключ;
 * "тип.тег_XXX_текст()" отдаёт сырой текст тега целиком - библиотеке
 * (например, ORM), написанной на самом Rech и не знающей ключи заранее,
 * нужен именно он, чтобы разобрать тег самостоятельно (examples/основы/
 * рефлексия.rech - остальная рефлексия, "число_полей"/"тип_поля" и т. п.).
 *
 * "индекс_поля_по_тегу"/"получить_поле_по_тегу" - обратное направление:
 * дан (ключ, значение) тега ("sql", "user_name"), нужно поле/его индекс,
 * не наоборот - типичный ORM-сценарий "дана колонка БД, нужно узнать
 * привязанное к ней поле сущности" без ручного перебора всех полей.
 * "?Целое"/"?Значение" - тег с таким ключом/значением не найден ни у
 * одного поля.
 */
сущность Пользователь `таблица:users, версия:2`
{
    имеет:
        имя:     Строка `json:name, sql:user_name`
        возраст: Целое  `sql:age`
        активен: Логическое

    сохранить(): Строка `выполняет:запись`
    {
        вернуть "сохранён"
    }
}

функция главная
{
    переменная т = тип Пользователь

    вывести т.тег("таблица")
    вывести т.тег_текст()

    переменная i = 0
    пока i < т.число_полей() {
        вывести т.имя_поля(i)
        вывести т.тег_поля(i, "sql")
        i = i + 1
    }
    вывести т.тег_поля_текст(0)

    вывести т.тег_метода(0, "выполняет")
    вывести т.тег_метода_текст(0)

    переменная индексВозраста = т.индекс_поля_по_тегу("sql", "age")
    если индексВозраста != Ничто {
        вывести т.имя_поля(индексВозраста) // возраст
    }

    переменная нетТакогоИндекса = т.индекс_поля_по_тегу("sql", "нет_такой_колонки")
    вывести нетТакогоИндекса == Ничто // истина

    переменная пользователь = новый Пользователь()
    пользователь.имя = "Аня"
    пользователь.возраст = 30
    пользователь.активен = истина

    переменная бокс = (Значение) пользователь
    переменная поле = бокс.получить_поле_по_тегу("sql", "user_name")
    если поле != Ничто {
        вывести поле как Строка // Аня
    }
}
