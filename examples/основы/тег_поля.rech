/** "тип.тег_поля(индекс, ключ)" - значение ключа тега поля по индексу ("" -
тега нет или в нём нет такого ключа, docs/SPEC.md, "Тег поля"). Позволяет
библиотеке (например, ORM), написанной на самом Rech, прочитать теги
произвольной сущности через уже существующую рефлексию (examples/основы/
рефлексия.rech) - без знания её полей на этапе компиляции самой библиотеки. */
сущность Пользователь
{
    имеет:
        имя: Строка `json:name, sql:user_name`
        возраст: Целое `sql:age`
        активен: Логическое
}

функция главная
{
    переменная т = тип Пользователь
    переменная i = 0
    пока i < т.число_полей()
    {
        вывести т.имя_поля(i)
        вывести т.тег_поля(i, "sql")
        i = i + 1
    }
}
