// Побитовые операторы - только для Целое, в отличие от "и"/"или"/"не"
// (которые словами и только для Логическое) записываются символами, как
// в C: << >> & | ^ ~ (унарный).

/** Побитовые операторы (только для Целое): << >> & | ^ ~. */
функция главная
{
    переменная а = 6   // 0b0110
    переменная б = 3   // 0b0011

    вывести а | б      // 0b0111 = 7
    вывести а & б      // 0b0010 = 2
    вывести а ^ б      // 0b0101 = 5
    вывести ~0         // -1 (все биты 1, дополнение до двух)

    вывести 1 << 3      // 8
    вывести 128 >> 4    // 8

    // Обычный приоритет операций между собой (| слабее ^ слабее & слабее
    // сдвигов слабее +/-), как в C - без скобок легко ошибиться, поэтому
    // на практике их лучше расставлять явно.
    вывести (1 << 2) | (1 << 0)   // 5
}
