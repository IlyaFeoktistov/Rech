// Побитовые операторы - для любого целочисленного типа (Целое, Байт,
// Целое8/16/32/64, Натуральное/8/16/32/64), в отличие от "и"/"или"/"не"
// (которые словами и только для Логическое) записываются символами, как
// в C: << >> & | ^ ~ (унарный). Оба операнда бинарного оператора обязаны
// быть ОДНОГО И ТОГО ЖЕ типа, без неявной промоции (та же строгость, что
// и у арифметики fixed-width типов, examples/основы/целые_ширины.rech) -
// результат остаётся тем же типом, что и операнды, не растёт до Целое.

/** Побитовые операторы (любой целочисленный тип): << >> & | ^ ~. */
функция главная
{
    переменная а = 6   // 0b0110
    переменная б = 3   // 0b0011

    вывести `${а | б      // 0b0111 = 7}\n`
    вывести `${а & б      // 0b0010 = 2}\n`
    вывести `${а ^ б      // 0b0101 = 5}\n`
    вывести `${~0         // -1 (все биты 1, дополнение до двух)}\n`

    вывести `${1 << 3      // 8}\n`
    вывести `${128 >> 4    // 8}\n`

    // Обычный приоритет операций между собой (| слабее ^ слабее & слабее
    // сдвигов слабее +/-), как в C - без скобок легко ошибиться, поэтому
    // на практике их лучше расставлять явно.
    вывести `${(1 << 2) | (1 << 0)   // 5}\n`

    // Ровно те же операторы применимы к Байт напрямую (не только через
    // приведение к Целое и обратно) - результат остаётся Байт, значение
    // усекается до 8 бит (0-255), как в C у unsigned char. Оба операнда
    // (включая счётчик сдвига) обязаны быть Байт - никакого смешения с
    // "голым" Целое-литералом.
    переменная байт_а = (Байт) 6
    переменная байт_б = (Байт) 3

    вывести `${байт_а | байт_б   // 7}\n`
    вывести `${байт_а & байт_б   // 2}\n`
    вывести `${байт_а ^ байт_б   // 5}\n`
    вывести `${~((Байт) 0)       // 255 (дополнение внутри 8 бит, не -1)}\n`

    вывести `${(Байт) 1 << (Байт) 3     // 8}\n`
    вывести `${(Байт) 200 << (Байт) 1   // 144 (400 mod 256 - усечение до Байт)}\n`

    // И для остальных fixed-width типов - усечение по СВОЕЙ ширине.
    переменная в8 = (Натуральное8) 200
    вывести `${в8 << (Натуральное8) 1   // 144 (400 mod 256)}\n`
    вывести `${~((Целое8) 0)            // -1 (дополнение внутри 8 бит)}\n`
}
