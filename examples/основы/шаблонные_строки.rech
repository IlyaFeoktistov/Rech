/** Шаблонные строки в обратных кавычках: интерполяция и многострочность. */
функция главная
{
    Строка имя    = "Аня"
    Целое возраст = 7

    // "${выражение}" - вставка значения любого выражения, приводится к
    // "Строка" автоматически (как явный каст (Строка) значение).
    вывести `Привет, ${имя}! Тебе ${возраст} лет.\n`

    // Настоящий перенос строки в исходнике - настоящий перенос строки в
    // значении, без какого-либо экранирования и без нормализации отступов.
    Строка письмо = `Здравствуй, ${имя}.
Через год тебе будет ${возраст + 1}.`
    вывести `${письмо}\n`

    // Экранирования работают только в обратных кавычках ("..." - как
    // написано): "\n" "\t" "\r" "\`" "\\" и "\$" - буквальный знак "$",
    // если после него не должна начинаться вставка.
    вывести `цена: \$5 (со скидкой)\n`

    // Внутри вставки можно писать произвольное выражение, включая свои
    // собственные строки в кавычках - границу вставки ищем по глубине
    // фигурных скобок, а не по первой попавшейся "}".
    вывести `{"имя": "${имя}", "возраст": ${возраст}}\n`
}
