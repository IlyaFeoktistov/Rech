/**
 * Криптографические примитивы: хеш пароля (SHA-256), подпись токена
 * (HMAC-SHA256, тот же алгоритм, что и у HS256 в JWT) и base64url для
 * частей самого токена. Значения ниже - общеизвестные тестовые векторы
 * (SHA-256("abc"), HMAC-SHA256 из FIPS/RFC-примеров), чтобы результат
 * можно было сверить с любой другой реализацией.
 *
 * "хеш_sha1"/"хеш_md5" - тут же, для контраста: оба алгоритма
 * криптографически сломаны (известны коллизии) - НЕ для новых
 * паролей/подписей (для этого - "хеш_sha256"/"подпись_hmac_sha256" выше),
 * а только для совместимости с форматами, которые их требуют "как есть"
 * (SHA-1 - объекты Git; MD5 - контрольные суммы файлов/ETag старых API).
 */
функция главная
{
    вывести хеш_sha256("abc")
    вывести хеш_sha1("abc")
    вывести хеш_md5("abc")

    переменная подпись = подпись_hmac_sha256("The quick brown fox jumps over the lazy dog", "key")
    вывести подпись

    // "Токен" вида заголовок.тело.подпись - тем же принципом, что и JWT
    // (HS256): заголовок/тело - настоящий base64url JSON, подпись -
    // HMAC-SHA256 в HEX, а не в base64url - Rech "Строка" не несёт
    // отдельно хранимую длину, а сырой 32-байтовый дайджест подписи может
    // содержать 0x00 внутри (docs/SPEC.md, раздел 11).
    переменная заголовок = закодировать_base64url("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")
    переменная тело = закодировать_base64url("{\"пользователь\":\"admin\"}")
    переменная подписанная_часть = заголовок + "." + тело
    переменная токен = подписанная_часть + "." + подпись_hmac_sha256(подписанная_часть, "секретный-ключ")
    вывести токен

    // Проверка подписи - пересчитать HMAC от той же подписанной части и
    // сравнить строки (константное время сравнения здесь не нужно - тот же
    // уровень строгости, что и у остального среза языка, см. ROADMAP).
    утверждать декодировать_base64url(тело) == "{\"пользователь\":\"admin\"}"
}
