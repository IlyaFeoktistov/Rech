// Мини-grep - демонстрация стандартных потоков и аргументов командной
// строки: читает построчно стандартный_ввод(), печатает в
// стандартный_вывод() только строки, содержащие переданный аргумент.
// Перенаправление ("|", ">") делает сам шелл, программе достаточно знать
// про готовые потоки - собрать и запустить:
//
//	rech build examples/основы/mygrep.rech
//	echo "мир" | examples/основы/mygrep истина
//	printf "привет\nмир\nвсем\n" | examples/основы/mygrep мир > найдено.txt

// Нужен ровно один аргумент - образец; код 2 - неверный вызов (как у grep).
константа НУЖНО_АРГУМЕНТОВ     = 1
константа КОД_УСПЕХА          = 0
константа КОД_НЕВЕРНОГО_ВЫЗОВА = 2

/**
 * Печатает строки стандартного ввода, содержащие образец - единственный
 * аргумент командной строки (аргументы - без имени программы, результат -
 * код завершения).
 */
публичная функция главная(аргументы: Список<Строка>): Целое
{
    если аргументы.длина() != НУЖНО_АРГУМЕНТОВ {
        стандартный_вывод_ошибок().записать(`нужен ровно один аргумент - образец для поиска\n`)

        вернуть КОД_НЕВЕРНОГО_ВЫЗОВА
    }
    Строка образец = аргументы.первый()
    Файл   вход    = стандартный_ввод()
    Файл   выход   = стандартный_вывод()
    для строка в входе {
        если содержит(строка, образец) {
            выход.записать(строка)
            выход.записать(`\n`)
        }
    }

    вернуть КОД_УСПЕХА
}
