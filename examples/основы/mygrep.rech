// Мини-grep - демонстрация стандартных потоков и аргументов командной
// строки (шаг 8): читает построчно стандартный_ввод(), печатает в
// стандартный_вывод() только строки, содержащие переданный аргумент.
// Перенаправление ("|", ">") делает сам шелл, программе достаточно знать
// про готовые потоки - собрать и запустить:
//
//	rech build examples/основы/mygrep.rech
//	echo "мир" | examples/основы/mygrep истина
//	printf "привет\nмир\nвсем\n" | examples/основы/mygrep мир > найдено.txt

/** Печатает строки стандартного ввода, содержащие аргумент командной строки. */
функция главная
{
    если количество_аргументов() != 1 {
        записать(стандартный_вывод_ошибок(), "нужен ровно один аргумент - образец для поиска\n")

        вернуть
    }
    переменная образец = аргумент(0)
    переменная вход    = стандартный_ввод()
    для строка в входе {
        если содержит(строка, образец) {
            записать(стандартный_вывод(), строка)
            записать(стандартный_вывод(), "\n")
        }
    }
}
