/** Escape-последовательности, сравнение строк, ";" как разделитель. */
функция главная
{
    // Escape-последовательности: \n (перенос строки), \t (табуляция),
    // \" (кавычка внутри строки), \\ (сама обратная косая черта).
    вывести "строка1\nстрока2"
    вывести "колонка1\tколонка2"
    вывести "он сказал \"привет\""
    вывести "путь: C:\\rech"

    // "==" / "!=" для "Строка" - сравнение содержимого, а не указателей.
    переменная а = "привет"
    переменная б = "привет"
    переменная прощание = "пока"
    вывести а == б
    вывести а != прощание

    // ";" - равноправная альтернатива переносу строки как разделителю
    // инструкций внутри блока; можно смешивать с переносами.
    переменная г = "x"; переменная д = "y"
    вывести г + д
}
