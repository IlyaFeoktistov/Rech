/**
 * "спать_мс"/"выйти" - управление текущим потоком/процессом. "выйти"
 * завершает ВЕСЬ процесс немедленно, из любой глубины вызовов, минуя
 * "окончательно"/"поймать" - не то же самое, что "вернуть" из "главная"
 * (та код возврата отдавать не умеет вовсе).
 */
функция проверить_возраст(возраст: Целое)
{
    если возраст < 0 {
        вывести "недопустимый возраст"
        выйти(1)
    }
}

функция главная
{
    вывести "начало"
    спать_мс(10)
    вывести "прошло 10мс"

    проверить_возраст(-5)

    вывести "сюда не дойдём"
}
