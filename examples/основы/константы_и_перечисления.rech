// Константы и перечисления (шаг 12). "константа" - как "переменная", но
// повторное присваивание - ошибка компиляции, не времени выполнения.
// "перечисление" - именованный набор целочисленных значений (без явного
// "= число" значение автоматическое: 0, потом +1 к предыдущему).
перечисление Приоритет
{
    Низкий,
    Средний = 5,
    Высокий
}

// Само перечисление можно использовать и как имя ТИПА (поле сущности,
// параметр/тип результата функции, аннотация переменной) - не только как
// источник Целое-констант через "Приоритет.Член": хранится оно по-прежнему
// как Целое, поэтому сравнение/арифметика с обычным Целое работают без
// приведения.
сущность Поручение
{
    имеет:
        Приоритет приоритет

    конструктор(приоритет: Приоритет)
    {
        этот.приоритет = приоритет
    }

    срочное(): Логическое
    {
        вернуть этот.приоритет == Приоритет.Высокий
    }
}

функция описать_приоритет(приоритет: Приоритет): Строка
{
    если приоритет == Приоритет.Высокий {
        вернуть "высокий"
    }
    вернуть "обычный"
}

/** Локальные константы, перечисление "Приоритет" и встроенные перечисления. */
функция главная
{
    константа порог = 5

    вывести `${Приоритет.Низкий}\n`
    вывести `${Приоритет.Средний}\n`
    вывести `${Приоритет.Высокий}\n`

    если Приоритет.Высокий >= порог {
        вывести `высокий приоритет достаточен\n`
    }

    переменная поручение = новое Поручение(Приоритет.Высокий)
    вывести `${поручение.срочное()}\n`
    вывести `${описать_приоритет(поручение.приоритет)}\n`

    // Стандартные перечисления - доступны без объявления, тем же
    // принципом, что и "Файл"/"Сокет": HTTPКод (для сравнения с
    // "запрос(...).код"), ДеньНедели, Месяц.
    вывести `${HTTPКод.ОК}\n`
    вывести `${HTTPКод.НеНайдено}\n`
    вывести `${ДеньНедели.Пятница}\n`
    вывести `${Месяц.Март}\n`
}
