// Константы и перечисления (шаг 12). "константа" - как "переменная", но
// повторное присваивание - ошибка компиляции, не времени выполнения.
// "перечисление" - именованный набор целочисленных значений (без явного
// "= число" значение автоматическое: 0, потом +1 к предыдущему).
перечисление Приоритет
{
    Низкий,
    Средний = 5,
    Высокий
}

/** Локальные константы, перечисление "Приоритет" и встроенные перечисления. */
функция главная
{
    константа порог = 5

    вывести Приоритет.Низкий
    вывести Приоритет.Средний
    вывести Приоритет.Высокий

    если Приоритет.Высокий >= порог
    {
        вывести "высокий приоритет достаточен"
    }

    // Стандартные перечисления - доступны без объявления, тем же
    // принципом, что и "Файл"/"Сокет": HTTPКод (для сравнения с
    // "запрос(...).код"), ДеньНедели, Месяц.
    вывести HTTPКод.ОК
    вывести HTTPКод.НеНайдено
    вывести ДеньНедели.Пятница
    вывести Месяц.Март
}
