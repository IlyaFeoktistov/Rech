/** "если"/"иначе если"/"иначе", "пока", "для от до" и "вернуть" без значения. */
функция главная
{
    переменная а = 7

    если а > 5 {
        вывести `больше пяти\n`
    } иначе {
        вывести `не больше пяти\n`
    }

    если а < 0 {
        вывести `отрицательное\n`
    } иначе если а == 0 {
        вывести `ноль\n`
    } иначе если а < 10 {
        вывести `однозначное положительное\n`
    } иначе {
        вывести `большое положительное\n`
    }

    переменная сумма = 0
    переменная i     = 1
    пока i <= 5 {
        сумма = сумма + i
        i = i + 1
    }
    вывести `${сумма}\n`

    переменная произведение = 1
    для n от 1 до 5 {
        произведение = произведение * n
    }
    вывести `${произведение}\n`

    если произведение == 120 {
        вывести `${истина}\n`
    } иначе {
        вернуть
    }
}
