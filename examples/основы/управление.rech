/** "если"/"иначе", "пока", "для от до" и "вернуть" без значения. */
функция главная
{
    переменная а = 7

    если а > 5 {
        вывести "больше пяти"
    } иначе {
        вывести "не больше пяти"
    }

    переменная сумма = 0
    переменная i     = 1
    пока i <= 5 {
        сумма = сумма + i
        i = i + 1
    }
    вывести сумма

    переменная произведение = 1
    для n от 1 до 5 {
        произведение = произведение * n
    }
    вывести произведение

    если произведение == 120 {
        вывести истина
    } иначе {
        вернуть
    }
}
