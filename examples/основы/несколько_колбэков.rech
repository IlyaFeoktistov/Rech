// Несколько ОДНОВРЕМЕННО живых замыканий ОДНОЙ сигнатуры "Вызываемый(...)"
// (docs/SPEC.md, раздел 12) - раньше был всего один активный слот на
// сигнатуру: вторая регистрация ТИХО заменяла первую, и оба обработчика
// atexit ниже стали бы вызывать один и тот же (последний) счётчик. Теперь
// каждая регистрация занимает СВОЙ слот пула - libc реально хранит ДВА
// РАЗНЫХ адреса функций и зовёт каждый со своим окружением замыкания. Тот
// же принцип нужен для WNDCLASS-паттерна (несколько оконных классов со
// своим WNDPROC каждый, examples/основы/внешняя_структура_колбэк.rech) -
// atexit здесь просто самый простой способ показать это без сторонней
// C-библиотеки.
внешняя функция atexit(обработчик: Вызываемый())

/**
 * atexit зовёт обработчики В ОБРАТНОМ порядке регистрации (LIFO,
 * стандартное поведение реальной libc) - ожидаемый вывод: "второй: 2",
 * затем "первый: 1", а не дважды одно и то же значение.
 */
функция главная
{
    переменная первый_счётчик = 1
    atexit(функция () {
        вывести "первый:"
        вывести первый_счётчик
    })

    переменная второй_счётчик = 2
    atexit(функция () {
        вывести "второй:"
        вывести второй_счётчик
    })

    вывести "тело главная завершилось"
}
