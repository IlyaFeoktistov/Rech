/**
 * Десятичное - точная десятичная дробь для денег и учёта (как decimal в
 * C#): до 28 знаков после запятой, 0.1 + 0.2 ровно 0.3. Масштаб
 * сохраняется (129.90 печатается как 129.90). Где цифр не хватает -
 * банковское округление: половина к чётному (2.5 -> 2, 3.5 -> 4).
 * С целыми смешивается свободно, с Дробное/Действительное - только явным
 * приведением. См. docs/SPEC.md, раздел 5.
 */
структура Позиция
{
    имеет:
        Строка     товар
        Десятичное цена
        Целое      количество
}

функция итог(позиции: Список<Позиция>): Десятичное
{
    Десятичное сумма = 0
    для позиция в позициях {
        сумма += позиция.цена * позиция.количество
    }
    вернуть сумма
}

функция главная
{
    Десятичное а = 0.1
    Десятичное б = 0.2
    вывести `${а + б} ${а + б == 0.3}\n`

    Список<Позиция> чек   = [новая Позиция("чай", 129.90, 2), новая Позиция("сахар", 0.35, 10)]
    Десятичное      сумма = итог(чек)
    вывести `${сумма}\n`

    // НДС 20% из суммы с НДС, до копеек.
    Десятичное ндс = (сумма * 20 / 120).округлить(2)
    вывести `${ндс}\n`

    // Деление - до 28 знаков; банковское округление.
    вывести `${(Десятичное) 1 / 3}\n`
    Десятичное половина = 2.5
    вывести `${половина.округлить()} ${(половина + 1).округлить()}\n`

    // Приведения: из строки - точно, в Действительное - ближайшее double.
    Десятичное курс = (Десятичное) "92.5050"
    вывести `${курс} ${(Целое) курс} ${(Действительное) курс}\n`
}
