/**
 * Асимметричная криптография (цифровая подпись) - RSA/Ed25519 через
 * "сгенерировать_приватный_ключ(алгоритм)", "алгоритм" - член встроенного
 * перечисления "АлгоритмПодписи". Нет отдельной сущности "пара ключей" -
 * "получить_публичный_ключ" выводит публичный ключ из приватного, тем же
 * рабочим процессом, что у "openssl pkey -pubout".
 *
 * Ключи/подписи - PEM-текст/HEX, совместимые с настоящим openssl
 * ("openssl pkey"/"openssl dgst -sign"/"openssl pkeyutl" и т. п.), не
 * только с самим Rech - можно сгенерировать ключ здесь и подписать им
 * файл через настоящий openssl, или наоборот.
 */
функция главная
{
    // RSA - 2048 бит (не параметр - единственный размер, тем же принципом
    // минимализма, что и у AES-256-GCM в examples/основы/крипто.rech).
    // Подписывается через SHA-256 (PKCS#1 v1.5).
    переменная приватный_ключ_rsa = сгенерировать_приватный_ключ(АлгоритмПодписи.RSA)
    переменная публичный_ключ_rsa = получить_публичный_ключ(приватный_ключ_rsa)
    переменная подпись_rsa = подписать("платёж на 100 рублей", приватный_ключ_rsa)

    // "проверить_подпись" НЕ паникует на несовпавшей подписи - возвращает
    // "ложь", как и положено булевой проверке (можно писать
    // "если проверить_подпись(...) {" без попытаться/поймать). Паникует
    // только на структурно некорректном входе (не HEX/не PEM).
    утверждать проверить_подпись("платёж на 100 рублей", подпись_rsa, публичный_ключ_rsa)
    утверждать не проверить_подпись("платёж на 100000 рублей", подпись_rsa, публичный_ключ_rsa)

    // Ed25519 - современный стандарт (умолчание в OpenSSH с 2014), проще
    // в использовании (нет выбора размера ключа/padding-схемы) и быстрее
    // RSA. Хеширует сообщение сам, как часть алгоритма (PureEdDSA) - в
    // отличие от RSA выше, отдельного шага с SHA-256 здесь нет.
    переменная приватный_ключ_ed = сгенерировать_приватный_ключ(АлгоритмПодписи.Ed25519)
    переменная публичный_ключ_ed = получить_публичный_ключ(приватный_ключ_ed)
    переменная подпись_ed = подписать("платёж на 100 рублей", приватный_ключ_ed)

    утверждать проверить_подпись("платёж на 100 рублей", подпись_ed, публичный_ключ_ed)
    утверждать не проверить_подпись("платёж на 100000 рублей", подпись_ed, публичный_ключ_ed)

    вывести "оба алгоритма: подпись верна, подделка отклонена"
}
