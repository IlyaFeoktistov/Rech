// Вариативный параметр "...имя: Тип" (docs/SPEC.md, раздел 4, "Параметры
// и тип результата") принимает любое число аргументов, в теле это
// Список<Тип>. "...список" раскрывает готовый список на месте аргументов
// вызова или элементов литерала списка.

/** Сумма любого числа слагаемых. */
публичная функция сумма(...числа: Целое): Целое
{
    переменная итог = 0
    для число в числах {
        итог += число
    }

    вернуть итог
}

/** Склеивает части через разделитель. */
публичная функция склеить(разделитель: Строка, ...части: Строка): Строка
{
    переменная итог = ""
    для часть в частях {
        если итог != "" {
            итог += разделитель
        }
        итог += часть
    }

    вернуть итог
}

/** Наибольший из переданных - тип выводится из аргументов. */
публичная функция наибольший<Т>(первый: Т, ...кандидаты: Т): Т
{
    переменная лучший = первый
    для кандидат в кандидатах {
        если кандидат > лучший {
            лучший = кандидат
        }
    }

    вернуть лучший
}

/** Журнал сообщений. */
публичная сущность Журнал
{
    имеет:
        приватный Список<Строка> записи

    конструктор()
    {
        этот.записи = []
    }

    /** Добавляет сразу несколько записей. */
    публичный записать(...строки: Строка)
    {
        для строка в строках {
            этот.записи.добавить(строка)
        }
    }

    /** Все записи через перевод строки. */
    публичный текст(): Строка
    {
        вернуть склеить(`\n`, ...этот.записи)
    }
}

публичная функция главная
{
    вывести `${сумма()}\n`
    вывести `${сумма(1, 2, 3)}\n`

    Список<Целое> добавка = [10, 20]
    вывести `${сумма(1, ...добавка, 5)}\n`

    переменная все = [0, ...добавка, 30]
    вывести `${все.длина()}\n`

    вывести `${склеить(", ", "яблоко", "груша", "слива")}\n`
    вывести `${наибольший(3, 9, 4)} ${наибольший(2.5, 1.5)}\n`

    переменная журнал = новый Журнал()
    журнал.записать("старт", "работа")
    журнал.записать("стоп")
    вывести `${журнал.текст()}\n`
}
