// "++"/"--" у простого имени переменной - полноценные выражения со
// значением (как в C), не только самостоятельные инструкции: постфикс
// возвращает старое значение и потом увеличивает/уменьшает переменную,
// префикс - сначала меняет, потом возвращает новое. Применимы только к
// уже объявленной переменной типа Целое/Действительное.
//
// "++"/"--" у ПОЛЯ ("этот.поле++"/"перем.поле--") - тоже поддержаны, но
// ТОЛЬКО как самостоятельная инструкция (сахар над "поле = поле + 1"/
// "- 1" - значение не возвращается, "x = перем.поле++" не годится).

сущность Счётчик
{
    имеет:
        значение: Целое = 0
}

/**
 * "++"/"--" как выражения (постфикс/префикс) и как самостоятельные
 * инструкции, для Целое и Действительное - и как самостоятельная
 * инструкция для поля сущности.
 */
функция главная
{
    переменная а = 5

    вывести `${а++   // печатает 5 (старое значение), а становится 6}\n`
    вывести `${а     // 6}\n`

    вывести `${++а   // сначала становится 7, печатает 7 (новое значение)}\n`
    вывести `${а     // 7}\n`

    // Как самостоятельная инструкция (значение не нужно) - обе формы
    // делают одно и то же, разница появляется только когда значение
    // используется.
    а++
    вывести `${а     // 8}\n`
    --а
    вывести `${а     // 7}\n`

    переменная б = 1.5
    вывести `${б++}\n`
    вывести `${б}\n`

    // Поле - только как самостоятельная инструкция.
    переменная сч = новый Счётчик()
    сч.значение++
    сч.значение++
    вывести `${сч.значение   // 2}\n`
    сч.значение--
    вывести `${сч.значение   // 1}\n`
}
