// "++"/"--" - полноценные выражения со значением (как в C), не только
// самостоятельные инструкции: постфикс возвращает старое значение и потом
// увеличивает/уменьшает переменную, префикс - сначала меняет, потом
// возвращает новое. Применимы только к уже объявленной переменной типа
// Целое/Действительное (не к полю сущности, не к результату вызова).

/** "++"/"--" как выражения (постфикс/префикс) и как самостоятельные
    инструкции, для Целое и Действительное. */
функция главная
{
    переменная а = 5

    вывести а++   // печатает 5 (старое значение), а становится 6
    вывести а     // 6

    вывести ++а   // сначала становится 7, печатает 7 (новое значение)
    вывести а     // 7

    // Как самостоятельная инструкция (значение не нужно) - обе формы
    // делают одно и то же, разница появляется только когда значение
    // используется.
    а++
    вывести а     // 8
    --а
    вывести а     // 7

    переменная б = 1.5
    вывести б++
    вывести б
}
