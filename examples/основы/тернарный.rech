/**
 * Тернарный условный оператор `условие ? тогда : иначе` - выражение (не
 * инструкция, как "если") со значением: условие обязано быть Логическое,
 * "тогда"/"иначе" - строго одного типа (без неявного расширения, та же
 * строгость, что и у элементов литерала списка). В рантайме вычисляется
 * ТОЛЬКО одна из двух ветвей (короткое замыкание, как у "и"/"или") - не
 * обе.
 */
функция главная
{
    переменная возраст   = 20
    переменная категория = возраст >= 18 ? "взрослый" : "ребёнок"
    вывести `${категория}\n`

    // Правоассоциативен - цепочка `? :` уходит вправо, как в C:
    // `а ? б : в ? г : д` разбирается как `а ? б : (в ? г : д)`.
    переменная число = 0
    переменная знак  = число < 0 ? "отрицательное" : число == 0 ? "ноль" : "положительное"
    вывести `${знак}\n`

    // Перенос строки после бинарного оператора/после "?"/после ":" -
    // незначим, длинную цепочку можно разбить на несколько строк.
    переменная итог = число < 0 ?
    "отрицательное" :
    число == 0 ?
    "ноль" :
    "положительное"
    вывести `${итог}\n`

    // "условие ?: иначе" (Elvis-форма из PHP/Kotlin, без повтора условия
    // в середине) - условие обязано быть Логическое, поэтому "тогда" в
    // true-случае - буквально "истина" (эквивалентно "условие или иначе").
    переменная можно = 5 > 3 ?: ложь
    вывести `${можно}\n`
}
