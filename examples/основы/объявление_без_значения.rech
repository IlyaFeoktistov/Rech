// Объявление переменной без значения - "<Тип> <имя>": значение
// присваивается позже. Читать переменную можно только там, где
// присваивание есть на каждом пути до этого места, - иначе ошибка
// компиляции. Структуру без значения можно заполнить по полям: поле
// читается после записи, вся структура - когда заданы все поля без
// значения по умолчанию.

/** Точка на плоскости с подписью. */
структура Точка
{
    имеет:
        Целое  x
        Целое  y
        Строка подпись = "точка"
}

функция описать(х: Целое): Строка
{
    Строка описание
    если х > 0 {
        описание = "положительное"
    } иначе {
        описание = "не положительное"
    }
    вернуть описание
}

функция главная
{
    Целое сумма
    сумма = 2 + 3
    вывести `${сумма} - ${описать(сумма)}\n`
    вывести `${описать(-1)}\n`

    Точка т
    т.x = 3
    т.y = 4
    вывести `${т.подпись} ${расстояние_в_квадрате(т)}\n`
}

/** Квадрат расстояния от начала координат. */
функция расстояние_в_квадрате(т: Точка): Целое
{
    вернуть т.x * т.x + т.y * т.y
}
