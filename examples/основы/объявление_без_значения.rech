/**
 * Объявление переменной без значения - "<Тип> <имя>" или "переменная
 * <имя>: <Тип>": значение присваивается позже. Читать переменную можно
 * только там, где присваивание есть на каждом пути до этого места, -
 * иначе ошибка компиляции.
 */
функция описать(х: Целое): Строка
{
    Строка описание
    если х > 0 {
        описание = "положительное"
    } иначе {
        описание = "не положительное"
    }
    вернуть описание
}

функция главная
{
    Целое сумма
    сумма = 2 + 3
    вывести `${сумма} - ${описать(сумма)}\n`
    вывести `${описать(-1)}\n`
}
