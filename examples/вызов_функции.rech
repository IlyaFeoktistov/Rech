функция сложить(кого: Целое, кому: Целое): Целое
{
    вернуть кого + кому
}

функция площадь_прямоугольника(кого: Число, кому: Число): Число
{
    вернуть кого * кому
}

функция поприветствовать
{
    вывести "привет из вызванной функции"
}

функция главная
{
    переменная сумма = сложить(2, 3)
    вывести сумма

    вывести площадь_прямоугольника(2.5, 4.0)

    поприветствовать()
}
