/**
 * Приведение указателя - "(Указатель<T>) x" или "(*T) x". Так C-буфер без
 * типа ("void *", здесь - *Байт от malloc) становится массивом нужного
 * типа, а адрес - числом и обратно (intptr_t в C). Приводятся друг к другу
 * указатели, Целое/Натуральное и внешняя сущность. См. docs/SPEC.md,
 * "Указатели".
 */
внешняя функция malloc(размер: Целое): *Байт
внешняя функция free(память: *Байт)
внешняя функция memset(память: *Байт, значение: Целое32, размер: Целое): *Байт

функция главная
{
    *Байт сырая = malloc(16)
    memset(сырая, 0, 16)

    *Целое32 числа = (*Целое32) сырая
    числа[1] = 42
    вывести `${числа[0]} ${числа[1]}\n`

    // Адрес числом: соседние Целое32 - через 4 байта.
    Целое начало = (Целое) числа
    Целое второй = (Целое) &числа[1]
    вывести `${второй - начало}\n`

    *Целое32 снова = (Указатель<Целое32>) второй
    вывести `${снова[0]}\n`

    free(сырая)
}
