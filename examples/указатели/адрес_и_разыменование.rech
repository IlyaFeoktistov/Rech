/** Указатель<T> - адрес значения T (переменной/параметра, поля сущности,
элемента списка). "&получатель" берёт адрес, "*значение" разыменовывает
(читает или, слева от "=", пишет). Многоуровневые указатели ("**x") -
обычная вложенность, без отдельного синтаксиса. "*Тип" в объявлении типа -
синтаксический сахар над "Указатель<Тип>" (как в C/C++/Go/Rust). См.
docs/SPEC.md, "Указатели". */
сущность Точка
{
    имеет:
        x: Целое

    конструктор(x: Целое)
    {
        этот.x = x
    }
}

/** out-параметр - типичный мотив (как sqlite3_open в C): функция пишет
результат через переданный ей адрес, а не через "вернуть". "*Целое" здесь -
то же самое, что "Указатель<Целое>". */
функция изменить(п: *Целое)
{
    *п = 99
}

функция главная
{
    переменная а = 5
    переменная указ = &а
    вывести *указ
    // Сам адрес ("вывести &а", без разыменования) - настоящий C-указатель
    // ("%p") при компиляции, но неотличимый от прочих указателей плейсхолдер
    // "[указатель]" в интерпретаторе (он не хранит настоящий адрес памяти -
    // см. package doc internal/interp/pointer.go) - расхождение того же
    // рода, что и у указателя на элемент списка, переживший realloc
    // (см. там же), не баг.
    вывести &а
    изменить(&а)
    вывести а

    переменная т = новая Точка(1)
    переменная указНаПоле = &т.x
    вывести *указНаПоле
    *указНаПоле = 42
    вывести т.x

    переменная сп = новый Список<Целое>()
    сп.добавить(10)
    сп.добавить(20)
    переменная указНаЭлемент = &сп[1]
    вывести *указНаЭлемент
    *указНаЭлемент = 77
    вывести сп.получить(1)

    переменная пп = &указ
    вывести **пп
    **пп = 123
    вывести а
}
