/**
 * Указатель<T> - адрес значения T (переменной/параметра, поля сущности,
 * элемента списка). "&получатель" берёт адрес, "*значение" разыменовывает
 * (читает или, слева от "=", пишет). Многоуровневые указатели ("**x") -
 * обычная вложенность, без отдельного синтаксиса. "*Тип" в объявлении типа -
 * синтаксический сахар над "Указатель<Тип>" (как в C/C++/Go/Rust). См.
 * docs/SPEC.md, "Указатели".
 */
сущность Точка
{
    имеет:
        x: Целое

    конструктор(x: Целое)
    {
        этот.x = x
    }
}

/**
 * out-параметр - типичный мотив (как sqlite3_open в C): функция пишет
 * результат через переданный ей адрес, а не через "вернуть". "*Целое" здесь -
 * то же самое, что "Указатель<Целое>".
 */
функция изменить(п: *Целое)
{
    *п = 99
}

функция главная
{
    Целое а     = 5
    *Целое указ = &а
    вывести `${*указ}\n`
    // Сам адрес ("вывести &а", без разыменования) - настоящий C-указатель
    // ("%p") при компиляции, но неотличимый от прочих указателей плейсхолдер
    // "[указатель]" в интерпретаторе (он не хранит настоящий адрес памяти -
    // см. package doc internal/interp/pointer.go) - расхождение того же
    // рода, что и у указателя на элемент списка, переживший realloc
    // (см. там же), не баг.
    вывести `${&а}\n`
    изменить(&а)
    вывести `${а}\n`

    Точка т           = новая Точка(1)
    *Целое указНаПоле = &т.x
    вывести `${*указНаПоле}\n`
    *указНаПоле = 42
    вывести `${т.x}\n`

    Список<Целое> сп = новый Список<Целое>()
    сп.добавить(10)
    сп.добавить(20)
    *Целое указНаЭлемент = &сп[1]
    вывести `${*указНаЭлемент}\n`
    *указНаЭлемент = 77
    вывести `${сп.получить(1)}\n`
    // "добавить" может перевыделить буфер списка - после него старый адрес
    // элемента использовать нельзя (ошибка компиляции), только взять заново.
    // Вернуть такой адрес из функции или сохранить в поле/коллекции -
    // тоже ошибка компиляции.
    сп.добавить(30)
    указНаЭлемент = &сп[1]
    вывести `${*указНаЭлемент}\n`

    **Целое пп = &указ
    вывести `${**пп}\n`
    **пп = 123
    вывести `${а}\n`

    // "Ничто" как значение "Указатель<T>" - независимо от "?Тип" (раздел 8):
    // нулевой адрес, без has/value-обёртки, нужен в первую очередь для FFI
    // (многие C-функции ожидают буквальный NULL там, где значение
    // необязательно).
    Указатель<Целое> пусто = Ничто
    вывести `${пусто == Ничто}\n`
    пусто = &а
    вывести `${пусто != Ничто}\n`
}
