/** Указатель<T> - адрес значения T (переменной/параметра, поля сущности,
элемента списка). "&получатель" берёт адрес, "*значение" разыменовывает
(читает или, слева от "=", пишет). Многоуровневые указатели ("**x") -
обычная вложенность, без отдельного синтаксиса. См. docs/SPEC.md,
"Указатели". */
сущность Точка
{
    имеет:
        x: Целое
}

/** out-параметр - типичный мотив (как sqlite3_open в C): функция пишет
результат через переданный ей адрес, а не через "вернуть". */
функция изменить(п: Указатель<Целое>)
{
    *п = 99
}

функция главная
{
    переменная а = 5
    переменная указ = &а
    вывести *указ
    изменить(&а)
    вывести а

    переменная т = новая Точка(1)
    переменная указНаПоле = &т.x
    вывести *указНаПоле
    *указНаПоле = 42
    вывести т.x

    переменная сп = новый Список<Целое>()
    сп.добавить(10)
    сп.добавить(20)
    переменная указНаЭлемент = &сп[1]
    вывести *указНаЭлемент
    *указНаЭлемент = 77
    вывести сп.получить(1)

    переменная пп = &указ
    вывести **пп
    **пп = 123
    вывести а
}
