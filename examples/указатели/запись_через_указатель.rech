/**
 * Запись через указатель - те же формы, что в C: "*п = x", "*п += x",
 * "(*п)++"/"++(*п)" (и "++*п"), "(*п).поле = x", "(*п)[i] = x".
 * "*п--" - как в C, сдвиг самого указателя, а не значения: для значения
 * пишется "(*п)--". См. docs/SPEC.md, раздел 22.
 */
внешняя структура Точка
{
    имеет:
        Целое32 x
        Целое32 y
}

внешняя функция calloc(количество: Целое, размер: Целое): *Точка
внешняя функция free(память: *Точка)

функция главная
{
    Целое  счётчик = 1
    *Целое у       = &счётчик
    (*у)++
    *у += 10
    (*у) *= 2
    ++(*у)
    --*у
    вывести `${счётчик}\n`

    Целое[3]            м  = [1, 2, 3]
    Указатель<Целое[3]> пм = &м
    (*пм)[1] = 20
    вывести `${м[0]} ${м[1]} ${м[2]}\n`

    // Память от C: поле пишется прямо по адресу.
    *Точка точки = calloc(2, 8)
    (*точки).x = 3
    точки[1].y = 7
    вывести `${точки[0].x} ${точки[1].y}\n`
    free(точки)
}
