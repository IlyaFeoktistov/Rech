/**
 * Массив фиксированной длины полем "внешняя структура" - как "char
 * имя[N]" в C (utsname, dirent, sockaddr_in): массив лежит прямо внутри
 * структуры, C пишет в него по адресу структуры. Здесь в поле пишет
 * memset, по-настоящему так заполняются, например, utsname через uname().
 * См. docs/SPEC.md, "Массивы фиксированной длины".
 */
внешняя структура Запись
{
    имеет:
        Байт[4] метка
        Целое32 число = 0
}

внешняя функция memset как заполнить(запись: *Запись, значение: Целое32, размер: Целое): *Запись

/** Текст из байтов до первого нулевого, как C-строка в "char[N]". */
функция в_строку(байты: Байт[4]): Строка
{
    Строка итог = ""
    для б в байты {
        если б == 0 {
            прервать
        }
        итог += (Строка) (Символ) б
    }
    вернуть итог
}

функция главная
{
    Запись запись = новая Запись()
    запись.число = 7
    заполнить(&запись, 65, 3)
    вывести `${в_строку(запись.метка)} ${запись.метка[3]} ${запись.число}\n`
}
