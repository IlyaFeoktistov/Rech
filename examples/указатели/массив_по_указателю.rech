/**
 * Указатель<T> как начало массива T - так C отдаёт буферы и массивы
 * ("int *", "char **"). "п[i]" читает i-й элемент, "п[i] = значение" пишет
 * его, "&п[i]" - адрес i-го элемента (сдвинутый указатель). Границы не
 * проверяются: длины у указателя нет, как и в C. См. docs/SPEC.md,
 * "Указатели".
 */
внешняя функция malloc(размер: Целое): *Целое32
внешняя функция free(память: *Целое32)
внешняя функция qsort(база: *Целое32, количество: Целое, размер: Целое, сравнить: Вызываемый(*Целое32, *Целое32): Целое32)

структура Точка
{
    имеет:
        Целое x
        Целое y
}

функция главная
{
    Целое    количество = 5
    *Целое32 числа      = malloc(количество * 4)
    для i = 0; i < количество; i++ {
        числа[i] = (Целое32) ((i * 7) % 5)
    }
    qsort(числа, количество, 4, функция (а: *Целое32, б: *Целое32): Целое32 {
        вернуть *а - *б
    })
    для i = 0; i < количество; i++ {
        вывести `${числа[i]} `
    }
    вывести `\n`

    // Сдвинутый указатель - снова начало массива, со своей нумерацией.
    *Целое32 хвост = &числа[3]
    вывести `${хвост[0]} ${хвост[1]}\n`
    free(числа)

    // Адрес элемента списка - тоже начало массива: соседние элементы
    // доступны по индексу.
    Список<Точка> точки = [новая Точка(1, 2), новая Точка(3, 4)]
    *Точка        п     = &точки[0]
    п[1].x = 30
    вывести `${п[1].x} ${точки.получить(1).x}\n`
}
