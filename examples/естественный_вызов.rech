функция поприветствовать(кого: Строка, где: Строка)
{
    вывести "Привет, " + кого + "! Добро пожаловать в " + где
}

функция главная
{
    переменная пользователь = "Илья"
    переменная система = "чат"

    // Падеж словоформы определяет параметр, а не порядок слов - и
    // "в системе" (предложный - "где"), и "пользователя" (винительный,
    // одушевлённый - "кого") можно поменять местами без изменения смысла.
    поприветствовать пользователя в системе
}
