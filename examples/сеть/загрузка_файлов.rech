// Загрузка/раздача файлов через HTTP - бинарно-безопасно.
// "Строка" в cbackend - null-terminated C-строка, обрезается на первом
// нулевом байте - непригодна для содержимого произвольного бинарного
// файла (картинки, PDF, zip). Решение - "Список<Байт>" (существующая
// generic-коллекция, её C-представление - сырой массив байт с явной
// длиной, уже бинарно-безопасна сама по себе):
//   - "принять_http_байты"/"отправить_http_ответ_байты" - те же операции,
//     что и "принять_http"/"отправить_http_ответ", но тело - "Список<
//     Байт>", не "Строка"; отдельные функции/сущности (ЗапросБайты/
//     ОтветБайты), не поле в уже существующих Запрос/Ответ - иначе КАЖДАЯ
//     Rech-программа (даже без единого сетевого вызова) была бы вынуждена
//     тянуть машинерию Список<Байт>.
//   - "прочитать_файл_байты"/"записать_в_файл_байты" - бинарно-безопасные
//     обёртки над файловым вводом-выводом (тот же "Файл", что и раньше).
//   - "разобрать_multipart" - разбирает multipart/form-data (настоящая
//     HTML-форма с "<input type=file>" кодирует загрузку именно так) на
//     части - у каждой "имя"/"имя_файла"/"тип_содержимого"/"данные".
//
// Проверить вручную:
//   curl http://127.0.0.1:8090/файлы/тест.txt                  (раздача)
//   curl -F "фото=@фото.jpg;type=image/jpeg" \
//        http://127.0.0.1:8090/загрузить                        (загрузка)

использовать Сокет, сетевой_узел, СетевойПротокол из стандарт/сеть
использовать прочитать_файл_байты, записать_в_файл_байты из стандарт/файлы
использовать ОтветБайты, Ответ, ЗапросБайты, разобрать_multipart из стандарт/http
использовать длина_строки, подстрока из стандарт/строки

/** Раздаёт файл из текущего каталога по имени из пути (после "/файлы/"). */
приватная функция раздать(соединение: Сокет, имя_файла: Строка)
{
    попытаться {
        переменная содержимое = прочитать_файл_байты(имя_файла)
        переменная ответ      = новый ОтветБайты(200, "Content-Type: application/octet-stream", содержимое)
        соединение.отправить_http_ответ_байты(ответ)
    } поймать (ошибка: ОшибкаФайла) {
        переменная ответ = новый Ответ(404, "", "файл не найден")
        соединение.отправить_http_ответ(ответ)
    }
}

/** Результат загрузки - сколько частей формы сохранено на диск как файлы. */
структура РезультатЗагрузки
{
    имеет:
        Целое сохранено
}

/** Принимает multipart/form-data, сохраняет каждую часть с "имя_файла" на диск. */
приватная функция загрузить(соединение: Сокет, запрос: ЗапросБайты)
{
    переменная части     = разобрать_multipart(запрос.тело, запрос.заголовки)
    переменная результат = новый РезультатЗагрузки(0)
    переменная i         = 0
    пока i < части.длина() {
        переменная часть = части.получить(i)
        если часть.имя_файла != "" {
            записать_в_файл_байты(часть.имя_файла, часть.данные)
            результат.сохранено = результат.сохранено + 1
        }
        i = i + 1
    }
    соединение.отправить_http_ответ(новый Ответ(200, "Content-Type: application/json", сериализовать JSON результат))
}

функция главная
{
    переменная слушатель  = сетевой_узел(СетевойПротокол.TCP, "", 8090)
    переменная соединение = слушатель.принять()
    если соединение != Ничто {
        // Заголовки метода/пути - всегда текст, читать их можно и через
        // "принять_http_байты" (запрос.метод/запрос.путь - те же Строка
        // поля, что и у обычного "Запрос") - бинарной безопасности здесь
        // не требуется, только у тела.
        переменная запрос = соединение.принять_http_байты()
        если запрос.метод == "POST" {
            загрузить(соединение, запрос)
        } иначе {
            если длина_строки(запрос.путь) > 7 && подстрока(запрос.путь, 0, 7) == "/файлы/" {
                раздать(соединение, подстрока(запрос.путь, 7, длина_строки(запрос.путь) - 7))
            } иначе {
                соединение.отправить_http_ответ(новый Ответ(404, "", "не найдено"))
            }
        }
        соединение.закрыть()
    }
    слушатель.закрыть()
}
