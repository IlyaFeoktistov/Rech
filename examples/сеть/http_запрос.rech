// HTTP-клиент типа curl (шаг 9) - "запрос" принимает сущность "Запрос" и
// возвращает "Ответ" (обе - встроенные, без объявления, как "Файл"/"Сокет").
// Заголовки - одна Строка, каждый на своей строке через "\r\n", без
// завершающего - "запрос" сам добавляет Host/Connection/Content-Length.
//
// Ответ читается до закрытия соединения сервером (не по Content-Length) -
// сервер должен закрывать соединение после ответа (обычный HTTP/1.0-
// подобный сценарий, не keep-alive); chunked transfer encoding при этом
// тоже разбирается (HTTP highload пункт 4).
//
// "https://" в начале "адреса" - TLS (HTTP highload
// пункт 5) - без схемы (как у "р" ниже) - обычный HTTP, тем же принципом,
// что и раньше.

/** Отправляет HTTP GET-запрос и печатает код ответа и тело. */
функция главная
{
    переменная р = новый Запрос("GET", "example.com", 80, "/", "", "")
    переменная о = запрос(р)
    вывести `${о.код}\n`
    вывести `${о.тело}\n`

    переменная р2 = новый Запрос("GET", "https://httpbin.org", 443, "/get", "", "")
    переменная о2 = запрос(р2)
    вывести `${о2.код}\n`

    // Именованный конструктор с умолчаниями - "метод" ("GET"), "порт" (80),
    // "путь" ("/"), "заголовки"/"тело" (пустая строка) можно не называть.
    переменная р3 = новый Запрос(адрес: "example.com")
    переменная о3 = запрос(р3)
    вывести `${о3.код}\n`
}
