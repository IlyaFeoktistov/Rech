// Сетевые примитивы - минимальный TCP-эхо-сервер: принимает одно
// соединение, отправляет полученное сообщение обратно с префиксом, закрывает
// и соединение, и сам слушающий сокет. Запускать вместе с
// examples/сеть/эхо_клиент.rech (сервер должен быть запущен первым):
//
//     rech build examples/сеть/эхо_сервер.rech
//     rech build examples/сеть/эхо_клиент.rech
//     ./эхо_сервер &
//     ./эхо_клиент
//
// "принять" возвращает "?Сокет" (Ничто - истёк таймаут слушателя, здесь не
// установлен, значит вызов просто блокируется до подключения клиента) -
// разворачивается явным кастом "(Сокет) значение" (паника на "Ничто", тот же
// принцип, что и у "(Целое) значение" для "?Целое" - см. docs/SPEC.md,
// "Явные касты"), а не идиомой "если ... != Ничто {...}": здесь ожидается
// РОВНО одно соединение, дальнейшего кода без него всё равно нет.

использовать сетевой_узел, СетевойПротокол из стандарт/сеть

/** Принимает одно TCP-соединение, отправляет сообщение обратно с префиксом. */
функция главная
{
    переменная слушатель  = сетевой_узел(СетевойПротокол.TCP, "", 18080)
    переменная соединение = (Сокет) слушатель.принять()
    переменная сообщение  = соединение.получить(1024)
    соединение.отправить("эхо: " + сообщение)
    соединение.закрыть()
    слушатель.закрыть()
}
