// Сетевые примитивы (шаг 8) - минимальный TCP-эхо-сервер: принимает одно
// соединение, отправляет полученное сообщение обратно с префиксом, закрывает
// и соединение, и сам слушающий сокет. Запускать вместе с
// examples/сеть/эхо_клиент.rech (сервер должен быть запущен первым):
//
//     rech build examples/сеть/эхо_сервер.rech
//     rech build examples/сеть/эхо_клиент.rech
//     ./эхо_сервер &
//     ./эхо_клиент
функция главная
{
    переменная слушатель = слушать_tcp(18080)
    переменная соединение = принять(слушатель)
    переменная сообщение = получить(соединение, 1024)
    отправить(соединение, "эхо: " + сообщение)
    закрыть_сокет(соединение)
    закрыть_сокет(слушатель)
}
