// Клиент к examples/сеть/эхо_сервер.rech - подключается по TCP, отправляет
// сообщение, печатает ответ, закрывает сокет.

/** Подключается по TCP к эхо-серверу, отправляет сообщение и печатает ответ. */
функция главная
{
    переменная сокет = сетевой_узел(СетевойПротокол.TCP, "127.0.0.1", 18080)
    сокет.отправить("привет")
    вывести `${сокет.получить(1024)}\n`
    сокет.закрыть()
}
