/**
 * gRPC поверх HTTP/2 (http2_эхо.rech) + PROTOBUF (json/protobuf.rech) -
 * сервер и клиент в одном процессе, unary ("Поздороваться") и server-
 * streaming ("Считать") - ОДНИ И ТЕ ЖЕ grpc_прочитать_сообщение/grpc_
 * отправить_сообщение для обоих: unary читает/пишет РОВНО ОДИН раз, streaming
 * - в цикле, разницы на уровне транспорта нет. Само gRPC-сообщение -
 * Список<Байт> - что внутри (protobuf, как здесь, JSON или что угодно ещё)
 * решает вызывающая программа, grpc_* об этом не знает. "Поздороваться"
 * дополнительно демонстрирует "сжато: истина" третьим (необязательным)
 * параметром grpc_отправить_сообщение - gzip-сжатый ответ, распаковка на
 * стороне клиента ("вывести ответ1.сообщение" ниже) полностью прозрачна:
 * grpc_прочитать_сообщение сам распознаёт флаг сжатия во входящем кадре.
 */
структура ЗапросПривета
{
    имеет:
        имя: Строка `protobuf:1`
}

структура ОтветПривета
{
    имеет:
        сообщение: Строка `protobuf:1`
}

структура ЗапросСчёта
{
    имеет:
        предел: Целое `protobuf:1`
}

структура ЗначениеСчёта
{
    имеет:
        значение: Целое `protobuf:1`
}

функция поздороваться(поток: HTTP2Поток)
{
    переменная тело = поток.grpc_прочитать_сообщение()
    если тело != Ничто {
        переменная запрос = разобрать PROTOBUF тело как ЗапросПривета

        поток.grpc_начать_ответ()
        переменная ответ = новый ОтветПривета("привет, " + запрос.имя)
        поток.grpc_отправить_сообщение(сериализовать PROTOBUF ответ, истина)
        поток.grpc_завершить(0, "")
    } иначе {
        поток.grpc_завершить(3, "пустое тело запроса")
    }
}

функция считать(поток: HTTP2Поток)
{
    переменная тело = поток.grpc_прочитать_сообщение()
    если тело != Ничто {
        переменная запрос = разобрать PROTOBUF тело как ЗапросСчёта

        поток.grpc_начать_ответ()
        переменная i: Целое = 1
        пока i <= запрос.предел {
            переменная значение = новое ЗначениеСчёта(i)
            поток.grpc_отправить_сообщение(сериализовать PROTOBUF значение)
            i = i + 1
        }
        поток.grpc_завершить(0, "")
    } иначе {
        поток.grpc_завершить(3, "пустое тело запроса")
    }
}

функция сервер(слушающий: Сокет)
{
    переменная сессия = слушающий.принять_http2_сессию()

    переменная первый = сессия.принять_поток()
    если первый.путь() == "/привет.Приветствие/Поздороваться" {
        поздороваться(первый)
    }

    переменная второй = сессия.принять_поток()
    если второй.путь() == "/привет.Приветствие/Считать" {
        считать(второй)
    }
}

функция главная
{
    переменная слушающий = сетевой_узел(СетевойПротокол.TCP, "", 18400)
    переменная задача    = запустить сервер(слушающий)

    переменная клиент = новая_http2_сессия("127.0.0.1", 18400)

    // unary: один запрос - один ответ.
    переменная поток1  = клиент.grpc_открыть_поток("/привет.Приветствие/Поздороваться")
    переменная запрос1 = новый ЗапросПривета("Аня")
    поток1.grpc_отправить_сообщение(сериализовать PROTOBUF запрос1)
    поток1.завершить()

    переменная тело1 = поток1.grpc_прочитать_сообщение()
    если тело1 != Ничто {
        переменная ответ1 = разобрать PROTOBUF тело1 как ОтветПривета
        вывести `${ответ1.сообщение}\n`
    }
    // grpc_статус читает трейлер - тот виден надёжно только ПОСЛЕ того,
    // как поток дочитан до конца (см. doc grpc_статус) - для unary это
    // ровно второе чтение, до Ничто, даже когда ответ был всего один.
    поток1.grpc_прочитать_сообщение()
    вывести `${"статус: " + (Строка) поток1.grpc_статус()}\n`

    // server-streaming: один запрос - несколько ответов подряд, читаем в
    // цикле до Ничто (конец потока).
    переменная поток2  = клиент.grpc_открыть_поток("/привет.Приветствие/Считать")
    переменная запрос2 = новый ЗапросСчёта(3)
    поток2.grpc_отправить_сообщение(сериализовать PROTOBUF запрос2)
    поток2.завершить()

    переменная сообщение = поток2.grpc_прочитать_сообщение()
    пока сообщение != Ничто {
        переменная значение = разобрать PROTOBUF сообщение как ЗначениеСчёта
        вывести `${значение.значение}\n`
        сообщение = поток2.grpc_прочитать_сообщение()
    }
    вывести `${"статус: " + (Строка) поток2.grpc_статус()}\n`

    дождаться задача
    клиент.закрыть()
}
