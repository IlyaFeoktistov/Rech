// Cookies поверх "заголовки" (одна Строка, как и у самого HTTP) - две
// чистые функции, без отдельного типа с методами. "значение_куки" читает
// заголовок "Cookie" входящего запроса, "строка_куки" строит одну строку
// "Set-Cookie: ..." (без завершающего "\r\n" - её нужно самостоятельно
// добавить в "ответ.заголовки" при нескольких заголовках сразу).

/** Демонстрирует чтение и запись cookies. */
функция главная
{
    переменная запрос = новый Запрос("GET", "", 0, "/", "Cookie: сессия=abc123; тема=тёмная", "")

    вывести значение_куки(запрос, "сессия") ?? "нет сессии"
    вывести значение_куки(запрос, "тема") ?? "нет темы"
    вывести значение_куки(запрос, "неизвестная") ?? "нет такой куки"

    // "ОпцииКуки" - обычная сущность-структура с значениями по умолчанию у
    // каждого поля (пустая строка/false/Ничто - "атрибут не выставлять") -
    // именованная форма конструктора называет только нужные атрибуты.
    переменная новая_сессия = строка_куки("сессия", "новое-значение", новый ОпцииКуки(путь: "/", только_http: истина, безопасный: истина))
    вывести новая_сессия

    // Max-Age=0 - немедленное удаление cookie (типичный "выход из системы") -
    // поэтому "максимальный_возраст" - ?Целое, не голое Целое: 0 - настоящее
    // значение, отличное от "атрибут не выставлен" (Ничто, по умолчанию).
    переменная выход = строка_куки("сессия", "", новый ОпцииКуки(путь: "/", максимальный_возраст: 0))
    вывести выход

    переменная ответ = новый Ответ(200, новая_сессия, "готово")
    вывести ответ.заголовки
}
