// Полноценный UDP-сервер - "сетевой_узел("udp", "", порт)" без хоста
// (bind, без connect - в отличие от UDP-клиента, у datagram-сокета нет
// подключения вообще) даёт узел, отвечающий ЛЮБОМУ отправителю:
// "получить_от" возвращает не только данные, но и адрес отправителя
// (Дейтаграмма), "отправить_в" отвечает именно ему. Проверить вручную
// (сервер должен быть запущен первым):
//
//     rech build examples/сеть/udp_сервер.rech
//     ./udp_сервер &
//     python3 -c "
//         import socket
//         s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
//         s.sendto(b'привет', ('127.0.0.1', 18081))
//         print(s.recv(1024).decode())"

/** Принимает одну UDP-датаграмму от произвольного отправителя, отвечает ему же. */
функция главная
{
    переменная узел = сетевой_узел("udp", "", 18081)
    переменная датаграмма = получить_от(узел, 1024)
    вывести датаграмма.данные
    отправить_в(узел, "эхо: " + датаграмма.данные, датаграмма.адрес, датаграмма.порт)
    закрыть_сокет(узел)
}
