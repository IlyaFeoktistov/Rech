/**
 * Минимальный HTTP/2-сервер и клиент в одном процессе (см. docs/SPEC.md,
 * раздел про HTTP/2) - транспортный слой поверх уже существующего "Сокет":
 * клиент отправляет тело запроса, сервер отвечает и добавляет трейлер.
 * Тело - "Список<Байт>" (не "Строка") - произвольные бинарные данные, тот же
 * принцип, что и у "Список<Байт>" для файлов/HTTP-загрузок; путь/метод/
 * заголовки/трейлеры - обычные строки (сами по себе текстовые в HTTP/2).
 * Имя заголовка/трейлера (не значение) - ASCII-токен по спецификации HTTP,
 * поэтому "x-processed", не кириллица.
 */
функция сервер(слушающий: Сокет)
{
    переменная сессия = http2_принять_сессию(слушающий)
    переменная поток  = http2_принять_поток(сессия)

    вывести http2_метод(поток) + " " + http2_путь(поток)

    переменная тело = http2_прочитать_всё(поток)
    вывести "сервер получил: " + строка_из_байт(тело)

    http2_отправить_заголовки(поток, 200)
    http2_отправить_данные(поток, байты_из_строки("привет от сервера"))
    http2_отправить_трейлер(поток, "x-processed", "истина")
    http2_завершить_поток(поток)
}

функция главная
{
    переменная слушающий = сетевой_узел("tcp", "", 18080)
    переменная задача    = запустить сервер(слушающий)

    переменная клиент = новая_http2_сессия("127.0.0.1", 18080)
    переменная поток  = http2_открыть_поток(клиент, "POST", "/эхо")
    http2_отправить_данные(поток, байты_из_строки("привет от клиента"))
    http2_завершить_поток(поток)

    вывести "код ответа: " + (Строка) http2_статус(поток)
    переменная ответ = http2_прочитать_всё(поток)
    вывести "клиент получил: " + строка_из_байт(ответ)

    переменная трейлер = http2_заголовок(поток, "x-processed")
    если трейлер != Ничто {
        вывести "трейлер x-processed: " + трейлер
    }

    дождаться задача
    http2_закрыть_сессию(клиент)
}
