использовать Сокет, сетевой_узел, СетевойПротокол из стандарт/сеть
использовать строка_из_байт, байты_из_строки из стандарт/строки
использовать новая_http2_сессия из стандарт/http2

/**
 * Минимальный HTTP/2-сервер и клиент в одном процессе (см. docs/SPEC.md,
 * раздел про HTTP/2) - транспортный слой поверх уже существующего "Сокет":
 * клиент отправляет тело запроса, сервер отвечает и добавляет трейлер.
 * Тело - "Список<Байт>" (не "Строка") - произвольные бинарные данные, тот же
 * принцип, что и у "Список<Байт>" для файлов/HTTP-загрузок; путь/метод/
 * заголовки/трейлеры - обычные строки (сами по себе текстовые в HTTP/2).
 * Имя заголовка/трейлера (не значение) - ASCII-токен по спецификации HTTP,
 * поэтому "x-processed", не кириллица.
 */
функция сервер(слушающий: Сокет)
{
    переменная сессия = слушающий.принять_http2_сессию()
    переменная поток  = сессия.принять_поток()

    вывести `${поток.метод() + " " + поток.путь()}\n`

    переменная тело = поток.прочитать_всё()
    вывести `${"сервер получил: " + строка_из_байт(тело)}\n`

    поток.отправить_заголовки(200)
    поток.отправить_данные(байты_из_строки("привет от сервера"))
    поток.отправить_трейлер("x-processed", "истина")
    поток.завершить()
}

функция главная
{
    переменная слушающий = сетевой_узел(СетевойПротокол.TCP, "", 18080)
    переменная задача    = запустить сервер(слушающий)

    переменная клиент = новая_http2_сессия("127.0.0.1", 18080)
    переменная поток  = клиент.открыть_поток("POST", "/эхо")
    поток.отправить_данные(байты_из_строки("привет от клиента"))
    поток.завершить()

    вывести `${"код ответа: " + (Строка) поток.статус()}\n`
    переменная ответ = поток.прочитать_всё()
    вывести `${"клиент получил: " + строка_из_байт(ответ)}\n`

    переменная трейлер = поток.заголовок("x-processed")
    если трейлер != Ничто {
        вывести `${"трейлер x-processed: " + трейлер}\n`
    }

    дождаться задача
    клиент.закрыть()
}
