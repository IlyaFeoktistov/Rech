// Наследование и интерфейсы у generic-сущностей: шаблон наследует обычную
// сущность и реализует интерфейс, другой шаблон наследует его же
// инстанциацию, обычная сущность - инстанциацию с конкретным типом.

интерфейс Описываемый
{
    описание(): Строка
}

/** Общая часть любого хранилища - имя. */
сущность Хранилище
{
    имеет:
        публичная Строка имя

    конструктор(имя: Строка)
    {
        этот.имя = имя
    }
}

/** Коробка с одним значением произвольного типа. */
сущность Коробка<T> наследует Хранилище реализует Описываемый
{
    имеет:
        публичное T значение

    конструктор(имя: Строка, значение: T)
    {
        родитель(имя)
        этот.значение = значение
    }

    публичный описание(): Строка
    {
        вернуть `${этот.имя}: ${этот.значение}`
    }
}

/** Коробка с подписью - наследует Коробку того же типа T. */
сущность Подписанная<T> наследует Коробку<T>
{
    имеет:
        публичная Строка подпись

    конструктор(имя: Строка, значение: T, подпись: Строка)
    {
        родитель(имя, значение)
        этот.подпись = подпись
    }

    публичный описание(): Строка
    {
        вернуть `${этот.имя}: ${этот.значение} (${этот.подпись})`
    }
}

/** Коробка только для целых чисел - наследует Коробку<Целое>. */
сущность Счётчик наследует Коробку<Целое>
{
    конструктор(имя: Строка)
    {
        родитель(имя, 0)
    }

    публичный увеличить(): Пусто
    {
        этот.значение++
    }
}

/** Печатает описание любого Описываемого. */
публичная функция напечатать(что: Описываемый): Пусто
{
    вывести `${что.описание()}\n`
}

функция главная
{
    Коробка<Строка> письмо           = новая Коробка<Строка>("письмо", "привет")
    Подписанная<Действительное> цена = новая Подписанная<Действительное>("цена", 9.5, "руб.")
    Счётчик шаги                     = новый Счётчик("шаги")
    шаги.увеличить()
    шаги.увеличить()

    напечатать(письмо)
    напечатать(цена)
    напечатать(шаги)

    Хранилище общее = цена
    вывести `${общее.имя} ${цена относится к Коробка<Действительное>} ${шаги относится к Коробка<Целое>}\n`
}
