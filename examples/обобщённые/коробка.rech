/** Обёртка над одним значением произвольного типа T. */
сущность Коробка<T>
{
    имеет:
        содержимое: T

    конструктор(содержимое: T)
    {
        этот.содержимое = содержимое
    }

    /** Возвращает содержимое коробки. */
    получить(): T
    {
        вернуть этот.содержимое
    }
}

/** Пара значений разных типов A и Б. */
сущность Пара<A, Б>
{
    имеет:
        первый: A
        второй: Б

    конструктор(первый: A, второй: Б)
    {
        этот.первый = первый
        этот.второй = второй
    }
}

интерфейс Звучащий
{
    издать_звук(): Строка
}

/** Кошка - реализует "Звучащий". */
сущность Кошка реализует Звучащий
{
    /** Кошка мяукает. */
    издать_звук(): Строка
    {
        вернуть "мяу"
    }
}

/** Возвращает первый элемент списка любого типа T. */
функция первый<T>(список: Список<T>): T
{
    вернуть список.первый()
}

/** Вызывает "издать_звук" на значении, чей тип ограничен интерфейсом "Звучащий". */
функция крикнуть<T как Звучащий>(x: T): Строка
{
    вернуть x.издать_звук()
}

/**
 * Демонстрирует пользовательские generic-сущности и generic-функции.
 * Аргументы типа выводятся из аргументов вызова ("новая Коробка(5)" -
 * Коробка<Целое>); явная запись "<...>" нужна, только когда вывести не
 * из чего - например, пустой "новый Список<Строка>()".
 */
функция главная
{
    переменная коробка = новая Коробка(5)
    вывести `${коробка.получить()}\n`

    переменная пара = новая Пара(1, "текст")
    вывести `${пара.первый}\n`
    вывести `${пара.второй}\n`

    переменная список = новый Список<Строка>()
    список.добавить("привет")
    переменная первыйЭлемент = первый(список)
    вывести `${первыйЭлемент}\n`

    переменная кот  = новая Кошка()
    переменная звук = крикнуть(кот)
    вывести `${звук}\n`

    // Явная запись тоже работает - то же самое, что и выше.
    переменная явно = первый<Строка>(список)
    вывести `${явно}\n`
}
