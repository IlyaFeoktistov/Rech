сущность Коробка<T>
{
    имеет:
        содержимое: T

    получить(): T
    {
        вернуть этот.содержимое
    }
}

сущность Пара<A, Б>
{
    имеет:
        первый: A
        второй: Б
}

интерфейс Звучащий
{
    издать_звук(): Строка
}

сущность Кошка реализует Звучащий
{
    издать_звук(): Строка
    {
        вернуть "мяу"
    }
}

функция первый<T>(список: Список<T>): T
{
    вернуть список.получить(0)
}

функция крикнуть<T как Звучащий>(x: T): Строка
{
    вернуть x.издать_звук()
}

функция главная
{
    переменная коробка = новая Коробка<Целое>(5)
    вывести коробка.получить()

    переменная пара = новая Пара<Целое, Строка>(1, "текст")
    вывести пара.первый
    вывести пара.второй

    переменная список = новый Список<Строка>()
    список.добавить("привет")
    вывести первый<Строка>(список)

    переменная кот = новая Кошка()
    вывести крикнуть<Кошка>(кот)
}
