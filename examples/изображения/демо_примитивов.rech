/**
 * Демонстрация примитивов рисования (examples/изображения/примитивы.rech)
 * поверх "Изображение" (examples/изображения/растровое_изображение.rech) -
 * рисует диагональ, контур и закрашенный прямоугольник, сохраняет
 * результат как BMP.
 */
использовать Изображение, Пиксель, сохранить_bmp из "растровое_изображение"
использовать нарисовать_линию, нарисовать_прямоугольник, закрасить_прямоугольник из "примитивы"

функция главная
{
    переменная изображение = новое Изображение(20, 20)
    изображение.залить(новый Пиксель((Байт) 255, (Байт) 255, (Байт) 255))

    нарисовать_линию(изображение, 0, 0, 19, 19, новый Пиксель((Байт) 0, (Байт) 0, (Байт) 0))
    нарисовать_прямоугольник(изображение, 2, 2, 6, 6, новый Пиксель((Байт) 255, (Байт) 0, (Байт) 0))
    закрасить_прямоугольник(изображение, 12, 12, 5, 5, новый Пиксель((Байт) 0, (Байт) 0, (Байт) 255))

    сохранить_bmp(изображение, "демо_примитивов.bmp")

    // Диагональ должна закрасить (0,0) и (19,19).
    переменная угол_1 = изображение.получить_пиксель(0, 0)
    вывести `${(Целое) угол_1.красный}\n`
    переменная угол_2 = изображение.получить_пиксель(19, 19)
    вывести `${(Целое) угол_2.красный}\n`

    // Контур прямоугольника: у угла контура зелёный канал 0 (чистый
    // красный), у внутренней точки (не закрашивалась) - 255 (фон белый).
    переменная контур_угол = изображение.получить_пиксель(2, 2)
    вывести `${(Целое) контур_угол.зелёный}\n`
    переменная контур_внутри = изображение.получить_пиксель(3, 6)
    вывести `${(Целое) контур_внутри.зелёный}\n`

    // Закрашенный прямоугольник: и угол, и середина - синие.
    переменная залив_угол = изображение.получить_пиксель(12, 12)
    вывести `${(Целое) залив_угол.синий}\n`
    переменная залив_центр = изображение.получить_пиксель(14, 14)
    вывести `${(Целое) залив_центр.синий}\n`
}
