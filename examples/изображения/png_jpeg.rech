/**
 * Третий срез работы с изображениями ("Работа с
 * изображениями") - PNG/JPEG. В отличие от первых двух (BMP + примитивы -
 * чистый Rech) - настоящее сжатие делает встроенный кодек компилятора
 * (биндинг к libpng/libjpeg, internal/backend/cbackend/{png,jpeg,
 * imagecodec}.go/internal/interp/imagecodec.go) - единые
 * "декодировать_изображение(путь, ФорматИзображения)"/"закодировать_
 * изображение(путь, ширина, высота, пиксели, ФорматИзображения, качество)"
 * на оба формата (тот же принцип, что и у "хеш(АлгоритмХеша, данные)").
 *
 * Этот файл - тонкая обёртка на самом Rech: конверсия результата кодека
 * (сущность "ДекодированноеИзображение" - ширина/высота/пиксели, встроена
 * компилятором, ничего не знает про пользовательскую "Изображение") в/из
 * "Изображение" (растровое_изображение.rech), плюс "загрузить_изображение" -
 * определение формата по сигнатуре первых байт файла (не по расширению
 * имени - надёжнее, если файл переименован/расширение отсутствует).
 */
использовать Изображение, Пиксель, загрузить_bmp из "растровое_изображение"

/**
 * "ДекодированноеИзображение" (результат "декодировать_изображение") в
 * "Изображение" - копирование пикселей через уже существующий
 * "установить_пиксель" (примитивы.rech делает то же самое для рисования -
 * ни одного нового метода у "Изображение" не потребовалось и здесь).
 */
функция изображение_из_декодированного(буфер: ДекодированноеИзображение): Изображение
{
    переменная изображение = новое Изображение(буфер.ширина, буфер.высота)
    переменная y           = 0
    пока y < буфер.высота {
        переменная x = 0
        пока x < буфер.ширина {
            переменная смещение = (y * буфер.ширина + x) * 4
            изображение.установить_пиксель(x, y, новый Пиксель(
                буфер.пиксели.получить(смещение),
                буфер.пиксели.получить(смещение + 1),
                буфер.пиксели.получить(смещение + 2),
                буфер.пиксели.получить(смещение + 3),
            ))
            x = x + 1
        }
        y = y + 1
    }
    вернуть изображение
}

функция загрузить_png(путь: Строка): Изображение
{
    вернуть изображение_из_декодированного(декодировать_изображение(путь, ФорматИзображения.PNG))
}

/**
 * PNG - сжатие без потерь, у него нет понятия "качество" - альфа-канал
 * (в отличие от BMP) сохраняется на диск как есть.
 */
функция сохранить_png(изображение: Изображение, путь: Строка)
{
    закодировать_изображение(путь, изображение.ширина, изображение.высота, изображение.пиксели, ФорматИзображения.PNG, 0)
}

функция загрузить_jpeg(путь: Строка): Изображение
{
    вернуть изображение_из_декодированного(декодировать_изображение(путь, ФорматИзображения.JPEG))
}

/**
 * "качество" - 0-100 (выше - лучше и тяжелее, тот же диапазон, что и у
 * jpeg_set_quality в libjpeg под капотом). Альфа-канал отбрасывается (в
 * JPEG её не бывает) - тот же выбор, что и у "сохранить_bmp"
 * (растровое_изображение.rech).
 */
функция сохранить_jpeg(изображение: Изображение, путь: Строка, качество: Целое)
{
    закодировать_изображение(путь, изображение.ширина, изображение.высота, изображение.пиксели, ФорматИзображения.JPEG, качество)
}

/**
 * Определяет формат по сигнатуре первых байт файла (не по расширению
 * имени) - "BM" (BMP), 0x89+"PNG" (PNG), 0xFF 0xD8 (JPEG) - и делегирует
 * соответствующему загрузчику.
 */
функция загрузить_изображение(путь: Строка): Изображение
{
    переменная байты = прочитать_файл_байты(путь)
    если байты.длина() >= 2 и
        байты.получить(0) == (Байт) 'B' и
        байты.получить(1) == (Байт) 'M'
    {
        вернуть загрузить_bmp(путь)
    }
    если байты.длина() >= 4 и
        байты.получить(0) == (Байт) 137 и
        байты.получить(1) == (Байт) 'P' и
        байты.получить(2) == (Байт) 'N' и
        байты.получить(3) == (Байт) 'G'
    {
        вернуть загрузить_png(путь)
    }
    если байты.длина() >= 2 и
        байты.получить(0) == (Байт) 255 и
        байты.получить(1) == (Байт) 216
    {
        вернуть загрузить_jpeg(путь)
    }
    выбросить новое Исключение("загрузить_изображение: не удалось определить формат файла \"" + путь + "\" (ожидался BMP/PNG/JPEG)")
}

функция главная
{
    Изображение изображение = новое Изображение(4, 3)
    изображение.залить(новый Пиксель((Байт) 30, (Байт) 144, (Байт) 255))
    изображение.установить_пиксель(0, 0, новый Пиксель((Байт) 255, (Байт) 0, (Байт) 0))
    изображение.установить_пиксель(3, 2, новый Пиксель((Байт) 0, (Байт) 255, (Байт) 0))

    сохранить_png(изображение, "тест.png")
    сохранить_jpeg(изображение, "тест.jpg", 90)

    переменная из_png = загрузить_изображение("тест.png")
    вывести из_png.ширина
    вывести из_png.высота
    переменная угол_png = из_png.получить_пиксель(0, 0)
    вывести (Целое) угол_png.красный
    вывести (Целое) угол_png.зелёный
    вывести (Целое) угол_png.синий
    вывести (Целое) угол_png.альфа

    переменная из_jpeg = загрузить_изображение("тест.jpg")
    вывести из_jpeg.ширина
    вывести из_jpeg.высота
}
