/**
 * Второй срез работы с изображениями ("Работа с
 * изображениями") - примитивы рисования поверх уже готового `Изображение`
 * (examples/изображения/растровое_изображение.rech): линия, контур
 * прямоугольника, закрашенный прямоугольник. Библиотека НА САМОМ Rech,
 * как и первый срез - работает только через публичные `получить_пиксель`/
 * `установить_пиксель`, ни одного нового метода у самого `Изображение` не
 * потребовалось.
 */
использовать Изображение, Пиксель из "растровое_изображение"

/** -1/0/1 по знаку целого (встроенная "знак" - для Действительное). */
функция знак_целого(значение: Целое): Целое
{
    если значение > 0 {
        вернуть 1
    }
    если значение < 0 {
        вернуть -1
    }
    вернуть 0
}

/**
 * Отрезок между двумя точками включительно - целочисленный алгоритм
 * Брезенхема (без чисел с плавающей точкой), один и тот же код для
 * любого наклона, включая вертикальные/горизонтальные отрезки как частный
 * случай.
 */
функция нарисовать_линию(изображение: Изображение, x0: Целое, y0: Целое, x1: Целое, y1: Целое, цвет: Пиксель)
{
    переменная dx     = абсолютное_значение_целого(x1 - x0)
    переменная dy     = -абсолютное_значение_целого(y1 - y0)
    переменная шаг_x  = знак_целого(x1 - x0)
    переменная шаг_y  = знак_целого(y1 - y0)
    переменная ошибка = dx + dy

    переменная x = x0
    переменная y = y0
    пока истина {
        изображение.установить_пиксель(x, y, цвет)
        если x == x1 и y == y1 {
            прервать
        }
        переменная удвоенная_ошибка = 2 * ошибка
        если удвоенная_ошибка >= dy {
            ошибка = ошибка + dy
            x = x + шаг_x
        }
        если удвоенная_ошибка <= dx {
            ошибка = ошибка + dx
            y = y + шаг_y
        }
    }
}

/**
 * Контур прямоугольника - 4 отрезка (см. "нарисовать_линию" выше). (x, y)
 * - левый верхний угол, "ширина"/"высота" - в пикселях, включая обе
 * граничные линии на каждой из сторон.
 */
функция нарисовать_прямоугольник(изображение: Изображение, x: Целое, y: Целое, ширина: Целое, высота: Целое, цвет: Пиксель)
{
    переменная x_конец = x + ширина - 1
    переменная y_конец = y + высота - 1
    нарисовать_линию(изображение, x, y, x_конец, y, цвет)
    нарисовать_линию(изображение, x, y_конец, x_конец, y_конец, цвет)
    нарисовать_линию(изображение, x, y, x, y_конец, цвет)
    нарисовать_линию(изображение, x_конец, y, x_конец, y_конец, цвет)
}

/** Закрашенный прямоугольник - построчная заливка сплошным цветом. */
функция закрасить_прямоугольник(изображение: Изображение, x: Целое, y: Целое, ширина: Целое, высота: Целое, цвет: Пиксель)
{
    переменная j = 0
    пока j < высота {
        переменная i = 0
        пока i < ширина {
            изображение.установить_пиксель(x + i, y + j, цвет)
            i = i + 1
        }
        j = j + 1
    }
}
