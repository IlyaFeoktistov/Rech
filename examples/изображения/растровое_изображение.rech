/**
 * Первый срез работы с изображениями ("Отложено - работа
 * с изображениями") - библиотека НА САМОМ Rech (не фича компилятора, тот
 * же принцип, что и examples/бд/orm_легковесный.rech): пиксельный буфер
 * плюс формат **BMP** (несжатый, не требует внешней библиотеки) поверх
 * уже существующих `Список<Байт>`/`прочитать_файл_байты`/
 * `записать_в_файл_байты`. Примитивы рисования (линия/прямоугольник) и
 * PNG/JPEG через FFI - следующие срезы, здесь их нет.
 *
 * Пиксели хранятся построчно как RGBA (4 байта на пиксель, строка 0 -
 * верх изображения) - выбор пользователя при постановке задачи. Файл BMP
 * на диске классический 24-битный (BGR, без альфа-канала, строки снизу
 * вверх с выравниванием на 4 байта) - самый широко читаемый вариант
 * формата; альфа-канал при сохранении отбрасывается, при загрузке
 * восстанавливается как 255 (непрозрачный).
 */
структура Пиксель
{
    имеет:
        красный: Байт
        зелёный: Байт
        синий:   Байт
        альфа:   Байт = (Байт) 255
}

сущность Изображение
{
    имеет:
        ширина:  Целое
        высота:  Целое
        пиксели: Список<Байт>

    конструктор(ширина: Целое, высота: Целое)
    {
        если ширина <= 0 или высота <= 0 {
            выбросить новое Исключение("Изображение: ширина и высота должны быть положительными, получено " + (Строка) ширина + "x" + (Строка) высота)
        }
        этот.ширина = ширина
        этот.высота = высота
        этот.пиксели = новый Список<Байт>()
        переменная всего = ширина * высота * 4
        переменная i     = 0
        пока i < всего {
            этот.пиксели.добавить((Байт) 0)
            i = i + 1
        }
    }

    /** Индекс первого из 4 байт пикселя (x, y) в этот.пиксели. */
    смещение_пикселя(x: Целое, y: Целое): Целое
    {
        если x < 0 или x >= этот.ширина или y < 0 или y >= этот.высота {
            выбросить новое Исключение("Изображение: координата (" + (Строка) x + ", " + (Строка) y + ") вне границ " + (Строка) этот.ширина + "x" + (Строка) этот.высота)
        }
        вернуть (y * этот.ширина + x) * 4
    }

    получить_пиксель(x: Целое, y: Целое): Пиксель
    {
        переменная смещение = этот.смещение_пикселя(x, y)
        вернуть новый Пиксель(
            этот.пиксели.получить(смещение),
            этот.пиксели.получить(смещение + 1),
            этот.пиксели.получить(смещение + 2),
            этот.пиксели.получить(смещение + 3),
        )
    }

    установить_пиксель(x: Целое, y: Целое, значение: Пиксель)
    {
        переменная смещение = этот.смещение_пикселя(x, y)
        этот.пиксели.установить(смещение, значение.красный)
        этот.пиксели.установить(смещение + 1, значение.зелёный)
        этот.пиксели.установить(смещение + 2, значение.синий)
        этот.пиксели.установить(смещение + 3, значение.альфа)
    }

    залить(значение: Пиксель)
    {
        переменная y = 0
        пока y < этот.высота {
            переменная x = 0
            пока x < этот.ширина {
                этот.установить_пиксель(x, y, значение)
                x = x + 1
            }
            y = y + 1
        }
    }
}

/**
 * Дописывает целое как 2 байта little-endian (BMP-заголовки - только
 * little-endian, независимо от архитектуры машины).
 */
функция дописать_u16_le(байты: Список<Байт>, значение: Целое)
{
    байты.добавить((Байт) (значение & 255))
    байты.добавить((Байт) ((значение >> 8) & 255))
}

/** Дописывает целое как 4 байта little-endian. */
функция дописать_u32_le(байты: Список<Байт>, значение: Целое)
{
    байты.добавить((Байт) (значение & 255))
    байты.добавить((Байт) ((значение >> 8) & 255))
    байты.добавить((Байт) ((значение >> 16) & 255))
    байты.добавить((Байт) ((значение >> 24) & 255))
}

/** Читает 2 байта little-endian из списка байт как беззнаковое целое. */
функция прочитать_u16_le(байты: Список<Байт>, смещение: Целое): Целое
{
    вернуть (Целое) байты.получить(смещение) | ((Целое) байты.получить(смещение + 1) << 8)
}

/** Читает 4 байта little-endian из списка байт как беззнаковое целое. */
функция прочитать_u32_le(байты: Список<Байт>, смещение: Целое): Целое
{
    вернуть (Целое) байты.получить(смещение) | ((Целое) байты.получить(смещение + 1) << 8) | ((Целое) байты.получить(смещение + 2) << 16) | ((Целое) байты.получить(смещение + 3) << 24)
}

/**
 * Количество байт-заполнителей в конце строки пикселей BMP - каждая
 * строка выровнена на 4 байта.
 */
функция bmp_заполнение_строки(ширина: Целое): Целое
{
    переменная байт_в_строке = ширина * 3
    вернуть (4 - байт_в_строке % 4) % 4
}

/**
 * Сохраняет изображение как классический 24-битный BMP (BI_RGB, без
 * сжатия) - строки снизу вверх, порядок каналов BGR, альфа отбрасывается.
 */
функция сохранить_bmp(изображение: Изображение, путь: Строка)
{
    переменная заполнение      = bmp_заполнение_строки(изображение.ширина)
    переменная размер_строки   = изображение.ширина * 3 + заполнение
    переменная размер_данных   = размер_строки * изображение.высота
    переменная смещение_данных = 14 + 40

    переменная байты = новый Список<Байт>()

    // Заголовок файла BMP (14 байт).
    байты.добавить((Байт) 'B')
    байты.добавить((Байт) 'M')
    дописать_u32_le(байты, смещение_данных + размер_данных)
    дописать_u32_le(байты, 0)
    дописать_u32_le(байты, смещение_данных)

    // BITMAPINFOHEADER (40 байт).
    дописать_u32_le(байты, 40)
    дописать_u32_le(байты, изображение.ширина)
    дописать_u32_le(байты, изображение.высота)
    дописать_u16_le(байты, 1)
    дописать_u16_le(байты, 24)
    дописать_u32_le(байты, 0)
    дописать_u32_le(байты, размер_данных)
    дописать_u32_le(байты, 2835)
    дописать_u32_le(байты, 2835)
    дописать_u32_le(байты, 0)
    дописать_u32_le(байты, 0)

    // Строки пикселей снизу вверх, BGR, с заполнением.
    переменная y = изображение.высота - 1
    пока y >= 0 {
        переменная x = 0
        пока x < изображение.ширина {
            переменная пиксель = изображение.получить_пиксель(x, y)
            байты.добавить(пиксель.синий)
            байты.добавить(пиксель.зелёный)
            байты.добавить(пиксель.красный)
            x = x + 1
        }
        переменная p = 0
        пока p < заполнение {
            байты.добавить((Байт) 0)
            p = p + 1
        }
        y = y - 1
    }

    записать_в_файл_байты(путь, байты)
}

/**
 * Загружает классический 24-битный несжатый BMP (BI_RGB), сохранённый
 * "сохранить_bmp" или любым другим редактором в том же формате. Альфа
 * восстанавливается как 255 (непрозрачный) - в 24-битном BMP её нет.
 */
функция загрузить_bmp(путь: Строка): Изображение
{
    переменная байты = прочитать_файл_байты(путь)
    если байты.длина() < 54 {
        выбросить новое Исключение(`загрузить_bmp: файл "` + путь + `" короче минимального заголовка BMP`)
    }
    если байты.получить(0) != (Байт) 'B' или байты.получить(1) != (Байт) 'M' {
        выбросить новое Исключение(`загрузить_bmp: файл "` + путь + `" не начинается с сигнатуры "BM"`)
    }
    переменная смещение_данных = прочитать_u32_le(байты, 10)
    переменная размер_dib      = прочитать_u32_le(байты, 14)
    если размер_dib != 40 {
        выбросить новое Исключение("загрузить_bmp: поддерживается только BITMAPINFOHEADER (размер 40), получено " + (Строка) размер_dib)
    }
    переменная ширина = прочитать_u32_le(байты, 18)
    переменная высота = прочитать_u32_le(байты, 22)
    если высота <= 0 или высота > 0x7FFFFFFF {
        выбросить новое Исключение("загрузить_bmp: поддерживаются только BMP с положительной высотой (строки снизу вверх)")
    }
    переменная bpp = прочитать_u16_le(байты, 28)
    если bpp != 24 {
        выбросить новое Исключение("загрузить_bmp: поддерживается только 24-битный BMP (BI_RGB), получено " + (Строка) bpp + " бит на пиксель")
    }
    переменная сжатие = прочитать_u32_le(байты, 30)
    если сжатие != 0 {
        выбросить новое Исключение("загрузить_bmp: сжатые BMP не поддерживаются")
    }

    переменная изображение   = новое Изображение(ширина, высота)
    переменная заполнение    = bmp_заполнение_строки(ширина)
    переменная размер_строки = ширина * 3 + заполнение

    переменная y = высота - 1
    пока y >= 0 {
        переменная база_строки = смещение_данных + (высота - 1 - y) * размер_строки
        переменная x           = 0
        пока x < ширина {
            переменная база_пикселя = база_строки + x * 3
            переменная синий        = байты.получить(база_пикселя)
            переменная зелёный      = байты.получить(база_пикселя + 1)
            переменная красный      = байты.получить(база_пикселя + 2)
            изображение.установить_пиксель(x, y, новый Пиксель(красный, зелёный, синий, (Байт) 255))
            x = x + 1
        }
        y = y - 1
    }

    вернуть изображение
}

функция главная
{
    переменная изображение = новое Изображение(4, 3)
    изображение.залить(новый Пиксель((Байт) 30, (Байт) 30, (Байт) 30))
    изображение.установить_пиксель(0, 0, новый Пиксель((Байт) 255, (Байт) 0, (Байт) 0))
    изображение.установить_пиксель(3, 0, новый Пиксель((Байт) 0, (Байт) 255, (Байт) 0))
    изображение.установить_пиксель(0, 2, новый Пиксель((Байт) 0, (Байт) 0, (Байт) 255))
    изображение.установить_пиксель(3, 2, новый Пиксель((Байт) 255, (Байт) 255, (Байт) 0))

    сохранить_bmp(изображение, "тест.bmp")

    переменная загруженное = загрузить_bmp("тест.bmp")
    вывести загруженное.ширина
    вывести загруженное.высота

    переменная угол = загруженное.получить_пиксель(0, 0)
    вывести (Целое) угол.красный
    вывести (Целое) угол.зелёный
    вывести (Целое) угол.синий
    вывести (Целое) угол.альфа

    переменная центр = загруженное.получить_пиксель(1, 1)
    вывести (Целое) центр.красный
}
