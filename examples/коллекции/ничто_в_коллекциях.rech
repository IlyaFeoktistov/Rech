/**
 * "?Тип" элементом коллекции - Список<?Целое>, Стопка<?Т>, Очередь<?Т>,
 * значение Словарь<К, ?В>. Обычное значение и "Ничто" кладутся напрямую,
 * без явной обёртки; литерал с "Ничто" сам выводит "Список<?Т>".
 * Безопасная индексация "[]" не оборачивает повторно: "Ничто" - и промах,
 * и сохранённое "Ничто".
 */
сущность Задание
{
    имеет:
        Строка название

    конструктор(название: Строка)
    {
        этот.название = название
    }
}

функция главная
{
    переменная оценки = [5, Ничто, 4]
    оценки.добавить(Ничто)
    вывести `${оценки.длина()}\n`  // 4

    для оценка в оценках {
        если оценка != Ничто {
            вывести `оценка ${оценка}\n`
        } иначе {
            вывести `не сдано\n`
        }
    }

    вывести `${оценки[1] ?? 0}\n`   // 0 - сохранённое Ничто
    вывести `${оценки[99] ?? 0}\n`  // 0 - вне границ

    Список<?Целое> копия = [5, Ничто, 4, Ничто]
    вывести `${оценки.равен(копия)}\n`  // истина - Ничто равно Ничто

    переменная телефоны = новый Словарь<Строка, ?Строка>()
    телефоны.установить("Аня", "+7 900 000-00-00")
    телефоны.установить("Борис", Ничто)
    вывести `${телефоны.содержит("Борис")}\n`   // истина - ключ есть, телефона нет
    вывести `${телефоны["Борис"] ?? "нет"}\n`  // нет

    переменная очередь = новая Очередь<?Задание>()
    очередь.добавить(новое Задание("отчёт"))
    очередь.добавить(Ничто)
    пока !очередь.пусто() {
        переменная задание = очередь.извлечь()
        если задание != Ничто {
            вывести `${задание.название}\n`  // отчёт
        } иначе {
            вывести `пропуск\n`
        }
    }
}
