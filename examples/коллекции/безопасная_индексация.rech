/**
 * Безопасная индексация "[]" - Список<T>[i]/Словарь<К, В>[ключ] - в
 * отличие от ".получить(...)" (паникует при промахе), значение всегда
 * "?T"/"?В" (Ничто при выходе за границу/отсутствии ключа). Запись
 * "receiver[индекс] = значение" - сахар над ".установить(...)".
 * Цепочка "таблица[i][j]" - тоже "?T": Ничто на любом уровне даёт Ничто.
 */
функция главная
{
    переменная числа = новый Список<Целое>()
    числа.добавить(10)
    числа.добавить(20)
    числа.добавить(30)

    вывести `${числа[0] ?? -1  // 10}\n`
    вывести `${числа[99] ?? -1 // -1 - вне границ, но не паника}\n`

    числа[1] = 999
    вывести `${числа.получить(1) // 999}\n`

    переменная карта = новый Словарь<Строка, Целое>()
    карта.установить("а", 1)
    вывести `${карта["а"] ?? -1   // 1}\n`
    вывести `${карта["нет"] ?? -1 // -1 - нет такого ключа}\n`

    карта["б"] = 2
    вывести `${карта.получить("б") // 2}\n`

    Список<Список<Целое>> таблица = [[1, 2], [3, 4]]
    вывести `${таблица[1][0] ?? -1 // 3}\n`
    вывести `${таблица[5][0] ?? -1 // -1 - нет строки 5}\n`
}
