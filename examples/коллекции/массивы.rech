/**
 * Массив фиксированной длины "Тип[N]" - длина - часть типа, массив -
 * значение: присваивание и передача в функцию копируют все элементы (в
 * отличие от "Тип[]" - это Список<Тип>, растущий и общий по ссылке).
 * "м[i]" - элемент (выход за границы - аварийное завершение), "м.длина()" -
 * N. Без значения массив заполнен нулями. "Тип[N][M]" - N массивов по M
 * элементов, как в C. См. docs/SPEC.md, "Массивы фиксированной длины".
 */
структура Точка
{
    имеет:
        Целое x
        Целое y
}

функция сумма(числа: Целое[3]): Целое
{
    Целое итог = 0
    для i = 0; i < числа.длина(); i++ {
        итог += числа[i]
    }
    вернуть итог
}

функция главная
{
    Целое[3] числа = [1, 2, 3]
    Целое[3] копия = числа
    копия[0] = 100
    вывести `${числа[0]} ${копия[0]} ${сумма(числа)}\n`

    // Без значения - нули.
    Целое[2][3] матрица
    матрица[1][2] = 7
    вывести `${матрица[1][2]} ${матрица[0][0]} ${матрица[1].длина()}\n`

    Точка[2] точки = [новая Точка(1, 2), новая Точка(3, 4)]
    точки[1].x = 30
    вывести `${точки[1].x} ${точки[1].y}\n`

    // Адрес элемента - начало C-массива: соседние элементы по индексу.
    *Целое строка = &матрица[1][0]
    строка[1] = 5
    вывести `${матрица[1][1]}\n`

    // "*Тип[N]" - массив указателей (как "char *a[N]" в C).
    *Символ[2] указатели
    вывести `${указатели[0] == Ничто}\n`
}
