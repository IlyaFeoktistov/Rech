/**
 * Клетка поля - структура (значение), элемент вложенного списка.
 */
структура Клетка
{
    имеет:
        Целое      x
        Целое      y
        Логическое занята = ложь
}

/**
 * Список<T> как элемент другого Список<T> (матрица - Список<Список<Целое>>) -
 * та же строгая типизация (один и тот же T на инстанциацию), что и у
 * обычного Список<T>, только T сам оказывается generic-коллекцией. Элементом
 * может быть и структура/сущность: Клетка[][] - то же, что
 * Список<Список<Клетка>>; такие списки сравниваются по содержимому через
 * "равен".
 */
функция главная
{
    переменная матрица = новый Список<Список<Целое>>()

    переменная строка1 = новый Список<Целое>()
    строка1.добавить(1)
    строка1.добавить(2)
    матрица.добавить(строка1)

    переменная строка2 = новый Список<Целое>()
    строка2.добавить(3)
    строка2.добавить(4)
    матрица.добавить(строка2)

    вывести `${матрица.длина()}\n`

    переменная первая = матрица.первый()
    вывести `${первая.получить(1)}\n`

    для строка в матрице {
        для x в строке {
            вывести `${x}\n`
        }
    }

    Клетка[][] поле = [
        [новая Клетка(x: 0, y: 0), новая Клетка(x: 1, y: 0, занята: истина)],
        [новая Клетка(x: 0, y: 1), новая Клетка(x: 1, y: 1)],
    ]
    вывести `${поле.получить(0).получить(1).занята}\n`
    вывести `${поле.равен([[новая Клетка(x: 0, y: 0)]])}\n`

    // Поле элемента-структуры меняется прямо в списке.
    Клетка[] ряд = [новая Клетка(x: 0, y: 0)]
    ряд[0].занята = истина
    вывести `${ряд.получить(0).занята}\n`
}
