/** Демонстрирует встроенную generic-"Стопка<T>" (LIFO): положить/снять/верх/длина/пусто/перебор/значения. */
функция главная
{
    переменная стопка = новая Стопка<Целое>()
    вывести `${стопка.пусто()}\n`

    стопка.положить(1)
    стопка.положить(2)
    стопка.положить(3)

    вывести `${стопка.длина()}\n`
    вывести `${стопка.верх()}\n`

    // Перебор - сверху вниз, в том же порядке, что и "снять".
    для число в стопке {
        вывести `${число}\n`
    }
    показать стопка.значения()

    вывести `${стопка.снять()}\n`
    вывести `${стопка.снять()}\n`
    вывести `${стопка.длина()}\n`
    вывести `${стопка.пусто()}\n`
}
