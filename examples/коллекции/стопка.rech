/** Демонстрирует встроенную generic-"Стопка<T>" (LIFO): положить/снять/верх/длина/пусто. */
функция главная
{
    переменная стопка = новая Стопка<Целое>()
    вывести `${стопка.пусто()}\n`

    стопка.положить(1)
    стопка.положить(2)
    стопка.положить(3)

    вывести `${стопка.длина()}\n`
    вывести `${стопка.верх()}\n`

    вывести `${стопка.снять()}\n`
    вывести `${стопка.снять()}\n`
    вывести `${стопка.длина()}\n`
    вывести `${стопка.пусто()}\n`
}
