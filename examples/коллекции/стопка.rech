/** Демонстрирует встроенную generic-"Стопка<T>" (LIFO): положить/снять/верх/длина/пусто. */
функция главная
{
    переменная стопка = новая Стопка<Целое>()
    вывести стопка.пусто()

    стопка.положить(1)
    стопка.положить(2)
    стопка.положить(3)

    вывести стопка.длина()
    вывести стопка.верх()

    вывести стопка.снять()
    вывести стопка.снять()
    вывести стопка.длина()
    вывести стопка.пусто()
}
