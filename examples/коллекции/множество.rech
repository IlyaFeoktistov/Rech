/**
 * Множество<T> - набор без повторов: "добавить" уже имеющийся элемент
 * ничего не меняет, "содержит" - есть ли элемент, перебор "для x в ..." -
 * в порядке добавления. Элемент - Целое/Байт/Символ/Логическое/Строка или
 * перечисление.
 */
функция главная
{
    Множество<Строка> теги = новое Множество<Строка>()
    теги.добавить("rech")
    теги.добавить("язык")
    теги.добавить("rech")
    вывести `${теги.длина()} ${теги.содержит("язык")} ${теги.содержит("go")}\n`

    для тег в тегах {
        вывести `${тег}\n`
    }

    теги.удалить("rech")
    вывести `${теги.значения().длина()}\n`

    Множество<Целое> а = новое Множество<Целое>()
    Множество<Целое> б = новое Множество<Целое>()
    а.добавить(1)
    а.добавить(2)
    б.добавить(2)
    б.добавить(1)
    вывести `${а.равен(б)}\n`
}
