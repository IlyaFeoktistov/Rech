функция главная
{
    переменная числа = создать Список<Целое>()
    числа.добавить(10)
    числа.добавить(20)
    числа.добавить(30)

    вывести числа.длина()
    вывести числа.получить(0)
    вывести числа.получить(2)

    числа.установить(1, 99)
    вывести числа.получить(1)

    вывести числа.пусто()
}
