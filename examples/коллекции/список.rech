/** Демонстрирует встроенный generic-"Список<T>": добавить/получить/установить/первый/последний/длина/пусто/перебор. */
функция главная
{
    переменная числа = новый Список<Целое>()
    числа.добавить(10)
    числа.добавить(20)
    числа.добавить(30)

    вывести `${числа.длина()}\n`
    вывести `${числа.получить(0)}\n`
    вывести `${числа.получить(2)}\n`

    числа.установить(1, 99)
    вывести `${числа.получить(1)}\n`

    // Короче, чем "получить(0)"/"получить(длина() - 1)".
    вывести `${числа.первый()}\n`
    вывести `${числа.последний()}\n`

    вывести `${числа.пусто()}\n`

    для x в числах {
        вывести `${x}\n`
    }

    // Две переменные - порядковый номер элемента (с 0) и сам элемент.
    для номер, x в числах {
        вывести `${номер}: ${x}\n`
    }
}
