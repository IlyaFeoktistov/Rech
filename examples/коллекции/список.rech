/** Демонстрирует встроенный generic-"Список<T>": добавить/получить/установить/длина/пусто/перебор. */
функция главная
{
    переменная числа = новый Список<Целое>()
    числа.добавить(10)
    числа.добавить(20)
    числа.добавить(30)

    вывести числа.длина()
    вывести числа.получить(0)
    вывести числа.получить(2)

    числа.установить(1, 99)
    вывести числа.получить(1)

    вывести числа.пусто()

    для x в числах {
        вывести x
    }
}
