/** Литерал списка "[элемент, ...]" - создаёт Список<T>. Непустой - тип
    элемента выводится из первого элемента, дальше работает без явной
    аннотации типа переменной, как обычный литерал. Пустой "[]" сам по
    себе не несёт типа - нужна явная аннотация ("переменная а: Список<Тип>
    = []"). Массивы строго типизированы - элементы одного литерала обязаны
    быть РОВНО одного типа, без неявного расширения. */
функция главная
{
    переменная а: Список<Целое> = []
    вывести а.длина() // 0

    переменная числа = [1, 2, 3, 4]
    вывести числа.длина()     // 4
    вывести числа.получить(0) // 1

    числа.добавить(5)
    вывести числа.длина() // 5

    переменная строки = ["а", "бб", "ввв"]
    вывести строки.длина()     // 3
    вывести строки.получить(1) // бб
}
