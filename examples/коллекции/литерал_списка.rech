/**
 * Литерал списка "[элемент, ...]" - создаёт Список<T>. Непустой - тип
 * элемента выводится из первого элемента ("переменная а = [1, 2]").
 * Пустой "[]" сам по себе не несёт типа - тип пишется явно
 * ("Список<Тип> а = []"). Массивы строго типизированы - элементы одного литерала обязаны
 * быть РОВНО одного типа, без неявного расширения.
 */
функция главная
{
    Список<Целое> а = []
    вывести `${а.длина() // 0}\n`

    переменная числа = [1, 2, 3, 4]
    вывести `${числа.длина()     // 4}\n`
    вывести `${числа.получить(0) // 1}\n`

    числа.добавить(5)
    вывести `${числа.длина() // 5}\n`

    переменная строки = ["а", "бб", "ввв"]
    вывести `${строки.длина()     // 3}\n`
    вывести `${строки.получить(1) // бб}\n`
}
