/** Демонстрирует встроенную generic-"Очередь<T>" (FIFO): добавить/извлечь/первый/длина/пусто/перебор. */
функция главная
{
    переменная очередь = новая Очередь<Целое>()
    вывести `${очередь.пусто()}\n`

    очередь.добавить(1)
    очередь.добавить(2)
    очередь.добавить(3)

    вывести `${очередь.длина()}\n`
    вывести `${очередь.первый()}\n`

    // Перебор - от первого к последнему, в том же порядке, что и "извлечь".
    для номер, число в очереди {
        вывести `${номер}: ${число}\n`
    }

    вывести `${очередь.извлечь()}\n`
    вывести `${очередь.извлечь()}\n`
    вывести `${очередь.длина()}\n`
    вывести `${очередь.пусто()}\n`
}
