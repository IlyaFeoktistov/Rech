/** Демонстрирует встроенную generic-"Очередь<T>" (FIFO): добавить/извлечь/первый/длина/пусто. */
функция главная
{
    переменная очередь = новая Очередь<Целое>()
    вывести очередь.пусто()

    очередь.добавить(1)
    очередь.добавить(2)
    очередь.добавить(3)

    вывести очередь.длина()
    вывести очередь.первый()

    вывести очередь.извлечь()
    вывести очередь.извлечь()
    вывести очередь.длина()
    вывести очередь.пусто()
}
