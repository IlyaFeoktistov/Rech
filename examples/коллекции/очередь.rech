/** Демонстрирует встроенную generic-"Очередь<T>" (FIFO): добавить/извлечь/первый/длина/пусто. */
функция главная
{
    переменная очередь = новая Очередь<Целое>()
    вывести `${очередь.пусто()}\n`

    очередь.добавить(1)
    очередь.добавить(2)
    очередь.добавить(3)

    вывести `${очередь.длина()}\n`
    вывести `${очередь.первый()}\n`

    вывести `${очередь.извлечь()}\n`
    вывести `${очередь.извлечь()}\n`
    вывести `${очередь.длина()}\n`
    вывести `${очередь.пусто()}\n`
}
