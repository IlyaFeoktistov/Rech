/**
 * Список/Стопка/Очередь/Словарь - ССЫЛОЧНЫЕ типы (как "сущность"/"класс"),
 * не значения: переданные обычным параметром функции или присвоенные
 * другой переменной, остаются ТЕМ ЖЕ объектом - мутация внутри функции
 * видна вызывающей стороне после возврата.
 */
функция вставить_в(словарь: Словарь<Строка, Строка>)
{
    словарь.установить("а", "1")
}

функция добавить_в(список: Список<Целое>)
{
    список.добавить(99)
}

функция главная
{
    переменная словарь = новый Словарь<Строка, Строка>()
    вставить_в(словарь)
    вывести `${словарь.содержит("а")}\n`
    вывести `${словарь.длина()}\n`

    переменная список = новый Список<Целое>()
    добавить_в(список)
    вывести `${список.длина()}\n`
    вывести `${список.первый()}\n`

    // Присваивание другой переменной - тоже ссылка, не копия.
    переменная псевдоним = список
    псевдоним.добавить(100)
    вывести `${список.длина()}\n`
}
