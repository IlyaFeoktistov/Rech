/**
 * Двоичный wire-формат Protocol Buffers (см. docs/SPEC.md, раздел 18) -
 * номер поля обязателен (тег `protobuf:<номер>`, не переименование, как у
 * `json:...`) - реальный protobuf-собеседник (на любом другом языке) знает
 * только номера полей, не русские имена. Источник/результат - `Список<Байт>`,
 * не `Строка` (двоичный формат).
 */
структура Адрес
{
    имеет:
        Строка улица `protobuf:1`
        Целое  дом   `protobuf:2`
}

структура Пользователь
{
    имеет:
        Строка         имя     `protobuf:1`
        Целое          возраст `protobuf:2`
        Список<Строка> теги    `protobuf:3`
        Адрес          адрес   `protobuf:4`
}

функция главная
{
    переменная теги = новый Список<Строка>()
    теги.добавить("admin")
    теги.добавить("vip")
    переменная адрес        = новый Адрес("Ленина", 10)
    переменная пользователь = новый Пользователь("Аня", 30, теги, адрес)

    переменная байты = сериализовать PROTOBUF пользователь
    вывести `${байты.длина()}\n`

    переменная разобранный = разобрать PROTOBUF байты как Пользователь
    вывести `${разобранный.имя}\n`
    вывести `${разобранный.возраст}\n`
    вывести `${разобранный.теги.получить(0)}\n`
    вывести `${разобранный.теги.получить(1)}\n`
    вывести `${разобранный.адрес.улица}\n`
    вывести `${разобранный.адрес.дом}\n`
}
