/**
 * Обратное к разбору: "сериализовать YAML <выражение>" -> Строка. Строки
 * всегда в двойных кавычках (простое правило вместо анализа "похож ли
 * скаляр на число/true/false/пусто"); вложенная сущность/список -
 * с новой строки, отступ +2 от родителя.
 */
сущность Адрес
{
    имеет:
        город: Строка
}

сущность Пользователь
{
    имеет:
        имя:     Строка
        возраст: Целое
        адрес:   Адрес
}

функция главная
{
    переменная адрес = новый Адрес()
    адрес.город = "Москва"
    переменная пользователь = новый Пользователь()
    пользователь.имя = "Аня"
    пользователь.возраст = 30
    пользователь.адрес = адрес
    вывести `${сериализовать YAML пользователь}\n`

    переменная числа = новый Список<Целое>()
    числа.добавить(1)
    числа.добавить(2)
    числа.добавить(3)
    вывести `${сериализовать YAML числа}\n`

    переменная пусто = новый Список<Целое>()
    вывести `${сериализовать YAML пусто}\n` // "[]" - блочный стиль не может выразить ноль элементов иначе

    переменная восстановленный = разобрать YAML (сериализовать YAML пользователь) как Пользователь
    вывести `${восстановленный.имя}\n`
    вывести `${восстановленный.адрес.город}\n`
}
