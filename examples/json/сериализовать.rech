/** Обратное к разбору: "сериализовать JSON <выражение>" -> Строка. */
сущность Адрес
{
    имеет:
        город: Строка
}

сущность Пользователь
{
    имеет:
        имя:     Строка
        возраст: Целое
        адрес:   Адрес
}

функция главная
{
    переменная адрес = новый Адрес()
    адрес.город = "Москва"
    переменная пользователь = новый Пользователь()
    пользователь.имя = "Аня"
    пользователь.возраст = 30
    пользователь.адрес = адрес
    вывести `${сериализовать JSON пользователь}\n`

    переменная числа = новый Список<Целое>()
    числа.добавить(1)
    числа.добавить(2)
    числа.добавить(3)
    вывести `${сериализовать JSON числа}\n`

    переменная строкаСКавычками = `текст с "кавычками"`
    вывести `${сериализовать JSON строкаСКавычками}\n`

    переменная восстановленный = разобрать JSON (сериализовать JSON пользователь) как Пользователь
    вывести `${восстановленный.имя}\n`
    вывести `${восстановленный.адрес.город}\n`
}
