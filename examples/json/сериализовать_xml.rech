/** Обратное к разбору: "сериализовать XML <выражение>" -> Строка. */
сущность Адрес
{
    имеет:
        Строка город
}

сущность Пользователь
{
    имеет:
        Строка имя
        Целое  возраст
        Адрес  адрес
}

функция главная
{
    переменная адрес = новый Адрес()
    адрес.город = "Москва"
    переменная пользователь = новый Пользователь()
    пользователь.имя = "Аня"
    пользователь.возраст = 30
    пользователь.адрес = адрес
    вывести `${сериализовать XML пользователь}\n`

    переменная числа = новый Список<Целое>()
    числа.добавить(1)
    числа.добавить(2)
    числа.добавить(3)
    вывести `${сериализовать XML числа}\n`

    вывести `${сериализовать XML "текст с <тегами> и амперсандом &"}\n`

    переменная восстановленный = разобрать XML (сериализовать XML пользователь) как Пользователь
    вывести `${восстановленный.имя}\n`
    вывести `${восстановленный.адрес.город}\n`
}
