/** Schema-first разбор XML: "разобрать XML <выражение> как <Тип>". */
сущность Адрес
{
    имеет:
        город: Строка
}

сущность Пользователь
{
    имеет:
        имя:     Строка
        возраст: Целое
        активен: Логическое
        адрес:   Адрес
}

функция главная
{
    переменная текст        = "<пользователь><имя>Аня</имя><возраст>30</возраст><активен>true</активен><адрес><город>Москва</город></адрес></пользователь>"
    переменная пользователь = разобрать XML текст как Пользователь
    вывести `${пользователь.имя}\n`
    вывести `${пользователь.возраст}\n`
    вывести `${пользователь.активен}\n`
    вывести `${пользователь.адрес.город}\n`

    переменная числа = разобрать XML "<список><элемент>1</элемент><элемент>2</элемент><элемент>3</элемент></список>" как Список<Целое>
    вывести `${числа.длина()}\n`
    вывести `${числа.получить(2)}\n`

    попытаться {
        переменная плохой = разобрать XML "<пользователь></пользователь>" как Пользователь
        вывести "не должно случиться\n"
    } поймать(ошибка: ОшибкаРазбора) {
        вывести `${ошибка.сообщение}\n`
    }
}
