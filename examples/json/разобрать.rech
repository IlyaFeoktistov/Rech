/** Schema-first разбор JSON: "разобрать JSON <выражение> как <Тип>". */
сущность Адрес
{
    имеет:
        Строка город
}

сущность Пользователь
{
    имеет:
        Строка     имя
        Целое      возраст
        Логическое активен
        Адрес      адрес
}

функция главная
{
    переменная текст        = `{"имя": "Аня", "возраст": 30, "активен": true, "адрес": {"город": "Москва"}}`
    переменная пользователь = разобрать JSON текст как Пользователь
    вывести `${пользователь.имя}\n`
    вывести `${пользователь.возраст}\n`
    вывести `${пользователь.активен}\n`
    вывести `${пользователь.адрес.город}\n`

    переменная числа = разобрать JSON "[1, 2, 3]" как Список<Целое>
    вывести `${числа.длина()}\n`
    вывести `${числа.получить(2)}\n`

    попытаться {
        переменная плохой = разобрать JSON "{}" как Пользователь
        вывести `не должно случиться\n`
    } поймать(ошибка: ОшибкаРазбора) {
        вывести `${ошибка.сообщение}\n`
    }
}
