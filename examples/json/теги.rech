/** Тег поля - `ключ:значение, ключ2:значение2` после типа поля (см.
docs/SPEC.md, "Тег поля"). Ключ "json:" даёт полю внешнее имя в JSON,
отличное от собственного (Кириллического) имени поля - без тега внешний
ключ совпадает с именем поля, как и раньше. */
сущность Пользователь
{
    имеет:
        имя: Строка `json:name, sql:user_name`
        возраст: Целое `json:age`
        активен: Логическое
}

функция главная
{
    переменная пользователь = разобрать JSON "{\"name\": \"Илья\", \"age\": 30, \"активен\": true}" как Пользователь
    вывести пользователь.имя
    вывести пользователь.возраст
    вывести пользователь.активен
    вывести сериализовать JSON пользователь
}
