/**
 * Schema-first разбор YAML: "разобрать YAML <выражение> как <Тип>" -
 * блочный стиль (отступами), без фигурных/квадратных скобок JSON (кроме
 * "[]"/"{}" как записи пустого списка/отображения - блочный стиль сам по
 * себе не может выразить "далее ноль элементов" никаким отступом).
 */
сущность Адрес
{
    имеет:
        город: Строка
}

сущность Пользователь
{
    имеет:
        имя:     Строка
        возраст: Целое
        активен: Логическое
        адрес:   Адрес
}

сущность Маршрут
{
    имеет:
        путь:  Строка
        метод: Строка
}

функция главная
{
    переменная текст        = `имя: Аня\nвозраст: 30\nактивен: true\nадрес:\n  город: Москва\n`
    переменная пользователь = разобрать YAML текст как Пользователь
    вывести `${пользователь.имя}\n`
    вывести `${пользователь.возраст}\n`
    вывести `${пользователь.активен}\n`
    вывести `${пользователь.адрес.город}\n`

    переменная числа = разобрать YAML `- 1\n- 2\n- 3\n` как Список<Целое>
    вывести `${числа.длина()}\n`
    вывести `${числа.получить(2)}\n`

    // "- ключ: значение" с продолжением тем же отступом, что и "ключ" -
    // частый идиом YAML для списка записей (список сущностей - только
    // ЛОКАЛЬНАЯ переменная, не поле другой сущности, раздел 8 SPEC.md).
    переменная маршруты = разобрать YAML `- путь: /a\n  метод: GET\n- путь: /b\n  метод: POST\n` как Список<Маршрут>
    вывести `${маршруты.длина()}\n`
    переменная первый = маршруты.первый()
    вывести `${первый.путь}\n`
    вывести `${первый.метод}\n`

    // Пустой список - буквально "[]", единственный распознанный
    // flow-style токен в этом подмножестве.
    переменная пусто = разобрать YAML `[]\n` как Список<Целое>
    вывести `${пусто.длина()}\n`

    попытаться {
        переменная плохой = разобрать YAML `имя: Аня\n` как Пользователь
        вывести `не должно случиться\n`
    } поймать(ошибка: ОшибкаРазбора) {
        вывести `${ошибка.сообщение}\n`
    }
}
