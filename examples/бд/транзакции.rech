/**
 * Транзакции - "начать_транзакцию(БД, Вызываемый(Транзакция): Ничто)"
 * (docs/SPEC.md, "БД", "Транзакции") - callback-стиль, как
 * DB::transaction(closure) в Laravel Eloquent: несколько "выполнить"
 * подряд на ОДНОМ закреплённом соединении, коммит - только автоматический
 * (штатный возврат колбэка), откат - автоматический же (любое "выбросить",
 * любая паника - в т. ч. от ошибки самого SQL, - или явный
 * "тр.откатить()"). Результат наружу - через "&перем"/"*указ" (раздел 22
 * SPEC.md), не через возврат самой "начать_транзакцию" - копия
 * захваченного Указатель<T> несёт тот же адрес, запись через него внутри
 * колбэка видна снаружи после возврата.
 *
 * "тр.вложенная(колбэк)" - вложенная транзакция (SAVEPOINT) на том же
 * соединении: её откат (исключение/паника/"откатить()") отменяет только
 * сделанное внутри неё, внешняя транзакция продолжается и фиксируется
 * как обычно.
 */
функция главная
{
    переменная бд = подключиться_к_бд("sqlite::memory:")
    бд.выполнить("CREATE TABLE accounts (id INTEGER, balance INTEGER)")

    переменная параметры1 = новый Список<Значение>()
    параметры1.добавить((Значение) 1)
    параметры1.добавить((Значение) 100)
    бд.выполнить("INSERT INTO accounts (id, balance) VALUES (?, ?)", параметры1)

    переменная параметры2 = новый Список<Значение>()
    параметры2.добавить((Значение) 2)
    параметры2.добавить((Значение) 100)
    бд.выполнить("INSERT INTO accounts (id, balance) VALUES (?, ?)", параметры2)

    // Успешный перевод - обе строки одной транзакцией: если бы вторая
    // "выполнить" упала (например, нет такой строки), первая тоже
    // откатилась бы, счета не разошлись бы в пользу одной стороны.
    начать_транзакцию(бд, функция (тр: Транзакция) {
        переменная списать = новый Список<Значение>()
        списать.добавить((Значение) 30)
        списать.добавить((Значение) 1)
        тр.выполнить("UPDATE accounts SET balance = balance - ? WHERE id = ?", списать)

        переменная зачислить = новый Список<Значение>()
        зачислить.добавить((Значение) 30)
        зачислить.добавить((Значение) 2)
        тр.выполнить("UPDATE accounts SET balance = balance + ? WHERE id = ?", зачислить)
    })

    переменная баланс_после_перевода: Целое = 0
    переменная указ_на_баланс               = &баланс_после_перевода
    начать_транзакцию(бд, функция (тр: Транзакция) {
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) 1)
        переменная строки = тр.запросить("SELECT balance FROM accounts WHERE id = ?", параметры)
        *указ_на_баланс = строки.первый().получить("balance") как Целое
    })
    вывести `${баланс_после_перевода}\n`

    // Сознательная ошибка (несуществующая колонка) - паникует внутри
    // колбэка, "начать_транзакцию" откатывает автоматически, счета
    // остаются нетронутыми.
    попытаться {
        начать_транзакцию(бд, функция (тр: Транзакция) {
            переменная списать = новый Список<Значение>()
            списать.добавить((Значение) 1000)
            списать.добавить((Значение) 1)
            тр.выполнить("UPDATE accounts SET no_such_column = no_such_column - ? WHERE id = ?", списать)
        })
    } поймать (сообщение: Паника) {
        вывести `ожидаемая ошибка - откат\n`
    }

    переменная баланс_после_ошибки: Целое = 0
    переменная указ_на_баланс2            = &баланс_после_ошибки
    начать_транзакцию(бд, функция (тр: Транзакция) {
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) 1)
        переменная строки = тр.запросить("SELECT balance FROM accounts WHERE id = ?", параметры)
        *указ_на_баланс2 = строки.первый().получить("balance") как Целое
    })
    вывести `${баланс_после_ошибки}\n`

    // Вложенная транзакция: бонус зачисляется, а ошибочное списание во
    // вложенной откатывается до SAVEPOINT - бонус внешней транзакции
    // остаётся.
    начать_транзакцию(бд, функция (тр: Транзакция) {
        переменная бонус = новый Список<Значение>()
        бонус.добавить((Значение) 5)
        бонус.добавить((Значение) 1)
        тр.выполнить("UPDATE accounts SET balance = balance + ? WHERE id = ?", бонус)

        тр.вложенная(функция (вл: Транзакция) {
            переменная списать = новый Список<Значение>()
            списать.добавить((Значение) 500)
            списать.добавить((Значение) 1)
            вл.выполнить("UPDATE accounts SET balance = balance - ? WHERE id = ?", списать)
            вл.откатить()
        })
    })

    переменная баланс_после_вложенной: Целое = 0
    переменная указ_на_баланс3               = &баланс_после_вложенной
    начать_транзакцию(бд, функция (тр: Транзакция) {
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) 1)
        переменная строки = тр.запросить("SELECT balance FROM accounts WHERE id = ?", параметры)
        *указ_на_баланс3 = строки.первый().получить("balance") как Целое
    })
    вывести `${баланс_после_вложенной}\n`

    бд.закрыть()
}
