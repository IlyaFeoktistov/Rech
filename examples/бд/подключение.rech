/**
 * БД - единый API поверх SQLite/PostgreSQL/MySQL: "подключиться_к_бд"
 * возвращает БД, дальше - методы "бд.запросить(...)"/"бд.выполнить(...)"/
 * "бд.закрыть()" (метод-стиль поверх одноимённых свободных функций,
 * docs/SPEC.md, "БД"). "?" - общий плейсхолдер параметров во всех трёх, результат запроса -
 * Список<Словарь<Строка, Значение>> (schema-free форма - третий аргумент
 * "параметры" необязателен, по умолчанию пустой список, если у запроса нет
 * плейсхолдеров). Имена таблицы/колонок - латиницей, как обычно принято в SQL
 * (не связаны с тем, что сам Rech-код кириллический). Пример использует
 * SQLite (":memory:") - не требует внешнего сервера; PostgreSQL/MySQL
 * работают тем же кодом, только с другой строкой подключения
 * ("postgres://.../база", "mysql://.../база").
 */
сущность Пользователь
{
    имеет:
        имя:    Строка          `sql:name`
        баланс: ?Действительное `sql:balance`
}

функция главная
{
    переменная бд = подключиться_к_бд("sqlite::memory:")
    бд.выполнить("CREATE TABLE users (id INTEGER, name TEXT, balance REAL)")

    переменная параметры1 = новый Список<Значение>()
    параметры1.добавить((Значение) 1)
    параметры1.добавить((Значение) "Илья")
    параметры1.добавить((Значение) 9.5)
    вывести `${бд.выполнить("INSERT INTO users (id, name, balance) VALUES (?, ?, ?)", параметры1)}\n`

    переменная параметры2 = новый Список<Значение>()
    параметры2.добавить((Значение) 2)
    параметры2.добавить((Значение) "Аня")
    бд.выполнить("INSERT INTO users (id, name) VALUES (?, ?)", параметры2)

    переменная строки = бд.запросить("SELECT id, name, balance FROM users ORDER BY id")
    вывести `${строки.длина()}\n`

    переменная первая = строки.первый()
    вывести `${(первая.получить("name") как Строка)}\n`
    вывести `${(первая.получить("balance") как Действительное)}\n`

    переменная вторая = строки.получить(1)
    вывести `${(вторая.получить("name") как Строка)}\n`
    переменная баланс2 = вторая.получить("balance")
    переменная тип2    = баланс2.тип_значения()
    вывести `${тип2.имя()}\n`

    // "бд.запросить(...) как Список<Тип>" - typed-маппинг той же строки
    // результата в сущность по имени поля/тегу `sql:...` (не по умолчанию
    // schema-free Словарь<Строка, Значение> выше) - Пользователь.баланс
    // nullable, потому что у Ани (id 2) колонка balance не задана (NULL).
    переменная пользователи = бд.запросить("SELECT id, name, balance FROM users ORDER BY id") как Список<Пользователь>
    вывести `${пользователи.длина()}\n`
    вывести `${пользователи.первый().имя}\n`
    вывести `${пользователи.первый().баланс ?? -1.0}\n`
    вывести `${пользователи.получить(1).имя}\n`
    вывести `${пользователи.получить(1).баланс ?? -1.0}\n`

    бд.закрыть()
}
