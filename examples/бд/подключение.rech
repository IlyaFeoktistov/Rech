/** БД - единый API поверх SQLite/PostgreSQL/MySQL: "подключиться_к_бд"/
"запросить"/"выполнить"/"закрыть_бд" (docs/SPEC.md, "БД"). "?" - общий
плейсхолдер параметров во всех трёх, результат запроса -
Список<Словарь<Строка, Значение>>. Имена таблицы/колонок - латиницей, как
обычно принято в SQL (не связаны с тем, что сам Rech-код кириллический) -
если имя поля Rech-сущности при маппинге результата должно отличаться от
имени колонки, для этого есть тег `sql:...` (см. examples/основы/
тег_поля.rech). Пример использует SQLite (":memory:") - не требует внешнего
сервера; PostgreSQL/MySQL работают тем же кодом, только с другой строкой
подключения ("postgres://.../база", "mysql://.../база"). */
функция главная
{
    переменная бд = подключиться_к_бд("sqlite::memory:")
    выполнить(бд, "CREATE TABLE users (id INTEGER, name TEXT, balance REAL)", новый Список<Значение>())

    переменная параметры1 = новый Список<Значение>()
    параметры1.добавить((Значение) 1)
    параметры1.добавить((Значение) "Илья")
    параметры1.добавить((Значение) 9.5)
    вывести выполнить(бд, "INSERT INTO users (id, name, balance) VALUES (?, ?, ?)", параметры1)

    переменная параметры2 = новый Список<Значение>()
    параметры2.добавить((Значение) 2)
    параметры2.добавить((Значение) "Аня")
    выполнить(бд, "INSERT INTO users (id, name) VALUES (?, ?)", параметры2)

    переменная строки = запросить(бд, "SELECT id, name, balance FROM users ORDER BY id", новый Список<Значение>())
    вывести строки.длина()

    переменная первая = строки.получить(0)
    вывести (первая.получить("name") как Строка)
    вывести (первая.получить("balance") как Действительное)

    переменная вторая = строки.получить(1)
    вывести (вторая.получить("name") как Строка)
    переменная баланс2 = вторая.получить("balance")
    переменная тип2 = баланс2.тип_значения()
    вывести тип2.имя()

    закрыть_бд(бд)
}
