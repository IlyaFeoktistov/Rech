/**
 * Постраничная обработка результата БД большими порциями по возрастанию
 * значения курсорного поля - аналог "chunkById" в Laravel Eloquent: вместо
 * OFFSET (дорого растущего с глубиной страницы и нестабильного при
 * параллельных INSERT/DELETE между чтением страниц) каждая следующая
 * страница запрашивается условием "поле_курсора > последнее увиденное
 * значение", отсортированным по тому же полю по возрастанию - обработчик
 * получает страницу целиком (Список<T>), не по одной строке.
 *
 * Колонка/тег - тем же принципом, что и у "выполнить_модель"
 * (examples/бд/orm_легковесный.rech, `sql:...` либо само имя поля). T обязан
 * удовлетворять тем же ограничениям, что и цель "запросить(...) как
 * Список<Тип>" (docs/SPEC.md, раздел "БД") - без собственного конструктора,
 * только примитивные/nullable поля.
 *
 * из_запроса - "SELECT ..." БЕЗ WHERE/ORDER BY/LIMIT (та же дисциплина
 * курируемого минимума, что у извлечь_имена_колонок в orm_легковесный.rech -
 * не полный построитель запросов): доп_условие - необязательное
 * ДОПОЛНИТЕЛЬНОЕ условие WHERE (свои "?" в доп_параметры), условие и
 * сортировку по поле_курсора добавляет сама эта функция.
 */
функция ключ_колонки(тип_модели: Тип, индекс: Целое): Строка
{
    переменная тег = тип_модели.тег_поля(индекс, "sql")
    если тег != "" {
        вернуть тег
    }

    вернуть тип_модели.имя_поля(индекс)
}

/**
 * Значение курсорного поля последней строки страницы - находит поле по
 * его SQL-колонке (тег/имя, ключ_колонки) и боксирует его через рефлексию,
 * готовым параметром для запроса следующей страницы.
 */
функция значение_курсора(тип_модели: Тип, строка: Значение, поле_курсора: Строка): Значение
{
    переменная i = 0
    пока i < тип_модели.число_полей() {
        если ключ_колонки(тип_модели, i) == поле_курсора {
            вернуть строка.получить_поле(тип_модели.имя_поля(i))
        }
        i++
    }
    выбросить новое Исключение(`у сущности "${тип_модели.имя()}" нет поля с тегом/именем колонки "${поле_курсора}"`)
}

/** Возвращает общее число обработанных строк. */
функция чанковать_по_полю<T>(
    бд: БД,
    из_запроса: Строка,
    поле_курсора: Строка,
    размер_чанка: Целое,
    обработчик: Вызываемый(Список<T>),
    доп_условие: Строка = "",
    доп_параметры: Список<Значение> = новый Список<Значение>(),
): Целое {
    переменная всего_обработано           = 0
    переменная есть_курсор                = ложь
    переменная последний_курсор: Значение = (Значение) 0
    переменная продолжать                 = истина

    пока продолжать {
        переменная условие = ""
        если доп_условие != "" {
            условие = "(" + доп_условие + ")"
        }
        если есть_курсор {
            если условие != "" {
                условие = условие + " AND "
            }
            условие = условие + поле_курсора + " > ?"
        }

        переменная параметры = новый Список<Значение>()
        переменная i         = 0
        пока i < доп_параметры.длина() {
            параметры.добавить(доп_параметры.получить(i))
            i++
        }
        если есть_курсор {
            параметры.добавить(последний_курсор)
        }
        параметры.добавить((Значение) размер_чанка)

        переменная sql = из_запроса
        если условие != "" {
            sql = sql + " WHERE " + условие
        }
        sql = sql + " ORDER BY " + поле_курсора + " ASC LIMIT ?"

        переменная страница        = бд.запросить(sql, параметры) как Список<T>
        переменная размер_страницы = страница.длина()

        если размер_страницы > 0 {
            обработчик(страница)
            всего_обработано = всего_обработано + размер_страницы
            переменная последняя_строка = (Значение) страница.последний()
            последний_курсор = значение_курсора(последняя_строка.тип_значения(), последняя_строка, поле_курсора)
            есть_курсор = истина
        }

        продолжать = размер_страницы > 0 и размер_страницы == размер_чанка
    }

    вернуть всего_обработано
}

структура Пользователь
{
    имеет:
        id:  Целое
        имя: Строка `sql:name`
}

константа МАКС_РАЗМЕР_ЧАНКА = 3

функция главная
{
    переменная бд = подключиться_к_бд("sqlite::memory:")
    бд.выполнить("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")

    переменная i = 1
    пока i <= 7 {
        переменная параметры = новый Список<Значение>()
        параметры.добавить((Значение) i)
        параметры.добавить((Значение) `пользователь${i}`)
        бд.выполнить("INSERT INTO users (id, name) VALUES (?, ?)", параметры)
        i = i + 1
    }

    переменная всего = чанковать_по_полю(
        бд,
        "SELECT id, name FROM users",
        "id",
        МАКС_РАЗМЕР_ЧАНКА,
        функция (страница: Список<Пользователь>) {
            вывести `чанк из ${страница.длина()} строк:\n`
            переменная j = 0
            пока j < страница.длина() {
                вывести `  ${страница.получить(j).id} ${страница.получить(j).имя}\n`
                j++
            }
        },
    )
    вывести `всего обработано: ${всего}\n`

    // Доп_условие - "WHERE id > 2" ПОВЕРХ курсорного условия чанкования,
    // своими "?"-параметрами (доп_параметры), не заменяет его.
    переменная доп_параметры = новый Список<Значение>()
    доп_параметры.добавить((Значение) 2)
    переменная отфильтровано = чанковать_по_полю(
        бд,
        "SELECT id, name FROM users", "id",
        МАКС_РАЗМЕР_ЧАНКА,
        функция (страница: Список<Пользователь>) {
            вывести `отфильтрованный чанк из ${страница.длина()} строк, первый id ${страница.первый().id}\n`
        },
        "id > ?",
        доп_параметры,
    )
    вывести `отфильтровано: ${отфильтровано}\n`

    бд.закрыть()
}
