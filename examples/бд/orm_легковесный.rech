/**
 * "ORM-lite" - библиотека НА САМОМ Rech (не фича компилятора - см.
 * docs/SPEC.md, "Методы Тип", про `тег_поля(i, ключ)`: API рефлексии полей
 * с тегами задуман именно для такой библиотеки), закрывающая одну
 * конкретную неудобность API БД (examples/бд/подключение.rech): вставка
 * строки без ручного "параметры.добавить((Значение) поле)" на каждое поле
 * по отдельности.
 *
 * "выполнить_модель(бд, sql, модель)" читает список колонок ПРЯМО ИЗ
 * ТЕКСТА sql (первая круглая скобочная группа - "INSERT INTO t (a, b, c)
 * VALUES (?, ?, ?)") и для каждой колонки находит поле модели, чей тег
 * `sql:...` (или, если тега нет, - само имя поля) совпадает с ней - тем же
 * ключом `sql:...`, которым уже пользуется ВСТРОЕННЫЙ (не библиотечный)
 * "запросить(...) как Список<Тип>" (internal/semantic/db_rows.go,
 * sqlFieldKey) - один и тот же тег на модели обслуживает и чтение, и
 * запись, показано ниже в "главная". Порядок "?" в sql не важен ни разу -
 * только порядок КОЛОНОК в самой этой скобочной группе.
 *
 * Область применения - ТОЛЬКО форма "... (колонка, колонка, ...) ..."
 * (INSERT со списком колонок) - для UPDATE/WHERE и любых "?" вне этой
 * скобочной группы по-прежнему пишите Список<Значение> вручную, как в
 * examples/бд/подключение.rech (таково и было решение).
 *
 * Строка/generic-коллекция без библиотеки "разбить"/"подстрока"/
 * "позиция_в_строке" (в языке пока нет regex, "Отложено -
 * регулярные выражения") - извлечение списка колонок написано вручную этими
 * тремя. Обрезка пробелов - встроенная "обрезать" (добавлена позже, по ходу
 * examples/проекты/чат_сервер - именно этот файл первым столкнулся с её
 * отсутствием и первым писал её вручную).
 */
/**
 * Список имён колонок из ПЕРВОЙ круглой скобочной группы sql ("INSERT INTO
 * t (a, b, c) ..." -> ["a", "b", "c"]) - предполагает, что группа не
 * содержит вложенных скобок (обычный список колонок INSERT, не подзапрос).
 */
функция извлечь_имена_колонок(sql: Строка): Список<Строка>
{
    переменная открывающая = позиция_в_строке(sql, "(")
    если открывающая == -1 {
        выбросить новое Исключение("в SQL-тексте не найден список колонок в скобках: " + sql)
    }
    переменная остаток     = подстрока(sql, открывающая + 1, длина_строки(sql) - открывающая - 1)
    переменная закрывающая = позиция_в_строке(остаток, ")")
    если закрывающая == -1 {
        выбросить новое Исключение("в SQL-тексте не найдена закрывающая скобка списка колонок: " + sql)
    }
    переменная сырые_части = разбить(подстрока(остаток, 0, закрывающая), ",")
    переменная колонки     = новый Список<Строка>()
    переменная i           = 0
    пока i < сырые_части.длина() {
        колонки.добавить(обрезать(сырые_части.получить(i)))
        i = i + 1
    }
    вернуть колонки
}

/**
 * Внешний ключ колонки поля индекс сущности тип_модели - тег "sql:..."
 * (internal/structtag), если он задан, иначе само имя поля - ТОТ ЖЕ
 * принцип, что и sqlFieldKey (internal/semantic/db_rows.go) у встроенного
 * "запросить(...) как Список<Тип>".
 */
функция ключ_колонки(тип_модели: Тип, индекс: Целое): Строка
{
    переменная тег = тип_модели.тег_поля(индекс, "sql")
    если тег != "" {
        вернуть тег
    }
    вернуть тип_модели.имя_поля(индекс)
}

/**
 * Значение поля модели, чья колонка (ключ_колонки) равна колонка -
 * аварийно завершается исключением, если ни одно поле не соответствует
 * (опечатка в sql либо в теге модели - лучше явная ошибка сразу, чем
 * молчаливый пропуск параметра и сдвиг всех "?" после него).
 */
функция значение_поля_по_колонке(тип_модели: Тип, модель: Значение, колонка: Строка): Значение
{
    переменная i = 0
    пока i < тип_модели.число_полей() {
        если ключ_колонки(тип_модели, i) == колонка {
            вернуть модель.получить_поле(тип_модели.имя_поля(i))
        }
        i = i + 1
    }
    выбросить новое Исключение("у сущности \"" + тип_модели.имя() + "\" нет поля с тегом/именем колонки \"" + колонка + "\"")
}

/**
 * Список<Значение> для "выполнить"/"запросить" - колонки модели (по
 * порядку из sql) идут первыми, доп_параметры (условие WHERE и т. п.,
 * колонок модели не касается) - следом, в том порядке, в каком написаны.
 */
функция параметры_из_модели(sql: Строка, модель: Значение, доп_параметры: Список<Значение>): Список<Значение>
{
    переменная тип_модели = модель.тип_значения()
    переменная колонки    = извлечь_имена_колонок(sql)
    переменная параметры  = новый Список<Значение>()

    переменная i = 0
    пока i < колонки.длина() {
        параметры.добавить(значение_поля_по_колонке(тип_модели, модель, колонки.получить(i)))
        i = i + 1
    }
    i = 0
    пока i < доп_параметры.длина() {
        параметры.добавить(доп_параметры.получить(i))
        i = i + 1
    }
    вернуть параметры
}

/**
 * "выполнить", собирающий параметры из модели сам - вместо ручного
 * "параметры.добавить((Значение) поле)" на каждое поле (examples/бд/
 * подключение.rech, "INSERT INTO users (username, ...) VALUES (?, ?, ?)")
 * теперь один вызов: "выполнить_модель(бд, sql, (Значение) модель)".
 * доп_параметры - необязательные "?" СВЕРХ колонок модели (например,
 * "... WHERE id = ?" у UPDATE), по умолчанию пусто.
 */
функция выполнить_модель(бд: БД, sql: Строка, модель: Значение, доп_параметры: Список<Значение> = новый Список<Значение>()): Целое
{
    вернуть бд.выполнить(sql, параметры_из_модели(sql, модель, доп_параметры))
}

/**
 * Модель без "конструктор(...)" - обязательное условие и для
 * "выполнить_модель" (рефлексия читает поля по имени/тегу), и для
 * встроенного "запросить(...) как Список<Тип>" ниже (internal/semantic/
 * db_rows.go запрещает целевую сущность с собственным конструктором) -
 * "структура" вместо "сущность" позволяет создать её позиционно
 * ("новый Пользователь(...)") без явного тела конструктора. Один и тот же
 * тег `sql:...` обслуживает и запись (выполнить_модель), и чтение
 * (запросить(...) как Список<Пользователь>).
 */
структура Пользователь
{
    имеет:
        имя_пользователя: Строка `sql:username`
        хеш_пароля:       Строка `sql:password_hash`
        соль:             Строка `sql:salt`
}

функция главная
{
    переменная бд = подключиться_к_бд("sqlite::memory:")
    бд.выполнить("CREATE TABLE users (username TEXT PRIMARY KEY, password_hash TEXT, salt TEXT)")

    переменная модель = новый Пользователь("admin", "хеш-пароля-условный", "соль-условная")
    вывести выполнить_модель(бд, "INSERT INTO users (username, password_hash, salt) VALUES (?, ?, ?)", (Значение) модель)

    переменная пользователи = бд.запросить("SELECT username, password_hash, salt FROM users") как Список<Пользователь>
    вывести пользователи.длина()
    вывести пользователи.первый().имя_пользователя
    вывести пользователи.первый().хеш_пароля
    вывести пользователи.первый().соль

    бд.закрыть()
}
