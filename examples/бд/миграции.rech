/**
 * Миграции схемы БД - библиотека НА САМОМ Rech (тот же принцип, что и у
 * examples/бд/orm_легковесный.rech - не фича компилятора). Одна миграция -
 * обычная сущность, реализующая интерфейс "Миграция" (версия + "накатить"/
 * "откатить") - тело обоих методов ничем не отличается от любого другого
 * Rech-кода с БД: обычные "бд.выполнить(sql, параметры)", можно
 * пользоваться и "выполнить_модель" (orm_легковесный.rech), и рефлексией -
 * никакого отдельного языка описания схемы или формата файла миграции нет.
 *
 * Состояние - ОДНА строка в служебной таблице "rech_schema_version"
 * (текущая версия схемы целиком, а не журнал применённых миграций по
 * отдельности) - "применить_миграции" накатывает всё с версией БОЛЬШЕ
 * текущей, "откатить_до" откатывает всё с версией больше целевой, в
 * порядке от старшей к младшей. Список миграций - обычный Список<Миграция>,
 * который вызывающий код составляет сам, ПЕРЕЧИСЛЯЯ каждую миграцию явно, в
 * порядке возрастания версии (библиотека не сортирует и не ищет миграции
 * сама - в языке нет рефлексии вида "все типы, реализующие интерфейс X",
 * поэтому автообнаружения по файлам, как в других языках/фреймворках,
 * здесь нет и не может быть без этого).
 */
/**
 * Миграция - версия() однозначно определяет её место среди остальных
 * (обычно просто порядковый номер 1, 2, 3, ... - но подойдёт и дата вида
 * 20260905, если так удобнее). "накатить"/"откатить" - обратные друг другу
 * действия над схемой ("CREATE TABLE" / "DROP TABLE", "ADD COLUMN" / нет
 * обратного в SQLite - тогда откатить() может быть пустым телом, откат
 * такой миграции просто необратим, и это ответственность автора миграции,
 * не библиотеки).
 */
интерфейс Миграция
{
    версия(): Целое
    накатить(бд: БД)
    откатить(бд: БД)
}

/**
 * Создаёт служебную таблицу версии схемы, если её ещё нет, и заводит в ней
 * единственную строку "version = 0" - идемпотентно, безопасно вызывать
 * перед каждой операцией.
 */
функция убедиться_в_таблице_версии(бд: БД)
{
    бд.выполнить("CREATE TABLE IF NOT EXISTS rech_schema_version (version INTEGER NOT NULL)")
    переменная строки = бд.запросить("SELECT version FROM rech_schema_version")
    если строки.длина() == 0 {
        бд.выполнить("INSERT INTO rech_schema_version (version) VALUES (0)")
    }
}

/** Текущая версия схемы (0 - ни одна миграция ещё не применена). */
функция текущая_версия_схемы(бд: БД): Целое
{
    убедиться_в_таблице_версии(бд)
    переменная строки = бд.запросить("SELECT version FROM rech_schema_version")

    вернуть (строки.первый().получить("version") как Целое)
}

функция установить_версию_схемы(бд: БД, версия: Целое)
{
    переменная параметры = новый Список<Значение>()
    параметры.добавить((Значение) версия)
    бд.выполнить("UPDATE rech_schema_version SET version = ?", параметры)
}

/**
 * Накатывает по порядку списка (см. package doc про обязательный порядок
 * возрастания версии) каждую миграцию, чья версия() больше текущей версии
 * схемы - версия схемы обновляется сразу после каждой отдельной миграции
 * (не одной записью в конце), поэтому упавшая на середине "накатить"
 * оставляет корректную "текущую версию" для следующего запуска, а не
 * заставляет повторно накатывать уже применённые.
 */
функция применить_миграции(бд: БД, миграции: Список<Миграция>)
{
    переменная текущая = текущая_версия_схемы(бд)
    переменная i       = 0
    пока i < миграции.длина() {
        переменная м = миграции.получить(i)
        если м.версия() > текущая {
            м.накатить(бд)
            установить_версию_схемы(бд, м.версия())
        }

        i++
    }
}

/**
 * Откатывает от старшей версии к младшей все миграции с версией больше
 * целевая_версия (включительно вниз до нее) - целевая_версия == 0 отменяет
 * вообще всё.
 */
функция откатить_до(бд: БД, миграции: Список<Миграция>, целевая_версия: Целое)
{
    переменная текущая = текущая_версия_схемы(бд)
    переменная i       = миграции.длина() - 1
    пока i >= 0 {
        переменная м = миграции.получить(i)
        если м.версия() <= текущая и м.версия() > целевая_версия {
            м.откатить(бд)
        }
        i--
    }
    установить_версию_схемы(бд, целевая_версия)
}

сущность СоздатьТаблицуЮзеров реализует Миграцию
{
    версия(): Целое
    {
        вернуть 1
    }

    накатить(бд: БД)
    {
        бд.выполнить("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
    }

    откатить(бд: БД)
    {
        бд.выполнить("DROP TABLE users")
    }
}

сущность ДобавитьВозрастЮзерам реализует Миграцию
{
    версия(): Целое
    {
        вернуть 2
    }

    накатить(бд: БД)
    {
        бд.выполнить("ALTER TABLE users ADD COLUMN age INTEGER")
    }

    // SQLite не умеет "DROP COLUMN" - откат этой миграции необратим (см.
    // package doc интерфейса "Миграция"), пустое тело документирует это
    // явно, а не молча ничего не делает по недосмотру.
    откатить(бд: БД)
    {
    }
}

функция главная
{
    переменная бд = подключиться_к_бд("sqlite::memory:")

    переменная миграции = новый Список<Миграция>()
    миграции.добавить(новый СоздатьТаблицуЮзеров())
    миграции.добавить(новый ДобавитьВозрастЮзерам())

    применить_миграции(бд, миграции)
    вывести `${текущая_версия_схемы(бд)}\n`

    переменная параметры = новый Список<Значение>()
    параметры.добавить((Значение) "Аня")
    параметры.добавить((Значение) 30)
    бд.выполнить("INSERT INTO users (name, age) VALUES (?, ?)", параметры)
    переменная строки = бд.запросить("SELECT name, age FROM users")
    вывести `${строки.длина()}\n`

    откатить_до(бд, миграции, 0)
    вывести `${текущая_версия_схемы(бд)}\n`

    бд.закрыть()
}
