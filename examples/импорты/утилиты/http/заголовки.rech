/**
 * Демонстрирует "../" и "@" - оба способа дотянуться до "утилиты.rech"
 * (два уровня выше этого файла - "утилиты/http/" -> "утилиты/" ->
 * "импорты/") из подпапки "утилиты/http/": "сложить" - через
 * "../../утилиты" (навигация вверх по дереву, тем же смыслом, что и в
 * путях большинства языков), "Точка" - через "@утилиты" (абсолютный путь
 * от корня программы - каталога entry-файла "главный.rech" - работает
 * одинаково из ЛЮБОЙ подпапки, не завися от глубины вложенности этого
 * файла - в отличие от "../../", число уровней здесь не пришлось бы менять
 * при переносе файла ещё глубже).
 */
использовать сложить из "../../утилиты"
использовать Точка из "@утилиты"

функция описание_суммы(a: Целое, b: Целое): Строка
{
    переменная p = новая Точка(a, b)
    вернуть (Строка) сложить(p.x, p.y)
}
