// "приватная" - видна только внутри этого файла, "использовать
// проверить_числа из "утилиты"" из другого файла было бы ошибкой
// компиляции ("приватное - недоступно для \"использовать\"").
приватная функция проверить_числа(a: Целое, b: Целое)
{
    утверждать a >= 0
    утверждать b >= 0
}

/** Складывает два числа. */
функция сложить(a: Целое, b: Целое): Целое
{
    проверить_числа(a, b)
    вернуть a + b
}

/** Точка на плоскости. */
сущность Точка
{
    имеет:
        x: Целое
        y: Целое

    конструктор(x: Целое, y: Целое)
    {
        этот.x = x
        этот.y = y
    }
}
