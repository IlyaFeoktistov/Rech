// Оба файла объявляют функцию с одним и тем же именем "получить_версию" -
// без переименования при импорте второй "использовать" был бы ошибкой
// (имя уже занято первым импортом).
использовать получить_версию как версия_а из "версия_а"
использовать получить_версию как версия_б из "версия_б"

/** Демонстрирует переименование импорта через "использовать ... как ...". */
функция главная
{
    вывести версия_а()
    вывести версия_б()
}
