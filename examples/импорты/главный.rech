использовать сложить, Точка, Представимый, МаксимумПопыток, ПорогПредупреждения из "утилиты"
использовать описание_кода из "утилиты/http/коды_ответов"
использовать описание_суммы из "утилиты/http/заголовки"

/**
 * Принимает любую сущность, реализующую интерфейс, импортированный по
 * имени из "утилиты" - "использовать" импортирует интерфейс точно так же,
 * как функцию/сущность.
 */
функция вывести_представление(о: Представимый)
{
    вывести о.представить()
}

/**
 * Демонстрирует "использовать" из соседнего файла, вложенного каталога, а
 * также "../" и "@" (см. package doc "утилиты/http/заголовки.rech") -
 * оба способа подняться из подпапки обратно к файлу выше по дереву.
 */
функция главная
{
    переменная сумма = сложить(2, 3)
    вывести сумма

    переменная p = новая Точка(1, 2)
    вывести p.x
    вывести_представление(p)

    вывести описание_кода(200)

    вывести описание_суммы(4, 5)

    // Константа уровня модуля, импортированная по имени - "ВнутреннийРежим"
    // в "утилиты.rech" приватное, "использовать ВнутреннийРежим из
    // "утилиты"" здесь было бы ошибкой компиляции.
    вывести МаксимумПопыток

    // "внутренняя" константа - импортируется точно так же, как "публичная",
    // пока файл-потребитель принадлежит ТОМУ ЖЕ проекту (см. комментарий в
    // "утилиты.rech").
    вывести ПорогПредупреждения
}
