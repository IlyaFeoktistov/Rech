использовать сложить, Точка из "утилиты"
использовать описание_кода из "утилиты/http/коды_ответов"
использовать описание_суммы из "утилиты/http/заголовки"

/** Демонстрирует "использовать" из соседнего файла, вложенного каталога, а
 * также "../" и "@" (см. package doc "утилиты/http/заголовки.rech") -
 * оба способа подняться из подпапки обратно к файлу выше по дереву. */
функция главная
{
    переменная сумма = сложить(2, 3)
    вывести сумма

    переменная p = новая Точка(1, 2)
    вывести p.x

    вывести описание_кода(200)

    вывести описание_суммы(4, 5)
}
