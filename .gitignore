/rech

# MkDocs (пользовательская документация из docs/*.md, README.md) - собранный
# сайт и venv для его сборки, не коммитим.
/site
/.venv-docs

# В examples/ (в т.ч. во вложенных тематических папках) хранятся только
# исходники на Rech и файлы проекта (.rechproj); всё, что генерирует
# компилятор (*.c, каталог "выход" из .rechproj и собранные бинарники без
# расширения), не коммитим.
examples/**
!examples/**/
!examples/**/*.rech
!examples/**/*.rechproj

# testdata/файлы_вывод.txt - результат запуска examples/основы/файлы.rech
# (запись/дозапись), не исходник - не коммитим, как и .c/бинарники выше.
testdata/файлы_вывод.txt
